{% # theme-check-disable %}
{%- if settings.type_body_font.system? == false and settings.type_body_custom_font == 'none' -%}
  <link
    rel="preload"
    as="font"
    href="{{ settings.type_body_font | font_url }}"
    type="font/woff2"
    crossorigin
    fetchpriority="low"
  >
{%- endif -%}
