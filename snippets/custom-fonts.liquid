{%- doc -%}
  Declares the bundled brand fonts (assets/font-*.woff2) and exposes each family as
  `--font-custom--<slug>`. Theme settings → Typography → Custom fonts map these onto the
  body, subheading, heading, and accent roles in `theme-styles-variables`.

  Browsers only download a face when rendered text uses it, so declaring every family is cheap.
  Only the body font's regular face is preloaded.

  @example
  {% render 'custom-fonts' %}
{%- enddoc -%}
{%- liquid
  case settings.type_body_custom_font
    when 'gotham'
      assign body_preload = 'font-gotham-book.woff2'
    when 'gotham_narrow'
      assign body_preload = 'font-gotham-narrow-book.woff2'
    when 'alexio_ace_display'
      assign body_preload = 'font-alexio-ace-display-regular.woff2'
    when 'albert_sans'
      assign body_preload = 'font-albert-sans-variable.woff2'
    when 'bahnschrift'
      assign body_preload = 'font-bahnschrift-variable.woff2'
    when 'bebas'
      assign body_preload = 'font-bebas-regular.woff2'
    when 'bebas_kai'
      assign body_preload = 'font-bebas-kai-regular.woff2'
    when 'bebas_neue'
      assign body_preload = 'font-bebas-neue-regular.woff2'
    when 'calibri'
      assign body_preload = 'font-calibri-regular.woff2'
    when 'cambria'
      assign body_preload = 'font-cambria-regular.woff2'
    when 'century_gothic'
      assign body_preload = 'font-century-gothic-regular.woff2'
    when 'capsule_x_pro'
      assign body_preload = 'font-capsule-x-pro-medium.woff2'
    when 'magnolia_script'
      assign body_preload = 'font-magnolia-script-regular.woff2'
  endcase
-%}
{%- if body_preload != blank -%}
  {{ body_preload | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}
