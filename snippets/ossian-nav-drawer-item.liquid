{%- doc -%}
  Renders one item of the Ossion mobile nav drawer: a round icon, the label, and
  either a chevron link or (when it has child links) an expandable panel with the
  child links, a "View all" link and an optional image.

  @param {string} title - Item label
  @param {string} [url] - Item link, also used for "View all"
  @param {object[]} [children] - Child links (linklist links)
  @param {object} [image] - Image shown inside the expanded panel
  @param {boolean} [current] - Whether the item is the current page
  @param {string} [attrs] - block.shopify_attributes, for the theme editor
{%- enddoc -%}

{%- liquid
  assign key = title | downcase
  assign icon = 'default'
  if key contains 'hair'
    assign icon = 'hair'
  elsif key contains 'skin'
    assign icon = 'leaf'
  elsif key contains 'wax'
    assign icon = 'drop'
  elsif key contains 'facial' or key contains 'face'
    assign icon = 'face'
  elsif key contains 'about'
    assign icon = 'info'
  elsif key contains 'science' or key contains 'lab'
    assign icon = 'flask'
  elsif key contains 'contact' or key contains 'help' or key contains 'support'
    assign icon = 'headset'
  endif

  assign has_children = false
  if children.size > 0
    assign has_children = true
  endif
-%}

{%- capture icon_svg -%}
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- case icon -%}
      {%- when 'hair' -%}
        <path d="M8 20c-2-2-3-5-3-9a7 7 0 0 1 14 0c0 4-1 7-3 9"/><path d="M9 20c-1-2-1.5-4-1.5-7 0-2.5 2-4.5 4.5-4.5"/><path d="M12 8.5c2.5 0 4.5 2 4.5 4.5 0 3-.5 5-1.5 7"/><path d="M10.5 12.5c0 2 .5 4 1.5 7.5"/>
      {%- when 'leaf' -%}
        <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19l9-9"/>
      {%- when 'drop' -%}
        <path d="M12 3c3.5 4.5 6 8 6 11a6 6 0 0 1-12 0c0-3 2.5-6.5 6-11z"/><path d="M9 15a3 3 0 0 0 3 3"/>
      {%- when 'face' -%}
        <path d="M12 3c-4 0-6.5 3-6.5 7.5S8 21 12 21s6.5-6 6.5-10.5S16 3 12 3z"/><path d="M8.5 10h2M13.5 10h2"/><path d="M10 15c1.2.8 2.8.8 4 0"/><path d="M7 7.5c2 .8 8 .8 10 0"/>
      {%- when 'info' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><circle cx="12" cy="7.5" r=".6" fill="currentColor"/>
      {%- when 'flask' -%}
        <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3"/><path d="M7.5 15h9"/>
      {%- when 'headset' -%}
        <path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/><path d="M19 20c0 1-1.5 1.5-4 1.5"/>
      {%- else -%}
        <path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>
    {%- endcase -%}
  </svg>
{%- endcapture -%}

<li class="ossian-nav-drawer__item{% if has_children %} ossian-nav-drawer__item--parent{% endif %}" {{ attrs }}>
  {%- if has_children -%}
    <button
      type="button"
      class="ossian-nav-drawer__row"
      data-nav-accordion
      aria-expanded="false"
    >
      <span class="ossian-nav-drawer__icon">{{ icon_svg }}</span>
      <span class="ossian-nav-drawer__label">{{ title }}</span>
      <svg class="ossian-nav-drawer__chevron ossian-nav-drawer__chevron--down" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="ossian-nav-drawer__panel" hidden>
      <ul class="ossian-nav-drawer__sublist">
        {%- for child in children -%}
          <li>
            <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
            {%- if child.links.size > 0 -%}
              <ul class="ossian-nav-drawer__subsublist">
                {%- for grandchild in child.links -%}
                  <li>
                    <a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if url != blank and url != '#' -%}
        <a href="{{ url }}" class="ossian-nav-drawer__view-all">
          View all {{ title }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      {%- if image != blank -%}
        <div class="ossian-nav-drawer__panel-image">
          {{ image | image_url: width: 400 | image_tag: loading: 'lazy', alt: title, sizes: '160px' }}
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    <a
      href="{{ url | default: routes.root_url }}"
      class="ossian-nav-drawer__row"
      {% if current %}aria-current="page"{% endif %}
    >
      <span class="ossian-nav-drawer__icon">{{ icon_svg }}</span>
      <span class="ossian-nav-drawer__label">{{ title }}</span>
      <svg class="ossian-nav-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  {%- endif -%}
</li>
