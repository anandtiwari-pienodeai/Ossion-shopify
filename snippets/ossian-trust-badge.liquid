{%- doc -%}
  Renders the icon and text of one trust marker. Icons inherit the section's text color.
  Owned by sections/ossian-trust-ticker.liquid, which holds the layout and styles.

  @param {object} badge - The trust badge block's settings

  @example
  {% render 'ossian-trust-badge', badge: block.settings %}
{%- enddoc -%}
<div class="trust-ticker__icon">
  {%- case badge.icon -%}
    {%- when 'image' -%}
      {%- if badge.custom_icon != blank -%}
        {{
          badge.custom_icon
          | image_url: width: 96
          | image_tag: class: 'trust-ticker__custom-icon', loading: 'lazy', alt: '', widths: '48, 96', sizes: '48px'
        }}
      {%- endif -%}
    {%- else -%}
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- case badge.icon -%}
          {%- when 'leaf' -%}
            <path d="M28 4C14 4 6 10 6 19c0 2 .5 3.5 1.5 5 1.5 1 3 1.5 5 1.5C22 25.5 28 18 28 4Z"/>
            <path d="M3 29c4-7 9-12 16-16"/>
          {%- when 'shield' -%}
            <path d="M16 3 5 7v9c0 6.5 4.5 11 11 13 6.5-2 11-6.5 11-13V7L16 3Z"/>
            <path d="m11 16 3.5 3.5L21 13"/>
          {%- when 'droplet' -%}
            <path d="M16 3c-5 6.5-9.5 11.5-9.5 17a9.5 9.5 0 0 0 19 0C25.5 14.5 21 9.5 16 3Z"/>
          {%- when 'sparkle' -%}
            <path d="M21 3c.6 4.5 2.5 6.4 7 7-4.5.6-6.4 2.5-7 7-.6-4.5-2.5-6.4-7-7 4.5-.6 6.4-2.5 7-7Z"/>
            <path d="M10 15c.5 3.7 2.3 5.5 6 6-3.7.5-5.5 2.3-6 6-.5-3.7-2.3-5.5-6-6 3.7-.5 5.5-2.3 6-6Z"/>
          {%- when 'star' -%}
            <path d="m16 4 3.7 7.6 8.3 1.2-6 5.9 1.4 8.3-7.4-3.9L8.6 27l1.4-8.3-6-5.9 8.3-1.2L16 4Z"/>
          {%- when 'lab' -%}
            <path d="M11 3h10M13 3v9L5.5 25a2.7 2.7 0 0 0 2.3 4h16.4a2.7 2.7 0 0 0 2.3-4L19 12V3"/>
            <path d="M16 21h.01"/>
          {%- when 'award' -%}
            <circle cx="16" cy="12" r="8.5"/>
            <path d="m10.5 19-2 10 7.5-4 7.5 4-2-10"/>
          {%- when 'rabbit' -%}
            <path d="M9 28h13c3 0 5-2 5-5 0-3.5-2.5-6-6-7 1.5-1 2.5-2.5 2-4.5 2-1.5 2.5-5 1-8-2.5.5-4 2.5-4.5 5-1-2-2.5-3.5-5-4-.5 3 .5 6 3 8-5 .5-10 4-10.5 9-2 .5-3 2-3 3.5S5.5 28 7 28h2Z"/>
            <path d="M13 28c1-2 2.5-3 5-3"/>
          {%- when 'professionals' -%}
            <path d="m16 2 1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3-2.2-2.1 3-.4L16 2Z"/>
            <path d="m16 21 1.3 2.7 3 .4-2.2 2.1.5 3-2.6-1.4-2.6 1.4.5-3-2.2-2.1 3-.4L16 21Z"/>
            <circle cx="7" cy="14" r="2.8"/>
            <circle cx="25" cy="14" r="2.8"/>
            <path d="M2 24c0-3.3 2-5.5 5-5.5 1.3 0 2.5.4 3.3 1.2M30 24c0-3.3-2-5.5-5-5.5-1.3 0-2.5.4-3.3 1.2"/>
          {%- else -%}
            <path d="M16 5v22M5 16h22"/>
        {%- endcase -%}
      </svg>
  {%- endcase -%}
</div>
<div class="trust-ticker__text">
  {%- if badge.title != blank -%}
    <strong class="trust-ticker__title">{{ badge.title | escape }}</strong>
  {%- endif -%}
  {%- if badge.description != blank -%}
    <span class="trust-ticker__desc">{{ badge.description | escape }}</span>
  {%- endif -%}
</div>
