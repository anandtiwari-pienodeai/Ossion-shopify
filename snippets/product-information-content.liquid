{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {number} product_media_size - Number of media items in the product
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product_media_size: product.media.size,
    section_id: section.id,
    settings: settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  assign product_has_media = true
  if product_media_size == 0
    assign product_has_media = false
  endif

  assign media_right = false
  if settings.desktop_media_position == 'right'
    assign media_right = true
  endif

  assign equal_cols = false
  if settings.equal_columns
    assign equal_cols = true
  endif
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="product-information section section--page-width spacing-style color-{{ settings.color_scheme }} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}

  <div
    class="product-information__flex{% unless product_has_media %} product-information__flex--no-media{% endunless %}{% if equal_cols %} product-information__flex--equal{% endif %}"
    data-product-grid-content
  >
    {% if product_has_media %}
      <div
        class="product-information__media{% if media_right %} product-information__media--right{% endif %}"
        data-testid="product-information-media"
      >
        {{ media_gallery }}
      </div>
    {% endif %}

    <div class="product-information__details{% if media_right %} product-information__details--first{% endif %}">
      {{ product_details }}
    </div>
  </div>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* ── Flex container ── */
  .product-information__flex {
    display: flex;
    gap: var(--gap, 48px);
    align-items: flex-start;
    width: 100%;
  }

  /* ── Media column ── */
  .product-information__media {
    flex: 2 1 0;
    min-width: 0;
  }

  /* ── Details column ── */
  .product-information__details {
   
    min-width: 0;
  }

  /* ── Equal columns (50/50) ── */
  .product-information__flex--equal .product-information__media,
  .product-information__flex--equal .product-information__details {
    flex: 1 1 ;
  }

  /* ── Media on the right: swap visual order ── */
  .product-information__media--right {
    order: 2;
  }

  .product-information__details--first {
    order: 1;
  }

  /* ── No media: center the details ── */
  .product-information__flex--no-media .product-information__details {
    max-width: var(--narrow-content-width, 680px);
    margin-inline: auto;
    flex: none;
    width: 100%;
  }

  /* ── Thumbnail + image placeholder fill ── */
  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  /* ── Sticky header offset for details ── */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  /* ── Mobile: stack vertically ── */
  @media screen and (max-width: 749px) {
    .product-information__flex {
      flex-direction: column;
      gap: 0;
    }

    .product-information__media,
    .product-information__details {
      flex: none;
      width: 100%;
      order: unset !important;
    }

    /* On mobile media always comes first */
    .product-information__media {
      order: 0 !important;
    }

    .product-information__details {
      order: 1 !important;
    }

    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  /* ── Large screen: widen media slightly ── */
  @media screen and (min-width: 1200px) {
    .product-information__flex:not(.product-information__flex--equal):not(.product-information__flex--no-media) {
      .product-information__media { flex: 2 1 0; }
      
    }
  }
{% endstylesheet %}
