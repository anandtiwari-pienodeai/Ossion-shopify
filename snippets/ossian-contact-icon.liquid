{%- doc -%}
  Renders a 24px line or filled icon for the Ossian contact section.

  @param {string} icon - One of shield, headset, chat, mail, phone, pin
  @param {boolean} [filled] - Use the solid variant (contact method badges)

  @example
  {% render 'ossian-contact-icon', icon: 'mail', filled: true %}
{%- enddoc -%}
{%- case icon -%}
  {%- when 'headset' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5" {% if filled %}fill="currentColor"{% endif %}/><rect x="17" y="14" width="4" height="6" rx="1.5" {% if filled %}fill="currentColor"{% endif %}/><path d="M19 20a3 3 0 0 1-3 2h-3"/></svg>
  {%- when 'chat' -%}
    {%- if filled -%}
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6l-4.5 4v-4H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M8 9h8M8 12h5" stroke="#dce6f5" stroke-width="1.8" stroke-linecap="round"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>
    {%- endif -%}
  {%- when 'mail' -%}
    {%- if filled -%}
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5V7l-9 5.5L3 7v-.5Z"/><path d="M3 9.2l9 5.5 9-5.5v8.3a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5V9.2Z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
    {%- endif -%}
  {%- when 'phone' -%}
    <svg viewBox="0 0 24 24" fill="{% if filled %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="{% if filled %}0{% else %}1.8{% endif %}" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
  {%- when 'pin' -%}
    {%- if filled -%}
      <svg viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 0 12 6.5a2.5 2.5 0 0 0 0 5Z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.8 7-13a7 7 0 0 0-14 0c0 5.2 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>
    {%- endif -%}
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 4 6v6c0 4.8 3.4 8.4 8 9.5 4.6-1.1 8-4.7 8-9.5V6l-8-3.5Z" {% if filled %}fill="currentColor"{% endif %}/></svg>
{%- endcase -%}
