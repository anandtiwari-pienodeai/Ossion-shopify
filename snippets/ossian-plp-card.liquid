{%- doc -%}
  Ossian PLP product card.

  Visual design is matched 1:1 with the home page "Best Sellers" card
  (sections/ossian-best-sellers.liquid — the .obs__card block).

  @param {object} product - Shopify product object
  @param {string} section_id - The id of the section rendering this card (needed for the add-to-cart form)
  @param {string} [badge_label] - Optional badge override (default: auto from tags)
{%- enddoc -%}

{%- assign card_product = product -%}
{%- assign variant = card_product.selected_or_first_available_variant -%}

{%- comment -%} Badge — same tag mapping as the Best Sellers section {%- endcomment -%}
{%- assign badge_text = badge_label | default: '' -%}
{%- if badge_text == blank -%}
  {%- for tag in card_product.tags -%}
    {%- if badge_text == blank -%}
      {%- assign tl = tag | downcase -%}
      {%- if tl == 'best seller' or tl == 'best-seller' or tl == 'bestseller' -%}
        {%- assign badge_text = 'BEST SELLER' -%}
      {%- elsif tl == 'top rated' or tl == 'top-rated' -%}
        {%- assign badge_text = 'TOP RATED' -%}
      {%- elsif tl == 'trending' -%}
        {%- assign badge_text = 'TRENDING' -%}
      {%- elsif tl == 'new' or tl == 'new arrival' -%}
        {%- assign badge_text = 'NEW' -%}
      {%- elsif tl == 'sale' -%}
        {%- assign badge_text = 'SALE' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Chip tags — up to 3 tags that are not already used as the badge {%- endcomment -%}
{%- assign badge_tags = 'best seller,best-seller,bestseller,top rated,top-rated,trending,new,new arrival,sale' | split: ',' -%}
{%- assign display_tags = '' -%}
{%- assign display_tag_count = 0 -%}
{%- for tag in card_product.tags -%}
  {%- if display_tag_count < 3 -%}
    {%- assign tl = tag | downcase -%}
    {%- unless badge_tags contains tl -%}
      {%- if display_tags == '' -%}
        {%- assign display_tags = tag -%}
      {%- else -%}
        {%- assign display_tags = display_tags | append: '|||' | append: tag -%}
      {%- endif -%}
      {%- assign display_tag_count = display_tag_count | plus: 1 -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Rating — real review metafields when present, otherwise the same defaults the home page card shows {%- endcomment -%}
{%- assign rating_raw = card_product.metafields.reviews.rating.value -%}
{%- assign rating_display = '4.9' -%}
{%- if rating_raw != blank -%}
  {%- if rating_raw.rating != blank -%}
    {%- assign rating_display = rating_raw.rating -%}
  {%- else -%}
    {%- assign rating_display = rating_raw -%}
  {%- endif -%}
{%- endif -%}
{%- assign rating_count_raw = card_product.metafields.reviews.rating_count.value -%}
{%- assign rating_count_display = '210' -%}
{%- if rating_count_raw != blank -%}
  {%- assign rating_count_display = rating_count_raw -%}
{%- endif -%}

<div class="ossian-plp-card">
  <a href="{{ variant.url | default: card_product.url }}" class="ossian-plp-card__link">

    <div class="ossian-plp-card__img-wrap">
      {%- if badge_text != blank -%}
        <span class="ossian-plp-card__badge">{{ badge_text }}</span>
      {%- endif -%}

      {%- if card_product.featured_image != blank -%}
        {{
          card_product.featured_image
          | image_url: width: 600
          | image_tag:
            class: 'ossian-plp-card__img',
            alt: card_product.title,
            loading: 'lazy',
            widths: '300,450,600'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ossian-plp-card__img ossian-plp-card__img--placeholder' }}
      {%- endif -%}
    </div>

    <div class="ossian-plp-card__info">
      {%- if card_product.type != blank -%}
        <p class="ossian-plp-card__type">{{ card_product.type | upcase }}</p>
      {%- endif -%}

      <h3 class="ossian-plp-card__name">{{ card_product.title }}</h3>

      <div class="ossian-plp-card__rating" aria-label="{{ rating_display }} stars">
        <span class="ossian-plp-card__stars" aria-hidden="true">★★★★★</span>
        <span class="ossian-plp-card__rating-val">{{ rating_display }}</span>
        <span class="ossian-plp-card__rating-count">({{ rating_count_display }})</span>
      </div>

      {%- if display_tags != blank -%}
        <div class="ossian-plp-card__tags">
          {%- assign tag_arr = display_tags | split: '|||' -%}
          {%- for tag in tag_arr -%}
            <span class="ossian-plp-card__tag">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ossian-plp-card__pricing">
        <span class="ossian-plp-card__price">{{ variant.price | money }}</span>
        {%- if variant.compare_at_price > variant.price -%}
          <s class="ossian-plp-card__compare">{{ variant.compare_at_price | money }}</s>
          {%- assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
          <span class="ossian-plp-card__discount">{{ pct }}% off</span>
        {%- endif -%}
      </div>
    </div>

  </a>

  <div class="ossian-plp-card__actions">
    {%- if variant.available -%}
      {%- assign form_id = 'OssianPlpAtc-' | append: section_id | append: '-' | append: card_product.id -%}
      <product-form-component
        class="ossian-plp-card__atc-form"
        data-section-id="{{ section_id }}"
        data-product-id="{{ card_product.id }}"
        data-product-url="{{ card_product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
        data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', card_product, id: form_id, data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}" ref="variantId">
          <input type="hidden" name="quantity" value="1">
          <add-to-cart-component ref="addToCartButtonContainer">
            <button
              type="submit"
              name="add"
              ref="addToCartButton"
              on:click="/handleClick"
              class="ossian-plp-card__atc"
              aria-label="Add {{ card_product.title | escape }} to cart"
            >
              ADD TO CART
            </button>
          </add-to-cart-component>
        {%- endform -%}
      </product-form-component>
    {%- else -%}
      <button type="button" class="ossian-plp-card__atc" disabled>SOLD OUT</button>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
/* ===================== CARD ===================== */
/* Values mirror .obs__card in sections/ossian-best-sellers.liquid */
.ossian-plp-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #fff;
  border-radius: 14px;
  border: 1px solid #efefef;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.07);
  overflow: hidden;
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}

.ossian-plp-card:hover {
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.13);
  transform: translateY(-3px);
}

.ossian-plp-card__link {
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  flex: 1;
}

/* ===================== IMAGE ===================== */
.ossian-plp-card__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #f5f0eb;
  flex-shrink: 0;
}

.ossian-plp-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.ossian-plp-card__img--placeholder {
  width: 100%;
  height: 100%;
}

.ossian-plp-card:hover .ossian-plp-card__img {
  transform: scale(1.04);
}

/* ===================== BADGE ===================== */
.ossian-plp-card__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  background: #1e3a5f;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 11px;
  border-radius: 4px;
  pointer-events: none;
}

/* ===================== INFO ===================== */
.ossian-plp-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 14px 16px 12px;
}

.ossian-plp-card__type {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #146a7d;
  margin: 0 0 6px;
}

.ossian-plp-card__name {
  font-size: 0.9rem;
  font-weight: 700;
  color: #111;
  margin: 0 0 8px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ===================== RATING ===================== */
.ossian-plp-card__rating {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 10px;
}

.ossian-plp-card__stars {
  color: #f4a623;
  font-size: 13px;
  letter-spacing: 1px;
}

.ossian-plp-card__rating-val {
  font-size: 12px;
  font-weight: 700;
  color: #222;
}

.ossian-plp-card__rating-count {
  font-size: 12px;
  color: #6b6b6b;
}

/* ===================== TAGS ===================== */
.ossian-plp-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 12px;
}

.ossian-plp-card__tag {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: 1px solid #ccc;
  color: #444;
  padding: 4px 9px;
  border-radius: 5px;
  background: #fff;
}

/* ===================== PRICING ===================== */
.ossian-plp-card__pricing {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 4px;
}

.ossian-plp-card__price {
  font-size: 1.1rem;
  font-weight: 800;
  color: #111;
}

.ossian-plp-card__compare {
  font-size: 0.85rem;
  color: #6f6f6f;
  text-decoration: line-through;
}

.ossian-plp-card__discount {
  font-size: 0.78rem;
  font-weight: 700;
  color: #2e7d32;
  background: #e8f5e9;
  padding: 2px 7px;
  border-radius: 4px;
}

/* ===================== ACTIONS ===================== */
.ossian-plp-card__actions {
  display: flex;
  gap: 8px;
  padding: 12px 14px 14px;
  border-top: 1px solid #f0f0f0;
}

.ossian-plp-card__atc-form {
  display: block;
  flex: 1;
  min-width: 0;
}

.ossian-plp-card__atc-form form,
.ossian-plp-card__atc-form add-to-cart-component {
  display: block;
  width: 100%;
}

.ossian-plp-card__atc {
  flex: 1;
  width: 100%;
  background: #1e3a5f;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 13px 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s;
}

.ossian-plp-card__atc:hover:not(:disabled) {
  background: #16304f;
}

.ossian-plp-card__atc:disabled {
  opacity: 0.5;
  cursor: default;
}

/* ===================== MOBILE (2-up grid) ===================== */
@media screen and (max-width: 749px) {
  .ossian-plp-card {
    border-radius: 12px;
  }

  .ossian-plp-card__info {
    padding: 12px 12px 10px;
  }

  .ossian-plp-card__name {
    font-size: 0.82rem;
  }

  .ossian-plp-card__price {
    font-size: 1rem;
  }

  .ossian-plp-card__actions {
    padding: 10px 10px 12px;
  }

  .ossian-plp-card__atc {
    padding: 11px 8px;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
}
{% endstylesheet %}
