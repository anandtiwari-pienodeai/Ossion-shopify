            "label": "Key Benefits",
            "use_product_description": false,
            "content": "",
            "features_list": "Anti-Yellow Technology for bright, clean results\nFiber Plex Protection for stronger hair\nUp to 9 levels of lift in one application\nNon-Damaging Formula with Marine Minerals\nAdvanced Plex & Sea Minerals complex"
          }
        },
        "tab_how": {
          "type": "tab",
          "settings": {
            "label": "How To Use",
            "use_product_description": false,
            "content": "<p><strong>Step 1:</strong> Mix the product with the developer in a 1:2 ratio.</p><p><strong>Step 2:</strong> Apply to dry, unwashed hair using a brush. Start from the roots and work towards the ends.</p><p><strong>Step 3:</strong> Leave on for 20–40 minutes depending on desired lift level.</p><p><strong>Step 4:</strong> Rinse thoroughly and follow with a toning shampoo and conditioner.</p>",
            "features_list": ""
          }
        },
        "tab_ingredients": {
          "type": "tab",
          "settings": {
            "label": "Ingredients",
            "use_product_description": false,
            "content": "<p>Potassium Persulfate, Ammonium Persulfate, Sodium Persulfate, Kaolin, Marine Minerals Complex, Hydrolysed Keratin, Panthenol (Vitamin B5), Tocopheryl Acetate (Vitamin E).</p>",
            "features_list": ""
          }
        }
      },
      "block_order": [
