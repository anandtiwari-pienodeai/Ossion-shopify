
<div class="pdp-actions" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="pdp-action-btn"
    aria-label="{{ 'products.product.save' | t | default: 'Save product' }}"
    onclick="this.classList.toggle('pdp-action-btn--saved'); this.querySelector('.pdp-action-label').textContent = this.classList.contains('pdp-action-btn--saved') ? 'Saved' : 'Save';"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
    <span class="pdp-action-label">Save</span>
  </button>

  <button
    type="button"
    class="pdp-action-btn"
    aria-label="{{ 'products.product.share' | t | default: 'Share product' }}"
    onclick="
      if (navigator.share) {
        navigator.share({ url: window.location.href, title: document.title }).catch(function(){});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href).then(function() {
          var lbl = this.querySelector('.pdp-action-label');
          if (lbl) { var orig = lbl.textContent; lbl.textContent = 'Copied!'; setTimeout(function(){ lbl.textContent = orig; }, 2000); }
        }.bind(this));
      }
    "
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
    </svg>
    <span class="pdp-action-label">Share</span>
  </button>
</div>

{% stylesheet %}
  .pdp-actions {
    display: flex;
    gap: 12px;
    width: 100%;
  }

  .pdp-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: transparent;
    color: #374151;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    flex: 1;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    font-family: inherit;
  }

  .pdp-action-btn:hover {
    border-color: #1e3a5f;
    color: #1e3a5f;
  }

  .pdp-action-btn--saved {
    border-color: #1e3a5f;
    color: #fff;
    background: #1e3a5f;
  }

  .pdp-action-btn--saved svg {
    fill: #fff;
  }
{% endstylesheet %}

