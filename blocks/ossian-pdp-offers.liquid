{%- liquid
  assign has_offer_1 = false
  assign has_offer_2 = false
  if block.settings.offer_1_title != blank
    assign has_offer_1 = true
  endif
  if block.settings.offer_2_title != blank
    assign has_offer_2 = true
  endif
-%}

{%- if has_offer_1 or has_offer_2 -%}
  <div
    class="ossian-pdp-offers spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <p class="ossian-pdp-offers__heading">{{ block.settings.heading }}</p>
    {%- endif -%}
    <div class="ossian-pdp-offers__row">
      {%- if has_offer_1 -%}
        <div class="ossian-pdp-offers__card">
          <span class="ossian-pdp-offers__icon" aria-hidden="true">
            {%- case block.settings.offer_1_icon -%}
              {%- when 'truck' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="11"/><path d="M15 9h4l3 3v5h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>
              {%- when 'gift' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13"/><path d="M3 12h18"/><path d="M12 8v13"/><path d="M12 8c-1.5 0-4-1-4-3a2 2 0 0 1 4 0 2 2 0 0 1 4 0c0 2-2.5 3-4 3z"/></svg>
              {%- when 'tag' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83 3.83 11l9.58 9.59a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.83z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 L4 6.5 L4 12.5 C4 17.5 7.5 20.5 12 22 C16.5 20.5 20 17.5 20 12.5 L20 6.5 Z"/></svg>
            {%- endcase -%}
          </span>
          <span class="ossian-pdp-offers__text">
            <span class="ossian-pdp-offers__title">{{ block.settings.offer_1_title }}</span>
            {%- if block.settings.offer_1_description != blank -%}
              <span class="ossian-pdp-offers__desc">{{ block.settings.offer_1_description }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}
      {%- if has_offer_2 -%}
        <div class="ossian-pdp-offers__card">
          <span class="ossian-pdp-offers__icon" aria-hidden="true">
            {%- case block.settings.offer_2_icon -%}
              {%- when 'truck' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="11"/><path d="M15 9h4l3 3v5h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>
              {%- when 'gift' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13"/><path d="M3 12h18"/><path d="M12 8v13"/><path d="M12 8c-1.5 0-4-1-4-3a2 2 0 0 1 4 0 2 2 0 0 1 4 0c0 2-2.5 3-4 3z"/></svg>
              {%- when 'tag' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83 3.83 11l9.58 9.59a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.83z"/><circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/></svg>
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 L4 6.5 L4 12.5 C4 17.5 7.5 20.5 12 22 C16.5 20.5 20 17.5 20 12.5 L20 6.5 Z"/></svg>
            {%- endcase -%}
          </span>
          <span class="ossian-pdp-offers__text">
            <span class="ossian-pdp-offers__title">{{ block.settings.offer_2_title }}</span>
            {%- if block.settings.offer_2_description != blank -%}
              <span class="ossian-pdp-offers__desc">{{ block.settings.offer_2_description }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
.ossian-pdp-offers {
  font-family: var(--font-body--family, sans-serif);
}

.ossian-pdp-offers__heading {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #1e3a5f;
  margin: 0 0 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid #e5e9f0;
}

.ossian-pdp-offers__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.ossian-pdp-offers__card {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #e5e9f0;
  border-radius: 10px;
  padding: 14px 16px;
  background: #f8fafc;
}

.ossian-pdp-offers__icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #dbeafe;
  color: #1e3a5f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ossian-pdp-offers__text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.ossian-pdp-offers__title {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #1e3a5f;
}

.ossian-pdp-offers__desc {
  font-size: 12px;
  line-height: 1.4;
  color: #6b7a91;
}

@media (max-width: 480px) {
  .ossian-pdp-offers__row {
    grid-template-columns: 1fr;
  }

  .ossian-pdp-offers__card {
    padding: 12px 14px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Active Offers",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Active Offers"
    },
    {
      "type": "header",
      "content": "Offer 1"
    },
    {
      "type": "select",
      "id": "offer_1_icon",
      "label": "Icon",
      "options": [
        { "value": "truck", "label": "Delivery truck" },
        { "value": "gift", "label": "Gift" },
        { "value": "tag", "label": "Price tag" },
        { "value": "shield", "label": "Shield" }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "offer_1_title",
      "label": "Title",
      "default": "Free Delivery"
    },
    {
      "type": "text",
      "id": "offer_1_description",
      "label": "Description",
      "default": "On orders above ₹399"
    },
    {
      "type": "header",
      "content": "Offer 2"
    },
    {
      "type": "select",
      "id": "offer_2_icon",
      "label": "Icon",
      "options": [
        { "value": "truck", "label": "Delivery truck" },
        { "value": "gift", "label": "Gift" },
        { "value": "tag", "label": "Price tag" },
        { "value": "shield", "label": "Shield" }
      ],
      "default": "gift"
    },
    {
      "type": "text",
      "id": "offer_2_title",
      "label": "Title",
      "default": "BOGO Payday Sale"
    },
    {
      "type": "text",
      "id": "offer_2_description",
      "label": "Description",
      "default": "Add 2 items to cart, 1 item will be free"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "PDP Active Offers",
      "category": "Product"
    }
  ]
}
{% endschema %}
