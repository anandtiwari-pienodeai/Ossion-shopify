{% liquid
  assign product = closest.product
  case block.settings.source
    when 'vendor'
      assign type_label = product.vendor
    when 'custom'
      assign type_label = block.settings.custom_text
    else
      assign type_label = product.type
  endcase
  if request.visual_preview_mode and product == blank
    assign type_label = 'LIGHTENING & BLEACHING'
  endif
-%}

{%- if type_label != blank -%}
  <p
    class="ossian-product-type ossian-product-type--{{ block.settings.style | default: 'pill' }} spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {{ type_label | upcase }}
  </p>
{%- endif -%}

{% stylesheet %}
.ossian-product-type {
  display: inline-flex;
  align-items: center;
  background: #dbeafe;
  border: 1.5px solid #93c5fd;
  color: #1e40af;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  padding: 4px 14px;
  margin: 0;
  line-height: 1.4;
  font-family: var(--font-body--family, sans-serif);
}

/* Plain uppercase eyebrow (e.g. the brand above the product title) */
.ossian-product-type--eyebrow {
  background: none;
  border: 0;
  border-radius: 0;
  padding: 0;
  color: #13233f;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.28em;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product Type Label",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Show",
      "default": "type",
      "options": [
        {
          "value": "type",
          "label": "Product type"
        },
        {
          "value": "vendor",
          "label": "Vendor / brand"
        },
        {
          "value": "custom",
          "label": "Custom text"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_text",
      "label": "Custom text",
      "visible_if": "{{ block.settings.source == 'custom' }}"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "pill",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "eyebrow",
          "label": "Plain uppercase label"
        }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Product Type Label",
      "category": "Product"
    }
  ]
}
{% endschema %}
