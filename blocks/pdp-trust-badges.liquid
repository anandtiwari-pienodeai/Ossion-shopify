
<div class="pdp-trust-badges" {{ block.shopify_attributes }}>
  <div class="pdp-trust-item">
    <span class="pdp-trust-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
        <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </span>
    <span class="pdp-trust-label">{{ block.settings.badge_1 | default: 'Free Shipping' }}</span>
  </div>

  <span class="pdp-trust-sep" aria-hidden="true"></span>

  <div class="pdp-trust-item">
    <span class="pdp-trust-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
    </span>
    <span class="pdp-trust-label">{{ block.settings.badge_2 | default: 'Authentic' }}</span>
  </div>

  <span class="pdp-trust-sep" aria-hidden="true"></span>

  <div class="pdp-trust-item">
    <span class="pdp-trust-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"/>
        <path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
      </svg>
    </span>
    <span class="pdp-trust-label">{{ block.settings.badge_3 | default: 'Easy Returns' }}</span>
  </div>
</div>

{% stylesheet %}
  .pdp-trust-badges {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 14px 12px;
    border: 1px solid #e8edf5;
    border-radius: 10px;
    background: #f8fafc;
    width: 100%;
    gap: 0;
  }

  .pdp-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    flex: 1;
    text-align: center;
    padding: 4px 8px;
  }

  .pdp-trust-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #eff6ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e3a5f;
    flex-shrink: 0;
  }

  .pdp-trust-label {
    font-size: 11px;
    font-weight: 600;
    color: #1e3a5f;
    white-space: nowrap;
    letter-spacing: 0.01em;
    font-family: var(--font-body--family, sans-serif);
  }

  .pdp-trust-sep {
    width: 1px;
    height: 40px;
    background-color: #dde3ee;
    flex-shrink: 0;
    align-self: center;
  }

  @media (max-width: 480px) {
    .pdp-trust-badges {
      border-radius: 8px;
      padding: 10px 6px;
    }
    .pdp-trust-label {
      font-size: 10px;
    }
    .pdp-trust-icon {
      width: 30px;
      height: 30px;
    }
    .pdp-trust-icon svg {
      width: 17px;
      height: 17px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Trust Badges",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge 1 label",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge 2 label",
      "default": "Authentic"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge 3 label",
      "default": "Easy Returns"
    }
  ],
  "presets": [
    {
      "name": "PDP Trust Badges"
    }
  ]
}
{% endschema %}
