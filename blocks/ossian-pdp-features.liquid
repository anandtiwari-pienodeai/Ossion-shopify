{%- doc -%}
  Product page feature list: icon circle, title and an optional one-line description, in two
  columns. Each line of the setting is "Title | Description | icon"; the description and icon are
  optional (lines with only a title still work). Icons: sparkle, shield, arrow-up, leaf, coral,
  drop, flask, check, star. Without an icon, a sensible default is picked by position.
{%- enddoc -%}
{%- if block.settings.features != blank -%}
  {%- assign default_icons = 'sparkle,shield,arrow-up,leaf,coral,drop' | split: ',' -%}
  <ul
    class="ossian-pdp-features spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    role="list"
    {{ block.shopify_attributes }}
  >
    {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
    {%- assign shown = 0 -%}
    {%- for line in lines -%}
      {%- assign trimmed = line | strip -%}
      {%- if trimmed == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign parts = trimmed | split: '|'
        assign f_title = parts[0] | strip
        assign f_text = parts[1] | strip
        assign f_icon = parts[2] | strip | downcase
        if f_icon == blank
          assign icon_index = shown | modulo: default_icons.size
          assign f_icon = default_icons[icon_index]
        endif
        assign shown = shown | plus: 1
      -%}
      <li class="ossian-pdp-feature-item">
        <span class="ossian-pdp-feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            {%- case f_icon -%}
              {%- when 'shield' -%}<path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6L12 3Z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>
              {%- when 'arrow-up' -%}<path d="M12 20V5M6 11l6-6 6 6"/>
              {%- when 'leaf' -%}<path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15Z"/><path d="M5 19 13 11"/>
              {%- when 'coral' -%}<path d="M12 21v-6M12 15c0-3-3-4-3-7M12 15c0-3 3-4 3-7M9 8c0-1.5-1.5-2.5-3-3M9 8c.5-2 0-3.5-1-5M15 8c0-1.5 1.5-2.5 3-3M15 8c-.5-2 0-3.5 1-5M12 12V6"/>
              {%- when 'drop' -%}<path d="M12 3s6.5 7.2 6.5 11.5a6.5 6.5 0 0 1-13 0C5.5 10.2 12 3 12 3Z"/>
              {%- when 'flask' -%}<path d="M9 3h6M10 3v6L4.5 18.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/><path d="M7 15h10"/>
              {%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16.5 9.5"/>
              {%- when 'star' -%}<path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7L12 3Z"/>
              {%- else -%}<path d="M10 4.5c.6 3.6 2.4 5.4 6 6-3.6.6-5.4 2.4-6 6-.6-3.6-2.4-5.4-6-6 3.6-.6 5.4-2.4 6-6Z"/><path d="M18 3c.3 1.7 1.1 2.5 2.8 2.8-1.7.3-2.5 1.1-2.8 2.8-.3-1.7-1.1-2.5-2.8-2.8C16.9 5.5 17.7 4.7 18 3Z"/>
            {%- endcase -%}
          </svg>
        </span>
        <span class="ossian-pdp-feature-text">
          <span class="ossian-pdp-feature-title">{{ f_title | escape }}</span>
          {%- if f_text != blank -%}
            <span class="ossian-pdp-feature-sub">{{ f_text | escape }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .ossian-pdp-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ossian-pdp-feature-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .ossian-pdp-feature-icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eaf1fc;
    color: #1f5fd1;
  }

  .ossian-pdp-feature-icon svg {
    width: 24px;
    height: 24px;
  }

  .ossian-pdp-feature-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ossian-pdp-feature-title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: #13233f;
  }

  .ossian-pdp-feature-sub {
    font-size: 0.86rem;
    line-height: 1.35;
    color: #5b6577;
  }

  @media screen and (max-width: 749px) {
    .ossian-pdp-features {
      gap: 12px 14px;
    }

    .ossian-pdp-feature-icon {
      width: 44px;
      height: 44px;
    }

    .ossian-pdp-feature-icon svg {
      width: 20px;
      height: 20px;
    }

    .ossian-pdp-feature-title { font-size: 0.86rem; }
    .ossian-pdp-feature-sub { font-size: 0.76rem; }
  }

  @media screen and (max-width: 420px) {
    .ossian-pdp-features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Feature Badges",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "features",
      "label": "Features (one per line)",
      "info": "Format: Title | Description | icon. Description and icon are optional. Icons: sparkle, shield, arrow-up, leaf, coral, drop, flask, check, star.",
      "default": "Anti-yellow Technology\nFibre Plex Protection\nUp to 9 Levels Lift\nNon-Damaging Formula\nEnriched with Marine actives"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "PDP Feature Badges",
      "category": "Product"
    }
  ]
}
{% endschema %}
