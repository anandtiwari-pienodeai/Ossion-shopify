<section class="ospot ospot--{{ section.settings.theme }}"{% if section.settings.theme == 'light' %} style="background-color: {{ section.settings.background_color }};"{% endif %}>
  <div class="ospot__inner page-width{% if section.settings.image_position == 'left' %} ospot__inner--reverse{% endif %}">

    <div class="ospot__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ospot__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ospot__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="ospot__body">{{ section.settings.body_text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="ospot__cta">
          {{ section.settings.cta_label }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="ospot__media">
      {%- if section.settings.cta_url != blank -%}
        <a
          href="{{ section.settings.cta_url }}"
          class="ospot__media-link"
          {% if section.settings.cta_label != blank %}aria-hidden="true" tabindex="-1"{% endif %}
        >
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: class: 'ospot__img', loading: 'lazy', widths: '400,600,800,900' }}
      {%- else -%}
        <div class="ospot__img-ph"></div>
      {%- endif -%}
      {%- if section.settings.cta_url != blank -%}</a>{%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
.ospot,
.ospot * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.ospot {
  padding: 72px 0;
}

.ospot__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.ospot__inner--reverse {
  direction: rtl;
}

.ospot__inner--reverse > * {
  direction: ltr;
}

.ospot__eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 100px;
  margin-bottom: 16px;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.ospot__heading {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 700;
  line-height: 1.25;
  margin: 0 0 18px;
  color: #1e3a5f;
}

.ospot__body {
  font-size: 1rem;
  line-height: 1.7;
  margin: 0 0 28px;
  color: #45536b;
}

.ospot__body p { margin: 0 0 1em; }
.ospot__body p:last-child { margin-bottom: 0; }

.ospot__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #1e3a5f;
  color: #fff;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-decoration: none;
  padding: 14px 26px;
  border-radius: 8px;
  transition: background 0.2s;
}

.ospot__cta:hover { background: #16304f; }

.ospot__media { position: relative; }

.ospot__media-link { display: block; }

.ospot__img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
  object-fit: cover;
}

.ospot__img-ph {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 20px;
  background: #eef1f8;
}

/* ── Dark theme variant ── */
.ospot--dark { background-color: #0d2444; }
.ospot--dark .ospot__heading { color: #fff; }
.ospot--dark .ospot__body { color: rgba(255, 255, 255, 0.75); }
.ospot--dark .ospot__eyebrow { background: rgba(255, 255, 255, 0.12); color: #fff; }
.ospot--dark .ospot__cta { background: #fff; color: #1e3a5f; }
.ospot--dark .ospot__cta:hover { background: #e5e9f0; }
.ospot--dark .ospot__img-ph { background: rgba(255, 255, 255, 0.08); }

@media (max-width: 900px) {
  .ospot { padding: 52px 0; }
  .ospot__inner {
    grid-template-columns: 1fr;
    gap: 32px;
    direction: ltr;
  }
  .ospot__media { order: -1; }
}

@media (max-width: 600px) {
  .ospot { padding: 40px 0; }
  .ospot__heading { font-size: clamp(1.5rem, 6vw, 2rem); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Promo Spotlight",
  "tag": "section",
  "class": "ossian-promo-spotlight-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Supporting hair professionals"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>From training programs to wellbeing initiatives, we're invested in the people behind the chair - not just the products they use.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Color theme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (light theme only)",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Promo Spotlight"
    }
  ]
}
{% endschema %}
