<div
  class="ossian-pro-testimonials section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ossian-pro-testimonials__header">
        {% if section.settings.heading != blank %}
          <h2 class="ossian-pro-testimonials__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ossian-pro-testimonials__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ossian-pro-testimonials__grid">
      {% for block in section.blocks %}
        <div class="ossian-pro-testimonials__card" {{ block.shopify_attributes }}>
          <div class="ossian-pro-testimonials__stars" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="0.5" aria-hidden="true"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon></svg>
            {% endfor %}
          </div>
          <blockquote class="ossian-pro-testimonials__quote">"{{ block.settings.quote }}"</blockquote>
          <div class="ossian-pro-testimonials__reviewer">
            {% if block.settings.avatar != blank %}
              <div class="ossian-pro-testimonials__avatar-wrap">
                {{ block.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ossian-pro-testimonials__avatar', alt: block.settings.name }}
              </div>
            {% else %}
              <div class="ossian-pro-testimonials__avatar-placeholder" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              </div>
            {% endif %}
            <div class="ossian-pro-testimonials__reviewer-info">
              <p class="ossian-pro-testimonials__reviewer-name">{{ block.settings.name }}</p>
              <p class="ossian-pro-testimonials__reviewer-role">{{ block.settings.role }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-pro-testimonials__header {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ossian-pro-testimonials__title {
    font-size: 2.25rem;
    font-weight: 700;
    margin: 0;
    color: #101828;
  }

  .ossian-pro-testimonials__subtitle {
    font-size: 1.125rem;
    color: #4a5565;
    margin: 0;
  }

  .ossian-pro-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 989px) {
    .ossian-pro-testimonials__grid {
      grid-template-columns: 1fr;
    }
    .ossian-pro-testimonials__title {
      font-size: 1.75rem;
    }
  }

  .ossian-pro-testimonials__card {
    background: #fff;
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 0 2px 4px rgba(0, 0, 0, 0.06);
  }

  .ossian-pro-testimonials__stars {
    display: flex;
    gap: 4px;
  }

  .ossian-pro-testimonials__quote {
    font-size: 1rem;
    color: #364153;
    line-height: 1.6;
    margin: 0;
    flex: 1;
    font-style: italic;
  }

  .ossian-pro-testimonials__reviewer {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ossian-pro-testimonials__avatar-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ossian-pro-testimonials__avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ossian-pro-testimonials__avatar-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #9ca3af;
  }

  .ossian-pro-testimonials__reviewer-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ossian-pro-testimonials__reviewer-name {
    font-size: 1rem;
    font-weight: 600;
    color: #101828;
    margin: 0;
  }

  .ossian-pro-testimonials__reviewer-role {
    font-size: 0.875rem;
    color: #4a5565;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pro Testimonials",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "OSSION products have transformed my salon. The Nano-Suit technology delivers results that my clients absolutely love!"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Reviewer photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maria Rodriguez"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Master Stylist"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Loved by Professionals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Real results from real stylists"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Pro Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "OSSION products have transformed my salon. The Nano-Suit technology delivers results that my clients absolutely love!", "name": "Maria Rodriguez", "role": "Master Stylist" } },
        { "type": "testimonial", "settings": { "quote": "Professional quality at its finest. The color protection range keeps my clients coming back month after month.", "name": "James Chen", "role": "Color Specialist" } },
        { "type": "testimonial", "settings": { "quote": "I've tried many brands, but OSSION stands out. The treatment line is simply unmatched in effectiveness.", "name": "Sophie Laurent", "role": "Hair Care Expert" } }
      ]
    }
  ]
}
{% endschema %}
