    #header-component .account-button__icon, #header-component .account-button__fallback { display: flex !important; align-items: center !important; justify-content: center !important; color: rgb(30, 58, 95) !important; }
    #header-component .account-button__icon svg { width: 20px !important; height: 20px !important; color: rgb(30, 58, 95) !important; }
