{%- comment -%}
  Ossion navbar. With "Sticky header" on, the whole header group (announcement bar
  + navbar) stays pinned to the top while scrolling.

  Desktop (>= 990px): logo, inline nav menu, search, and account/cart icons in one row.
  Menu source is either the "Nav Item" blocks, or — when no blocks are added — the
  linklist chosen in the "Menu (fallback)" setting. The fallback path renders nested
  child links (and grandchildren) as dropdowns.

  Mobile (<= 989px): the inline nav collapses into a hamburger button that opens a
  left side drawer: logo, icon rows for each nav link (nested menus expand into a
  panel with an optional image), highlight links and a promo card.
{%- endcomment -%}

{%- liquid
  assign nav_items = section.blocks | where: 'type', 'nav_item'
  assign sidebar_items = section.blocks | where: 'type', 'sidebar_category'
  assign fallback_links = section.settings.menu.links
  assign has_nav = false
  if nav_items.size > 0 or fallback_links.size > 0
    assign has_nav = true
  endif
-%}

<header-component
  id="header-component"
  class="header ossian-navbar"
  data-skip-node-update
  {% if section.settings.sticky_header %}data-ossian-sticky{% endif %}
  style="--ossian-logo-height: {{ section.settings.logo_height }}px; --ossian-logo-height-mobile: {{ section.settings.logo_height_mobile }}px;"
>
  <div class="ossian-navbar__inner page-width">
    {%- if has_nav -%}
      <button
        type="button"
        class="ossian-navbar__hamburger"
        data-nav-drawer-open
        aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}"
        aria-expanded="false"
        aria-controls="OssianNavDrawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    {%- endif -%}

    {%- render 'ossian-logo', image: section.settings.logo_image, loading: 'eager' -%}

    {%- if has_nav -%}
      <nav class="ossian-navbar__menu" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
        <ul class="ossian-navbar__menu-list">
          {%- if nav_items.size > 0 -%}
            {%- for block in nav_items -%}
              <li class="ossian-navbar__menu-item" {{ block.shopify_attributes }}>
                {%- if block.settings.enable_dropdown -%}
                  <button
                    type="button"
                    class="ossian-navbar__menu-link ossian-navbar__menu-trigger"
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-mega-menu-trigger="block-{{ forloop.index0 }}"
                  >
                    {{ block.settings.label }}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
                  </button>
                  <div class="ossian-mega-menu" data-mega-menu="block-{{ forloop.index0 }}" hidden>
                    <div class="ossian-mega-menu__inner page-width">
                      {%- if sidebar_items.size > 0 -%}
                        <div class="ossian-mega-menu__sidebar-col">
                          <ul class="ossian-mega-menu__sidebar">
                            {%- for sidebar_block in sidebar_items -%}
                              <li>
                                <a
                                  href="{{ sidebar_block.settings.link }}"
                                  class="ossian-mega-menu__sidebar-link{% if sidebar_block.settings.label == block.settings.label %} is-active{% endif %}"
                                >
                                  {%- if sidebar_block.settings.icon != blank -%}
                                    <span class="ossian-mega-menu__sidebar-icon">
                                      {{ sidebar_block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
                                    </span>
                                  {%- endif -%}
                                  {{ sidebar_block.settings.label }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                          {%- if block.settings.link != blank -%}
                            <a href="{{ block.settings.link }}" class="ossian-mega-menu__view-all">
                              View All Products
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.submenu != blank -%}
                        {%- liquid
                          assign submenu_links = block.settings.submenu.links
                          assign total_links = submenu_links.size
                          assign half = total_links | plus: 1 | divided_by: 2
                        -%}
                        <div class="ossian-mega-menu__column">
                          {%- if block.settings.column_1_heading != blank -%}
                            <h3 class="ossian-mega-menu__column-heading">{{ block.settings.column_1_heading }}</h3>
                          {%- endif -%}
                          <ul class="ossian-mega-menu__column-list">
                            {%- for link in submenu_links limit: half -%}
                              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                        <div class="ossian-mega-menu__column">
                          {%- if block.settings.column_2_heading != blank -%}
                            <h3 class="ossian-mega-menu__column-heading">{{ block.settings.column_2_heading }}</h3>
                          {%- endif -%}
                          <ul class="ossian-mega-menu__column-list">
                            {%- for link in submenu_links offset: half -%}
                              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}

                      {%- if block.settings.promo_image != blank or block.settings.promo_heading != blank -%}
                        <div class="ossian-mega-menu__promo">
                          {%- if block.settings.promo_image != blank -%}
                            {{ block.settings.promo_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
                          {%- endif -%}
                          <div class="ossian-mega-menu__promo-content">
                            {%- if block.settings.promo_heading != blank -%}
                              <h4>{{ block.settings.promo_heading }}</h4>
                            {%- endif -%}
                            {%- if block.settings.promo_text != blank -%}
                              <p>{{ block.settings.promo_text }}</p>
                            {%- endif -%}
                            {%- if block.settings.promo_button_label != blank -%}
                              <a href="{{ block.settings.promo_button_url | default: '#' }}" class="ossian-mega-menu__promo-btn">
                                {{ block.settings.promo_button_label }}
                              </a>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  <a href="{{ block.settings.link }}" class="ossian-navbar__menu-link">
                    {{ block.settings.label }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}

          {%- else -%}
            {%- comment -%}
              Fallback: render the chosen linklist, including its nested child links.
              A top-level link with children becomes a dropdown; a child with its own
              children becomes a headed column inside that dropdown.
            {%- endcomment -%}
            {%- for link in fallback_links -%}
              <li class="ossian-navbar__menu-item">
                {%- if link.links.size > 0 -%}
                  {%- assign has_grandchildren = false -%}
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      {%- assign has_grandchildren = true -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <button
                    type="button"
                    class="ossian-navbar__menu-link ossian-navbar__menu-trigger{% if link.active or link.child_active %} is-active{% endif %}"
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-mega-menu-trigger="link-{{ forloop.index0 }}"
                  >
                    {{ link.title }}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
                  </button>

                  <div
                    class="ossian-dropdown{% if has_grandchildren %} ossian-dropdown--columns{% endif %}"
                    data-mega-menu="link-{{ forloop.index0 }}"
                    hidden
                  >
                    {%- if has_grandchildren -%}
                      <div class="ossian-dropdown__cols">
                        {%- for child in link.links -%}
                          <div class="ossian-dropdown__col">
                            <a href="{{ child.url }}" class="ossian-dropdown__col-heading">{{ child.title }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="ossian-dropdown__col-list">
                                {%- for grandchild in child.links -%}
                                  <li>
                                    <a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>
                                      {{ grandchild.title }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <ul class="ossian-dropdown__list">
                        {%- for child in link.links -%}
                          <li>
                            <a
                              href="{{ child.url }}"
                              class="ossian-dropdown__link"
                              {% if child.current %}aria-current="page"{% endif %}
                            >
                              {{ child.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if link.url != blank and link.url != '#' -%}
                      <a href="{{ link.url }}" class="ossian-dropdown__view-all">
                        View all {{ link.title }}
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </a>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="ossian-navbar__menu-link{% if link.active %} is-active{% endif %}"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="ossian-navbar__actions">
      <button
        type="button"
        class="ossian-navbar__search"
        on:click="#search-modal/showDialog"
        aria-label="{{ 'content.search_input_label' | t }}"
        aria-haspopup="dialog"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>{{ section.settings.search_placeholder | default: 'Search products, collections...' }}</span>
      </button>

      {% render 'header-actions', section: section, display_style: 'icon', show_wishlist: false %}
    </div>
  </div>
</header-component>

{%- if has_nav -%}
  <div class="ossian-nav-drawer__backdrop" data-nav-drawer-backdrop data-nav-drawer-close></div>

  <nav
    id="OssianNavDrawer"
    class="ossian-nav-drawer"
    data-nav-drawer
    aria-label="{{ 'accessibility.header_navigation_label' | t }}"
  >
    <div class="ossian-nav-drawer__head">
      {%- render 'ossian-logo', image: section.settings.logo_image, class: 'ossian-nav-drawer__logo' -%}
      <button
        type="button"
        class="ossian-nav-drawer__close"
        data-nav-drawer-close
        aria-label="{{ 'actions.close' | t }}"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"/>
          <line x1="19" y1="5" x2="5" y2="19"/>
        </svg>
      </button>
    </div>

    <ul class="ossian-nav-drawer__list">
      {%- if nav_items.size > 0 -%}
        {%- for block in nav_items -%}
          {%- liquid
            assign drawer_children = null
            if block.settings.enable_dropdown
              assign drawer_children = block.settings.submenu.links
            endif
            assign drawer_image = block.settings.drawer_image | default: block.settings.promo_image
          -%}
          {%- render 'ossian-nav-drawer-item',
            title: block.settings.label,
            url: block.settings.link,
            children: drawer_children,
            image: drawer_image,
            attrs: block.shopify_attributes
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for link in fallback_links -%}
          {%- liquid
            assign drawer_image = null
            if link.type == 'collection_link'
              assign drawer_image = link.object.featured_image | default: link.object.products.first.featured_image
            elsif link.type == 'product_link'
              assign drawer_image = link.object.featured_image
            endif
          -%}
          {%- render 'ossian-nav-drawer-item',
            title: link.title,
            url: link.url,
            children: link.links,
            image: drawer_image,
            current: link.current
          -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- liquid
      assign highlight_1 = section.settings.drawer_highlight_1
      assign highlight_2 = section.settings.drawer_highlight_2
      assign highlight_3 = section.settings.drawer_highlight_3
    -%}
    {%- if highlight_1 != blank or highlight_2 != blank or highlight_3 != blank -%}
      <ul class="ossian-nav-drawer__highlights">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign highlight_text = highlight_1
                assign highlight_link = section.settings.drawer_highlight_1_link
              when 2
                assign highlight_text = highlight_2
                assign highlight_link = section.settings.drawer_highlight_2_link
              else
                assign highlight_text = highlight_3
                assign highlight_link = section.settings.drawer_highlight_3_link
            endcase
          -%}
          {%- if highlight_text != blank -%}
            <li>
              {%- if highlight_link != blank -%}
                {%- assign highlight_tag = 'a' -%}
              {%- else -%}
                {%- assign highlight_tag = 'div' -%}
              {%- endif -%}
              <{{ highlight_tag }}{% if highlight_link != blank %} href="{{ highlight_link }}"{% endif %} class="ossian-nav-drawer__highlight">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {%- case i -%}
                    {%- when 1 -%}
                      <path d="M2 6h11v10H2z"/><path d="M13 9h4l3 3.5V16h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
                    {%- when 2 -%}
                      <path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
                    {%- else -%}
                      <path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>
                  {%- endcase -%}
                </svg>
                <span>{{ highlight_text }}</span>
                {%- if highlight_link != blank -%}
                  <svg class="ossian-nav-drawer__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                {%- endif -%}
              </{{ highlight_tag }}>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.drawer_promo_heading != blank -%}
      <a
        href="{{ section.settings.drawer_promo_link | default: routes.all_products_collection_url }}"
        class="ossian-nav-drawer__promo"
      >
        {%- if section.settings.drawer_promo_image != blank -%}
          {{ section.settings.drawer_promo_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', class: 'ossian-nav-drawer__promo-image', sizes: '360px' }}
        {%- endif -%}
        <span class="ossian-nav-drawer__promo-content">
          <span class="ossian-nav-drawer__promo-heading">{{ section.settings.drawer_promo_heading }}</span>
          {%- if section.settings.drawer_promo_cta != blank -%}
            <span class="ossian-nav-drawer__promo-cta">
              {{ section.settings.drawer_promo_cta }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}

<script>
(function () {
  /* ---------- Desktop dropdowns / mega menus ---------- */
  var triggers = document.querySelectorAll('[data-mega-menu-trigger]');
  var menus = document.querySelectorAll('[data-mega-menu]');

  function closeAll() {
    triggers.forEach(function (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
    });
    menus.forEach(function (menu) {
      menu.hidden = true;
    });
  }

  triggers.forEach(function (trigger) {
    trigger.addEventListener('click', function (event) {
      event.stopPropagation();
      var id = trigger.dataset.megaMenuTrigger;
      var menu = document.querySelector('[data-mega-menu=\"' + id + '\"]');
      var wasOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (!wasOpen && menu) {
        trigger.setAttribute('aria-expanded', 'true');
        menu.hidden = false;
      }
    });
  });

  document.addEventListener('click', function (event) {
    if (!event.target.closest('.ossian-navbar__menu-item')) closeAll();
  });

  /* ---------- Mobile drawer ---------- */
  var drawer = document.querySelector('[data-nav-drawer]');
  var backdrop = document.querySelector('[data-nav-drawer-backdrop]');
  var openBtn = document.querySelector('[data-nav-drawer-open]');
  var closeEls = document.querySelectorAll('[data-nav-drawer-close]');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('is-open');
    if (backdrop) backdrop.classList.add('is-open');
    if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('ossian-nav-scroll-lock');
    var firstLink = drawer.querySelector('a, button');
    if (firstLink) firstLink.focus({ preventScroll: true });
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    if (backdrop) backdrop.classList.remove('is-open');
    if (openBtn) {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus({ preventScroll: true });
    }
    document.documentElement.classList.remove('ossian-nav-scroll-lock');
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  closeEls.forEach(function (el) {
    el.addEventListener('click', closeDrawer);
  });

  /* Accordions inside the drawer */
  document.querySelectorAll('[data-nav-accordion]').forEach(function (toggle) {
    toggle.addEventListener('click', function () {
      var panel = toggle.nextElementSibling;
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel) panel.hidden = isOpen;
      var item = toggle.closest('.ossian-nav-drawer__item');
      if (item) item.classList.toggle('is-open', !isOpen);
    });
  });

  /* Close the drawer when a link inside it is followed */
  if (drawer) {
    drawer.addEventListener('click', function (event) {
      if (event.target.closest('a')) closeDrawer();
    });
  }

  /* Escape closes whichever is open */
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    closeAll();
    if (drawer && drawer.classList.contains('is-open')) closeDrawer();
  });

  /* Leaving mobile width resets the drawer so it can't stay stuck open */
  var mq = window.matchMedia('(min-width: 990px)');
  var onChange = function (event) {
    if (event.matches) closeDrawer();
  };
  if (mq.addEventListener) {
    mq.addEventListener('change', onChange);
  } else if (mq.addListener) {
    mq.addListener(onChange);
  }
})();
</script>

{% stylesheet %}
  /* Sticky header: pins the whole header group (announcement bar + navbar) */
  #header-group:has(.ossian-navbar[data-ossian-sticky]) {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .ossian-navbar {
    background: var(--color-background, #fff);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    position: relative;
  }

  .ossian-navbar__inner {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: clamp(6px, 2vw, 32px);
    padding: 10px 20px;
  }

  /* ---------- Hamburger (mobile only) ---------- */
  .ossian-navbar__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-inline-start: -8px;
    padding: 0;
    border: none;
    background: none;
    color: #1e3a5f;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ossian-navbar__logo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.15;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ossian-navbar__logo img {
    display: block;
    height: var(--ossian-logo-height, 48px);
    width: auto;
    max-width: none;
  }

  .ossian-navbar__menu {
    min-width: 0;
    flex-shrink: 1;
  }

  .ossian-navbar__menu-list {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.8vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ossian-navbar__menu-list li {
    min-width: 0;
  }

  .ossian-navbar__menu-link {
    position: relative;
    display: block;
    padding-block: 10px;
    font-size: clamp(0.78rem, 1.3vw, 1rem);
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .ossian-navbar__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .ossian-navbar__menu-link:hover,
  .ossian-navbar__menu-link.is-active,
  .ossian-navbar__menu-trigger[aria-expanded='true'] {
    color: #1f5fa8;
  }

  .ossian-navbar__menu-link.is-active::after,
  .ossian-navbar__menu-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  .ossian-navbar__menu-item {
    position: relative;
    list-style: none;
  }

  .ossian-navbar__menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 10px 0;
    font-family: inherit;
    cursor: pointer;
  }

  .ossian-navbar__menu-trigger svg {
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .ossian-navbar__menu-trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* ---------- Simple dropdown (fallback linklist children) ---------- */
  .ossian-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    z-index: 60;
    min-width: 230px;
    padding: 10px;
    background: var(--color-background, #fff);
    border: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    border-radius: 12px;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12);
  }

  .ossian-dropdown[hidden] {
    display: none;
  }

  /* Bridges the gap between the trigger and the panel so the pointer
     can travel down without the panel losing hover. */
  .ossian-dropdown::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .ossian-dropdown--columns {
    min-width: min(760px, 88vw);
  }

  .ossian-dropdown__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .ossian-dropdown__link {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    color: #1e3a5f;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .ossian-dropdown__link:hover,
  .ossian-dropdown__link[aria-current='page'] {
    background: rgb(var(--color-foreground-rgb, 20 24 32) / 0.05);
  }

  .ossian-dropdown__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 8px 24px;
    padding: 8px 12px;
  }

  .ossian-dropdown__col-heading {
    display: block;
    margin-bottom: 10px;
    color: #1e3a5f;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .ossian-dropdown__col-heading:hover {
    text-decoration: underline;
  }

  .ossian-dropdown__col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ossian-dropdown__col-list a {
    color: #1e3a5f;
    font-size: 0.86rem;
    text-decoration: none;
  }

  .ossian-dropdown__col-list a:hover {
    text-decoration: underline;
  }

  .ossian-dropdown__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    padding: 9px 12px;
    color: var(--color-primary, #6d5bd0);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .ossian-mega-menu {
    position: fixed;
    top: var(--header-height, 70px);
    left: 0;
    right: 0;
    background: var(--color-background, #fff);
    border-top: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
    z-index: 50;
  }

  .ossian-mega-menu[hidden] {
    display: none;
  }

  .ossian-mega-menu__inner {
    display: grid;
    grid-template-columns: 220px 1fr 1fr 280px;
    gap: 32px;
    padding-block: 32px;
  }

  .ossian-mega-menu__sidebar-col {
    border-right: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    padding-right: 24px;
  }

  .ossian-mega-menu__sidebar {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ossian-mega-menu__sidebar-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: #1e3a5f;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .ossian-mega-menu__sidebar-link:hover {
    background: rgb(var(--color-foreground-rgb, 20 24 32) / 0.05);
  }

  .ossian-mega-menu__sidebar-link.is-active {
    background: rgb(var(--color-primary-rgb) / 0.1);
    color: var(--color-primary, #6d5bd0);
    font-weight: 700;
  }

  .ossian-mega-menu__sidebar-icon {
    display: flex;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .ossian-mega-menu__sidebar-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ossian-mega-menu__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary, #6d5bd0);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    padding-inline: 10px;
  }

  .ossian-mega-menu__column-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 20 24 32) / 0.5);
    margin: 0 0 16px;
  }

  .ossian-mega-menu__column-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ossian-mega-menu__column-list a {
    color: #1e3a5f;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .ossian-mega-menu__column-list a:hover {
    text-decoration: underline;
  }

  .ossian-mega-menu__promo {
    border-radius: 12px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 20 24 32) / 0.03);
    display: flex;
    flex-direction: column;
  }

  .ossian-mega-menu__promo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .ossian-mega-menu__promo-content {
    padding: 16px;
  }

  .ossian-mega-menu__promo-content h4 {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e3a5f;
  }

  .ossian-mega-menu__promo-content p {
    margin: 0 0 14px;
    font-size: 0.85rem;
    color: rgb(var(--color-foreground-rgb, 20 24 32) / 0.65);
  }

  .ossian-mega-menu__promo-btn {
    display: inline-block;
    background: var(--color-primary, #6d5bd0);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
  }

  /* ---------- Mobile side drawer ---------- */
  .ossian-nav-drawer {
    --drawer-navy: #1e3a5f;
    --drawer-tint: #eef4fb;
    --drawer-line: rgb(30 58 95 / 0.1);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    display: none;
    flex-direction: column;
    width: min(88vw, 400px);
    height: 100dvh;
    background: #fff;
    color: var(--drawer-navy);
    box-shadow: 4px 0 28px rgba(0, 0, 0, 0.18);
    transform: translateX(-100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .ossian-nav-drawer.is-open {
    transform: translateX(0);
  }

  .ossian-nav-drawer__backdrop {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    background: rgba(8, 20, 40, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .ossian-nav-drawer__backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .ossian-nav-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 18px 14px 24px;
  }

  .ossian-nav-drawer .ossian-nav-drawer__logo img {
    height: 46px;
    width: auto;
  }



  .ossian-nav-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    background: none;
    color: var(--drawer-navy);
    cursor: pointer;
  }

  /* Nav rows */
  .ossian-nav-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
  }

  .ossian-nav-drawer__item {
    position: relative;
  }

  .ossian-nav-drawer__item + .ossian-nav-drawer__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 76px;
    right: 0;
    border-top: 1px solid var(--drawer-line);
  }

  .ossian-nav-drawer__item.is-open::before,
  .ossian-nav-drawer__item.is-open + .ossian-nav-drawer__item::before {
    display: none;
  }

  .ossian-nav-drawer__row {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 12px 22px 12px 18px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--drawer-navy);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .ossian-nav-drawer__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--drawer-tint);
    color: var(--drawer-navy);
  }

  .ossian-nav-drawer__label {
    flex: 1;
  }

  .ossian-nav-drawer__chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .ossian-nav-drawer__row[aria-expanded='true'] .ossian-nav-drawer__chevron--down {
    transform: rotate(180deg);
  }

  /* Expanded parent: tinted rounded panel */
  .ossian-nav-drawer__item--parent.is-open {
    background: var(--drawer-tint);
    border-radius: 0 18px 18px 0;
  }

  .ossian-nav-drawer__item--parent.is-open .ossian-nav-drawer__icon {
    background: #fff;
  }

  .ossian-nav-drawer__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 10px;
    padding: 0 14px 22px 40px;
  }

  .ossian-nav-drawer__panel > :not(.ossian-nav-drawer__panel-image) {
    grid-column: 1;
  }

  .ossian-nav-drawer__panel[hidden] {
    display: none;
  }

  .ossian-nav-drawer__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ossian-nav-drawer__sublist > li > a {
    display: block;
    margin: 6px 0;
    padding: 6px 0 6px 18px;
    border-left: 1px solid rgb(30 58 95 / 0.25);
    color: var(--drawer-navy);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__subsublist {
    list-style: none;
    margin: 0 0 4px;
    padding: 0 0 0 18px;
  }

  .ossian-nav-drawer__subsublist > li > a {
    display: block;
    padding: 5px 0 5px 12px;
    color: rgb(30 58 95 / 0.72);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__panel > .ossian-nav-drawer__view-all {
    grid-column: 1 / -1;
  }

  .ossian-nav-drawer__view-all {
    justify-self: start;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: #1f5fa8;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ossian-nav-drawer__panel-image {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    width: clamp(96px, 32vw, 140px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle, #fff 0%, #e3ebf4 100%);
  }

  .ossian-nav-drawer__panel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  /* Highlights */
  .ossian-nav-drawer__highlights {
    list-style: none;
    margin: 8px 18px 0;
    padding: 10px 0;
    border-top: 1px solid rgb(30 58 95 / 0.15);
  }

  .ossian-nav-drawer__highlight {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 10px 4px 10px 6px;
    color: rgb(30 58 95 / 0.85);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__highlight span {
    flex: 1;
  }

  .ossian-nav-drawer__highlight svg:first-child {
    flex-shrink: 0;
    color: var(--drawer-navy);
  }

  /* Promo card */
  .ossian-nav-drawer__promo {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 190px;
    margin: 12px 18px 26px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(120deg, #dfe9f5 0%, #b9cfe6 100%);
    color: var(--drawer-navy);
    text-decoration: none;
  }

  .ossian-nav-drawer__promo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ossian-nav-drawer__promo-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 62%;
    padding: 24px 22px;
  }

  .ossian-nav-drawer__promo-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.55rem;
    line-height: 1.15;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(30 58 95 / 0.35);
  }

  .ossian-nav-drawer__promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  html.ossian-nav-scroll-lock {
    overflow: hidden;
  }

  @media (max-width: 989px) {
    .ossian-navbar__hamburger {
      display: flex;
    }

    .ossian-navbar__menu {
      display: none;
    }

    .ossian-nav-drawer,
    .ossian-nav-drawer__backdrop {
      display: flex;
    }

    .ossian-nav-drawer__backdrop {
      display: block;
    }

    .ossian-navbar__logo {
      margin-inline-end: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ossian-nav-drawer,
    .ossian-nav-drawer__backdrop {
      transition: none;
    }
  }

  .ossian-navbar__actions {
    display: flex;
    align-items: center;
    gap: clamp(4px, 1.2vw, 14px);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .ossian-navbar__search {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    width: clamp(160px, 22vw, 400px);
    height: 46px;
    border: 1px solid rgb(30 58 95 / 0.06);
    border-radius: 999px;
    padding: 0 20px;
    background: #eef4fb;
    color: rgb(30 58 95 / 0.6);
    cursor: pointer;
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    font-family: inherit;
  }

  .ossian-navbar__search svg {
    flex-shrink: 0;
  }

  .ossian-navbar__search span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    .ossian-navbar__actions .ossian-navbar__search {
      width: 40px;
      height: 40px;
      justify-content: center;
      padding: 0;
      border: none;
      background: transparent;
      color: #1e3a5f;
    }

    .ossian-navbar__actions .ossian-navbar__search svg {
      width: 22px;
      height: 22px;
    }

    /* Larger tap targets, icons and logo on phones */
    .ossian-navbar__hamburger {
      width: 46px;
      height: 46px;
    }

    .ossian-navbar__hamburger svg {
      width: 30px;
      height: 30px;
    }

    .ossian-navbar__logo img {
      height: var(--ossian-logo-height-mobile, 38px);
    }

    .ossian-navbar__actions .ossian-navbar__search,
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action {
      width: 44px !important;
      height: 44px !important;
    }

    .ossian-navbar__actions .ossian-navbar__search svg,
    .ossian-navbar__actions .header-actions__cart-icon svg,
    .ossian-navbar__actions .account-button__icon {
      width: 27px;
      height: 27px;
    }

    /* On phones the action icons sit bare, without the tinted circles */
    .ossian-navbar__actions .header-actions__action {
      background: transparent;
    }

    .ossian-navbar__actions .ossian-navbar__search span {
      display: none;
    }
  }

  .ossian-navbar__actions header-actions {
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.8vw, 8px);
  }

  .ossian-navbar__actions .header-actions__action {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: #eef4fb;
    color: #1e3a5f;
    flex-shrink: 0;
    padding: 0;
  }

  /* Fill the circular button above rather than drawing its own border/size,
     so account and cart icons don't end up with a circle nested inside a circle. */
  .ossian-navbar__actions shopify-account {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ossian-navbar__actions .header-actions__cart-icon svg,
  .ossian-navbar__actions .account-button__icon {
    width: 22px;
    height: 22px;
  }

  /* Cart count badge: always visible (shows 0 for an empty cart) */
  .ossian-navbar__actions .header-actions__cart-icon {
    --cart-bubble-size: 22px;
    --cart-bubble-top: -4px;
    --cart-bubble-right: -4px;
  }

  .ossian-navbar__actions .cart-bubble.visually-hidden {
    position: absolute !important;
    width: var(--cart-bubble-size);
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
  }

  .ossian-navbar__actions .cart-bubble__background {
    background-color: #2f6fe0;
  }

  .ossian-navbar__actions .cart-bubble__text {
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .ossian-navbar__actions .cart-bubble__text-count.hidden {
    display: inline !important;
  }

  /* sections/header.liquid styles every #header-component action as a bordered
     square with !important; this navbar reuses that id, so override them here. */
  #header-component.ossian-navbar header-actions .header-actions__action,
  #header-component.ossian-navbar .account-button.header-actions__action {
    width: 46px !important;
    height: 46px !important;
    border: none !important;
    border-radius: 50% !important;
    background: #eef4fb !important;
    overflow: visible;
  }

  #header-component.ossian-navbar header-actions .header-actions__action:hover {
    background: #e2ecf8 !important;
  }

  /* header.liquid also pins every header icon to 20px with !important */
  #header-component.ossian-navbar .header-actions__action svg.account-button__icon,
  #header-component.ossian-navbar .account-button__icon svg,
  #header-component.ossian-navbar .header-actions__cart-icon > .svg-wrapper svg {
    width: var(--ossian-action-icon, 22px) !important;
    height: var(--ossian-action-icon, 22px) !important;
  }

  @media (max-width: 749px) {
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action,
    #header-component.ossian-navbar header-actions .header-actions__action:hover {
      width: 44px !important;
      height: 44px !important;
      background: transparent !important;
    }

    #header-component.ossian-navbar {
      --ossian-action-icon: 27px;
    }
  }

  /* Small phones: tighten spacing so logo and all four icons still fit */
  @media (max-width: 399px) {
    .ossian-navbar__inner {
      gap: 6px;
      padding: 8px 12px;
    }

    .ossian-navbar__logo img {
      height: calc(var(--ossian-logo-height-mobile, 38px) * 0.85);
    }

    .ossian-navbar__actions,
    .ossian-navbar__actions header-actions {
      gap: 0;
    }

    #header-component.ossian-navbar {
      --ossian-action-icon: 25px;
    }

    .ossian-navbar__actions .ossian-navbar__search,
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action,
    #header-component.ossian-navbar header-actions .header-actions__action:hover {
      width: 40px !important;
      height: 40px !important;
    }

    .ossian-navbar__actions .ossian-navbar__search svg,
    .ossian-navbar__actions .header-actions__cart-icon svg,
    .ossian-navbar__actions .account-button__icon {
      width: 25px;
      height: 25px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossion Navbar",
  "tag": "section",
  "class": "ossian-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Used in the navbar and the mobile drawer. Leave empty to use the default OSSION Professional logo."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (desktop)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (fallback)",
      "default": "main-menu",
      "info": "Used when no Nav Item blocks are added. Nested sub-menus in this linklist render as dropdowns on desktop and accordions in the mobile drawer."
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
