  /* Sticky header: pins the whole header group (announcement bar + navbar) */
  #header-group:has(.ossian-navbar[data-ossian-sticky]) {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* sections/header.liquid sets ".header { background: transparent }" and this navbar
     also carries the .header class, so pin the background with a more specific selector
     (stylesheet bundle order differs between the dev server and the live store). */
  /* <header-component> is a custom element, so it is display: inline unless a stylesheet
     says otherwise. Locally sections/header.liquid's ".header { display: block }" happened to
     apply; on the live theme that stylesheet isn't loaded, the element stayed inline and its
     white background only painted behind the text (the banner showed through). */
  #header-component.ossian-navbar {
    display: block;
    background: #fff;
  }

  /* Belt and braces: the section wrapper is white too. */
  .ossian-header-section {
    background: #fff;
  }

  .ossian-navbar {
    background: #fff;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    position: relative;
  }

  .ossian-navbar__inner {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: clamp(6px, 2vw, 32px);
    padding: 10px 20px;
  }

  /* ---------- Hamburger (mobile only) ---------- */
  .ossian-navbar__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-inline-start: -8px;
    padding: 0;
    border: none;
    background: none;
    color: #1e3a5f;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ossian-navbar__logo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.15;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ossian-navbar__logo img {
    display: block;
    height: var(--ossian-logo-height, 48px);
    width: auto;
    max-width: none;
  }

  .ossian-navbar__menu {
    min-width: 0;
    flex-shrink: 1;
  }

  .ossian-navbar__menu-list {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.8vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ossian-navbar__menu-list li {
    min-width: 0;
  }

  .ossian-navbar__menu-link {
    position: relative;
    display: block;
    padding-block: 10px;
    font-size: clamp(0.78rem, 1.3vw, 1rem);
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .ossian-navbar__menu-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .ossian-navbar__menu-link:hover,
  .ossian-navbar__menu-link.is-active,
  .ossian-navbar__menu-trigger[aria-expanded='true'] {
    color: #1f5fa8;
  }

  .ossian-navbar__menu-link.is-active::after,
  .ossian-navbar__menu-trigger[aria-expanded='true']::after {
    transform: scaleX(1);
  }

  .ossian-navbar__menu-item {
    position: relative;
    list-style: none;
  }

  .ossian-navbar__menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 10px 0;
    font-family: inherit;
    cursor: pointer;
  }

  .ossian-navbar__menu-trigger svg {
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .ossian-navbar__menu-trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  /* ---------- Mega menu (fallback linklist children) ---------- */
  .ossian-navbar__menu-item--mega {
    position: static;
  }

  .ossian-mega {
    position: absolute;
    top: calc(100% - 4px);
    /* left/right are set from JS so the panel lines up with the nav links */
    left: 20px;
    right: 20px;
    z-index: 60;
    display: grid;
    grid-template-columns: minmax(230px, 0.85fr) minmax(0, 1.6fr) minmax(0, 1.35fr);
    /* Fixed height: the bestsellers list scrolls instead of growing the panel */
    height: clamp(360px, 28vw, 420px);
    background: linear-gradient(100deg, #fdfeff 0%, #f4f7fc 40%, #e4edf8 68%);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(10, 23, 48, 0.18);
    overflow: hidden;
    color: #1e3a5f;
  }

  .ossian-mega[hidden] {
    display: none;
  }

  /* Invisible bridge so moving the pointer from the link to the panel keeps it open */
  .ossian-mega::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 14px;
  }

  .ossian-mega__nav {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: clamp(20px, 1.8vw, 28px) clamp(18px, 1.8vw, 34px) clamp(20px, 1.8vw, 28px) clamp(18px, 1.9vw, 36px);
  }

  /* Short inset divider between the menu and the promo */
  .ossian-mega__nav::after {
    content: '';
    position: absolute;
    top: 34px;
    bottom: 34px;
    right: 0;
    width: 1px;
    background: rgb(30 58 95 / 0.1);
  }

  .ossian-mega__nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(11px, 0.95vw, 15px) clamp(14px, 1.4vw, 24px);
    border-radius: 10px;
    color: #1e3a5f;
    font-size: clamp(0.92rem, 0.95vw, 1.05rem);
    white-space: nowrap;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .ossian-mega__nav-link.is-active,
  .ossian-mega__nav-link:focus-visible {
    background: #e6eefa;
    color: #1f63d6;
  }

  .ossian-mega__promo {
    position: relative;
    display: flex;
    align-items: center;
    padding: clamp(28px, 2.6vw, 44px) clamp(24px, 2.4vw, 40px) clamp(28px, 2.6vw, 44px) clamp(26px, 2.6vw, 44px);
    overflow: hidden;
  }

  /* Image only: the banner fills the panel and the whole panel is the link */
  .ossian-mega__promo--cover {
    display: block;
    padding: 0;
    color: inherit;
    text-decoration: none;
  }

  .ossian-mega__promo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .ossian-mega__promo--cover:hover .ossian-mega__promo-bg {
    transform: scale(1.02);
  }

  .ossian-mega__promo--cover:focus-visible {
    outline: 2px solid #1f63d6;
    outline-offset: -4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ossian-mega__promo-bg {
      transition: none;
    }
  }

  .ossian-mega__promo-copy {
    position: relative;
    z-index: 1;
    max-width: 60%;
  }

  .ossian-mega__eyebrow {
    margin: 0 0 16px;
    font-size: clamp(0.66rem, 0.72vw, 0.78rem);
    white-space: nowrap;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(30 58 95 / 0.75);
  }

  .ossian-mega__heading {
    margin: 0 0 16px;
    font-size: clamp(1.5rem, 2.05vw, 2.6rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: #1e3a5f;
  }

  .ossian-mega__text {
    margin: 0 0 clamp(20px, 2vw, 30px);
    font-size: clamp(0.95rem, 1vw, 1.12rem);
    line-height: 1.75;
    color: rgb(30 58 95 / 0.62);
  }

  .ossian-mega__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: clamp(13px, 1.1vw, 17px) clamp(26px, 2.6vw, 42px);
    border-radius: 999px;
    background: #1d5fe6;
    box-shadow: 0 8px 18px rgb(29 95 230 / 0.25);
    color: #fff;
    font-size: clamp(0.95rem, 1vw, 1.08rem);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s;
  }

  .ossian-mega__button:hover {
    background: #0a4fc4;
  }

  .ossian-mega__promo-media {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .ossian-mega__promo-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .ossian-mega__side {
    --mega-thumb: clamp(84px, 7vw, 116px);
    --mega-product-gap: clamp(14px, 1.4vw, 22px);
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: clamp(26px, 2.6vw, 40px) clamp(22px, 2.6vw, 44px);
    background: #fbfcfe;
  }

  .ossian-mega__side-panel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .ossian-mega__side-panel[hidden] {
    display: none;
  }

  .ossian-mega__side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .ossian-mega__side-title {
    margin: 0;
    font-size: clamp(1.25rem, 1.4vw, 1.5rem);
    font-weight: 700;
    color: #1e3a5f;
  }

  .ossian-mega__side-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgb(30 58 95 / 0.8);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .ossian-mega__side-all:hover {
    color: #1f5fa8;
  }

  .ossian-mega__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }

  .ossian-mega__chips a {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(30 58 95 / 0.12);
    color: #1e3a5f;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .ossian-mega__chips a:hover {
    border-color: #1f5fa8;
    color: #1f5fa8;
  }

  /* About 2.5 products visible; the half-visible card signals that the list scrolls */
  .ossian-mega__products {
    display: flex;
    flex-direction: column;
    flex: 0 1 auto;
    gap: var(--mega-product-gap);
    min-height: 0;
    max-height: calc(var(--mega-thumb) * 108 / 116 * 2.5 + var(--mega-product-gap) * 2);
    list-style: none;
    margin: 0;
    padding: 0 6px 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(30 58 95 / 0.25) transparent;
  }

  .ossian-mega__products::-webkit-scrollbar {
    width: 6px;
  }

  .ossian-mega__products::-webkit-scrollbar-thumb {
    border-radius: 3px;
    background: rgb(30 58 95 / 0.25);
  }

  .ossian-mega__product {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 26px);
    color: #1e3a5f;
    text-decoration: none;
  }

  .ossian-mega__product-media {
    flex-shrink: 0;
    width: var(--mega-thumb);
    aspect-ratio: 116 / 108;
    border-radius: 12px;
    background: #f0f4f9;
    overflow: hidden;
  }

  .ossian-mega__product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .ossian-mega__product-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ossian-mega__product-title {
    font-size: clamp(0.95rem, 1vw, 1.12rem);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 600;
    line-height: 1.3;
  }

  .ossian-mega__product-sub {
    font-size: clamp(0.85rem, 0.9vw, 1rem);
    color: rgb(30 58 95 / 0.6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ossian-mega__product-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(40px, 3.4vw, 52px);
    height: clamp(40px, 3.4vw, 52px);
    border-radius: 50%;
    background: #eef2f8;
    color: #1e3a5f;
    transition: background-color 0.2s, color 0.2s;
  }

  .ossian-mega__product:hover .ossian-mega__product-arrow {
    background: #0b5ce6;
    color: #fff;
  }

  .ossian-mega__product:hover .ossian-mega__product-title {
    color: #1f5fa8;
  }

  .ossian-mega__empty {
    margin: 0;
    color: rgb(30 58 95 / 0.62);
    font-size: 0.9rem;
  }

  .ossian-mega-menu {
    position: fixed;
    top: var(--header-height, 70px);
    left: 0;
    right: 0;
    background: var(--color-background, #fff);
    border-top: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
    z-index: 50;
  }

  .ossian-mega-menu[hidden] {
    display: none;
  }

  .ossian-mega-menu__inner {
    display: grid;
    grid-template-columns: 220px 1fr 1fr 280px;
    gap: 32px;
    padding-block: 32px;
  }

  .ossian-mega-menu__sidebar-col {
    border-right: 1px solid rgb(var(--color-foreground-rgb, 20 24 32) / 0.08);
    padding-right: 24px;
  }

  .ossian-mega-menu__sidebar {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ossian-mega-menu__sidebar-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: #1e3a5f;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .ossian-mega-menu__sidebar-link:hover {
    background: rgb(var(--color-foreground-rgb, 20 24 32) / 0.05);
  }

  .ossian-mega-menu__sidebar-link.is-active {
    background: rgb(var(--color-primary-rgb) / 0.1);
    color: var(--color-primary, #6d5bd0);
    font-weight: 700;
  }

  .ossian-mega-menu__sidebar-icon {
    display: flex;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .ossian-mega-menu__sidebar-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ossian-mega-menu__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary, #6d5bd0);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    padding-inline: 10px;
  }

  .ossian-mega-menu__column-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb, 20 24 32) / 0.5);
    margin: 0 0 16px;
  }

  .ossian-mega-menu__column-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ossian-mega-menu__column-list a {
    color: #1e3a5f;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .ossian-mega-menu__column-list a:hover {
    text-decoration: underline;
  }

  .ossian-mega-menu__promo {
    border-radius: 12px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 20 24 32) / 0.03);
    display: flex;
    flex-direction: column;
  }

  .ossian-mega-menu__promo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .ossian-mega-menu__promo-content {
    padding: 16px;
  }

  .ossian-mega-menu__promo-content h4 {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e3a5f;
  }

  .ossian-mega-menu__promo-content p {
    margin: 0 0 14px;
    font-size: 0.85rem;
    color: rgb(var(--color-foreground-rgb, 20 24 32) / 0.65);
  }

  .ossian-mega-menu__promo-btn {
    display: inline-block;
    background: var(--color-primary, #6d5bd0);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
  }

  /* ---------- Mobile side drawer ---------- */
  .ossian-nav-drawer {
    --drawer-navy: #1e3a5f;
    --drawer-tint: #eef4fb;
    --drawer-line: rgb(30 58 95 / 0.1);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;
    display: none;
    flex-direction: column;
    width: min(88vw, 400px);
    height: 100dvh;
    background: #fff;
    color: var(--drawer-navy);
    box-shadow: 4px 0 28px rgba(0, 0, 0, 0.18);
    transform: translateX(-100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .ossian-nav-drawer.is-open {
    transform: translateX(0);
  }

  .ossian-nav-drawer__backdrop {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    background: rgba(8, 20, 40, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .ossian-nav-drawer__backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .ossian-nav-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 18px 14px 24px;
  }

  .ossian-nav-drawer .ossian-nav-drawer__logo img {
    height: 46px;
    width: auto;
  }



  .ossian-nav-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    background: none;
    color: var(--drawer-navy);
    cursor: pointer;
  }

  /* Nav rows */
  .ossian-nav-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
  }

  .ossian-nav-drawer__item {
    position: relative;
  }

  .ossian-nav-drawer__item + .ossian-nav-drawer__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 76px;
    right: 0;
    border-top: 1px solid var(--drawer-line);
  }

  .ossian-nav-drawer__item.is-open::before,
  .ossian-nav-drawer__item.is-open + .ossian-nav-drawer__item::before {
    display: none;
  }

  .ossian-nav-drawer__row {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 12px 22px 12px 18px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--drawer-navy);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .ossian-nav-drawer__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--drawer-tint);
    color: var(--drawer-navy);
  }

  .ossian-nav-drawer__label {
    flex: 1;
  }

  .ossian-nav-drawer__chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .ossian-nav-drawer__row[aria-expanded='true'] .ossian-nav-drawer__chevron--down {
    transform: rotate(180deg);
  }

  /* Expanded parent: tinted rounded panel */
  .ossian-nav-drawer__item--parent.is-open {
    background: var(--drawer-tint);
    border-radius: 0 18px 18px 0;
  }

  .ossian-nav-drawer__item--parent.is-open .ossian-nav-drawer__icon {
    background: #fff;
  }

  .ossian-nav-drawer__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 10px;
    padding: 0 14px 22px 40px;
  }

  .ossian-nav-drawer__panel > :not(.ossian-nav-drawer__panel-image) {
    grid-column: 1;
  }

  .ossian-nav-drawer__panel[hidden] {
    display: none;
  }

  .ossian-nav-drawer__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ossian-nav-drawer__sublist > li > a {
    display: block;
    margin: 6px 0;
    padding: 6px 0 6px 18px;
    border-left: 1px solid rgb(30 58 95 / 0.25);
    color: var(--drawer-navy);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__subsublist {
    list-style: none;
    margin: 0 0 4px;
    padding: 0 0 0 18px;
  }

  .ossian-nav-drawer__subsublist > li > a {
    display: block;
    padding: 5px 0 5px 12px;
    color: rgb(30 58 95 / 0.72);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__panel > .ossian-nav-drawer__view-all {
    grid-column: 1 / -1;
  }

  .ossian-nav-drawer__view-all {
    justify-self: start;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: #1f5fa8;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ossian-nav-drawer__panel-image {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    width: clamp(96px, 32vw, 140px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle, #fff 0%, #e3ebf4 100%);
  }

  .ossian-nav-drawer__panel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  /* Highlights */
  .ossian-nav-drawer__highlights {
    list-style: none;
    margin: 8px 18px 0;
    padding: 10px 0;
    border-top: 1px solid rgb(30 58 95 / 0.15);
  }

  .ossian-nav-drawer__highlight {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 10px 4px 10px 6px;
    color: rgb(30 58 95 / 0.85);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .ossian-nav-drawer__highlight span {
    flex: 1;
  }

  .ossian-nav-drawer__highlight svg:first-child {
    flex-shrink: 0;
    color: var(--drawer-navy);
  }

  /* Promo card */
  .ossian-nav-drawer__promo {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 190px;
    margin: 12px 18px 26px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(120deg, #dfe9f5 0%, #b9cfe6 100%);
    color: var(--drawer-navy);
    text-decoration: none;
  }

  .ossian-nav-drawer__promo-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ossian-nav-drawer__promo-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 62%;
    padding: 24px 22px;
  }

  .ossian-nav-drawer__promo-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.55rem;
    line-height: 1.15;
    padding-bottom: 14px;
    border-bottom: 1px solid rgb(30 58 95 / 0.35);
  }

  .ossian-nav-drawer__promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  html.ossian-nav-scroll-lock {
    overflow: hidden;
  }

  @media (max-width: 989px) {
    .ossian-navbar__hamburger {
      display: flex;
    }

    .ossian-navbar__menu {
      display: none;
    }

    .ossian-nav-drawer,
    .ossian-nav-drawer__backdrop {
      display: flex;
    }

    .ossian-nav-drawer__backdrop {
      display: block;
    }

    .ossian-navbar__logo {
      margin-inline-end: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ossian-nav-drawer,
    .ossian-nav-drawer__backdrop {
      transition: none;
    }
  }

  .ossian-navbar__actions {
    display: flex;
    align-items: center;
    gap: clamp(4px, 1.2vw, 14px);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .ossian-navbar__search {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    width: clamp(160px, 22vw, 400px);
    height: 46px;
    border: 1px solid rgb(30 58 95 / 0.16);
    border-radius: 999px;
    padding: 0 20px;
    background: #fff;
    color: rgb(30 58 95 / 0.6);
    cursor: pointer;
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    font-family: inherit;
  }

  .ossian-navbar__search svg {
    flex-shrink: 0;
  }

  .ossian-navbar__search span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    .ossian-navbar__actions .ossian-navbar__search {
      width: 40px;
      height: 40px;
      justify-content: center;
      padding: 0;
      border: none;
      background: transparent;
      color: #1e3a5f;
    }

    .ossian-navbar__actions .ossian-navbar__search svg {
      width: 22px;
      height: 22px;
    }

    /* Larger tap targets, icons and logo on phones */
    .ossian-navbar__hamburger {
      width: 46px;
      height: 46px;
    }

    .ossian-navbar__hamburger svg {
      width: 30px;
      height: 30px;
    }

    .ossian-navbar__logo img {
      height: var(--ossian-logo-height-mobile, 38px);
    }

    .ossian-navbar__actions .ossian-navbar__search,
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action {
      width: 44px !important;
      height: 44px !important;
    }

    .ossian-navbar__actions .ossian-navbar__search svg,
    .ossian-navbar__actions .header-actions__cart-icon svg,
    .ossian-navbar__actions .account-button__icon {
      width: 27px;
      height: 27px;
    }

    /* On phones the action icons sit bare, without the tinted circles */
    .ossian-navbar__actions .header-actions__action {
      background: transparent;
    }

    .ossian-navbar__actions .ossian-navbar__search span {
      display: none;
    }
  }

  .ossian-navbar__actions header-actions {
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.8vw, 8px);
  }

  .ossian-navbar__actions .header-actions__action {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #1e3a5f;
    flex-shrink: 0;
    padding: 0;
  }

  /* Fill the circular button above rather than drawing its own border/size,
     so account and cart icons don't end up with a circle nested inside a circle. */
  .ossian-navbar__actions shopify-account {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ossian-navbar__actions .header-actions__cart-icon svg,
  .ossian-navbar__actions .account-button__icon {
    width: 22px;
    height: 22px;
  }

  /* Cart count badge: always visible (shows 0 for an empty cart) */
  .ossian-navbar__actions .header-actions__cart-icon {
    --cart-bubble-size: 22px;
    --cart-bubble-top: -4px;
    --cart-bubble-right: -4px;
  }

  .ossian-navbar__actions .cart-bubble.visually-hidden {
    position: absolute !important;
    width: var(--cart-bubble-size);
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
  }

  .ossian-navbar__actions .cart-bubble__background {
    background-color: #2f6fe0;
  }

  .ossian-navbar__actions .cart-bubble__text {
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .ossian-navbar__actions .cart-bubble__text-count.hidden {
    display: inline !important;
  }

  /* sections/header.liquid styles every #header-component action as a bordered
     square with !important; this navbar reuses that id, so override them here. */
  #header-component.ossian-navbar header-actions .header-actions__action,
  #header-component.ossian-navbar .account-button.header-actions__action {
    width: 46px !important;
    height: 46px !important;
    border: none !important;
    border-radius: 50% !important;
    background: transparent !important;
    overflow: visible;
  }

  #header-component.ossian-navbar header-actions .header-actions__action:hover {
    background: rgb(30 58 95 / 0.06) !important;
  }

  /* header.liquid also pins every header icon to 20px with !important */
  #header-component.ossian-navbar .header-actions__action svg.account-button__icon,
  #header-component.ossian-navbar .account-button__icon svg,
  #header-component.ossian-navbar .header-actions__cart-icon > .svg-wrapper svg {
    width: var(--ossian-action-icon, 22px) !important;
    height: var(--ossian-action-icon, 22px) !important;
  }

  @media (max-width: 749px) {
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action,
    #header-component.ossian-navbar header-actions .header-actions__action:hover {
      width: 44px !important;
      height: 44px !important;
      background: transparent !important;
    }

    #header-component.ossian-navbar {
      --ossian-action-icon: 27px;
    }
  }

  /* Small phones: tighten spacing so logo and all four icons still fit */
  @media (max-width: 399px) {
    .ossian-navbar__inner {
      gap: 6px;
      padding: 8px 12px;
    }

    .ossian-navbar__logo img {
      height: calc(var(--ossian-logo-height-mobile, 38px) * 0.85);
    }

    .ossian-navbar__actions,
    .ossian-navbar__actions header-actions {
      gap: 0;
    }

    #header-component.ossian-navbar {
      --ossian-action-icon: 25px;
    }

    .ossian-navbar__actions .ossian-navbar__search,
    #header-component.ossian-navbar header-actions .header-actions__action,
    #header-component.ossian-navbar .account-button.header-actions__action,
    #header-component.ossian-navbar header-actions .header-actions__action:hover {
      width: 40px !important;
      height: 40px !important;
    }

    .ossian-navbar__actions .ossian-navbar__search svg,
    .ossian-navbar__actions .header-actions__cart-icon svg,
    .ossian-navbar__actions .account-button__icon {
      width: 25px;
      height: 25px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossion Navbar",
  "tag": "section",
  "class": "ossian-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Used in the navbar and the mobile drawer. Leave empty to use the default OSSION Professional logo."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (desktop)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height (mobile)",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu (fallback)",
      "default": "main-menu",
      "info": "Used when no Nav Item blocks are added. Nested sub-menus in this linklist render as dropdowns on desktop and accordions in the mobile drawer."
    },
    {
      "type": "header",
      "content": "Search pop-up"
    },
    {
      "type": "text",
      "id": "search_modal_placeholder",
      "label": "Search input placeholder",
      "default": "Search for products, categories or solutions..."
    },
    {
      "type": "text",
      "id": "search_trending_heading",
      "label": "Trending heading",
      "default": "Trending Searches"
    },
    {
      "type": "textarea",
      "id": "search_trending",
      "label": "Trending searches",
      "info": "One search term per line.",
      "default": "Shampoo\nHair Serum\nHair Mask\nKeratin Treatment\nHair Colour\nAnti Dandruff Shampoo\nHair Wax"
    },
    {
      "type": "text",
      "id": "search_categories_heading",
      "label": "Categories heading",
      "default": "Popular Categories",
      "info": "Add categories with \"Search category\" blocks."
    },
    {
      "type": "image_picker",
      "id": "search_promo_image",
      "label": "Promo banner image",
      "info": "Wide image (about 2100 × 640). Keep the left side light, the text sits there."
    },
    {
      "type": "text",
      "id": "search_promo_eyebrow",
      "label": "Promo eyebrow",
      "default": "Professional Hair Care"
    },
    {
      "type": "text",
      "id": "search_promo_heading",
      "label": "Promo heading",
      "default": "Find Your"
    },
    {
      "type": "text",
      "id": "search_promo_heading_accent",
      "label": "Promo heading (blue line)",
      "default": "Perfect Hair Solution"
    },
    {
      "type": "text",
      "id": "search_promo_text",
      "label": "Promo text",
      "default": "Explore professional hair care products for stronger, smoother and healthier hair."
    },
    {
      "type": "text",
      "id": "search_promo_button",
      "label": "Promo button label",
      "default": "Shop Hair Care"
    },
    {
      "type": "url",
      "id": "search_promo_link",
      "label": "Promo link"
    },
    {
      "type": "text",
      "id": "search_products_heading",
      "label": "Products heading",
      "default": "Products"
    },
    {
      "type": "collection",
      "id": "search_products_collection",
      "label": "Products to show before typing",
      "info": "First 4 products of this collection. Defaults to all products."
    },
    {
      "type": "text",
      "id": "search_recent_heading",
      "label": "Recent searches heading",
      "default": "Recent Searches"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "info": "Keeps the announcement bar and navbar fixed at the top while scrolling.",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search bar placeholder",
      "default": "Search products, collections..."
    },
    {
      "type": "header",
      "content": "Mobile drawer"
    },
    {
      "type": "paragraph",
      "content": "Row icons are picked from each link's title (hair, skin, wax, facial, about, science, contact). An expanded menu shows the linked collection's image."
    },
    {
      "type": "text",
      "id": "drawer_highlight_1",
      "label": "Highlight 1 (truck icon)",
      "default": "Free delivery above Rs. 999"
    },
    {
      "type": "url",
      "id": "drawer_highlight_1_link",
      "label": "Highlight 1 link"
    },
    {
      "type": "text",
      "id": "drawer_highlight_2",
      "label": "Highlight 2 (shield icon)",
      "default": "Trusted by Salon Professionals"
    },
    {
      "type": "url",
      "id": "drawer_highlight_2_link",
      "label": "Highlight 2 link"
    },
