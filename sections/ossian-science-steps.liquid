{{ 'section-ossian-science-steps.css' | asset_url | stylesheet_tag }}
{% comment %}
  Section contract.
  "How Our Technology Works": centred intro, then numbered steps (image, number, title,
  text) with arrows between them on desktop. Steps stack on mobile.
  @example
  <!-- templates/page.science.json → science_steps -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

<section class="oab oss" id="oss-{{ section.id }}" style="--oss-bg: {{ section.settings.background }};">
  <div class="oab-wrap">
    <div class="oab-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oab-eyebrow oab-eyebrow--rules">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ossian-about-heading', text: section.settings.heading, class: 'oab-heading--md' -%}
      {%- if section.settings.text != blank -%}
        <p class="oab-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="oss__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="oss-step" {{ block.shopify_attributes }}>
            <div class="oss-step__visual">
            <div class="oss-step__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width: 990px) 30vw, 90vw', alt: ''
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'oss-step__ph' }}
              {%- endif -%}
            </div>
            {%- unless forloop.last -%}
              <span class="oss-step__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h17M14 6l6 6-6 6"/></svg>
              </span>
            {%- endunless -%}
            </div>
            <div class="oss-step__copy">
              <span class="oss-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                {%- if block.settings.title != blank -%}
                  <h3 class="oss-step__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="oss-step__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "Ossian Science Steps",
  "tag": "div",
  "class": "section-ossian-science-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Science Behind The Results" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent.", "default": "How Our Technology Works" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From powerful actives to visibly healthier hair — a complete science-driven process." },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4f8fe" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "About 700 × 525 (4:3). Transparent or light backgrounds work best." },
        { "type": "text", "id": "title", "label": "Title", "default": "Active Ingredients" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Marine actives, silk amino acids and advanced complexes work together at a molecular level." }
      ]
    }
  ],
  "presets": [{ "name": "Ossian Science Steps" }]
}
{% endschema %}
