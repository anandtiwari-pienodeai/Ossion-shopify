<div
  class="ossian-why-choose section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ossian-why-choose__header">
        {% if section.settings.heading != blank %}
          <h2 class="ossian-why-choose__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ossian-why-choose__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ossian-why-choose__grid">
      {% for block in section.blocks %}
        <div class="ossian-why-choose__item" {{ block.shopify_attributes }}>
          <div class="ossian-why-choose__icon-box" aria-hidden="true">
            <span class="ossian-why-choose__emoji">{{ block.settings.emoji }}</span>
          </div>
          <h3 class="ossian-why-choose__item-title">{{ block.settings.title }}</h3>
          <p class="ossian-why-choose__item-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-why-choose__header {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ossian-why-choose__title {
    font-size: 2.25rem;
    font-weight: 700;
    margin: 0;
    color: #101828;
  }

  .ossian-why-choose__subtitle {
    font-size: 1.125rem;
    color: #4a5565;
    margin: 0;
  }

  .ossian-why-choose__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 989px) {
    .ossian-why-choose__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 499px) {
    .ossian-why-choose__grid {
      gap: 16px;
    }
    .ossian-why-choose__title {
      font-size: 1.75rem;
    }
  }

  .ossian-why-choose__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ossian-why-choose__icon-box {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: #1e3a5f;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ossian-why-choose__emoji {
    font-size: 1.875rem;
    line-height: 1;
  }

  .ossian-why-choose__item-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #101828;
    margin: 0;
  }

  .ossian-why-choose__item-desc {
    font-size: 1rem;
    color: #4a5565;
    margin: 0;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji icon",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Quality Guaranteed"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "100% authentic professional products"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Why Choose OSSION?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Professional quality you can trust"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        { "type": "item", "settings": { "emoji": "🛡️", "title": "Quality Guaranteed", "description": "100% authentic professional products" } },
        { "type": "item", "settings": { "emoji": "🚚", "title": "Free Shipping", "description": "On orders over ₹4000" } },
        { "type": "item", "settings": { "emoji": "🏆", "title": "Award Winning", "description": "Trusted by professionals worldwide" } },
        { "type": "item", "settings": { "emoji": "🎧", "title": "24/7 Support", "description": "Expert help when you need it" } }
      ]
    }
  ]
}
{% endschema %}
