<div class="ossian-instagram">
  <div class="ossian-instagram__header page-width">
    <div class="ossian-instagram__title-group">
      <h2 class="ossian-instagram__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="ossian-instagram__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.instagram_handle != blank -%}
      <a
        href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}"
        class="ossian-instagram__follow"
        target="_blank"
        rel="noopener"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        Follow us @{{ section.settings.instagram_handle | remove: '@' }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ossian-instagram__grid page-width">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.post_url | default: '#' }}"
          class="ossian-instagram__post"
          target="_blank"
          rel="noopener"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag:
                class: 'ossian-instagram__post-img',
                loading: 'lazy',
                widths: '200, 300, 400'
            }}
          {%- else -%}
            <div class="ossian-instagram__post-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
          <div class="ossian-instagram__post-overlay">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="white" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="white" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="white"/></svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.ossian-instagram {
  padding: 60px 0 0;
  background: #fff;
}

.ossian-instagram__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.ossian-instagram__heading {
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 900;
  color: #1e3a5f;
  margin: 0 0 6px;
  font-style: italic;
  letter-spacing: -0.01em;
}

.ossian-instagram__sub {
  font-size: 0.9rem;
  color: #666;
  margin: 0;
}

.ossian-instagram__follow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #1e3a5f;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  border: 1.5px solid #1e3a5f;
  padding: 10px 20px;
  border-radius: 6px;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s;
}

.ossian-instagram__follow:hover {
  background: #1e3a5f;
  color: #fff;
}

.ossian-instagram__grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 0;
}

.ossian-instagram__post {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  display: block;
}

.ossian-instagram__post-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.ossian-instagram__post-placeholder {
  width: 100%;
  height: 100%;
  background: #e8e4df;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ossian-instagram__post-overlay {
  position: absolute;
  inset: 0;
  background: rgba(30,58,95,0);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s, background 0.3s;
}

.ossian-instagram__post:hover .ossian-instagram__post-img { transform: scale(1.08); }
.ossian-instagram__post:hover .ossian-instagram__post-overlay {
  opacity: 1;
  background: rgba(30,58,95,0.5);
}

@media (max-width: 768px) {
  .ossian-instagram__grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 480px) {
  .ossian-instagram__grid { grid-template-columns: repeat(2, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossion Instagram",
  "tag": "section",
  "class": "ossian-instagram-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OSSION gram"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real people. Real results. Real stories"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle",
      "default": "ossion.care"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post image"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Post URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Instagram",
      "settings": {
        "heading": "OSSION gram",
        "subheading": "Real people. Real results. Real stories",
        "instagram_handle": "ossion.care"
      },
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
