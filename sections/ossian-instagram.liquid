<div class="ossian-reels" style="--ossian-reels-bg-image: image-set(
  {%- if section.settings.background_image != blank -%}
    url('{{ section.settings.background_image | image_url: width: 750 }}') 1x,
    url('{{ section.settings.background_image | image_url: width: 1500 }}') 2x,
    url('{{ section.settings.background_image | image_url: width: 1920 }}') 3x
  {%- else -%}
    url('https://cdn.shopify.com/s/files/1/1021/3716/8155/files/image_191.png?v=1783841201&width=750') 1x,
    url('https://cdn.shopify.com/s/files/1/1021/3716/8155/files/image_191.png?v=1783841201&width=1500') 2x,
    url('https://cdn.shopify.com/s/files/1/1021/3716/8155/files/image_191.png?v=1783841201&width=1920') 3x
  {%- endif -%}
);">
  <div class="ossian-reels__header page-width">
    <div class="ossian-reels__title-group">
      <h2 class="ossian-reels__heading">{{ section.settings.heading }}&nbsp;{%- if section.settings.heading_accent != blank %}<span class="ossian-reels__heading-accent">{{ section.settings.heading_accent }}</span>{% endif -%}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="ossian-reels__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.instagram_handle != blank -%}
      <a
        href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}"
        class="ossian-reels__follow"
        target="_blank"
        rel="noopener"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        Follow us @{{ section.settings.instagram_handle | remove: '@' }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="ossian-reels__track-wrap">
      <div class="ossian-reels__track" id="reels-track">
        {%- for block in section.blocks -%}
          {%- assign idx = forloop.index0 -%}
          <div
            class="ossian-reels__card{% if forloop.index == 3 %} ossian-reels__card--active{% elsif forloop.index == 2 or forloop.index == 4 %} ossian-reels__card--near{% endif %}"
            data-reel-index="{{ idx }}"
            {{ block.shopify_attributes }}
          >
            <div class="ossian-reels__card-media" data-open-reel="{{ idx }}">
              {%- if block.settings.video_url != blank -%}
                <video
                  class="ossian-reels__card-video is-playing"
                  data-src="{{ block.settings.video_url }}"
                  {%- if block.settings.thumbnail != blank -%}
                  poster="{{ block.settings.thumbnail | image_url: width: 400 }}"
                  {%- endif -%}
                  muted
                  loop
                  playsinline
                  preload="none"
                ></video>
              {%- else -%}
                <div class="ossian-reels__thumb-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}

              <div class="ossian-reels__play-btn">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
              </div>

              {%- if block.settings.product != blank or block.settings.custom_price != blank -%}
                <span class="ossian-reels__tag-badge" role="img" aria-label="Product tagged" title="Product tagged">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </span>
              {%- endif -%}

              {%- if block.settings.product != blank -%}
                {%- assign reel_product = block.settings.product -%}
                <div class="ossian-reels__card-footer">
                  {%- if reel_product.featured_image != blank -%}
                    <div class="ossian-reels__product-image-wrap">
                      {{
                        reel_product.featured_image
                        | image_url: width: 120
                        | image_tag:
                          class: 'ossian-reels__product-image',
                          loading: 'lazy',
                          alt: reel_product.title
                      }}
                    </div>
                  {%- endif -%}
                  <div class="ossian-reels__product-info">
                    <p class="ossian-reels__product-name">{{ reel_product.title }}</p>
                    <div class="ossian-reels__price-wrap">
                      <span class="ossian-reels__price-current">{{ reel_product.price | money_without_trailing_zeros }}</span>
                      {%- if reel_product.compare_at_price > reel_product.price -%}
                        <span class="ossian-reels__price-original">{{ reel_product.compare_at_price | money_without_trailing_zeros }}</span>
                        {%- assign discount = reel_product.compare_at_price | minus: reel_product.price | times: 100 | divided_by: reel_product.compare_at_price -%}
                        <span class="ossian-reels__price-discount">{{ discount }}%</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- elsif block.settings.custom_price != blank -%}
                <div class="ossian-reels__card-footer">
                  {%- if block.settings.product_image != blank -%}
                    <div class="ossian-reels__product-image-wrap">
                      {{
                        block.settings.product_image
                        | image_url: width: 120
                        | image_tag:
                          class: 'ossian-reels__product-image',
                          loading: 'lazy'
                      }}
                    </div>
                  {%- endif -%}
                  <div class="ossian-reels__product-info">
                    {%- if block.settings.reel_label != blank -%}
                      <p class="ossian-reels__product-name">{{ block.settings.reel_label }}</p>
                    {%- endif -%}
                    <div class="ossian-reels__price-wrap">
                      <span class="ossian-reels__price-current">{{ block.settings.custom_price }}</span>
                      {%- if block.settings.custom_compare_price != blank -%}
                        <span class="ossian-reels__price-original">{{ block.settings.custom_compare_price }}</span>
                      {%- endif -%}
                      {%- if block.settings.discount_label != blank -%}
                        <span class="ossian-reels__price-discount">{{ block.settings.discount_label }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<!-- Reel Popup Overlay -->
<div class="reel-popup" id="reel-popup" aria-hidden="true" inert>
  <div class="reel-popup__backdrop" id="reel-popup-backdrop"></div>
  <div class="reel-popup__dialog" role="dialog" aria-modal="true">
    <!-- Left: Video Player -->
    <div class="reel-popup__video-side">
      <div class="reel-popup__video-wrap">
        <video
          class="reel-popup__video"
          id="reel-popup-video"
          playsinline
          preload="metadata"
        ></video>
        <div class="reel-popup__video-placeholder" id="reel-popup-placeholder">
          <img id="reel-popup-poster" src="" alt="" loading="lazy">
        </div>
        <div class="reel-popup__video-top-bar">
          <div class="reel-popup__video-actions">
            <button class="reel-popup__icon-btn" id="reel-share-btn" title="Share">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
            <button class="reel-popup__icon-btn" id="reel-mute-btn" title="Mute">
              <svg class="icon-unmuted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
              <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            </button>
          </div>
        </div>
        <button class="reel-popup__play-center" id="reel-play-center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <div class="reel-popup__controls">
          <div class="reel-popup__progress-wrap">
            <span class="reel-popup__time" id="reel-time-current">0:00</span>
            <div class="reel-popup__progress-bar" id="reel-progress-bar">
              <div class="reel-popup__progress-fill" id="reel-progress-fill"></div>
              <div class="reel-popup__progress-thumb" id="reel-progress-thumb"></div>
            </div>
            <span class="reel-popup__time" id="reel-time-total">0:00</span>
          </div>
          <button class="reel-popup__fullscreen-btn" id="reel-fullscreen-btn" title="Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          </button>
        </div>
      </div>
      <!-- Thumbnail Strip -->
      <div class="reel-popup__thumbnails" id="reel-popup-thumbnails"></div>
    </div>

    <!-- Right: Product Details -->
    <div class="reel-popup__product-side" id="reel-popup-product-side">
      <button class="reel-popup__close" id="reel-popup-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="reel-popup__product-inner" id="reel-popup-product-inner">
        <p class="reel-popup__no-product">No product linked to this reel.</p>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
/* ===================== REELS SECTION ===================== */
.ossian-reels {
  padding: 60px 0 24px;
  background: #eaf3fb var(--ossian-reels-bg-image) center top / cover no-repeat;
}

.ossian-reels__header {
  display: flex;
  flex-direction: row;
  align-items: center;
 justify-content: center;
  text-align: left;
  gap: 24px;
  margin-bottom: 36px;
}

.ossian-reels__title-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.ossian-reels__heading {
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 900;
  color: #1e3a5f;
  margin: 0;
  font-style: normal;
  letter-spacing: -0.01em;
}

.ossian-reels__heading-accent {
  color: #2563eb;
}

.ossian-reels__sub {
  font-size: 0.9rem;
  color: #444;
  margin: 0;
}

.ossian-reels__follow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #2563eb;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  border: 1.5px solid #2563eb;
  background: rgba(255, 255, 255, 0.65);
  padding: 10px 20px;
  border-radius: 8px;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s;
}

.ossian-reels__follow:hover {
  background: #2563eb;
  color: #fff;
}

.ossian-reels__track-wrap {
  overflow-x: auto;
  overflow-y: visible;
  padding: 20px 40px 40px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.ossian-reels__track-wrap::-webkit-scrollbar { display: none; }

.ossian-reels__track {
  display: flex;
  gap: 20px;
  align-items: flex-end;
  width: max-content;
  margin: 0 auto;
}

.ossian-reels__card {
  flex-shrink: 0;
  /* sized so ~4 cards fill the visible row (track-wrap has 40px side
     padding, gap is 20px: (100vw - 80px padding - 60px gaps) / 4 */
  width: clamp(260px, calc((100vw - 140px) / 4), 420px);
  border-radius: 20px;
  overflow: hidden;
  background: #000;
  cursor: pointer;
  transform-origin: bottom center;
  /* far tier: shortest, sits at the bottom of the row */
  transform: scale(0.72);
  transition: transform 0.4s cubic-bezier(.4,0,.2,1),
              box-shadow 0.4s ease;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
}

.ossian-reels__card--near {
  transform: scale(0.87);
  box-shadow: 0 8px 24px rgba(0,0,0,0.2);
}

.ossian-reels__card--active {
  transform: scale(1);
  box-shadow: 0 16px 48px rgba(0,0,0,0.38);
  z-index: 2;
}

.ossian-reels__card:hover:not(.ossian-reels__card--active) {
  transform: scale(0.92);
}

.ossian-reels__card-media {
  position: relative;
  width: 100%;
  aspect-ratio: 9 / 16;
  overflow: hidden;
  cursor: pointer;
}

/* Card inline video — always visible and playing */
.ossian-reels__card-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: transform 0.4s ease;
  pointer-events: none;
  z-index: 1;
}

.ossian-reels__card:hover .ossian-reels__card-video { transform: scale(1.05); }

.ossian-reels__thumb-placeholder {
  width: 100%;
  height: 100%;
  background: #222;
}

.ossian-reels__play-btn {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
  background: rgba(0,0,0,0.2);
  z-index: 2;
}

.ossian-reels__card--active .ossian-reels__play-btn,
.ossian-reels__card:hover .ossian-reels__play-btn {
  opacity: 1;
}

.ossian-reels__play-btn svg {
  filter: drop-shadow(0 2px 6px rgba(0,0,0,0.5));
  width: 44px;
  height: 44px;
}

/* Shopping tag badge — shown on any reel with a product linked */
.ossian-reels__tag-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

/* Product / price bar — flush strip at the bottom edge of the card */
.ossian-reels__card-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #eaf2fb 0%, #cfe0f5 100%);
  padding: 10px 12px;
}

.ossian-reels__product-image-wrap {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.ossian-reels__product-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.ossian-reels__product-info {
  flex: 1;
  min-width: 0;
}

.ossian-reels__product-name {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: #1e3a5f;
  margin: 0 0 4px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ossian-reels__price-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.ossian-reels__price-current {
  color: #1a1a2e;
  font-size: 13px;
  font-weight: 800;
}

.ossian-reels__price-original {
  color: #8892a3;
  font-size: 12px;
  font-weight: 500;
  text-decoration: line-through;
}

.ossian-reels__price-discount {
  color: #2e9e4a;
  font-size: 12px;
  font-weight: 800;
}

/* ===================== POPUP ===================== */
.reel-popup {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.reel-popup.is-open {
  pointer-events: all;
  opacity: 1;
}

.reel-popup__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(4px);
}

.reel-popup__dialog {
  position: relative;
  z-index: 1;
  display: flex;
  width: min(96vw, 1100px);
  max-height: 90vh;
  border-radius: 18px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 32px 80px rgba(0,0,0,0.45);
  transform: scale(0.95);
  transition: transform 0.25s ease;
}

.reel-popup.is-open .reel-popup__dialog {
  transform: scale(1);
}

/* ---- Video Side ---- */
.reel-popup__video-side {
  width: 380px;
  flex-shrink: 0;
  background: #000;
  display: flex;
  flex-direction: column;
}

.reel-popup__video-wrap {
  position: relative;
  flex: 1;
  aspect-ratio: 9/16;
  max-height: calc(90vh - 100px);
  overflow: hidden;
  background: #000;
}

.reel-popup__video,
.reel-popup__video-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.reel-popup__video-placeholder {
  position: absolute;
  inset: 0;
}

.reel-popup__video-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.reel-popup__video-top-bar {
  position: absolute;
  top: 14px;
  right: 14px;
  left: 14px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  z-index: 2;
}

.reel-popup__video-actions {
  display: flex;
  gap: 8px;
}

.reel-popup__icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(0,0,0,0.45);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.reel-popup__icon-btn:hover { background: rgba(0,0,0,0.7); }

.reel-popup__play-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 2;
  transition: opacity 0.2s;
}

.reel-popup__play-center.is-playing { opacity: 0; }
.reel-popup__play-center.is-playing:hover { opacity: 1; }

.reel-popup__play-center svg {
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
  background: rgba(0,0,0,0.35);
  border-radius: 50%;
  padding: 6px;
}

.reel-popup__controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28px 14px 14px;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10px;
}

.reel-popup__progress-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
}

.reel-popup__time {
  color: #fff;
  font-size: 11px;
  font-weight: 500;
  white-space: nowrap;
  font-family: monospace;
}

.reel-popup__progress-bar {
  flex: 1;
  height: 4px;
  background: rgba(255,255,255,0.35);
  border-radius: 2px;
  position: relative;
  cursor: pointer;
}

.reel-popup__progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 2px;
  width: 0%;
  transition: width 0.1s linear;
}

.reel-popup__progress-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #fff;
  left: 0%;
  box-shadow: 0 0 4px rgba(0,0,0,0.4);
}

.reel-popup__fullscreen-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px;
  display: flex;
  align-items: center;
}

.reel-popup__thumbnails {
  display: flex;
  gap: 6px;
  padding: 10px 10px;
  background: #000;
  overflow-x: auto;
  scrollbar-width: none;
}

.reel-popup__thumbnails::-webkit-scrollbar { display: none; }

.reel-popup__thumb-item {
  flex-shrink: 0;
  width: 68px;
  height: 68px;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s;
  position: relative;
}

.reel-popup__thumb-item.is-active { border-color: #fff; }

.reel-popup__thumb-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.reel-popup__thumb-play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.35);
}

/* ---- Product Side ---- */
.reel-popup__product-side {
  flex: 1;
  overflow-y: auto;
  padding: 28px 28px 28px;
  position: relative;
  background: #fff;
  scrollbar-width: thin;
}

.reel-popup__close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #f0f0f0;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  transition: background 0.2s;
}

.reel-popup__close:hover { background: #e0e0e0; }

.reel-popup__no-product {
  color: #888;
  font-size: 14px;
  padding: 20px 0;
}

/* Product inner HTML injected by JS */
.rp-category-tag {
  display: inline-block;
  background: #1e8a9e;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 20px;
  margin-bottom: 14px;
}

.rp-product-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 10px;
}

.rp-product-info { flex: 1; }

.rp-product-image {
  width: 110px;
  height: 110px;
  object-fit: contain;
  border-radius: 10px;
  background: #f5f5f5;
  flex-shrink: 0;
}

.rp-title {
  font-size: 1.35rem;
  font-weight: 800;
  color: #1e3a5f;
  margin: 0 0 4px;
  line-height: 1.2;
}

.rp-subtitle {
  font-size: 0.85rem;
  color: #1e8a9e;
  font-weight: 600;
  margin: 0 0 8px;
}

.rp-rating {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #555;
  margin-bottom: 10px;
}

.rp-stars { color: #f5a623; letter-spacing: 1px; }

.rp-price-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.rp-price {
  font-size: 1.25rem;
  font-weight: 800;
  color: #111;
}

.rp-compare-price {
  font-size: 1rem;
  color: #999;
  text-decoration: line-through;
}

.rp-discount-badge {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 13px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
}

.rp-tax-note {
  font-size: 11px;
  color: #888;
  margin-bottom: 16px;
}

.rp-features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 18px;
  border: 1px solid #eee;
  border-radius: 10px;
  padding: 12px 8px;
}

.rp-feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;
}

.rp-feature-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rp-feature-icon svg { color: #1e3a5f; }

.rp-feature-label {
  font-size: 10px;
  color: #444;
  font-weight: 500;
  line-height: 1.3;
}

.rp-size-section { margin-bottom: 18px; }

.rp-size-label {
  font-size: 13px;
  font-weight: 700;
  color: #222;
  margin-bottom: 8px;
}

.rp-size-options {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.rp-size-btn {
  padding: 7px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  border: 1.5px solid #ddd;
  background: #fff;
  cursor: pointer;
  transition: all 0.2s;
  color: #333;
}

.rp-size-btn.is-active,
.rp-size-btn:hover {
  background: #1e3a5f;
  border-color: #1e3a5f;
  color: #fff;
}

.rp-tabs {
  display: flex;
  gap: 0;
  border-bottom: 2px solid #eee;
  margin-bottom: 14px;
}

.rp-tab-btn {
  background: none;
  border: none;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  color: #888;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  transition: color 0.2s, border-color 0.2s;
}

.rp-tab-btn.is-active {
  color: #1e3a5f;
  border-bottom-color: #1e3a5f;
}

.rp-tab-content { display: none; }
.rp-tab-content.is-active { display: block; }

.rp-description {
  display: flex;
  gap: 12px;
}

.rp-description-text {
  flex: 1;
  font-size: 13px;
  color: #555;
  line-height: 1.6;
}

.rp-description-highlights {
  background: #f0f7ff;
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 12px;
  color: #1e3a5f;
  font-weight: 500;
  line-height: 1.8;
  white-space: nowrap;
}

.rp-actions {
  display: flex;
  gap: 12px;
  margin-top: 18px;
  flex-wrap: wrap;
}

.rp-add-to-cart {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #fff;
  border: 1.5px solid #1e3a5f;
  color: #1e3a5f;
  font-size: 14px;
  font-weight: 700;
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s, color 0.2s;
  min-width: 150px;
}

.rp-add-to-cart:hover {
  background: #1e3a5f;
  color: #fff;
}

.rp-view-product {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: #fff;
  border: 1.5px solid #ccc;
  color: #333;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
  white-space: nowrap;
  min-width: 150px;
}

.rp-view-product:hover { border-color: #1e3a5f; color: #1e3a5f; }

/* ===================== RESPONSIVE ===================== */

/* ── Large desktop (≥1400px) ── */
@media (min-width: 1400px) {
  .ossian-reels__heading { font-size: 3.5rem; }
}

/* ── Small desktop / large tablet (769px–1023px) ── */
@media (min-width: 769px) and (max-width: 1023px) {
  .ossian-reels { padding: 40px 0 0; }
  .ossian-reels__heading { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .ossian-reels__track-wrap { padding: 16px 32px 36px; }
  .ossian-reels__card { width: clamp(150px, calc((100vw - 104px) / 3), 220px); }

  /* Popup: stacked column */
  .reel-popup__dialog {
    flex-direction: column;
    width: min(90vw, 560px);
    max-height: 92vh;
    border-radius: 16px;
  }
  .reel-popup__video-side { width: 100%; }
  .reel-popup__video-wrap { aspect-ratio: 16/9; max-height: 260px; }
  .reel-popup__product-side { max-height: 48vh; overflow-y: auto; padding: 20px; }
  .reel-popup__thumbnails { display: none; }
  .rp-features { grid-template-columns: repeat(2, 1fr); }
  .rp-description { flex-direction: column; }
  .rp-description-highlights { white-space: normal; }
}

/* ── Mobile (≤768px) ── */
@media (max-width: 768px) {

  /* ─ Section header ─ */
  .ossian-reels { padding: 24px 0 0; }

  .ossian-reels__header {
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 10px;
    margin-bottom: 18px;
    padding: 0 16px;
  }

  .ossian-reels__heading { font-size: clamp(1.4rem, 6vw, 2rem); }
  .ossian-reels__sub { font-size: 0.78rem; }

  .ossian-reels__follow {
    font-size: 12px;
    padding: 8px 14px;
  }

  /* ─ Track ─ */
  .ossian-reels__track-wrap { padding: 10px 0 24px; }
  .ossian-reels__track { gap: 8px; }

  /* Active card = centered hero; near/far = progressively smaller */
  .ossian-reels__card {
    width: 52vw;
    min-width: 150px;
    max-width: 200px;
    border-radius: 16px;
    transform: scale(0.78);
  }

  .ossian-reels__card--near { transform: scale(0.9); }

  .ossian-reels__card--active {
    transform: scale(1);
  }

  /* Always show play overlay on the active card */
  .ossian-reels__card--active .ossian-reels__play-btn { opacity: 1; }
  .ossian-reels__play-btn svg { width: 30px; height: 30px; }

  /* Card footer */
  .ossian-reels__card-footer { padding: 8px 10px; gap: 8px; }
  .ossian-reels__product-image-wrap { width: 34px; height: 34px; border-radius: 8px; }
  .ossian-reels__product-name { font-size: 10px; }
  .ossian-reels__price-current { font-size: 11.5px; }
  .ossian-reels__price-original { font-size: 10.5px; }
  .ossian-reels__price-discount { font-size: 10.5px; }

  /* ─────────────────────────────────────────────────
     MOBILE POPUP — Full-screen TikTok / Reels style
     ───────────────────────────────────────────────── */

  .reel-popup {
    align-items: stretch;
    justify-content: stretch;
    padding: 0;
  }

  /* Full-screen dialog, slides up from bottom */
  .reel-popup__dialog {
    width: 100vw !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    border-radius: 0 !important;
    flex-direction: column;
    position: relative;
    overflow: hidden !important;
    transform: translateY(100%) !important;
    transition: transform 0.35s cubic-bezier(.4,0,.2,1) !important;
  }

  .reel-popup.is-open .reel-popup__dialog {
    transform: translateY(0) !important;
  }

  /* Video layer: absolute, fills entire screen */
  .reel-popup__video-side {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .reel-popup__video-wrap {
    flex: 1 !important;
    aspect-ratio: unset !important;
    max-height: none !important;
    height: 100% !important;
  }

  .reel-popup__video,
  .reel-popup__video-placeholder,
  .reel-popup__video-placeholder img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  /* Hide thumbnail strip on mobile */
  .reel-popup__thumbnails { display: none !important; }

  /* ✕ Close — top-left, dark pill */
  .reel-popup__close {
    position: fixed !important;
    top: env(safe-area-inset-top, 16px) !important;
    left: 16px !important;
    right: unset !important;
    width: 36px !important;
    height: 36px !important;
    background: rgba(0,0,0,0.55) !important;
    color: #fff !important;
    border: none !important;
    z-index: 10 !important;
    border-radius: 50% !important;
  }

  /* Share + mute icons (top-right via video-top-bar) */
  .reel-popup__video-top-bar { z-index: 5; }
  .reel-popup__icon-btn { width: 36px; height: 36px; }

  /* Progress bar */
  .reel-popup__controls {
    padding: 20px 12px 12px;
  }

  /* ─ Product card: white sheet at the bottom ─ */
  .reel-popup__product-side {
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    top: unset !important;
    z-index: 4 !important;
    background: #fff !important;
    border-radius: 20px 20px 0 0 !important;
    padding: 6px 16px calc(env(safe-area-inset-bottom, 0px) + 24px) !important;
    max-height: none !important;
    overflow: visible !important;
    scrollbar-width: none;
  }

  /* Drag handle */
  .reel-popup__product-side::before {
    content: '';
    display: block;
    width: 40px;
    height: 4px;
    background: #d0d0d0;
    border-radius: 2px;
    margin: 0 auto 12px;
  }

  /* ─ Hide desktop-only elements in product panel ─ */
  .rp-category-tag,
  .rp-subtitle,
  .rp-rating,
  .rp-tax-note,
  .rp-features,
  .rp-size-section,
  .rp-tabs,
  .rp-tab-content,
  .rp-description,
  .rp-view-product { display: none !important; }

  /* ─ Compact product row ─ */
  .rp-product-row {
    flex-direction: row !important;
    align-items: center !important;
    gap: 12px !important;
    margin-bottom: 12px !important;
  }

  .rp-product-image {
    width: 54px !important;
    height: 54px !important;
    border-radius: 8px !important;
    flex-shrink: 0 !important;
    object-fit: cover !important;
  }

  .rp-product-info { flex: 1; min-width: 0; }

  .rp-title {
    font-size: 0.85rem !important;
    font-weight: 700 !important;
    color: #111 !important;
    margin: 0 0 3px !important;
    line-height: 1.3 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .rp-price-row { margin-bottom: 0 !important; gap: 5px !important; }
  .rp-price { font-size: 1rem !important; font-weight: 800 !important; color: #111 !important; }
  .rp-compare-price,
  .rp-discount-badge { display: none !important; }

  /* ─ Shop Now CTA ─ */
  .rp-actions { flex-direction: column !important; gap: 0 !important; margin-top: 0 !important; }

  .rp-add-to-cart {
    width: 100% !important;
    min-width: unset !important;
    background: #111 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 12px !important;
    padding: 15px !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em !important;
    justify-content: center !important;
  }

  .rp-add-to-cart svg { display: none !important; }
  .rp-add-to-cart:hover { background: #000 !important; }
}
{% endstylesheet %}

<script>
(function() {
  const reelData = [
    {%- for block in section.blocks -%}
    {
      index: {{ forloop.index0 }},
      videoUrl: {{ block.settings.video_url | default: '' | json }},
      thumbnail: {%- if block.settings.thumbnail != blank -%}{{ block.settings.thumbnail | image_url: width: 800 | json }}{%- else -%}null{%- endif -%},
      productHandle: {{ block.settings.product.handle | default: '' | json }},
      productTitle: {{ block.settings.product.title | default: '' | json }},
      productSubtitle: {{ block.settings.product_subtitle | default: '' | json }},
      productCategory: {{ block.settings.product_category | default: '' | json }},
      productUrl: {%- if block.settings.product != blank -%}{{ block.settings.product.url | json }}{%- else -%}{{ block.settings.product_url | default: '' | json }}{%- endif -%},
      productImage: {%- if block.settings.product != blank and block.settings.product.featured_image != blank -%}{{ block.settings.product.featured_image | image_url: width: 300 | json }}{%- elsif block.settings.product_image != blank -%}{{ block.settings.product_image | image_url: width: 300 | json }}{%- else -%}null{%- endif -%},
      price: {%- if block.settings.product != blank -%}{{ block.settings.product.price | money | json }}{%- else -%}{{ block.settings.custom_price | default: '' | json }}{%- endif -%},
      comparePrice: {%- if block.settings.product != blank and block.settings.product.compare_at_price > block.settings.product.price -%}{{ block.settings.product.compare_at_price | money | json }}{%- elsif block.settings.product == blank and block.settings.custom_compare_price != blank -%}{{ block.settings.custom_compare_price | json }}{%- else -%}null{%- endif -%},
      discountLabel: {%- if block.settings.product != blank and block.settings.product.compare_at_price > block.settings.product.price -%}{%- assign discount_pct = block.settings.product.compare_at_price | minus: block.settings.product.price | times: 100 | divided_by: block.settings.product.compare_at_price -%}{{ discount_pct | append: '% off' | json }}{%- elsif block.settings.discount_label != blank -%}{{ block.settings.discount_label | json }}{%- else -%}null{%- endif -%},
      rating: {{ block.settings.rating | default: '0' }},
      reviewCount: {{ block.settings.review_count | default: '0' }},
      description: {{ block.settings.product_description | default: '' | json }},
      highlights: {{ block.settings.product_highlights | default: '' | json }},
      features: [
        {%- if block.settings.feature_1 != blank -%}{{ block.settings.feature_1 | json }}{%- else -%}null{%- endif -%},
        {%- if block.settings.feature_2 != blank -%}{{ block.settings.feature_2 | json }}{%- else -%}null{%- endif -%},
        {%- if block.settings.feature_3 != blank -%}{{ block.settings.feature_3 | json }}{%- else -%}null{%- endif -%},
        {%- if block.settings.feature_4 != blank -%}{{ block.settings.feature_4 | json }}{%- else -%}null{%- endif -%}
      ].filter(Boolean),
      sizes: {{ block.settings.sizes | default: '' | json }},
      variantId: {%- if block.settings.product != blank -%}{{ block.settings.product.selected_or_first_available_variant.id | json }}{%- else -%}null{%- endif -%}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  const popup = document.getElementById('reel-popup');
  const backdrop = document.getElementById('reel-popup-backdrop');
  const closeBtn = document.getElementById('reel-popup-close');
  const video = document.getElementById('reel-popup-video');
  const poster = document.getElementById('reel-popup-poster');
  const placeholder = document.getElementById('reel-popup-placeholder');
  const productInner = document.getElementById('reel-popup-product-inner');
  const thumbnailsEl = document.getElementById('reel-popup-thumbnails');
  const playCenter = document.getElementById('reel-play-center');
  const muteBtn = document.getElementById('reel-mute-btn');
  const progressFill = document.getElementById('reel-progress-fill');
  const progressThumb = document.getElementById('reel-progress-thumb');
  const progressBar = document.getElementById('reel-progress-bar');
  const timeCurrent = document.getElementById('reel-time-current');
  const timeTotal = document.getElementById('reel-time-total');
  const fullscreenBtn = document.getElementById('reel-fullscreen-btn');
  const shareBtn = document.getElementById('reel-share-btn');

  let currentReel = null;
  let isPlaying = false;

  function formatTime(s) {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return m + ':' + (sec < 10 ? '0' : '') + sec;
  }

  function openReel(idx) {
    const data = reelData[idx];
    if (!data) return;
    currentReel = data;

    // Set poster/video
    if (data.thumbnail) {
      poster.src = data.thumbnail;
      poster.alt = data.productTitle || '';
      placeholder.style.display = 'block';
    } else {
      placeholder.style.display = 'none';
    }

    if (data.videoUrl) {
      video.src = data.videoUrl;
      video.style.display = 'block';
      video.load();
    } else {
      video.src = '';
      video.style.display = 'none';
    }

    // Reset controls
    progressFill.style.width = '0%';
    progressThumb.style.left = '0%';
    timeCurrent.textContent = '0:00';
    timeTotal.textContent = '0:00';
    playCenter.classList.remove('is-playing');
    isPlaying = false;

    // Build thumbnails strip
    thumbnailsEl.innerHTML = '';
    reelData.forEach(function(r, i) {
      const item = document.createElement('div');
      item.className = 'reel-popup__thumb-item' + (i === idx ? ' is-active' : '');
      item.dataset.reelIndex = i;
      if (r.thumbnail) {
        item.innerHTML = '<img src="' + r.thumbnail + '" alt="" loading="lazy">';
      } else {
        item.style.background = '#333';
      }
      if (r.videoUrl) {
        item.innerHTML += '<div class="reel-popup__thumb-play"><svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg></div>';
      }
      item.addEventListener('click', function() { openReel(i); });
      thumbnailsEl.appendChild(item);
    });

    // Build product panel
    buildProductPanel(data);

    popup.setAttribute('aria-hidden', 'false');
    popup.removeAttribute('inert');
    popup.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function buildProductPanel(data) {
    if (!data.productTitle) {
      productInner.innerHTML = '<p class="reel-popup__no-product">No product linked to this reel.</p>';
      return;
    }

    const stars = data.rating > 0
      ? '<span class="rp-stars">' + '★'.repeat(Math.round(data.rating)) + '☆'.repeat(5 - Math.round(data.rating)) + '</span>'
      : '';

    const ratingHtml = (data.rating > 0 || data.reviewCount > 0)
      ? '<div class="rp-rating">' + stars + '<span>' + data.rating + ' (' + data.reviewCount + ' Reviews)</span></div>'
      : '';

    const comparePriceHtml = data.comparePrice
      ? '<span class="rp-compare-price">' + data.comparePrice + '</span>'
      : '';

    const discountHtml = data.discountLabel
      ? '<span class="rp-discount-badge">' + data.discountLabel + '</span>'
      : '';

    const featuresHtml = data.features.length > 0
      ? '<div class="rp-features">' + data.features.map(function(f) {
          return '<div class="rp-feature-item"><div class="rp-feature-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1e3a5f" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg></div><span class="rp-feature-label">' + f + '</span></div>';
        }).join('') + '</div>'
      : '';

    const sizesArr = data.sizes ? data.sizes.split(',').map(function(s){ return s.trim(); }).filter(Boolean) : [];
    const sizesHtml = sizesArr.length > 0
      ? '<div class="rp-size-section"><div class="rp-size-label">Select size</div><div class="rp-size-options">' +
        sizesArr.map(function(s, i) {
          return '<button class="rp-size-btn' + (i === 0 ? ' is-active' : '') + '">' + s + '</button>';
        }).join('') +
        '</div></div>'
      : '';

    const highlightLines = data.highlights
      ? data.highlights.split('\n').filter(Boolean).map(function(l){ return '✓ ' + l.trim(); }).join('<br>')
      : '';

    const highlightsHtml = highlightLines
      ? '<div class="rp-description-highlights">' + highlightLines + '</div>'
      : '';

    const descriptionHtml = data.description
      ? '<div class="rp-description"><p class="rp-description-text">' + data.description + '</p>' + highlightsHtml + '</div>'
      : (highlightsHtml ? '<div class="rp-description">' + highlightsHtml + '</div>' : '');

    const categoryHtml = data.productCategory
      ? '<span class="rp-category-tag">' + data.productCategory + '</span>'
      : '';

    const productImageHtml = data.productImage
      ? '<img class="rp-product-image" src="' + data.productImage + '" alt="' + (data.productTitle || '') + '" loading="lazy">'
      : '';

    const addToCartUrl = data.variantId
      ? '/cart/add?id=' + data.variantId + '&quantity=1'
      : '#';

    const viewProductUrl = data.productUrl || '#';
    const isMobile = window.innerWidth <= 768;
    const ctaLabel = isMobile ? 'Shop Now' : 'ADD TO CART';
    const ctaHref  = isMobile ? viewProductUrl : addToCartUrl;
    const ctaIcon  = isMobile ? '' : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>';

    productInner.innerHTML =
      categoryHtml +
      '<div class="rp-product-row">' +
        '<div class="rp-product-info">' +
          '<h3 class="rp-title">' + data.productTitle + '</h3>' +
          (data.productSubtitle ? '<p class="rp-subtitle">' + data.productSubtitle + '</p>' : '') +
          ratingHtml +
          '<div class="rp-price-row">' +
            '<span class="rp-price">' + (data.price || '') + '</span>' +
            comparePriceHtml +
            discountHtml +
          '</div>' +
          '<p class="rp-tax-note">Inclusive of all taxes</p>' +
        '</div>' +
        productImageHtml +
      '</div>' +
      featuresHtml +
      sizesHtml +
      '<div class="rp-tabs">' +
        '<button class="rp-tab-btn is-active" data-tab="description">Description</button>' +
        '<button class="rp-tab-btn" data-tab="ingredients">Ingredients</button>' +
        '<button class="rp-tab-btn" data-tab="how-to-use">How to use</button>' +
        '<button class="rp-tab-btn" data-tab="suitable-for">Suitable for</button>' +
      '</div>' +
      '<div class="rp-tab-content is-active" data-tab-content="description">' + descriptionHtml + '</div>' +
      '<div class="rp-tab-content" data-tab-content="ingredients"></div>' +
      '<div class="rp-tab-content" data-tab-content="how-to-use"></div>' +
      '<div class="rp-tab-content" data-tab-content="suitable-for"></div>' +
      '<div class="rp-actions">' +
        '<a href="' + ctaHref + '" class="rp-add-to-cart">' +
          ctaIcon + ctaLabel +
        '</a>' +
        '<a href="' + viewProductUrl + '" class="rp-view-product">View full product →</a>' +
      '</div>';

    // Tab switching
    productInner.querySelectorAll('.rp-tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        productInner.querySelectorAll('.rp-tab-btn').forEach(function(b){ b.classList.remove('is-active'); });
        productInner.querySelectorAll('.rp-tab-content').forEach(function(c){ c.classList.remove('is-active'); });
        btn.classList.add('is-active');
        const tab = btn.dataset.tab;
        const content = productInner.querySelector('[data-tab-content="' + tab + '"]');
        if (content) content.classList.add('is-active');
      });
    });

    // Size button switching
    productInner.querySelectorAll('.rp-size-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        productInner.querySelectorAll('.rp-size-btn').forEach(function(b){ b.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });
    });
  }

  function closePopup() {
    popup.classList.remove('is-open');
    popup.setAttribute('aria-hidden', 'true');
    popup.setAttribute('inert', '');
    document.body.style.overflow = '';
    video.pause();
    video.src = '';
    isPlaying = false;
    playCenter.classList.remove('is-playing');
  }

  // ── Focused-card: update active class based on which card is nearest the track center ──
  (function() {
    const wrap = document.querySelector('.ossian-reels__track-wrap');
    const track = document.getElementById('reels-track');
    if (!wrap || !track) return;

    const cards = Array.from(track.querySelectorAll('.ossian-reels__card'));

    let isSnapping = false;
    let snapTimer = null;
    let currentActive = -1;

    /* Scroll the wrap so card[index] sits exactly in the horizontal center */
    function scrollToCenter(index, animate) {
      const card = cards[index];
      if (!card) return;
      const target = card.offsetLeft - wrap.offsetWidth / 2 + card.offsetWidth / 2;
      isSnapping = true;
      wrap.scrollTo({ left: Math.max(0, target), behavior: animate ? 'smooth' : 'instant' });
      /* release the snapping flag after the smooth scroll finishes (~500 ms) */
      setTimeout(function() { isSnapping = false; }, 550);
    }

    function setActive(index) {
      if (index === currentActive) return;
      currentActive = index;

      cards.forEach(function(c, i) {
        const isActive = i === index;
        c.classList.toggle('ossian-reels__card--active', isActive);
        c.classList.toggle('ossian-reels__card--near', !isActive && Math.abs(i - index) === 1);
      });
    }

    /* All reel videos autoplay and keep playing regardless of which card is active,
       but only once the section is actually scrolled near the viewport — loading
       every card's video eagerly on page load was costing ~27MB on every pageview. */
    function playAllVideos() {
      cards.forEach(function(c) {
        const vid = c.querySelector('.ossian-reels__card-video');
        if (!vid || vid.src) return;
        vid.src = vid.dataset.src;
        vid.load();
        vid.play().catch(function() { /* autoplay blocked until user interacts with the page */ });
      });
    }

    if ('IntersectionObserver' in window) {
      const lazyObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            playAllVideos();
            lazyObserver.disconnect();
          }
        });
      }, { rootMargin: '300px 0px' });
      lazyObserver.observe(track);
    } else {
      playAllVideos();
    }

    function findCenterCard() {
      const wrapCenter = wrap.scrollLeft + wrap.offsetWidth / 2;
      let closest = 0;
      let minDist = Infinity;
      cards.forEach(function(c, i) {
        const cardCenter = c.offsetLeft + c.offsetWidth / 2;
        const dist = Math.abs(cardCenter - wrapCenter);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      return closest;
    }

    /* While scrolling: update active highlight in real time */
    wrap.addEventListener('scroll', function() {
      if (isSnapping) return;
      setActive(findCenterCard());

      /* After scroll stops, snap the nearest card to exact center */
      clearTimeout(snapTimer);
      snapTimer = setTimeout(function() {
        if (isSnapping) return;
        const idx = findCenterCard();
        setActive(idx);
        scrollToCenter(idx, true);
      }, 120);
    }, { passive: true });

    /* Init: center the 3rd card (index 2) on load */
    function initActive() {
      const targetIdx = Math.min(2, cards.length - 1);
      scrollToCenter(targetIdx, false);
      setTimeout(function() {
        setActive(findCenterCard());
      }, 30);
    }
    setTimeout(initActive, 80);
  })();

  // Open reel on card click
  document.querySelectorAll('[data-open-reel]').forEach(function(el) {
    el.addEventListener('click', function() {
      openReel(parseInt(el.dataset.openReel));
    });
  });

  // Close
  closeBtn.addEventListener('click', closePopup);
  backdrop.addEventListener('click', closePopup);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && popup.classList.contains('is-open')) closePopup();
  });

  // Play/pause
  playCenter.addEventListener('click', function(e) {
    e.stopPropagation();
    if (!video.src) return;
    if (video.paused) {
      video.play();
      placeholder.style.display = 'none';
      isPlaying = true;
      playCenter.classList.add('is-playing');
    } else {
      video.pause();
      isPlaying = false;
      playCenter.classList.remove('is-playing');
    }
  });

  // Mute toggle
  muteBtn.addEventListener('click', function() {
    video.muted = !video.muted;
    muteBtn.querySelector('.icon-unmuted').style.display = video.muted ? 'none' : '';
    muteBtn.querySelector('.icon-muted').style.display = video.muted ? '' : 'none';
  });

  // Progress
  video.addEventListener('timeupdate', function() {
    if (!video.duration) return;
    const pct = (video.currentTime / video.duration) * 100;
    progressFill.style.width = pct + '%';
    progressThumb.style.left = pct + '%';
    timeCurrent.textContent = formatTime(video.currentTime);
  });

  video.addEventListener('loadedmetadata', function() {
    timeTotal.textContent = formatTime(video.duration);
  });

  video.addEventListener('ended', function() {
    isPlaying = false;
    playCenter.classList.remove('is-playing');
  });

  progressBar.addEventListener('click', function(e) {
    if (!video.duration) return;
    const rect = progressBar.getBoundingClientRect();
    const pct = (e.clientX - rect.left) / rect.width;
    video.currentTime = pct * video.duration;
  });

  // Fullscreen
  fullscreenBtn.addEventListener('click', function() {
    const wrap = document.querySelector('.reel-popup__video-wrap');
    if (wrap.requestFullscreen) wrap.requestFullscreen();
  });

  // Share
  shareBtn.addEventListener('click', function() {
    if (navigator.share && currentReel && currentReel.productUrl) {
      navigator.share({ url: window.location.origin + currentReel.productUrl }).catch(function(){});
    }
  });
})();
</script>

