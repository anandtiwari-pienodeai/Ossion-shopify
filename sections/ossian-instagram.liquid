        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        },
        {
          "type": "text",
          "id": "sizes",
          "label": "Size options (comma separated)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Reels",
      "settings": {
        "heading": "OSSION gram",
        "subheading": "Real people. Real results. Real stories",
        "instagram_handle": "ossion.care"
      },
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
