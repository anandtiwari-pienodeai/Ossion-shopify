{{ 'section-ossian-science-results.css' | asset_url | stylesheet_tag }}
{% comment %}
  Section contract.
  "Visible Results" before/after cards: centred intro, then cards with a draggable
  comparison slider (Before / After labels), a title and a short caption. The slider is
  a native range input, so it works with mouse, touch and keyboard.
  @example
  <!-- templates/page.science.json → science_results -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

<section class="oab osr" id="osr-{{ section.id }}" style="--osr-bg: {{ section.settings.background }};">
  <div class="oab-wrap">
    <div class="oab-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oab-eyebrow oab-eyebrow--rules">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ossian-about-heading', text: section.settings.heading, class: 'oab-heading--md' -%}
      {%- if section.settings.text != blank -%}
        <p class="oab-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="osr__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="osr-card" {{ block.shopify_attributes }}>
            <div class="osr-compare" style="--pos: 50%;" data-osr-compare>
              <div class="osr-compare__img osr-compare__img--before">
                {%- if block.settings.before_image != blank -%}
                  {{ block.settings.before_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 33vw, 90vw', alt: block.settings.before_label }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'osr-compare__ph' }}
                {%- endif -%}
              </div>
              <div class="osr-compare__img osr-compare__img--after">
                {%- if block.settings.after_image != blank -%}
                  {{ block.settings.after_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 33vw, 90vw', alt: block.settings.after_label }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'osr-compare__ph osr-compare__ph--after' }}
                {%- endif -%}
              </div>
              <span class="osr-compare__divider" aria-hidden="true">
                <span class="osr-compare__handle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 3 12l6 6M15 6l6 6-6 6"/></svg>
                </span>
              </span>
              {%- if block.settings.before_label != blank -%}<span class="osr-compare__tag osr-compare__tag--before">{{ block.settings.before_label | escape }}</span>{%- endif -%}
              {%- if block.settings.after_label != blank -%}<span class="osr-compare__tag osr-compare__tag--after">{{ block.settings.after_label | escape }}</span>{%- endif -%}
              <input
                class="osr-compare__range"
                type="range"
                min="0"
                max="100"
                value="50"
                aria-label="{{ 'content.ossian_science.compare_label' | t: title: block.settings.title }}"
                data-osr-range
              >
            </div>
            <div class="osr-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="osr-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="osr-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('osr-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('[data-osr-compare]').forEach(function (compare) {
      var range = compare.querySelector('[data-osr-range]');
      if (!range) return;
      var update = function () { compare.style.setProperty('--pos', range.value + '%'); };
      range.addEventListener('input', update);
      update();
    });
  })();
</script>


{% schema %}
{
  "name": "Ossian Science Results",
  "tag": "div",
  "class": "section-ossian-science-results",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Transformations" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent.", "default": "Visible Results. Healthier Hair." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Advanced science for stronger, smoother and more vibrant hair." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Before / after",
      "settings": [
        { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "About 800 × 600 (4:3). Use the same framing as the after image." },
        { "type": "image_picker", "id": "after_image", "label": "After image" },
        { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
        { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
        { "type": "text", "id": "title", "label": "Title", "default": "Reduced Breakage" },
        { "type": "text", "id": "text", "label": "Caption", "default": "Stronger, more resilient hair" }
      ]
    }
  ],
  "presets": [{ "name": "Ossian Science Results" }]
}
{% endschema %}
