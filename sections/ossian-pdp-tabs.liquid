{{ 'section-ossian-pdp-tabs.css' | asset_url | stylesheet_tag }}
{%- liquid
  # Pre-pass: a tab is shown only when it has something to say for this product,
  # so products without the tab metafields don't get empty panels.
  assign tabs_with_content = ''
  for block in section.blocks
    if block.type != 'tab' or block.settings.label == blank
      continue
    endif

    assign tab_value = blank
    assign tab_field = block.settings.metaobject_metafield | strip | remove_first: 'product.metafields.'
    assign tab_parts = tab_field | split: '.'
    if tab_parts[0] != blank and tab_parts[1] != blank
      assign tab_value = product.metafields[tab_parts[0]][tab_parts[1]].value
    endif

    assign tab_has_content = false
    if tab_value != blank or block.settings.content != blank or block.settings.features_list != blank or block.settings.featured_image != blank
      assign tab_has_content = true
    elsif product.description != blank
      if block.settings.use_product_description or block.settings.description_fallback
        assign tab_has_content = true
      endif
    endif

    if tab_has_content
      assign tabs_with_content = tabs_with_content | append: '|' | append: block.id | append: '|'
    endif
  endfor
-%}

{%- if tabs_with_content != blank -%}
<section class="pdp-tabs" id="pdp-tabs-{{ section.id }}">
  <div class="page-width pdp-tabs__inner">

    <div class="pdp-tabs__nav" role="tablist" aria-label="Product information">
      {%- assign nav_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign tab_key = '|' | append: block.id | append: '|' -%}
        {%- if block.type == 'tab' and block.settings.label != blank and tabs_with_content contains tab_key -%}
          {%- assign nav_index = nav_index | plus: 1 -%}
          <button
            class="pdp-tabs__nav-btn{% if nav_index == 1 %} pdp-tabs__nav-btn--active{% endif %}"
            role="tab"
            aria-selected="{% if nav_index == 1 %}true{% else %}false{% endif %}"
            aria-controls="pdp-tab-panel-{{ section.id }}-{{ nav_index }}"
            id="pdp-tab-{{ section.id }}-{{ nav_index }}"
            data-tab-index="{{ nav_index }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- capture check_icon -%}
      <span class="pdp-tabs__feature-check" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1e3a5f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </span>
    {%- endcapture -%}

    {%- assign panel_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign tab_key = '|' | append: block.id | append: '|' -%}
      {%- if block.type == 'tab' and block.settings.label != blank and tabs_with_content contains tab_key -%}
        {%- assign panel_index = panel_index | plus: 1 -%}
        {%- liquid
          # ---- Resolve the product metafield this tab points at ----
          assign mo_mf = nil
          assign mo_field = block.settings.metaobject_metafield | strip
          if mo_field != blank
            assign mo_field = mo_field | remove_first: 'product.metafields.'
            assign mo_parts = mo_field | split: '.'
            assign mo_ns = mo_parts[0]
            assign mo_key = mo_parts[1]
            if mo_ns != blank and mo_key != blank
              assign mo_mf = product.metafields[mo_ns][mo_key]
            endif
          endif

          # The metafield is either one metaobject entry, a list of entries, or a
          # plain value. Trust the declared type, then fall back to shape checks
          # so a tab still renders if the definition is not a reference type.
          assign mo_kind = nil
          assign mo_value = mo_mf.value
          if mo_mf != blank and mo_value != blank
            if mo_mf.type == 'metaobject_reference'
              assign mo_kind = 'entry'
            elsif mo_mf.type == 'list.metaobject_reference'
              assign mo_kind = 'entry_list'
            elsif mo_value.system != blank
              assign mo_kind = 'entry'
            else
              assign mo_kind = 'plain'
            endif
          endif

          # Candidate key lists: the key set in the theme editor wins, then the
          # conventional names. Any setting may hold several comma separated keys.
          assign heading_keys = block.settings.metaobject_label_field | append: ',label,heading,title,name,step_title' | split: ',' | join: ','
          assign body_keys = block.settings.metaobject_body_field | append: ',body,description,content,text,details,caption,summary,copy' | split: ',' | join: ','
          assign list_keys = block.settings.metaobject_list_field | append: ',steps,points,bullets,benefits,features,highlights,instructions' | split: ',' | join: ','
          assign image_keys = block.settings.metaobject_images_field | append: ',image,images,photo,photos,media,gallery' | split: ',' | join: ','
          assign before_keys = block.settings.comparison_before_field | append: ',before,before_image,image_before,before_photo,left_image' | split: ',' | join: ','
          assign after_keys = block.settings.comparison_after_field | append: ',after,after_image,image_after,after_photo,right_image' | split: ',' | join: ','

          assign is_comparison = false
          if block.settings.layout == 'comparison'
            assign is_comparison = true
          endif

          assign show_split = false
          if is_comparison == false and block.settings.featured_image != blank
            assign show_split = true
          endif

          assign use_description = block.settings.use_product_description
          if block.settings.description_fallback and mo_kind == nil and block.settings.content == blank and block.settings.features_list == blank
            assign use_description = true
          endif

          assign has_text = false
          if use_description and product.description != blank
            assign has_text = true
          endif
          if block.settings.content != blank
            assign has_text = true
          endif
          if block.settings.features_list != blank
            assign has_text = true
          endif

          assign before_label = block.settings.before_label | default: 'Before'
          assign after_label = block.settings.after_label | default: 'After'
        -%}
        <div
          class="pdp-tabs__panel{% if panel_index == 1 %} pdp-tabs__panel--active{% endif %}{% if show_split %} pdp-tabs__panel--split{% endif %}"
          role="tabpanel"
          id="pdp-tab-panel-{{ section.id }}-{{ panel_index }}"
          aria-labelledby="pdp-tab-{{ section.id }}-{{ panel_index }}"
          {% if panel_index != 1 %}hidden{% endif %}
        >
          {%- if has_text -%}
            <div class="pdp-tabs__panel-text">
              {%- if use_description and product.description != blank -%}
                <div class="pdp-tabs__rte rte">{{ product.description }}</div>
              {%- elsif block.settings.content != blank -%}
                <div class="pdp-tabs__rte rte">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.features_list != blank -%}
                <ul class="pdp-tabs__features">
                  {%- assign lines = block.settings.features_list | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}
                    {%- assign trimmed = line | strip -%}
                    {%- if trimmed != blank -%}
                      <li class="pdp-tabs__feature-item">{{ check_icon }}{{ trimmed }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- case mo_kind -%}
            {%- when 'entry' -%}
              {%- render 'ossian-pdp-tab-metaobject',
                entry: mo_value,
                layout: block.settings.layout,
                heading_keys: heading_keys,
                body_keys: body_keys,
                list_keys: list_keys,
                image_keys: image_keys,
                before_keys: before_keys,
                after_keys: after_keys,
                images_per_row: block.settings.metaobject_images_per_row,
                before_label: before_label,
                after_label: after_label,
                check_icon: check_icon
              -%}
            {%- when 'entry_list' -%}
              {%- for mo_entry in mo_value -%}
                {%- render 'ossian-pdp-tab-metaobject',
                  entry: mo_entry,
                  layout: block.settings.layout,
                  heading_keys: heading_keys,
                  body_keys: body_keys,
                  list_keys: list_keys,
                  image_keys: image_keys,
                  before_keys: before_keys,
                  after_keys: after_keys,
                  images_per_row: block.settings.metaobject_images_per_row,
                  before_label: before_label,
                  after_label: after_label,
                  check_icon: check_icon
                -%}
              {%- endfor -%}
            {%- when 'plain' -%}
              {%- comment -%} The metafield is a value, not a metaobject reference. {%- endcomment -%}
              <div class="pdp-tabs__entry">
                {%- if mo_mf.type == 'rich_text_field' -%}
                  <div class="pdp-tabs__rte rte">{{ mo_mf | metafield_tag }}</div>
                {%- elsif mo_mf.type == 'multi_line_text_field' -%}
                  <div class="pdp-tabs__rte rte">{{ mo_value | newline_to_br }}</div>
                {%- elsif mo_mf.type == 'single_line_text_field' -%}
                  <div class="pdp-tabs__rte rte"><p>{{ mo_value }}</p></div>
                {%- elsif mo_mf.type == 'list.single_line_text_field' or mo_mf.type == 'list.multi_line_text_field' -%}
                  <ul class="pdp-tabs__features">
                    {%- for item in mo_value -%}
                      {%- assign trimmed = item | strip -%}
                      {%- if trimmed != blank -%}
                        <li class="pdp-tabs__feature-item">{{ check_icon }}{{ trimmed }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- elsif mo_mf.type contains 'file_reference' -%}
                  {%- assign mo_cols = block.settings.metaobject_images_per_row | default: 3 -%}
                  <ul class="pdp-tabs__meta-images" style="--pdp-meta-cols: {{ mo_cols }};">
                    {%- if mo_mf.type contains 'list.' -%}
                      {%- for mo_image in mo_value -%}
                        {%- assign mo_img = mo_image.preview_image | default: mo_image -%}
                        {%- if mo_img != blank -%}
                          <li class="pdp-tabs__meta-image">
                            {{ mo_img | image_url: width: 800 | image_tag: class: 'pdp-tabs__meta-img', loading: 'lazy', widths: '200,300,400,600,800', alt: mo_img.alt }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- assign mo_img = mo_value.preview_image | default: mo_value -%}
                      <li class="pdp-tabs__meta-image">
                        {{ mo_img | image_url: width: 800 | image_tag: class: 'pdp-tabs__meta-img', loading: 'lazy', widths: '200,300,400,600,800', alt: mo_img.alt }}
                      </li>
                    {%- endif -%}
                  </ul>
                {%- else -%}
                  <div class="pdp-tabs__rte rte">{{ mo_mf | metafield_tag }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}

          {%- if show_split -%}
            {%- assign img_alt = block.settings.image_heading | default: '' -%}
            <div class="pdp-tabs__panel-image">
              {{ block.settings.featured_image | image_url: width: 900 | image_tag: class: 'pdp-tabs__panel-img', loading: 'lazy', alt: img_alt }}
              <div class="pdp-tabs__panel-overlay">
                {%- if block.settings.image_heading != blank -%}
                  <p class="pdp-tabs__panel-overlay-heading">{{ block.settings.image_heading }}</p>
                {%- endif -%}
                {%- if block.settings.image_cta_text != blank -%}
                  <a href="{{ block.settings.image_cta_url | default: '#' }}" class="pdp-tabs__panel-overlay-btn">
                    {{ block.settings.image_cta_text }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{%- if section.settings.show_reviews -%}
  {%- assign p5 = section.settings.five_star_pct | default: 90 -%}
  {%- assign p4 = section.settings.four_star_pct | default: 5 -%}
  {%- assign p3 = section.settings.three_star_pct | default: 2 -%}
  {%- assign p2 = section.settings.two_star_pct | default: 1 -%}
  {%- assign p1 = section.settings.one_star_pct | default: 2 -%}
  {%- assign rating_rounded = section.settings.aggregate_rating | default: '4.9' | times: 1 | round -%}
<section class="pdp-reviews" id="pdp-reviews-{{ section.id }}">
  <div class="page-width pdp-reviews__inner">

    <div class="pdp-reviews__header">
      <h2 class="pdp-reviews__title">{{ section.settings.reviews_heading | default: 'Customer Reviews' }}</h2>
      {%- if section.settings.reviews_link != blank -%}
        <a href="{{ section.settings.reviews_link }}" class="pdp-reviews__view-all">
          View all reviews
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="pdp-reviews__summary">
      <div class="pdp-reviews__agg">
        <span class="pdp-reviews__agg-num">{{ section.settings.aggregate_rating | default: '4.9' }}</span>
        <div class="pdp-reviews__agg-stars">
          {%- for i in (1..5) -%}
            {%- if i <= rating_rounded -%}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#f5a623" stroke="#f5a623" stroke-width="0.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- else -%}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <span class="pdp-reviews__agg-label">Based on {{ section.settings.review_count | default: 240 }} reviews</span>
      </div>

      <div class="pdp-reviews__breakdown">
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">5★</span>
          <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width: {{ p5 }}%"></div></div>
          <span class="pdp-reviews__bar-pct">{{ p5 }}%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">4★</span>
          <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width: {{ p4 }}%"></div></div>
          <span class="pdp-reviews__bar-pct">{{ p4 }}%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">3★</span>
          <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width: {{ p3 }}%"></div></div>
          <span class="pdp-reviews__bar-pct">{{ p3 }}%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">2★</span>
          <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width: {{ p2 }}%"></div></div>
          <span class="pdp-reviews__bar-pct">{{ p2 }}%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">1★</span>
          <div class="pdp-reviews__bar-track"><div class="pdp-reviews__bar-fill" style="width: {{ p1 }}%"></div></div>
          <span class="pdp-reviews__bar-pct">{{ p1 }}%</span>
        </div>
      </div>
    </div>

    {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
    {%- if review_blocks.size > 0 -%}
      <div class="pdp-reviews__cards">
        {%- for block in review_blocks -%}
          <div class="pdp-reviews__card" {{ block.shopify_attributes }}>
            <div class="pdp-reviews__card-top">
              <div class="pdp-reviews__card-stars">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="#f5a623" stroke="#f5a623" stroke-width="0.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- else -%}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.reviewer_name != blank -%}
                <span class="pdp-reviews__card-name">{{ block.settings.reviewer_name }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.review_title != blank -%}
              <p class="pdp-reviews__card-title">{{ block.settings.review_title }}</p>
            {%- endif -%}
            {%- if block.settings.review_text != blank -%}
              <p class="pdp-reviews__card-text">{{ block.settings.review_text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

<script>
(function() {
  var sections = document.querySelectorAll('[id^="pdp-tabs-"]');
  sections.forEach(function(section) {
    var btns = section.querySelectorAll('.pdp-tabs__nav-btn');
    var panels = section.querySelectorAll('.pdp-tabs__panel');
    btns.forEach(function(btn, i) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) { b.classList.remove('pdp-tabs__nav-btn--active'); b.setAttribute('aria-selected', 'false'); });
        panels.forEach(function(p) { p.classList.remove('pdp-tabs__panel--active'); p.hidden = true; });
        btn.classList.add('pdp-tabs__nav-btn--active');
        btn.setAttribute('aria-selected', 'true');
        panels[i].classList.add('pdp-tabs__panel--active');
        panels[i].hidden = false;
      });
    });
  });

  var compares = document.querySelectorAll('[data-pdp-compare]');
  compares.forEach(function(compare) {
    var range = compare.querySelector('.pdp-compare__range');
    if (!range) return;
    var sync = function() {
      compare.style.setProperty('--pdp-compare-pos', range.value + '%');
    };
    range.addEventListener('input', sync);
    sync();
  });
})();
</script>


{% schema %}
{
  "name": "PDP Info Tabs",
  "tag": "section",
  "class": "ossian-pdp-tabs-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews section",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "Customer Reviews"
    },
    {
      "type": "url",
      "id": "reviews_link",
      "label": "View all reviews URL"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate rating",
      "default": "4.9",
      "info": "e.g. 4.9"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Total review count",
      "default": 240
    },
    {
      "type": "number",
      "id": "five_star_pct",
      "label": "5-star percentage",
      "default": 90
    },
    {
      "type": "number",
      "id": "four_star_pct",
      "label": "4-star percentage",
      "default": 5
    },
    {
      "type": "number",
      "id": "three_star_pct",
      "label": "3-star percentage",
      "default": 2
    },
    {
      "type": "number",
      "id": "two_star_pct",
      "label": "2-star percentage",
      "default": 1
    },
    {
      "type": "number",
      "id": "one_star_pct",
      "label": "1-star percentage",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Description"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Tab layout",
          "options": [
            {
              "value": "text",
              "label": "Text + image grid"
            },
            {
              "value": "comparison",
              "label": "Before / after comparison"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use product description",
          "default": false,
          "info": "Pulls content from the product description in Shopify admin"
        },
        {
          "type": "checkbox",
          "id": "description_fallback",
          "label": "Use product description when empty",
          "default": false,
          "info": "Shows the product description when this tab's metafield and content are empty"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "info": "Used if 'Use product description' is off. Leave empty when the content comes from a metaobject."
        },
        {
          "type": "textarea",
          "id": "features_list",
          "label": "Feature checklist (one per line)",
          "info": "Renders as checkmark bullet list below the content"
        },
        {
          "type": "header",
          "content": "Metaobject content"
        },
        {
          "type": "text",
          "id": "metaobject_metafield",
          "label": "Product metafield",
          "info": "Type the namespace.key by hand, e.g. custom.ingredients — do not use the dynamic source picker here"
        },
        {
          "type": "text",
          "id": "metaobject_label_field",
          "label": "Heading field key",
          "default": "label",
          "info": "Text field rendered as the centred heading. Accepts several comma separated keys, tried in order."
        },
        {
          "type": "text",
          "id": "metaobject_body_field",
          "label": "Body field key",
          "info": "Rich text or multi-line text field rendered as the tab copy, e.g. description"
        },
        {
          "type": "text",
          "id": "metaobject_list_field",
          "label": "Checklist field key",
          "info": "List of text values rendered as a checkmark list, e.g. steps"
        },
        {
          "type": "text",
          "id": "metaobject_images_field",
          "label": "Images field key",
          "default": "image",
          "info": "Metaobject field holding the file / image list"
        },
        {
          "type": "range",
          "id": "metaobject_images_per_row",
          "label": "Images per row (desktop)",
          "min": 2,
          "max": 6,
          "step": 1,
          "default": 3,
          "visible_if": "{{ block.settings.layout != 'comparison' }}"
        },
        {
          "type": "header",
          "content": "Before / after comparison",
          "visible_if": "{{ block.settings.layout == 'comparison' }}"
        },
        {
          "type": "text",
          "id": "comparison_before_field",
          "label": "Before image field key",
          "info": "Metaobject file field for the before image. Falls back to the first two images of the images field.",
          "visible_if": "{{ block.settings.layout == 'comparison' }}"
