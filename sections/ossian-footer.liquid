<footer class="ossian-footer" role="contentinfo">
  <div class="ossian-footer__main">
    <div class="page-width">
      <div class="ossian-footer__grid">

        {%- comment -%} Column 1 – Brand {%- endcomment -%}
        <div class="ossian-footer__brand">
          <a href="{{ routes.root_url }}" class="ossian-footer__logo-link" aria-label="{{ shop.name }}">
            <p class="ossian-footer__logo-name">OSSION</p>
            <p class="ossian-footer__logo-tagline">PROFESSIONAL</p>
          </a>
          {%- if section.settings.description != blank -%}
            <p class="ossian-footer__desc">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} Column 2 – Quick Links {%- endcomment -%}
        <div class="ossian-footer__col">
          <h5 class="ossian-footer__col-heading">{{ section.settings.quick_links_heading }}</h5>
          <ul class="ossian-footer__list" role="list">
            {%- if section.settings.link_1_label != blank -%}
              <li>
                <a href="{{ section.settings.link_1_url | default: '#' }}" class="ossian-footer__link">
                  {{- section.settings.link_1_label -}}
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.link_2_label != blank -%}
              <li>
                <a href="{{ section.settings.link_2_url | default: '#' }}" class="ossian-footer__link">
                  {{- section.settings.link_2_label -}}
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.link_3_label != blank -%}
              <li>
                <a href="{{ section.settings.link_3_url | default: '#' }}" class="ossian-footer__link">
                  {{- section.settings.link_3_label -}}
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.link_4_label != blank -%}
              <li>
                <a href="{{ section.settings.link_4_url | default: '#' }}" class="ossian-footer__link">
                  {{- section.settings.link_4_label -}}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>

        {%- comment -%} Column 3 – Our Values {%- endcomment -%}
        <div class="ossian-footer__col">
          <h5 class="ossian-footer__col-heading">{{ section.settings.values_heading }}</h5>
          <ul class="ossian-footer__list ossian-footer__list--values" role="list">
            {%- assign values = '' | split: '' -%}
            {%- if section.settings.value_1 != blank -%}
              <li>
                <span class="ossian-footer__value-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="7.25" stroke="#4ade80" stroke-width="1.5"/><polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ section.settings.value_1 }}
              </li>
            {%- endif -%}
            {%- if section.settings.value_2 != blank -%}
              <li>
                <span class="ossian-footer__value-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="7.25" stroke="#4ade80" stroke-width="1.5"/><polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ section.settings.value_2 }}
              </li>
            {%- endif -%}
            {%- if section.settings.value_3 != blank -%}
              <li>
                <span class="ossian-footer__value-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="7.25" stroke="#4ade80" stroke-width="1.5"/><polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ section.settings.value_3 }}
              </li>
            {%- endif -%}
            {%- if section.settings.value_4 != blank -%}
              <li>
                <span class="ossian-footer__value-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8" cy="8" r="7.25" stroke="#4ade80" stroke-width="1.5"/><polyline points="4.5,8.5 7,11 11.5,5.5" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                {{ section.settings.value_4 }}
              </li>
            {%- endif -%}
          </ul>
        </div>

        {%- comment -%} Column 4 – Contact {%- endcomment -%}
        <div class="ossian-footer__col">
          <h5 class="ossian-footer__col-heading">{{ section.settings.contact_heading }}</h5>
          {%- if section.settings.contact_address != blank -%}
            <address class="ossian-footer__address">
              {{- section.settings.contact_address | newline_to_br -}}
            </address>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>

  <div class="ossian-footer__bottom">
    <div class="page-width">
      <p class="ossian-footer__copyright">
        {{- section.settings.copyright_text -}}
      </p>
    </div>
  </div>
</footer>

{% stylesheet %}
  /* ─── CSS custom properties scoped to the footer ─── */
  .ossian-footer {
    --footer-pad-x: clamp(20px, 5vw, 64px);
    --footer-pad-y-top: 72px;
    --footer-pad-y-bottom: 64px;
    --footer-bar-pad-y: 28px;
    --footer-col-gap: 48px;
    --footer-row-gap: 48px;

    background: #1e3a5f;
    color: #fff;
  }

  /* ─── Shared inner spacing: every page-width inside the footer
        gets the same horizontal breathing room ─── */
  .ossian-footer .page-width {
    padding-inline: var(--footer-pad-x);
  }

  /* ─── Main grid area ─── */
  .ossian-footer__main {
    padding-top: var(--footer-pad-y-top);
    padding-bottom: var(--footer-pad-y-bottom);
  }

  .ossian-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    column-gap: var(--footer-col-gap);
    row-gap: var(--footer-row-gap);
    align-items: start;
  }

  /* ─── Tablet (640 – 989 px):
        brand spans the full row, 3 equal columns beneath ─── */
  @media screen and (max-width: 989px) {
    .ossian-footer {
      --footer-pad-y-top: 56px;
      --footer-pad-y-bottom: 48px;
      --footer-col-gap: 32px;
      --footer-row-gap: 40px;
    }

    .ossian-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ossian-footer__brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 40px;
      align-items: start;
    }

    .ossian-footer__logo-link {
      margin-bottom: 0;
    }

    .ossian-footer__desc {
      max-width: 100%;
      padding-top: 6px;
    }
  }

  /* ─── Mobile (< 640 px): single column ─── */
  @media screen and (max-width: 639px) {
    .ossian-footer {
      --footer-pad-y-top: 48px;
      --footer-pad-y-bottom: 40px;
      --footer-row-gap: 32px;
      --footer-bar-pad-y: 20px;
    }

    .ossian-footer__grid {
      grid-template-columns: 1fr;
    }

    /* Reset the tablet side-by-side brand layout */
    .ossian-footer__brand {
      grid-column: auto;
      display: flex;
      flex-direction: column;
    }

    .ossian-footer__logo-link {
      margin-bottom: 16px;
    }

    .ossian-footer__desc {
      max-width: 100%;
    }
  }

  /* ─── Brand column ─── */
  .ossian-footer__logo-link {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .ossian-footer__logo-name {
    font-size: 1.875rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.1em;
    margin: 0;
    line-height: 1.1;
  }

  .ossian-footer__logo-tagline {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #bedbff;
    letter-spacing: 0.15em;
    margin: 4px 0 0;
    line-height: 1;
  }

  .ossian-footer__desc {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    margin: 0;
    max-width: 280px;
  }

  /* ─── Shared column styles ─── */
  .ossian-footer__col-heading {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 20px;
    letter-spacing: 0.01em;
  }

  .ossian-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ─── Quick links ─── */
  .ossian-footer__link {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-block;
  }

  .ossian-footer__link:hover,
  .ossian-footer__link:focus-visible {
    color: #fff;
  }

  /* ─── Values list ─── */
  .ossian-footer__list--values li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .ossian-footer__value-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  /* ─── Contact ─── */
  .ossian-footer__address {
    font-style: normal;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.75;
  }

  /* ─── Bottom copyright bar ─── */
  .ossian-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: var(--footer-bar-pad-y);
    padding-bottom: var(--footer-bar-pad-y);
  }

  .ossian-footer__copyright {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 639px) {
    .ossian-footer__copyright {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

