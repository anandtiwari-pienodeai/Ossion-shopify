{% comment %}
  Section contract.
  Site footer: brand column (logo, description, contact rows, social icons),
  Shop / Discover / Help & Policies link columns, a "Need Help?" contact
  column, and a bottom bar with copyright, legal links and accepted payment
  icons. On mobile the four columns collapse into native <details>
  accordions; on desktop they are always expanded.
  @example
  <!-- sections/footer-group.json → ossian_footer_main -->
{% endcomment %}

{%- liquid
  assign shop_links_manual = '1,2,3,4,5,6' | split: ','
  assign discover_links_manual = '1,2,3,4' | split: ','
  assign help_links_manual = '1,2,3,4,5,6' | split: ','
-%}

<footer class="ofo" id="ofo-{{ section.id }}">
  <div class="ofo__wrap ofo__main">
    {%- comment -%}── Brand ───────────────────────────────────────{%- endcomment -%}
    <div class="ofo__brand">
      <a class="ofo__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: class: 'ofo__logo-img', loading: 'lazy', widths: '200,300,400', sizes: '200px', alt: shop.name
          }}
        {%- else -%}
          <span class="ofo__logo-text" aria-hidden="true">
            <span class="ofo__logo-name">{{ section.settings.brand_name | default: shop.name | escape }}<sup>®</sup></span>
            {%- if section.settings.brand_tagline != blank -%}
              <span class="ofo__logo-sub">{{ section.settings.brand_tagline | escape }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </a>

      {%- if section.settings.brand_description != blank -%}
        <p class="ofo__desc">{{ section.settings.brand_description | escape }}</p>
      {%- endif -%}

      <ul class="ofo__contact" role="list">
        {%- if section.settings.address != blank -%}
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 0 12 6.5a2.5 2.5 0 0 0 0 5Z"/></svg>
            <span>{{ section.settings.address | escape }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone | escape }}</a>
          </li>
        {%- endif -%}
      </ul>

      {%- if section.settings.instagram != blank or section.settings.facebook != blank or section.settings.youtube != blank or section.settings.pinterest != blank or section.settings.linkedin != blank -%}
        <ul class="ofo__social" role="list">
          {%- if section.settings.instagram != blank -%}
            <li><a class="ofo__social-btn" href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a></li>
          {%- endif -%}
          {%- if section.settings.facebook != blank -%}
            <li><a class="ofo__social-btn" href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4A20 20 0 0 0 14.4 4.3c-2.2 0-3.7 1.3-3.7 3.8v2.4H8.2v3h2.5V21h2.8Z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if section.settings.youtube != blank -%}
            <li><a class="ofo__social-btn" href="{{ section.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if section.settings.pinterest != blank -%}
            <li><a class="ofo__social-btn" href="{{ section.settings.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2Z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if section.settings.linkedin != blank -%}
            <li><a class="ofo__social-btn" href="{{ section.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.9 8.8H3.7V20h3.2V8.8ZM5.3 3.8a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.3 13.6c0-3-1.6-4.9-4.2-4.9a3.6 3.6 0 0 0-3.2 1.7V8.8H9.8V20H13v-5.9c0-1.6.6-2.7 2-2.7 1.4 0 1.9 1.1 1.9 2.7V20h3.3v-6.4Z"/></svg>
            </a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%}── Link columns ────────────────────────────────{%- endcomment -%}
    <div class="ofo__cols">
      {%- comment -%} Shop {%- endcomment -%}
      <details class="ofo__col" open data-ofo-col>
        <summary class="ofo__col-head">
          <span class="ofo__col-title">{{ section.settings.shop_heading | escape }}</span>
          <svg class="ofo__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="ofo__links" role="list">
          {%- assign shop_menu = section.settings.shop_menu -%}
          {%- if shop_menu != blank and shop_menu.links.size > 0 -%}
            {%- for link in shop_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for n in shop_links_manual -%}
              {%- assign label_key = 'shop_link_' | append: n | append: '_label' -%}
              {%- assign url_key = 'shop_link_' | append: n | append: '_url' -%}
              {%- if section.settings[label_key] != blank -%}
                <li><a href="{{ section.settings[url_key] | default: routes.all_products_collection_url }}">{{ section.settings[label_key] | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </details>

      {%- comment -%} Discover {%- endcomment -%}
      <details class="ofo__col" open data-ofo-col>
        <summary class="ofo__col-head">
          <span class="ofo__col-title">{{ section.settings.discover_heading | escape }}</span>
          <svg class="ofo__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="ofo__links" role="list">
          {%- assign discover_menu = section.settings.discover_menu -%}
          {%- if discover_menu != blank and discover_menu.links.size > 0 -%}
            {%- for link in discover_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for n in discover_links_manual -%}
              {%- assign label_key = 'discover_link_' | append: n | append: '_label' -%}
              {%- assign url_key = 'discover_link_' | append: n | append: '_url' -%}
              {%- if section.settings[label_key] != blank -%}
                <li><a href="{{ section.settings[url_key] | default: routes.root_url }}">{{ section.settings[label_key] | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </details>

      {%- comment -%} Help & Policies {%- endcomment -%}
      <details class="ofo__col" open data-ofo-col>
        <summary class="ofo__col-head">
          <span class="ofo__col-title">{{ section.settings.help_heading | escape }}</span>
          <svg class="ofo__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="ofo__links" role="list">
          {%- assign help_menu = section.settings.help_menu -%}
          {%- if help_menu != blank and help_menu.links.size > 0 -%}
            {%- for link in help_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- for n in help_links_manual -%}
              {%- assign label_key = 'help_link_' | append: n | append: '_label' -%}
              {%- assign url_key = 'help_link_' | append: n | append: '_url' -%}
              {%- if section.settings[label_key] != blank -%}
                <li><a href="{{ section.settings[url_key] | default: routes.root_url }}">{{ section.settings[label_key] | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </details>

      {%- comment -%} Need help {%- endcomment -%}
      <details class="ofo__col ofo__col--help" open data-ofo-col>
        <summary class="ofo__col-head">
          <span class="ofo__col-title">{{ section.settings.support_heading | escape }}</span>
          <svg class="ofo__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="ofo__support">
          {%- if section.settings.support_text != blank -%}
            <p class="ofo__support-text">{{ section.settings.support_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.support_button_label != blank -%}
            <a class="ofo__support-btn" href="{{ section.settings.support_button_link | default: '/pages/contact' }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5Z"/></svg>
              {{ section.settings.support_button_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>
      </details>
    </div>
  </div>

  {%- comment -%}── Bottom bar ────────────────────────────────────{%- endcomment -%}
  <div class="ofo__bottom">
    <div class="ofo__wrap ofo__bottom-inner">
      <p class="ofo__copy">{{ section.settings.copyright_text | escape }}</p>

      {%- if section.settings.bottom_link_1_label != blank or section.settings.bottom_link_2_label != blank or section.settings.bottom_link_3_label != blank -%}
        <ul class="ofo__legal" role="list">
          {%- for n in (1..3) -%}
            {%- assign label_key = 'bottom_link_' | append: n | append: '_label' -%}
            {%- assign url_key = 'bottom_link_' | append: n | append: '_url' -%}
            {%- if section.settings[label_key] != blank -%}
              <li><a href="{{ section.settings[url_key] | default: routes.root_url }}">{{ section.settings[label_key] | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- liquid
        # Store's enabled methods first; the fallback list covers stores without payments set up yet
        assign pay_types = shop.enabled_payment_types
        if pay_types.size == 0 and section.settings.payment_fallback != blank
          assign pay_types = section.settings.payment_fallback | remove: ' ' | split: ','
        endif
      -%}
      {%- if section.settings.show_payment_icons and pay_types.size > 0 -%}
        <div class="ofo__pay">
          {%- if section.settings.payment_label != blank -%}
            <span class="ofo__pay-label">{{ section.settings.payment_label | escape }}</span>
          {%- endif -%}
          <ul class="ofo__pay-list" role="list">
            {%- for type in pay_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'ofo__pay-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function () {
    var root = document.getElementById('ofo-{{ section.id }}');
    if (!root) return;
    var cols = root.querySelectorAll('[data-ofo-col]');
    var mq = window.matchMedia('(max-width: 749px)');
    /* Accordions on mobile (collapsed), always open on larger screens */
    function sync() {
      cols.forEach(function (col) {
        if (mq.matches) col.removeAttribute('open');
        else col.setAttribute('open', '');
      });
    }
    sync();
    if (mq.addEventListener) mq.addEventListener('change', sync);
    root.addEventListener('click', function (event) {
      var summary = event.target.closest('.ofo__col-head');
      if (summary && !mq.matches) event.preventDefault();
    });
  })();
</script>

{% stylesheet %}
.ofo {
  --ofo-bg: #0f1d45;
  --ofo-text: rgba(255, 255, 255, 0.82);
  --ofo-muted: rgba(255, 255, 255, 0.68);
  --ofo-line: rgba(255, 255, 255, 0.14);
  background: var(--ofo-bg);
  color: var(--ofo-text);
  font-size: 0.95rem;
  line-height: 1.6;
}

.ofo a { color: inherit; text-decoration: none; }
.ofo a:hover { color: #fff; }
.ofo a:focus-visible,
.ofo summary:focus-visible { outline: 2px solid #7fb0ff; outline-offset: 3px; border-radius: 4px; }

.ofo__wrap {
  width: 100%;
  max-width: 1320px;
  margin-inline: auto;
  padding-inline: 48px;
}

/* Main grid */
.ofo__main {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 3fr);
  gap: 48px;
  padding-block: 44px 36px;
}

/* Brand */
.ofo__brand { min-width: 0; }

.ofo__logo { display: inline-block; margin-bottom: 14px; }
.ofo__logo-img { display: block; width: 190px; max-width: 100%; height: auto; }

.ofo__logo-text {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.ofo__logo-name {
  font-size: 2.3rem;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.01em;
}

.ofo__logo-name sup { font-size: 0.35em; font-weight: 600; vertical-align: top; }

.ofo__logo-sub {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.3em;
}

.ofo__logo-sub::before,
.ofo__logo-sub::after {
  content: '';
  width: 20px;
  height: 1px;
  background: currentColor;
}

.ofo__desc {
  margin: 0 0 18px;
  max-width: 36ch;
  color: var(--ofo-text);
}

.ofo__contact {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0 0 22px;
  padding: 0;
  list-style: none;
}

.ofo__contact li {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  overflow-wrap: anywhere;
}

.ofo__contact svg { width: 18px; height: 18px; flex-shrink: 0; color: #fff; }

.ofo__social {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ofo__social-btn {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  transition: background 0.2s ease;
}

.ofo__social-btn svg { width: 18px; height: 18px; }
.ofo__social-btn:hover { background: rgba(255, 255, 255, 0.18); }

/* Columns */
.ofo__cols {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 1.3fr);
  gap: 32px;
  min-width: 0;
}

.ofo__col { min-width: 0; }

.ofo__col-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  list-style: none;
  cursor: default;
}

.ofo__col-head::-webkit-details-marker { display: none; }

.ofo__col-title {
  position: relative;
  display: block;
  padding-bottom: 14px;
  margin-bottom: 22px;
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
}

/* Short underline under each column title */
.ofo__col-title::after {
  content: '';
  position: absolute;
  inset-inline-start: 0;
  bottom: 0;
  width: 44px;
  height: 2px;
  background: #fff;
}

.ofo__caret { display: none; width: 18px; height: 18px; color: #fff; }

.ofo__links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ofo__links a { color: var(--ofo-text); }
.ofo__links a:hover { color: #fff; }

.ofo__support-text { margin: 0 0 18px; max-width: 34ch; color: var(--ofo-text); }

.ofo__support-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 52px;
  padding: 0 28px;
  border: 1.5px solid rgba(255, 255, 255, 0.85);
  border-radius: 10px;
  color: #fff;
  font-weight: 700;
  transition: background 0.2s ease, color 0.2s ease;
}

.ofo__support-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
.ofo .ofo__support-btn:hover { background: #fff; color: var(--ofo-bg); }
[dir='rtl'] .ofo__support-btn svg:last-child { transform: scaleX(-1); }

/* Bottom bar */
.ofo__bottom { border-top: 1px solid var(--ofo-line); }

.ofo__bottom-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px 0;
  padding-block: 20px;
}

.ofo__copy { margin: 0; color: #fff; }

.ofo__legal {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ofo__legal li { display: flex; align-items: center; }

.ofo__legal li::before {
  content: '';
  width: 1px;
  height: 18px;
  margin-inline: 20px;
  background: rgba(255, 255, 255, 0.35);
}

.ofo__legal a { color: var(--ofo-muted); }

.ofo__pay {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px 22px;
  margin-inline-start: auto;
}

.ofo__pay-label { color: #fff; }

.ofo__pay-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ofo__pay-icon {
  display: block;
  width: 50px;
  height: auto;
  border-radius: 4px;
}

/* Tablet */
@media (max-width: 1099px) {
  .ofo__main { grid-template-columns: minmax(0, 1fr); gap: 36px; }
}

@media (max-width: 989px) {
  .ofo__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ofo__pay { margin-inline-start: 0; width: 100%; }
}

/* Mobile: accordions + centred bottom bar */
@media (max-width: 749px) {
  .ofo__wrap { padding-inline: 20px; }
  .ofo__main { gap: 22px; padding-block: 28px 0; }

  .ofo__logo-name { font-size: 2rem; }
  .ofo__desc { margin-bottom: 14px; font-size: 0.92rem; }
  .ofo__contact { gap: 12px; margin-bottom: 18px; }
  .ofo__social { gap: 14px; }

  .ofo__cols {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    border-top: 1px solid var(--ofo-line);
  }

  .ofo__col { border-bottom: 1px solid var(--ofo-line); }

  .ofo__col-head {
    min-height: 52px;
    cursor: pointer;
  }

  .ofo__col-title {
    padding: 0;
    margin: 0;
    font-size: 1.05rem;
  }

  .ofo__col-title::after { display: none; }
  .ofo__caret { display: block; transition: transform 0.2s ease; }
  .ofo__col[open] .ofo__caret { transform: rotate(180deg); }

  .ofo__links,
  .ofo__support { padding: 2px 0 18px; }

  .ofo__bottom { border-top: 0; }

  .ofo__bottom-inner {
    flex-direction: column;
    gap: 18px;
    padding-block: 22px 26px;
    text-align: center;
  }

  /* Visual order on mobile: payments, legal links, copyright */
  .ofo__pay { order: 1; flex-direction: column; justify-content: center; gap: 10px; }
  .ofo__pay-list { justify-content: center; }
  .ofo__legal { order: 2; justify-content: center; }
  .ofo__copy { order: 3; font-size: 0.88rem; color: var(--ofo-text); }

  .ofo__legal li:first-child::before { display: none; }
  .ofo__legal li::before { margin-inline: 14px; height: 14px; }
  .ofo__legal a { font-size: 0.88rem; }
  .ofo__pay-icon { width: 46px; }
}

@media (prefers-reduced-motion: reduce) {
  .ofo__social-btn,
  .ofo__support-btn,
  .ofo__caret { transition: none; }
}
{% endstylesheet %}

