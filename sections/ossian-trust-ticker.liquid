{% comment %}
  Section contract.
  Row of trust markers, each labeled Skin or Hair. Product pages show only the markers
  matching the product; every other page shows all of them. A product is matched by a
  skin or hair tag first, then by its product type, and shows all markers if neither matches.
  The markers scroll as a continuous carousel at every width and pause on hover.
  @example
  <!-- Add "Trust Ticker" to a template, then choose Skin or Hair on each badge -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign trust_category = ''

  if template.name == 'product' and product
    for tag in product.tags
      assign tag_handle = tag | handleize
      if tag_handle == 'skin' or tag_handle == 'skin-care'
        assign trust_category = 'skin'
        break
      elsif tag_handle == 'hair' or tag_handle == 'hair-care'
        assign trust_category = 'hair'
        break
      endif
    endfor

    assign product_type = product.type | strip | downcase
    if trust_category == blank and product_type != blank
      assign skin_types = s.skin_product_types | downcase | split: ','
      for skin_type in skin_types
        assign skin_type_name = skin_type | strip
        if skin_type_name == product_type
          assign trust_category = 'skin'
        endif
      endfor

      assign hair_types = s.hair_product_types | downcase | split: ','
      for hair_type in hair_types
        assign hair_type_name = hair_type | strip
        if hair_type_name == product_type
          assign trust_category = 'hair'
        endif
      endfor
    endif
  endif

  assign visible_count = 0
  for block in section.blocks
    if trust_category == blank or block.settings.category == trust_category
      assign visible_count = visible_count | plus: 1
    endif
  endfor

  # Each looped set repeats its markers until it is wider than large screens, so the
  # carousel never shows a gap. The duration scales with that count to hold the same pace.
  if visible_count > 0
    assign repeat_count = 16.0 | divided_by: visible_count | ceil
    assign ticker_duration = visible_count | times: repeat_count | times: s.scroll_speed | divided_by: 8.0
  endif
-%}

{%- if visible_count > 0 -%}
  <div
    class="trust-ticker"
    style="
      --ticker-speed: {{ ticker_duration }}s;
      --trust-color: {{ s.text_color }};
      padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
      background: {{ s.background_color }};
    "
  >
    <div class="trust-ticker__track-outer">
      <div class="trust-ticker__track">
        {%- comment -%} The second pass is a hidden copy that makes the carousel loop seamlessly {%- endcomment -%}
        {%- for pass in (1..2) -%}
          <div class="trust-ticker__set"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {%- for repeat in (1..repeat_count) -%}
              {%- for block in section.blocks -%}
                {%- if trust_category == blank or block.settings.category == trust_category -%}
                  <div
                    class="trust-ticker__item"
                    {% if pass == 1 and repeat == 1 %}
                      {{ block.shopify_attributes }}
                    {% else %}
                      aria-hidden="true"
                    {% endif %}
                  >
                    {%- render 'ossian-trust-badge', badge: block.settings -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .trust-ticker-section {
    margin: 20px;
  }

  .trust-ticker {
    color: var(--trust-color);
  }

  .trust-ticker__track-outer {
    overflow: hidden;
    width: 100%;
  }

  .trust-ticker__track {
    display: flex;
    width: max-content;
    animation: trust-ticker-scroll var(--ticker-speed, 28s) linear infinite;
  }

  .trust-ticker__track:hover {
    animation-play-state: paused;
  }

  @keyframes trust-ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .trust-ticker__set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .trust-ticker__item {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    padding: 6px 18px;
  }

  /* Dividers sit between visible markers, including across the looped copy */
  .trust-ticker__item + .trust-ticker__item::before,
  .trust-ticker__set + .trust-ticker__set .trust-ticker__item:first-child::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 1px;
    background: currentcolor;
    opacity: 0.45;
  }

  .trust-ticker__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .trust-ticker__icon svg,
  .trust-ticker__custom-icon {
    display: block;
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .trust-ticker__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: max-content;
    max-width: 8.6em;
    font-size: 13px;
  }

  .trust-ticker__title {
    display: block;
    font-family: var(--font-body--family);
    font-size: 1em;
    font-weight: 700;
    line-height: 1.25;
    color: inherit;
    text-wrap: balance;
  }

  .trust-ticker__desc {
    display: block;
    font-size: 0.9em;
    line-height: 1.35;
    color: inherit;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-ticker__track-outer {
      overflow-x: auto;
    }

    .trust-ticker__track {
      animation: none;
    }

    .trust-ticker__set[aria-hidden='true'],
    .trust-ticker__item[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Ticker",
  "tag": "section",
  "class": "trust-ticker-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:ossian_trust_ticker.settings.text_color",
      "default": "#0b1d4d"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "t:ossian_trust_ticker.headers.product_matching",
      "info": "t:ossian_trust_ticker.info.product_matching"
    },
    {
      "type": "textarea",
      "id": "skin_product_types",
      "label": "t:ossian_trust_ticker.settings.skin_product_types",
      "info": "t:ossian_trust_ticker.info.product_types",
      "default": "Facial Masks, Facial Kit, De-tan, Wax"
    },
    {
      "type": "textarea",
      "id": "hair_product_types",
      "label": "t:ossian_trust_ticker.settings.hair_product_types",
      "info": "t:ossian_trust_ticker.info.product_types",
      "default": "Shampoo, Conditioner, Hair Mask, Hair Spa, Hair Color, Blonder, Developer, Nano Silk"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "t:ossian_trust_ticker.settings.category",
          "info": "t:ossian_trust_ticker.info.category",
          "options": [
            {
              "value": "skin",
              "label": "t:ossian_trust_ticker.options.skin"
            },
            {
              "value": "hair",
              "label": "t:ossian_trust_ticker.options.hair"
            }
          ],
          "default": "hair"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf / Plant"
            },
            {
              "value": "shield",
              "label": "Shield / Tested"
            },
            {
              "value": "droplet",
              "label": "Droplet / Water"
            },
            {
              "value": "sparkle",
              "label": "Sparkle / Stars"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "lab",
              "label": "Lab / Flask"
            },
            {
              "value": "award",
              "label": "Award / Medal"
            },
            {
              "value": "rabbit",
              "label": "t:ossian_trust_ticker.options.rabbit"
            },
            {
              "value": "professionals",
              "label": "t:ossian_trust_ticker.options.professionals"
            },
            {
              "value": "image",
              "label": "Custom image"
            }
          ],
          "default": "sparkle"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image (if 'Custom image' selected)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Trust Badge"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Ticker",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "category": "skin",
            "icon": "shield",
            "title": "Dermatologically Tested"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "hair",
            "icon": "droplet",
            "title": "Salon Professional Quality"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "hair",
            "icon": "sparkle",
            "title": "Visible Results"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "skin",
            "icon": "leaf",
            "title": "Skin-Loving Ingredients"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "skin",
            "icon": "rabbit",
            "title": "Cruelty-Free Products"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "hair",
            "icon": "professionals",
            "title": "Trusted by Professionals"
          }
        },
        {
          "type": "badge",
          "settings": {
            "category": "skin",
            "icon": "shield",
            "title": "Safe for Everyday Use"
