<div
  class="ossian-hero-banner"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-hero-banner__inner">
    <div class="ossian-hero-banner__content">
      {% if section.settings.badge != blank %}
        <div class="ossian-hero-banner__badge">{{ section.settings.badge }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="ossian-hero-banner__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="ossian-hero-banner__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
      <div class="ossian-hero-banner__actions">
        {% if section.settings.primary_button_label != blank %}
          <a href="{{ section.settings.primary_button_url }}" class="ossian-hero-banner__btn ossian-hero-banner__btn--primary">
            {{ section.settings.primary_button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a href="{{ section.settings.secondary_button_url }}" class="ossian-hero-banner__btn ossian-hero-banner__btn--secondary">
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.image != blank %}
      <div class="ossian-hero-banner__image-wrap">
        {{ section.settings.image | image_url: width: 980 | image_tag: loading: 'lazy', class: 'ossian-hero-banner__image', alt: section.settings.image.alt }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .ossian-hero-banner {
    background: linear-gradient(149deg, #1e3a5f 0%, #2d4a6f 100%);
    overflow: hidden;
  }

  .ossian-hero-banner__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .ossian-hero-banner__inner {
      grid-template-columns: 1fr;
      padding: 48px 20px;
    }
    .ossian-hero-banner__image-wrap {
      order: -1;
    }
  }

  .ossian-hero-banner__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ossian-hero-banner__badge {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 0.875rem;
    padding: 6px 16px;
    border-radius: 999px;
    width: fit-content;
  }

  .ossian-hero-banner__heading {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.1;
    margin: 0;
    letter-spacing: 0.005em;
  }

  .ossian-hero-banner__subtext {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
    max-width: 512px;
  }

  .ossian-hero-banner__actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ossian-hero-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .ossian-hero-banner__btn:hover {
    opacity: 0.9;
  }

  .ossian-hero-banner__btn--primary {
    background: #fff;
    color: #1e3a5f;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .ossian-hero-banner__btn--secondary {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  .ossian-hero-banner__image-wrap {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    aspect-ratio: 490 / 603;
  }

  .ossian-hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge text",
      "default": "✨ New Innovation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GO GLOW DE-TAN"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Kojic & Milk Illuminate formula that reveals your skin's natural radiance. Professional tan removal with visible results."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
