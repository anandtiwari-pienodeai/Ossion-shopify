{% comment %}
  Section contract.
  Image beside copy, with separate desktop and mobile images. The image can
  sit on either side and bleed to the screen edge. Optional feature blocks
  render as a two-column list under the copy.
  @example
  <!-- templates/page.about.json → about_story (image right) / about_trust (image left) -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

{%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}

<section
  class="oab oabs oabs--image-{{ section.settings.image_side }}{% if section.settings.bleed %} oabs--bleed{% endif %}"
  id="oabs-{{ section.id }}"
  style="--oabs-bg: {{ section.settings.background }}; --oabs-ratio: {{ section.settings.image_ratio }}; --oabs-ratio-mobile: {{ section.settings.image_ratio_mobile }};"
>
  {%- if section.settings.anchor_id != blank -%}
    <span class="oabs__anchor" id="{{ section.settings.anchor_id | handleize }}"></span>
  {%- endif -%}
  <div class="oabs__grid">
    <div class="oabs__media">
      {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
        {%- assign split_alt = section.settings.image.alt | default: section.settings.image_mobile.alt | default: '' -%}
        {%- render 'ossian-about-picture',
          desktop: section.settings.image,
          mobile: section.settings.image_mobile,
          sizes: '(min-width: 990px) 50vw, 100vw',
          alt: split_alt
        -%}
      {%- else -%}
        <div class="oabs__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>

    <div class="oabs__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oab-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ossian-about-heading', text: section.settings.heading -%}
      {%- if section.settings.text != blank -%}
        <div class="oab-text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if feature_blocks.size > 0 -%}
        <ul class="oabs__features" role="list">
          {%- for block in feature_blocks -%}
            <li class="oabs__feature" {{ block.shopify_attributes }}>
              <span class="oabs__feature-icon">{%- render 'ossian-about-icon', icon: block.settings.icon -%}</span>
              <span class="oabs__feature-text">
                {%- if block.settings.title != blank -%}
                  <span class="oabs__feature-title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="oabs__feature-sub">{{ block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="oab-btn oab-btn--outline" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.oabs {
  position: relative;
  background: var(--oabs-bg, #f2f6fc);
  padding-block: 16px;
}

.oabs__anchor { position: absolute; top: -80px; }

.oabs__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(32px, 4vw, 64px);
  width: 100%;
  max-width: 1240px;
  margin-inline: auto;
  padding-inline: 40px;
}

/* Bleed: image runs to the screen edge on its side */
.oabs--bleed .oabs__grid {
  max-width: none;
  padding-inline: 0;
}

.oabs--bleed.oabs--image-right .oabs__copy {
  padding-inline-start: max(40px, calc((100vw - 1240px) / 2 + 40px));
}

.oabs--bleed.oabs--image-left .oabs__copy {
  padding-inline-end: max(40px, calc((100vw - 1240px) / 2 + 40px));
}

.oabs--image-left .oabs__media { order: -1; }
.oabs--image-right .oabs__media { order: 2; }

.oabs__media {
  position: relative;
  min-width: 0;
  aspect-ratio: var(--oabs-ratio, 4 / 3);
  overflow: hidden;
  border-radius: 6px;
  background: #dfe6f1;
}

.oabs--bleed.oabs--image-right .oabs__media { border-start-end-radius: 0; border-end-end-radius: 0; }
.oabs--bleed.oabs--image-left .oabs__media { border-start-start-radius: 0; border-end-start-radius: 0; }

.oabs__media .oab-picture {
  position: absolute;
  inset: 0;
}

.oabs__placeholder,
.oabs__placeholder svg {
  width: 100%;
  height: 100%;
  fill: rgba(30, 58, 95, 0.2);
}

.oabs__copy {
  min-width: 0;
  padding-block: 32px;
}

.oabs__copy > :last-child { margin-bottom: 0; }

.oabs__features {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px 24px;
  margin: 0 0 28px;
  padding: 0;
  list-style: none;
}

.oabs__feature {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  min-width: 0;
}

.oabs__feature-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--oab-navy-deep);
  color: #fff;
}

.oabs__feature-icon svg { width: 19px; height: 19px; }

.oabs__feature-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
  padding-top: 2px;
}

.oabs__feature-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--oab-ink);
}

.oabs__feature-sub {
  font-size: 0.8rem;
  line-height: 1.45;
  color: var(--oab-muted);
}

@media (max-width: 749px) {
  .oabs { padding-block: 0; }

  .oabs__grid,
  .oabs--bleed .oabs__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding-inline: 0;
  }

  /* Mobile: copy first, then the full-width mobile image */
  .oabs--image-left .oabs__media,
  .oabs--image-right .oabs__media {
    order: 2;
    aspect-ratio: var(--oabs-ratio-mobile, 4 / 3);
    border-radius: 0;
  }

  .oabs__copy,
  .oabs--bleed.oabs--image-right .oabs__copy,
  .oabs--bleed.oabs--image-left .oabs__copy {
    padding: 32px 20px 28px;
  }

  .oabs__features { gap: 18px 14px; margin-bottom: 22px; }
  .oabs__feature { gap: 10px; }
  .oabs__feature-icon { width: 34px; height: 34px; }
  .oabs__feature-icon svg { width: 16px; height: 16px; }
  .oabs__feature-title { font-size: 0.82rem; }
  .oabs__feature-sub { font-size: 0.74rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian About Image + Text",
  "tag": "div",
  "class": "section-ossian-about-split",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Shown full width under the text on mobile. Falls back to the desktop image." },
    {
      "type": "select",
      "id": "image_side",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "checkbox", "id": "bleed", "label": "Extend image to screen edge", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Desktop image shape",
      "default": "4 / 3",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "16 / 10", "label": "Wide 16:10" },
        { "value": "3 / 2", "label": "Landscape 3:2" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Mobile image shape",
      "default": "4 / 3",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape 4:3" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "16 / 10", "label": "Wide 16:10" }
      ]
    },
    { "type": "color", "id": "background", "label": "Background", "default": "#f2f6fc" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent. Use | for a line break.", "default": "Born in Salons.|Built for You." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ossion Professional was created with a simple belief — professional grade hair and skin care should be accessible to everyone.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Lets buttons jump here, e.g. our-story → link to #our-story." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "people", "label": "People" },
            { "value": "shield", "label": "Shield" },
            { "value": "badge", "label": "Badge" },
            { "value": "flask", "label": "Flask" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "molecule", "label": "Molecule" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Quality You Can Trust" },
        { "type": "text", "id": "text", "label": "Text", "default": "Consistent and reliable performance" }
      ]
    }
  ],
  "presets": [
    { "name": "Ossian About Image + Text" }
  ]
}
{% endschema %}
