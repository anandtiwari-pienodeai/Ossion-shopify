

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper add-to-cart-icon">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product_media_size: closest.product.media.size,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  @media screen and (max-width: 749px) {
    /* base.css adds 20px padding inside every section on top of the 16px page margin;
       on phones that leaves the product image at ~318px, so drop the extra side padding here */
    .shopify-section:not(.header-section) .product-information.section {
      padding-inline: 0;
    }
  }

  /* ── Category badge (product type) ──────────── */
  .product-information .ossian-product-type {
    margin-bottom: 6px;
  }

  /* ── Product title sizing on PDP ─────────────── */
  .product-information .product-details h1 {
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    line-height: 1.2;
    font-weight: 800;
    color: #101828;
    margin: 0;
    font-family: var(--font-primary--family, sans-serif);
  }

  /* ── Product subtitle (metafield) ────────────── */
  .product-information .text-block--text_subtitle p,
  .product-information .text-block--text_subtitle {
    font-size: 1.05rem;
    color: #4b5563;
    font-weight: 500;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Rating row ─────────────────────────────── */
  .product-information .rating-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ── Price block on PDP ──────────────────────── */
  .product-information .price__regular .price-item,
  .product-information .price__sale .price-item--sale {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e3a5f;
    font-family: var(--font-body--family, sans-serif);
  }

  .product-information .price__sale .price-item--regular {
    font-size: 1.05rem;
    color: #9ca3af;
    text-decoration: line-through;
    font-weight: 400;
  }

  .product-information .price__badges .price__badge-sale {
    font-size: 12px;
    font-weight: 700;
    background: #fee2e2;
    color: #b91c1c;
    border-radius: 4px;
    padding: 2px 8px;
  }

  /* ── Tax info line ───────────────────────────── */
  .product-information .price__tax-note,
  .product-information .price__tax-note * {
    font-size: 12px;
    color: #6b7280;
    margin-top: 2px;
  }

  /* ── Variant picker ─────────────────────────── */
  .product-information .variant-picker-block .variant-option__heading {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 8px;
  }

  .product-information .variant-option--buttons .variant-option__button-label {
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 18px;
    border: 1.5px solid #d1d5db;
    color: #374151;
    background: #fff;
    transition: all 0.15s;
  }

  .product-information .variant-option--buttons .variant-option__button-label:hover {
    border-color: #1e3a5f;
    color: #1e3a5f;
  }

  .product-information .variant-option--buttons .variant-option__button-input:checked + .variant-option__button-label {
    background: #1e3a5f;
    border-color: #1e3a5f;
    color: #fff;
    font-weight: 700;
  }

  /* ── Quantity selector ──────────────────────── */
  .product-information .quantity-selector {
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
  }

  .product-information .quantity__input {
    font-size: 15px;
    font-weight: 700;
    color: #1e3a5f;
  }

  /* Quantity sits above buttons in its own row */
  .product-information .quantity-selector-wrapper {
    flex: 0 0 auto;
  }

  /* ── Add to cart button ──────────────────────── */
  .product-information .add-to-cart-button.button {
    background: #1e3a5f;
    border-color: #1e3a5f;
    border-radius: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    min-height: 52px;
    font-size: 13px;
    text-transform: uppercase;
  }

  .product-information .add-to-cart-button.button:hover:not(:disabled) {
    background: #16304f;
    border-color: #16304f;
  }

  /* Add cart icon appearance */
  .product-information .add-to-cart-icon {
    margin-right: 6px;
  }

  /* ── Accelerated checkout (Buy Now) ──────────── */
  .product-information .shopify-payment-button__button {
    border-radius: 10px !important;
    min-height: 52px !important;
    border: 1.5px solid #d1d5db !important;
  }

  .product-information .shopify-payment-button__button--unbranded {
    background: #fff !important;
    color: #1e3a5f !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
  }

  /* ── Wishlist button ─────────────────────────── */
  .product-information .ossian-pdp-wish-btn {
    border-radius: 10px;
    min-height: 52px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1.5px solid #d1d5db;
    color: #374151;
  }

  .product-information .ossian-pdp-wish-btn:hover {
    border-color: #1e3a5f;
    color: #1e3a5f;
    background: #f8fafc;
  }

  /* ── Divider ────────────────────────────────── */
  .product-information .divider-block {
    border-color: #e8edf5;
  }

  /* ── Media column ────────────────────────────── */
  .product-information .product-information__media {
    position: relative;
  }

  .product-information .product-media-container {
    border-radius: 12px;
    overflow: hidden;
  }

  .product-information .product-media-thumbnail {
    border-radius: 6px;
    overflow: hidden;
  }

  /* ── Variant option headings ("COLOR  1 Black") ── */
  .product-information .variant-picker .variant-option legend {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .product-information .variant-picker .variant-option legend .variant-option__swatch-value {
    font-weight: 500;
    text-transform: none;
  }

  /* ── Mobile ────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .product-information .product-details h1 {
      font-size: 1.6rem;
    }

    .product-information .price__regular .price-item,
    .product-information .price__sale .price-item--sale {
      font-size: 1.45rem;
    }

  }

  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* ── PDP: vertical thumbnail strip on the left ── */
  @media screen and (min-width: 750px) {
    .product-information slideshow-controls[thumbnails][pagination-position='left'] {
      width: calc(var(--thumbnail-width, 72px) + 16px);
      min-width: calc(var(--thumbnail-width, 72px) + 16px);
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails {
      flex-direction: column;
      gap: 8px;
      padding-inline: 4px;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control {
      width: var(--thumbnail-width, 72px);
      height: var(--thumbnail-width, 72px);
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      border-radius: 6px;
      overflow: hidden;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
      outline: 2px solid #1e3a5f;
      outline-offset: 2px;
    }
  }

  /* ══ Ossion PDP layout (design refresh) ══════════════════════════ */

  /* Main image: rounded frame, no arrows (thumbnails handle navigation) */
  .product-information .product-media-container,
  .product-information slideshow-container {
    border-radius: 16px;
  }

  .product-information slideshow-container {
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .product-information slideshow-arrows {
      display: none;
    }
  }

  /* Benefit strip over the bottom of the main image */
  .ossian-media-badges {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 6px;
    margin: 0;
    padding: 34px 12px 16px;
    list-style: none;
    color: #fff;
    background: linear-gradient(180deg, rgb(8 24 50 / 0) 0%, rgb(8 24 50 / 0.82) 55%);
    pointer-events: none;
  }

  .ossian-media-badges__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-inline: clamp(8px, 1.2vw, 20px);
    font-size: clamp(0.78rem, 0.95vw, 0.95rem);
    font-weight: 500;
    white-space: nowrap;
  }

  .ossian-media-badges__item + .ossian-media-badges__item {
    border-inline-start: 1px solid rgb(255 255 255 / 0.4);
  }

  .ossian-media-badges__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  /* Desktop: keep the gallery in view while the longer details column scrolls */
  @media screen and (min-width: 750px) {
    .product-information .product-information__media {
      position: sticky;
      top: calc(var(--header-height, 0px) + 16px);
    }
  }

  /* Phones: compact strip; thumbnails sit below the image */
  @media screen and (max-width: 749px) {
    .ossian-media-badges {
      padding: 28px 8px 14px;
    }

    .product-information slideshow-controls[thumbnails] {
      margin-block-start: 10px;
      padding-inline: 0;
    }

    .product-information slideshow-controls[thumbnails] .slideshow-controls__thumbnails {
      justify-content: flex-start;
      gap: 8px;
      padding: 3px;
    }

    .product-information slideshow-controls[thumbnails] .slideshow-control {
      flex: 0 0 60px;
      width: 60px;
      height: 60px;
      overflow: hidden;
      border: 1px solid #e3e8f1;
      border-radius: 10px;
      background: #f4f7fc;
    }

    .product-information slideshow-controls[thumbnails] .slideshow-control img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-information slideshow-controls[thumbnails] .slideshow-control[aria-selected='true'] {
      outline: 2px solid #1e3a5f;
      outline-offset: 0;
      border-color: transparent;
    }

    .ossian-media-badges__item {
      gap: 5px;
      padding-inline: 8px;
      font-size: 0.72rem;
    }

    .ossian-media-badges__icon {
      width: 16px;
      height: 16px;
    }
  }

  /* Thumbnails: rounded tiles, navy ring on the active one, max six */
  @media screen and (min-width: 990px) {
    /* Larger than the gallery setting's 72px maximum, to match the design */
    /* Set on the strip itself: the gallery's inline --thumbnail-width would win on the gallery element */
    .product-information slideshow-controls[thumbnails][pagination-position='left'] {
      --thumbnail-width: 96px;
    }
  }

  @media screen and (min-width: 750px) {
    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control {
      border-radius: 12px;
      border: 1px solid #e3e8f1;
      background: #f4f7fc;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
      outline: 2px solid #1e3a5f;
      outline-offset: 0;
      border-color: transparent;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails .slideshow-control:nth-child(n + 7) {
      display: none;
    }

    .product-information slideshow-controls[thumbnails][pagination-position='left'] .slideshow-controls__thumbnails {
      gap: 12px;
    }
  }

  /* Size badge pinned top-right of the details column */
  .product-information .product-details {
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .product-information .product-details .ossian-size-badge {
      position: absolute;
      top: 0;
      inset-inline-end: 0;
      z-index: 1;
    }

    /* Keep the eyebrow, title and subtitle clear of the badge */
    .product-information .product-details:has(.ossian-size-badge) .ossian-product-type,
    .product-information .product-details:has(.ossian-size-badge) .text-block {
      padding-inline-end: 200px;
    }
  }

  @media screen and (max-width: 749px) {
    /* Breathing room between the gallery and the brand label */
    .product-information .product-details {
      padding-top: 18px;
    }

    .product-information .product-details .ossian-size-badge {
      align-self: flex-start;
      gap: 10px;
      padding: 8px 12px;
    }

    .product-information .ossian-size-badge__icon svg {
      width: 22px;
      height: 22px;
    }

    .product-information .ossian-size-badge__value {
      font-size: 1rem;
    }

    .product-information .ossian-size-badge__label {
      font-size: 0.62rem;
    }

    .product-information .product-details h1 {
      font-size: 1.6rem;
    }
  }

  /* Buy buttons: quantity on its own row, full-width Add to cart and Buy it now */
  .product-information .product-form-buttons {
    flex-wrap: wrap;
    gap: 12px;
  }

  .product-information .product-form-buttons > .quantity-selector-wrapper {
    flex: 0 0 100%;
  }

  /* flex: none so the theme's flex-basis can't override the width */
  .product-information .product-form-buttons .quantity-selector {
    flex: 0 0 148px;
    width: 148px;
    min-height: 48px;
    height: 48px;
    border-radius: 10px;
  }

  .product-information .product-form-buttons > :not(.quantity-selector-wrapper, .quantity-rules, .quantity-label, .volume-pricing, .product-form-text__error) {
    flex: 1 1 100%;
  }

  /* Sized to the design's proportions: 48px tall, 15px label */
  .product-information .add-to-cart-button.button {
    min-height: 48px;
    height: 48px;
    padding-block: 0;
    font-size: 0.94rem;
    letter-spacing: 0.08em;
  }

  .product-information .shopify-payment-button__button {
    min-height: 48px !important;
    border: 1.5px solid #1e3a5f !important;
  }

  .product-information .shopify-payment-button__button--unbranded {
    font-size: 0.94rem !important;
    letter-spacing: 0.08em !important;
  }

  .product-information shopify-accelerated-checkout {
    --shopify-accelerated-checkout-button-block-size: 48px;
    --shopify-accelerated-checkout-button-border-radius: 10px;
  }

  /* ══ Image zoom popup (opens when a product image is clicked) ══════ */
  .product-information .dialog-zoomed-gallery__dialog[open] {
    position: fixed;
    inset: 0;
    width: min(1200px, calc(100vw - 48px));
    height: min(820px, calc(100dvh - 48px));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 18px;
    border: 0;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.35);
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 18px;
    overflow: hidden;
  }

  .product-information .dialog-zoomed-gallery__dialog::backdrop {
    background: rgb(15 23 42 / 0.72);
    backdrop-filter: blur(4px);
  }

  /* Thumbnail column */
  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list-container {
    position: static;
    grid-column: 1;
    grid-row: 1;
    width: auto;
    min-height: 0;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list {
    position: static;
    inset: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 4px;
    overflow-y: auto;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list::after {
    display: none;
  }

  /* The theme's slide-in ends at translateY(-50%) for its floating strip; use a plain fade here */
  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list,
  .product-information .dialog-zoomed-gallery__dialog.dialog--closed .dialog-thumbnails-list {
    transform: none;
    animation: ossian-zoom-thumbs-in 0.25s ease forwards;
  }

  .product-information .dialog-zoomed-gallery__dialog.dialog--closed .dialog-thumbnails-list {
    animation-name: ossian-zoom-thumbs-out;
  }

  @keyframes ossian-zoom-thumbs-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes ossian-zoom-thumbs-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  /* Every thumbnail stays visible: tiles shrink to share the panel height instead of scrolling */
  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list {
    height: 100%;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list__thumbnail {
    width: 100%;
    height: auto;
    flex: 0 1 124px;
    min-height: 56px;
    border-radius: 14px;
    background: #f2f5fa;

    img {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: cover;
      border-radius: 12px;
    }

    &[aria-selected='true'] {
      outline: 3px solid #2f6fd6;
      outline-offset: 2px;
      border: 0;
    }
  }

  /* Main image: one at a time, snapping */
  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    height: 100%;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
    border: 1px solid #e3e8f1;
    border-radius: 16px;
    background: #fff;
    cursor: default;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery::-webkit-scrollbar {
    display: none;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery > .product-media-container {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery .product-media,
  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery drag-zoom-wrapper {
    width: 100%;
    height: 100%;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Close button */
  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery__close-button.close-button {
    position: absolute;
    top: 34px;
    inset-inline-end: 34px;
    z-index: 3;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: #13233f;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
    --button-color: #13233f;
    --button-background-color: #fff;
    /* the theme's close button uses mix-blend-mode: difference, which turns white dark on a white panel */
    mix-blend-mode: normal;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery__close-button.close-button:hover {
    background: #f2f5fa;
  }

  .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery__close-button svg {
    width: 20px;
    height: 20px;
  }

  /* Prev / next arrows over the main image */
  .product-information .dialog-zoomed-gallery__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(15 23 42 / 0.75);
    color: #fff;
    transform: translateY(-50%);
    transition: background 0.2s ease;
  }

  .product-information .dialog-zoomed-gallery__nav:hover {
    background: rgb(15 23 42 / 0.92);
  }

  .product-information .dialog-zoomed-gallery__nav svg {
    width: 22px;
    height: 22px;
  }

  .product-information .dialog-zoomed-gallery__nav--prev {
    /* panel padding + thumbnail column + gap + inset */
    inset-inline-start: calc(18px + 132px + 18px + 20px);
  }

  .product-information .dialog-zoomed-gallery__nav--next {
    inset-inline-end: 38px;
  }

  .product-information .dialog-zoomed-gallery__close-button:focus-visible,
  .product-information .dialog-zoomed-gallery__nav:focus-visible,
  .product-information .dialog-thumbnails-list__thumbnail:focus-visible {
    outline: 3px solid #2f6fd6;
    outline-offset: 2px;
  }

  [dir='rtl'] .product-information .dialog-zoomed-gallery__nav svg {
    transform: scaleX(-1);
  }

  /* Phones: full screen, image on top, thumbnails in a row underneath */
  @media screen and (max-width: 749px) {
    .product-information .dialog-zoomed-gallery__dialog[open] {
      width: 100%;
      height: 100dvh;
      padding: 12px;
      border-radius: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 12px;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery {
      grid-column: 1;
      grid-row: 1;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list-container {
      grid-column: 1;
      grid-row: 2;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list {
      height: auto;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-thumbnails-list__thumbnail {
      flex: 0 0 68px;
      width: 68px;
      height: 68px;
    }

    .product-information .dialog-zoomed-gallery__dialog .dialog-zoomed-gallery__close-button.close-button {
      top: 24px;
      inset-inline-end: 24px;
      width: 44px;
      height: 44px;
    }

    .product-information .dialog-zoomed-gallery__nav {
      width: 42px;
      height: 42px;
      /* centre on the image, not the whole screen (thumbnail row is ~96px) */
      top: calc(50% - 48px);
    }

    .product-information .dialog-zoomed-gallery__nav--prev {
      inset-inline-start: 22px;
    }

    .product-information .dialog-zoomed-gallery__nav--next {
      inset-inline-end: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-information .dialog-zoomed-gallery__nav {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
