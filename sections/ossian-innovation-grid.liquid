{%- assign card_blocks = section.blocks | where: 'type', 'innovation' -%}

<section class="oinno">
  <div class="oinno__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="oinno__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="oinno__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="oinno__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="oinno__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_blocks.size > 0 -%}
      <div class="oinno__grid">
        {%- for block in card_blocks -%}
          <div class="oinno__card" {{ block.shopify_attributes }}>
            <div class="oinno__card-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: class: 'oinno__card-img', loading: 'lazy', widths: '300,450,600' }}
              {%- else -%}
                <div class="oinno__card-img-ph"></div>
              {%- endif -%}
            </div>
            <div class="oinno__card-body">
              {%- if block.settings.heading != blank -%}
                <h3 class="oinno__card-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="oinno__card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link_url | default: '#' }}" class="oinno__card-link">
                  {{ block.settings.link_label }}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.oinno,
.oinno * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.oinno {
  padding: 80px 0;
  background: #f7f9fc;
}

.oinno__header {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 48px;
}

.oinno__eyebrow {
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #2563eb;
  margin: 0 0 12px;
}

.oinno__heading {
  font-size: clamp(1.9rem, 3.2vw, 2.75rem);
  font-weight: 700;
  color: #1e3a5f;
  margin: 0 0 14px;
  line-height: 1.2;
}

.oinno__sub {
  font-size: 1rem;
  line-height: 1.6;
  color: #5b7091;
  margin: 0;
}

.oinno__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.oinno__card {
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 12px 32px rgba(20, 40, 74, 0.08);
  display: flex;
  flex-direction: column;
}

.oinno__card-media {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #eef1f8;
  overflow: hidden;
}

.oinno__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.oinno__card-img-ph {
  width: 100%;
  height: 100%;
}

.oinno__card-body {
  padding: 24px 26px 28px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.oinno__card-heading {
  font-size: 1.15rem;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0 0 10px;
  line-height: 1.3;
}

.oinno__card-desc {
  font-size: 0.9rem;
  line-height: 1.6;
  color: #5b7091;
  margin: 0 0 18px;
  flex: 1;
}

.oinno__card-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  font-size: 0.88rem;
  font-weight: 600;
  color: #1e3a5f;
  text-decoration: none;
  border-bottom: 1.5px solid rgba(30, 58, 95, 0.35);
  padding-bottom: 2px;
  transition: border-color 0.2s;
}

.oinno__card-link:hover { border-color: #1e3a5f; }

@media (max-width: 900px) {
  .oinno { padding: 56px 0; }
  .oinno__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
}

@media (max-width: 600px) {
  .oinno { padding: 40px 0; }
  .oinno__header { margin-bottom: 32px; }
  .oinno__grid { grid-template-columns: 1fr; gap: 20px; }
}
{% endstylesheet %}

