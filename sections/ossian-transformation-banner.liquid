{%- comment -%}
  Transformation Banner — image only. Separate desktop and mobile images, each shown at
  its own proportions (never cropped); optional link and alt text. The bundled
  assets/ossion-salon-choice-*.jpg banners are only the defaults.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign desktop_image = s.image | default: s.image_mobile
  assign mobile_image = s.image_mobile | default: s.image
-%}

<div class="otb-image">
  {%- if s.link != blank -%}
    <a href="{{ s.link }}" class="otb-image__media" aria-label="{{ s.alt | default: shop.name | escape }}">
  {%- else -%}
    <div class="otb-image__media">
  {%- endif -%}
    <picture>
      {%- if desktop_image != blank -%}
        {%- if mobile_image != desktop_image -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{- mobile_image | image_url: width: 500 }} 500w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w,
              {{ mobile_image | image_url: width: 1400 }} 1400w
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 2400
          | image_tag:
            class: 'otb-image__img',
            alt: s.alt,
            loading: 'lazy',
            widths: '750, 1100, 1500, 1900, 2400',
            sizes: '100vw'
        }}
      {%- else -%}
        {%- comment -%} Defaults bundled with the theme, used until images are picked {%- endcomment -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ 'ossion-salon-choice-mobile.jpg' | asset_url }}"
          width="1774"
          height="887"
        >
        <img
          class="otb-image__img"
          src="{{ 'ossion-salon-choice-desktop.jpg' | asset_url }}"
          alt="{{ s.alt | escape }}"
          width="2000"
          height="668"
          loading="lazy"
        >
      {%- endif -%}
    </picture>
  {%- if s.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .otb-image__media {
    display: block;
    line-height: 0;
  }

  .otb-image__media picture {
    display: block;
  }

  .otb-image__img {
    display: block;
    width: 100%;
    height: auto;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Transformation Banner",
  "tag": "section",
  "class": "ossian-transformation-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Shown full width at its own proportions (not cropped), e.g. 2400 × 800. Leave empty for the default Salon Choice banner."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Shown below 750px at its own proportions. Uses the desktop image when empty (or the default mobile banner when both are empty)."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description (alt text)",
      "info": "Describe any text in the image, e.g. Salon Choice — Real Transformations."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Transformation Banner"
    }
  ]
}
{% endschema %}
