<section class="ohist" style="background-color: {{ section.settings.background_color }};">
  <div class="ohist__inner page-width{% if section.settings.image_position == 'left' %} ohist__inner--reverse{% endif %}">

    <div class="ohist__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ohist__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ohist__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="ohist__body">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank or section.settings.pdf_label != blank -%}
        <div class="ohist__actions">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="ohist__cta">
              {{ section.settings.cta_label }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.pdf_label != blank -%}
            <a href="{{ section.settings.pdf_url | default: '#' }}" class="ohist__pdf" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
              {{ section.settings.pdf_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ohist__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: class: 'ohist__img', loading: 'lazy', widths: '400,600,800,900' }}
      {%- else -%}
        <div class="ohist__img-ph"></div>
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
.ohist,
.ohist * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.ohist {
  padding: 80px 0;
}

.ohist__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.ohist__inner--reverse {
  direction: rtl;
}

.ohist__inner--reverse > * {
  direction: ltr;
}

.ohist__eyebrow {
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #2563eb;
  margin: 0 0 12px;
}

.ohist__heading {
  font-size: clamp(1.9rem, 3.2vw, 2.75rem);
  font-weight: 700;
  color: #1e3a5f;
  line-height: 1.2;
  margin: 0 0 20px;
}

.ohist__body {
  font-size: 1rem;
  line-height: 1.7;
  color: #45536b;
  margin: 0 0 32px;
}

.ohist__body p { margin: 0 0 1em; }
.ohist__body p:last-child { margin-bottom: 0; }

.ohist__actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.ohist__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #1e3a5f;
  color: #fff;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-decoration: none;
  padding: 14px 26px;
  border-radius: 8px;
  transition: background 0.2s;
}

.ohist__cta:hover { background: #16304f; }

.ohist__pdf {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #1e3a5f;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid rgba(30, 58, 95, 0.35);
  padding-bottom: 2px;
  transition: border-color 0.2s;
}

.ohist__pdf:hover { border-color: #1e3a5f; }

.ohist__media { position: relative; }

.ohist__img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
  object-fit: cover;
}

.ohist__img-ph {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 20px;
  background: #eef1f8;
}

@media (max-width: 900px) {
  .ohist { padding: 56px 0; }
  .ohist__inner {
    grid-template-columns: 1fr;
    gap: 32px;
    direction: ltr;
  }
  .ohist__media { order: -1; }
}

@media (max-width: 600px) {
  .ohist { padding: 40px 0; }
  .ohist__heading { font-size: clamp(1.6rem, 6vw, 2rem); }
  .ohist__actions { flex-direction: column; align-items: flex-start; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Heritage Story",
  "tag": "section",
  "class": "ossian-heritage-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR HERITAGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Year by year, forever passionate"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>For over a decade, Ossion Professional has pushed the boundaries of hair science - refining formulas, perfecting technique, and partnering with salons who share our obsession with results.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Discover our story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "pdf_label",
      "label": "Secondary link label (e.g. PDF download)",
      "default": "Download our brand book"
    },
    {
      "type": "url",
      "id": "pdf_url",
      "label": "Secondary link URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Heritage Story"
    }
  ]
}
{% endschema %}
