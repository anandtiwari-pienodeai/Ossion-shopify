{% comment %}
  Section contract.
  "From Our Blog" carousel: intro + View All button, then article cards
  (image, category pill, date, title, excerpt, Read More) with arrows and
  dots. Shows the selected blog's latest articles; when the blog has none,
  or "Manual cards" is chosen, it renders the Post blocks instead.
  @example
  <!-- Homepage → Add section → Ossian Blog; pick a blog or add Post blocks -->
{% endcomment %}

{%- liquid
  assign blog = section.settings.blog
  assign use_blog = false
  if section.settings.source == 'blog' and blog != blank and blog.articles_count > 0
    assign use_blog = true
  endif
  assign post_blocks = section.blocks | where: 'type', 'post'
  if use_blog
    assign card_count = blog.articles_count | at_most: section.settings.limit
  else
    assign card_count = post_blocks.size
  endif
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and blog != blank
    assign view_all_url = blog.url
  endif
-%}

<section class="obl" id="obl-{{ section.id }}" style="--obl-bg: {{ section.settings.background }};">
  <div class="obl__wrap">
    <div class="obl__head">
      <div class="obl__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="obl__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- assign obl_heading = section.settings.heading | escape | replace: '[', '<span class="obl__accent">' | replace: ']', '</span>' -%}
          <h2 class="obl__heading">{{ obl_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="obl__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
        <a class="obl__view-all" href="{{ view_all_url }}">
          {{ section.settings.view_all_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if card_count > 0 -%}
      <div class="obl__carousel" data-obl-carousel>
        <button type="button" class="obl__arrow obl__arrow--prev" data-obl-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>

        <ul class="obl__track" role="list" data-obl-track>
          {%- if use_blog -%}
            {%- for article in blog.articles limit: section.settings.limit -%}
              {%- liquid
                assign card_tag = article.tags.first
                assign card_excerpt = article.excerpt_or_content | strip_html | truncatewords: 22
              -%}
              <li class="obl__item">
                {%- render 'ossian-blog-card',
                  image: article.image,
                  tag: card_tag,
                  date: article.published_at,
                  title: article.title,
                  excerpt: card_excerpt,
                  url: article.url
                -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in post_blocks -%}
              {%- liquid
                assign card_article = block.settings.article
                assign card_image = block.settings.image | default: card_article.image
                assign card_title = block.settings.title | default: card_article.title
                assign card_url = block.settings.link | default: card_article.url | default: view_all_url
                assign card_tag = block.settings.tag | default: card_article.tags.first
                assign card_excerpt = block.settings.excerpt
                if card_excerpt == blank and card_article != blank
                  assign card_excerpt = card_article.excerpt_or_content | strip_html | truncatewords: 22
                endif
                assign card_date = block.settings.date
                if card_date == blank and card_article != blank
                  assign card_date = card_article.published_at
                endif
              -%}
              <li class="obl__item" {{ block.shopify_attributes }}>
                {%- render 'ossian-blog-card',
                  image: card_image,
                  tag: card_tag,
                  date: card_date,
                  title: card_title,
                  excerpt: card_excerpt,
                  url: card_url
                -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        <button type="button" class="obl__arrow obl__arrow--next" data-obl-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>

      {%- if card_count > 1 -%}
        <div class="obl__dots" data-obl-dots>
          {%- for i in (1..card_count) -%}
            <button
              type="button"
              class="obl__dot{% if forloop.first %} is-active{% endif %}"
              data-obl-dot="{{ forloop.index0 }}"
              aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: card_count }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('obl-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-obl-track]');
    if (!track) return;
    var items = Array.prototype.slice.call(track.children);
    var prev = root.querySelector('[data-obl-prev]');
    var next = root.querySelector('[data-obl-next]');
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-obl-dot]'));
    var rtl = getComputedStyle(track).direction === 'rtl';

    function step() {
      if (items.length < 2) return track.clientWidth;
      return Math.abs(items[1].offsetLeft - items[0].offsetLeft);
    }

    function currentIndex() {
      return Math.round(Math.abs(track.scrollLeft) / step());
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var pos = Math.abs(track.scrollLeft);
      /* nothing to scroll: every card is already visible */
      root.classList.toggle('obl--static', max <= 2);
      if (prev) prev.disabled = pos <= 2;
      if (next) next.disabled = pos >= max - 2;
      /* at the end every remaining card is visible, so highlight the last dot */
      var idx = pos >= max - 2 ? items.length - 1 : currentIndex();
      dots.forEach(function (d, i) {
        var on = i === idx;
        d.classList.toggle('is-active', on);
        if (on) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }

    function goTo(index) {
      var target = Math.max(0, Math.min(items.length - 1, index)) * step();
      track.scrollTo({ left: rtl ? -target : target, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { goTo(currentIndex() - 1); });
    if (next) next.addEventListener('click', function () { goTo(currentIndex() + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(parseInt(d.dataset.oblDot, 10)); });
    });

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% stylesheet %}
.obl {
  --obl-ink: #13233f;
  --obl-navy: #0f2a55;
  --obl-accent: #2f6fd6;
  --obl-muted: #5b6577;
  --obl-gap: 18px;
  --obl-per-view: 4;
  background: var(--obl-bg, #fff);
  padding-block: 56px 48px;
}

.obl__wrap {
  position: relative;
  width: 100%;
  max-width: 1320px;
  margin-inline: auto;
  padding-inline: 72px;
}

.obl__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
  text-align: center;
}

.obl__intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.obl__eyebrow {
  margin: 0 0 8px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--obl-accent);
}

.obl__heading {
  margin: 0 0 12px;
  font-size: clamp(2rem, 3.6vw, 3rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.01em;
  color: var(--obl-ink);
}

.obl__accent { color: var(--obl-accent); }

.obl__text {
  margin: 0;
  max-width: 52ch;
  font-size: 1rem;
  line-height: 1.55;
  color: var(--obl-muted);
}

.obl__view-all {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  min-height: 48px;
  padding: 0 24px;
  border: 1.5px solid var(--obl-navy);
  border-radius: 10px;
  color: var(--obl-navy);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.obl__view-all svg { width: 18px; height: 18px; }
.obl__view-all:hover { background: var(--obl-navy); color: #fff; }
.obl__view-all:focus-visible { outline: 2px solid var(--obl-accent); outline-offset: 3px; }

/* Carousel */
.obl__carousel { position: relative; }

.obl__track {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: calc((100% - (var(--obl-per-view) - 1) * var(--obl-gap)) / var(--obl-per-view));
  gap: var(--obl-gap);
  margin: 0;
  padding: 4px 0 18px;
  list-style: none;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  overscroll-behavior-x: contain;
}

.obl__track::-webkit-scrollbar { display: none; }

.obl__item {
  min-width: 0;
  scroll-snap-align: start;
  display: flex;
}

.obl__arrow {
  position: absolute;
  top: calc(50% - 9px);
  z-index: 2;
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #fff;
  color: var(--obl-navy);
  box-shadow: 0 6px 20px rgba(20, 40, 74, 0.14);
  cursor: pointer;
  transform: translateY(-50%);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.obl__arrow svg { width: 22px; height: 22px; }
.obl__arrow:hover:not(:disabled) { transform: translateY(-50%) scale(1.06); }
.obl__arrow:disabled { opacity: 0.35; cursor: default; }
.obl__arrow:focus-visible { outline: 2px solid var(--obl-accent); outline-offset: 3px; }
.obl__arrow--prev { inset-inline-start: -66px; }
.obl__arrow--next { inset-inline-end: -66px; }
[dir='rtl'] .obl__arrow svg { transform: scaleX(-1); }

.obl--static .obl__arrow,
.obl--static .obl__dots { display: none; }

/* Dots */
.obl__dots {
  display: flex;
  justify-content: center;
  gap: 4px;
  margin-top: 6px;
}

.obl__dot {
  width: 22px;
  height: 22px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  position: relative;
}

.obl__dot::before {
  content: '';
  position: absolute;
  inset: 50% auto auto 50%;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #cfd6e2;
  transform: translate(-50%, -50%);
  transition: background 0.2s ease;
}

.obl__dot.is-active::before { background: var(--obl-navy); }
.obl__dot:focus-visible { outline: 2px solid var(--obl-accent); outline-offset: 1px; border-radius: 50%; }

@media (max-width: 1199px) {
  .obl { --obl-per-view: 3; }
}

@media (max-width: 989px) {
  .obl { --obl-per-view: 2; }
  .obl__wrap { padding-inline: 32px; }
  .obl__arrow { display: none; }
}

@media (max-width: 749px) {
  .obl { --obl-gap: 12px; padding-block: 40px 32px; }
  .obl__wrap { padding-inline: 0; }

  .obl__head {
    gap: 16px;
    margin-bottom: 20px;
    padding-inline: 20px;
  }

  .obl__eyebrow { font-size: 0.7rem; }
  .obl__heading { font-size: clamp(1.8rem, 8vw, 2.2rem); margin-bottom: 8px; }
  .obl__text { font-size: 0.9rem; }
  .obl__view-all { min-height: 44px; padding: 0 18px; font-size: 0.88rem; }

  /* One card plus a peek of the next */
  .obl__track {
    grid-auto-columns: 82%;
    padding-inline: 20px;
    scroll-padding-inline: 20px;
  }

}

@media (prefers-reduced-motion: reduce) {
  .obl__arrow,
  .obl__view-all { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian Blog",
  "tag": "div",
  "class": "section-ossian-blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Blog & Articles" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent.", "default": "From Our [Blog]" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Expert tips, hair & skin care routines, ingredient insights and more — curated to help you look and feel your best." },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "View All Articles" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "info": "Defaults to the selected blog." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "header", "content": "Articles" },
    {
      "type": "select",
      "id": "source",
      "label": "Card source",
      "default": "blog",
      "options": [
        { "value": "blog", "label": "Latest blog articles" },
        { "value": "manual", "label": "Manual cards (Post blocks)" }
      ],
      "info": "Post blocks are also shown while the selected blog has no articles."
    },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Number of articles", "min": 2, "max": 12, "step": 1, "default": 8, "visible_if": "{{ section.settings.source == 'blog' }}" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "article", "id": "article", "label": "Article", "info": "Optional. Fields left empty below are filled from this article." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Category tag", "default": "Hair Care" },
        { "type": "text", "id": "date", "label": "Date", "default": "Oct 12, 2024" },
        { "type": "text", "id": "title", "label": "Title", "default": "5 Everyday Habits for Stronger, Healthier Hair" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "Small daily habits can make a big difference. Discover expert-backed tips to keep your hair stronger, smoother and healthier." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the selected article, then the View all link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossian Blog",
      "blocks": [
        { "type": "post", "settings": { "tag": "Hair Care", "date": "Oct 12, 2024", "title": "5 Everyday Habits for Stronger, Healthier Hair", "excerpt": "Small daily habits can make a big difference. Discover expert-backed tips to keep your hair stronger, smoother and healthier." } },
        { "type": "post", "settings": { "tag": "Skin Care", "date": "Oct 08, 2024", "title": "How to Build a Simple Skincare Routine", "excerpt": "A step-by-step guide to creating an effective skincare routine for cleaner, brighter and healthier skin — no complicated steps." } },
        { "type": "post", "settings": { "tag": "Ingredients", "date": "Sep 28, 2024", "title": "Spotlight on Fiber Plex Technology", "excerpt": "Discover how Fiber Plex works to protect, strengthen and maintain your hair while delivering visible results." } },
        { "type": "post", "settings": { "tag": "Tips & Guides", "date": "Sep 20, 2024", "title": "How to Keep Your Hair Color Vibrant for Longer", "excerpt": "Expert tips and care routines to maintain your salon-fresh hair color and prevent fading." } }
      ]
    }
  ]
}
{% endschema %}
