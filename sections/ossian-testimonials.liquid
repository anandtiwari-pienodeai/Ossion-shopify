<div
  class="ossian-testimonials section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ossian-testimonials__header">
        {% if section.settings.heading != blank %}
          <h2 class="ossian-testimonials__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ossian-testimonials__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ossian-testimonials__grid">
      {% for block in section.blocks %}
        <div class="ossian-testimonials__card" {{ block.shopify_attributes }}>
          <div class="ossian-testimonials__stars" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="0.5" aria-hidden="true"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"></polygon></svg>
            {% endfor %}
          </div>
          <blockquote class="ossian-testimonials__quote">"{{ block.settings.quote }}"</blockquote>
          <div class="ossian-testimonials__reviewer">
            <div class="ossian-testimonials__reviewer-info">
              <p class="ossian-testimonials__reviewer-name">{{ block.settings.name }}</p>
              <p class="ossian-testimonials__reviewer-role">{{ block.settings.role }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-testimonials__header {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ossian-testimonials__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: #111827;
  }

  .ossian-testimonials__subtitle {
    font-size: 1rem;
    color: #6b7280;
    margin: 0;
  }

  .ossian-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 989px) {
    .ossian-testimonials__grid {
      grid-template-columns: 1fr;
    }
  }

  .ossian-testimonials__card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ossian-testimonials__stars {
    display: flex;
    gap: 4px;
  }

  .ossian-testimonials__quote {
    font-size: 0.9375rem;
    color: #374151;
    line-height: 1.75;
    margin: 0;
    flex: 1;
    font-style: italic;
  }

  .ossian-testimonials__reviewer {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 8px;
    border-top: 1px solid #f3f4f6;
  }

  .ossian-testimonials__reviewer-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ossian-testimonials__reviewer-name {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }

  .ossian-testimonials__reviewer-role {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product is amazing and has transformed my salon services!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Salon Owner"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Loved by Professionals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "See what salon experts say about OSSION"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
