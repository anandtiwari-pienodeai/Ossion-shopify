<div
  class="ossian-about-pillars"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-about-pillars__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ossian-about-pillars__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="ossian-about-pillars__grid">
      {% for block in section.blocks %}
        <div class="ossian-about-pillars__item" {{ block.shopify_attributes }}>
          <div class="ossian-about-pillars__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'lightbulb' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21h6M12 3a6 6 0 0 1 6 6c0 2.22-1.21 4.16-3 5.2V17H9v-2.8A6 6 0 0 1 6 9a6 6 0 0 1 6-6z"/></svg>
              {% when 'heart' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {% when 'leaf' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 19.22A16 16 0 0 0 22 3s-7 2-5 5c0 0-5.45 3.45-5 8 2.5-3 5-3 7-8"/></svg>
              {% when 'award' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21,13.89 7,23 12,20 17,23 15.79,13.88"/></svg>
              {% when 'flask' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M8 3v7L5.5 17A2 2 0 0 0 7.39 20h9.22A2 2 0 0 0 18.5 17L16 10V3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              {% when 'shield' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9,12 11,14 15,10"/></svg>
              {% when 'star' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
            {% endcase %}
          </div>
          <h3 class="ossian-about-pillars__item-heading">{{ block.settings.heading }}</h3>
          <p class="ossian-about-pillars__item-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-about-pillars {
    background: #ffffff;
  }

  .ossian-about-pillars__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .ossian-about-pillars__heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #111827;
    text-align: center;
    margin: 0;
  }

  .ossian-about-pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .ossian-about-pillars__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ossian-about-pillars__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #eff6ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e3a5f;
    flex-shrink: 0;
  }

  .ossian-about-pillars__item-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }

  .ossian-about-pillars__item-text {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ossian-about-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ossian-about-pillars__inner {
      padding: 0 20px;
      gap: 32px;
    }
    .ossian-about-pillars__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About - What We Stand For",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lightbulb", "label": "Lightbulb" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "award", "label": "Award" },
            { "value": "flask", "label": "Flask" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" }
          ],
          "default": "lightbulb"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Innovation First"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Pioneering advanced formulations with cutting-edge scientific research and technology."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What We Stand For"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About - What We Stand For",
      "settings": { "heading": "What We Stand For" },
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "lightbulb",
            "heading": "Innovation First",
            "text": "Pioneering advanced formulations with cutting-edge scientific research and technology that sets new beauty standards."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "heading": "Customer-Centric",
            "text": "Every product is designed with your beauty goals in mind, ensuring satisfaction and visible results."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "leaf",
            "heading": "Natural Excellence",
            "text": "Harnessing the power of natural ingredients combined with regulatory compliance in every formula."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "award",
            "heading": "Professional Quality",
            "text": "Salon-grade formulations that deliver professional results in the comfort of your home."
          }
        }
      ]
    }
  ]
}
{% endschema %}
