<div
  class="ossian-featured-collection"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-featured-collection__inner">
    <div class="ossian-featured-collection__content">
      {% if section.settings.label != blank %}
        <div class="ossian-featured-collection__label">{{ section.settings.label }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ossian-featured-collection__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="ossian-featured-collection__description">{{ section.settings.description }}</p>
      {% endif %}
      <div class="ossian-featured-collection__bullets">
        {% if section.settings.bullet_1 != blank %}
          <div class="ossian-featured-collection__bullet">
            <span class="ossian-featured-collection__bullet-dot ossian-featured-collection__bullet-dot--green"></span>
            <span>{{ section.settings.bullet_1 }}</span>
          </div>
        {% endif %}
        {% if section.settings.bullet_2 != blank %}
          <div class="ossian-featured-collection__bullet">
            <span class="ossian-featured-collection__bullet-dot ossian-featured-collection__bullet-dot--blue"></span>
            <span>{{ section.settings.bullet_2 }}</span>
          </div>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_url }}" class="ossian-featured-collection__btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <div class="ossian-featured-collection__image-side">
      <div class="ossian-featured-collection__image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1184 | image_tag: loading: 'lazy', class: 'ossian-featured-collection__image', alt: section.settings.heading }}
        {% else %}
          <div class="ossian-featured-collection__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
      {% if section.settings.price_label != blank or section.settings.price != blank %}
        <div class="ossian-featured-collection__price-badge">
          {% if section.settings.price_label != blank %}
            <p class="ossian-featured-collection__price-label">{{ section.settings.price_label }}</p>
          {% endif %}
          {% if section.settings.price != blank %}
            <p class="ossian-featured-collection__price">{{ section.settings.price }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-featured-collection {
    background: linear-gradient(163deg, #f3f4f6 8%, #f9fafb 92%);
    overflow: hidden;
  }

  .ossian-featured-collection__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    min-height: 700px;
  }

  @media screen and (max-width: 989px) {
    .ossian-featured-collection__inner {
      grid-template-columns: 1fr;
      padding: 48px 20px;
      min-height: unset;
    }
    .ossian-featured-collection__image-side {
      order: -1;
    }
  }

  .ossian-featured-collection__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 64px 0;
  }

  @media screen and (max-width: 989px) {
    .ossian-featured-collection__content {
      padding: 0;
    }
  }

  .ossian-featured-collection__label {
    display: inline-flex;
    align-items: center;
    background: rgba(30, 58, 95, 0.1);
    color: #1e3a5f;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    width: fit-content;
  }

  .ossian-featured-collection__heading {
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 700;
    color: #101828;
    line-height: 1.1;
    margin: 0;
  }

  .ossian-featured-collection__description {
    font-size: 1.125rem;
    color: #4a5565;
    line-height: 1.6;
    margin: 0;
    max-width: 512px;
  }

  .ossian-featured-collection__bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ossian-featured-collection__bullet {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: #364153;
  }

  .ossian-featured-collection__bullet-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ossian-featured-collection__bullet-dot--green { background: #00c950; }
  .ossian-featured-collection__bullet-dot--blue { background: #2b7fff; }

  .ossian-featured-collection__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    background: #1e3a5f;
    color: #fff;
    width: fit-content;
    transition: opacity 0.2s;
  }

  .ossian-featured-collection__btn:hover { opacity: 0.85; }

  .ossian-featured-collection__image-side {
    position: relative;
    padding: 64px 0;
  }

  @media screen and (max-width: 989px) {
    .ossian-featured-collection__image-side { padding: 0; }
  }

  .ossian-featured-collection__image-wrap {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    aspect-ratio: 1 / 1;
  }

  .ossian-featured-collection__image,
  .ossian-featured-collection__image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ossian-featured-collection__price-badge {
    position: absolute;
    bottom: 80px;
    right: 0;
    background: #fff;
    border: 2px solid #1e3a5f;
    border-radius: 16px;
    padding: 18px 26px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 989px) {
    .ossian-featured-collection__price-badge {
      bottom: 16px;
      right: 16px;
    }
  }

  .ossian-featured-collection__price-label {
    font-size: 0.875rem;
    color: #4a5565;
    margin: 0 0 4px;
  }

  .ossian-featured-collection__price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label badge",
      "default": "Hair Color Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vibrant Color, Lasting Shine"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Professional-grade hair color formulas for salon-quality results at home"
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet point 1",
      "default": "3 Products Available"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet point 2",
      "default": "Professional Quality"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price badge label",
      "default": "Starting at"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price badge value",
      "default": "₹1999"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
