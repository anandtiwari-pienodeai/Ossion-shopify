<div
  class="ossian-about-story"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-about-story__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ossian-about-story__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.content != blank %}
      <div class="ossian-about-story__content rte">{{ section.settings.content }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .ossian-about-story {
    background: #ffffff;
  }

  .ossian-about-story__inner {
    max-width: 896px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ossian-about-story__heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #111827;
    text-align: center;
    margin: 0;
  }

  .ossian-about-story__content {
    color: #4b5563;
    line-height: 1.75;
    font-size: 1rem;
  }

  .ossian-about-story__content p + p {
    margin-top: 1.25rem;
  }

  @media screen and (max-width: 749px) {
    .ossian-about-story__inner {
      padding: 0 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About - Our Story",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Founded in 2010, OSSION Beauty emerged from a simple belief: that everyone deserves access to professional-grade, science-backed beauty products. What started as a small laboratory in Mumbai has grown into a trusted brand serving millions of customers worldwide.</p><p>Over the years, we've grown from a small laboratory to an internationally recognised brand, always staying true to our commitment: to create safe, effective beauty solutions that truly deliver results.</p><p>Today, OSSION Beauty stands at the forefront of skincare innovation, offering a comprehensive range of products that blend scientific precision with natural ingredients. Our formulations are developed by leading dermatologists and beauty experts who are passionate about delivering real, visible results.</p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About - Our Story"
    }
  ]
}
{% endschema %}
