{%- comment -%}
  Ossian About Story — chaptered brand narrative. Each chapter pairs a
  sticky label rail with a generous measure of body copy, an optional
  emphasis line, and an optional bordered callout with proof icons.
{%- endcomment -%}

{%- assign chapters = section.blocks | where: 'type', 'chapter' -%}

<section
  class="abs"
  id="abs-{{ section.id }}"
  style="background-color: {{ section.settings.background_color }};"
>
  {%- if section.settings.show_top_wave -%}
    <div class="abs__wave abs__wave--top" aria-hidden="true">
      <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
        <path d="M0,54 C240,18 480,74 720,52 C960,30 1200,72 1440,44 L1440,0 L0,0 Z"/>
      </svg>
    </div>
  {%- endif -%}

  <div class="abs__inner">
    {%- for block in chapters -%}
      <article class="abs__chapter" {{ block.shopify_attributes }}>

        <div class="abs__rail">
          {%- if block.settings.label != blank -%}
            <span class="abs__label">{{ block.settings.label }}</span>
          {%- endif -%}
          <span class="abs__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        </div>

        <div class="abs__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="abs__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.body_text != blank -%}
            <div class="abs__body">{{ block.settings.body_text }}</div>
          {%- endif -%}

          {%- if block.settings.emphasis != blank -%}
            <p class="abs__emphasis">{{ block.settings.emphasis }}</p>
          {%- endif -%}

          {%- if block.settings.callout_text != blank -%}
            <aside class="abs__callout">
              {%- assign icon_list = block.settings.callout_icons | split: ',' -%}
              {%- if icon_list.size > 0 -%}
                <span class="abs__callout-icons" aria-hidden="true">
                  {%- for icon in icon_list -%}
                    {%- assign icon_key = icon | strip -%}
                    <span class="abs__callout-icon">
                      {%- case icon_key -%}
                        {%- when 'leaf' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20c0-8 5-13 16-14 0 10-5 15-13 15H4z"/><path d="M8.5 15.5C11 13 14 11.5 17 11"/></svg>
                        {%- when 'rabbit' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 11C7 9 6.5 5.5 8 3.5c1.4-1.8 2.8.6 3 3.4"/><path d="M13 7c.4-2.8 1.8-5 3.1-3.3C17.6 5.7 17 9.2 15.5 11"/><path d="M6.5 14.5a5.5 5.5 0 0 1 11 0c0 3.6-2.4 6-5.5 6s-5.5-2.4-5.5-6z"/><circle cx="10" cy="16" r=".6" fill="currentColor"/><circle cx="14" cy="16" r=".6" fill="currentColor"/></svg>
                        {%- when 'drop' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7l5.7 5.6a8 8 0 1 1-11.4 0z"/></svg>
                        {%- when 'wave' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8q3-3 6 0t6 0 6 0"/><path d="M2 14q3-3 6 0t6 0 6 0"/><path d="M2 20q3-3 6 0t6 0 6 0"/></svg>
                        {%- when 'shield' -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 4 6.3v6c0 5 3.5 8.2 8 9.7 4.5-1.5 8-4.7 8-9.7v-6z"/><path d="M8.6 12.3 11 14.8l4.4-4.6"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.4 11 15l4.5-5"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- endfor -%}
                </span>
              {%- endif -%}
              <p class="abs__callout-text">{{ block.settings.callout_text }}</p>
            </aside>
          {%- endif -%}
        </div>

      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.abs {
  position: relative;
  padding: clamp(56px, 8vw, 100px) 0 clamp(56px, 8vw, 96px);
}

.abs__inner {
  max-width: 1320px;
  margin: 0 auto;
  padding-inline: 24px;
}

/* ===================== WAVE DIVIDER ===================== */
.abs__wave {
  position: absolute;
  left: 0;
  right: 0;
  line-height: 0;
  pointer-events: none;
}

.abs__wave--top {
  top: -1px;
  height: clamp(40px, 5vw, 78px);
}

.abs__wave svg {
  width: 100%;
  height: 100%;
  display: block;
}

.abs__wave--top path {
  /* Matches the hero's closing wave so the two sections read as one body of water */
  fill: #041f36;
  opacity: 0.045;
}

/* ===================== CHAPTER ===================== */
.abs__chapter {
  display: grid;
  grid-template-columns: 200px minmax(0, 1fr);
  gap: 0 56px;
  padding-block: clamp(34px, 5vw, 58px);
  border-top: 1px solid rgba(30, 58, 95, 0.12);
}

.abs__chapter:first-child {
  border-top: 0;
  padding-top: 0;
}

.abs__chapter:last-child {
  padding-bottom: 0;
}

/* ===================== LABEL RAIL ===================== */
.abs__rail {
  position: sticky;
  top: 110px;
  align-self: start;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.abs__label {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: #1e3a5f;
}

.abs__index {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #9fb0c6;
}

.abs__index::before {
  content: "";
  display: block;
  width: 34px;
  height: 2px;
  margin-bottom: 12px;
  background: #7c5cbf;
}

/* ===================== BODY ===================== */
.abs__heading {
  margin: 0 0 20px;
  max-width: 22ch;
  font-size: clamp(1.5rem, 3vw, 2.3rem);
  font-weight: 300;
  line-height: 1.18;
  letter-spacing: -0.005em;
  color: #1e3a5f;
}

.abs__body {
  max-width: 64ch;
  font-size: clamp(1rem, 1.35vw, 1.16rem);
  font-weight: 300;
  line-height: 1.85;
  color: #3d5673;
}

.abs__body p {
  margin: 0 0 1.15em;
}

.abs__body p:last-child {
  margin-bottom: 0;
}

/* First line of the opening chapter gets a touch more presence */
.abs__chapter:first-child .abs__body > p:first-child {
  font-size: 1.1em;
  color: #2c435e;
}

.abs__emphasis {
  margin: 30px 0 0;
  max-width: 24ch;
  font-size: clamp(1.25rem, 2.4vw, 1.75rem);
  font-weight: 300;
  line-height: 1.32;
  letter-spacing: -0.005em;
  color: #1e3a5f;
  padding-left: 22px;
  border-left: 2px solid #7c5cbf;
}

/* ===================== CALLOUT ===================== */
.abs__callout {
  margin-top: 32px;
  max-width: 60ch;
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 20px 24px;
  border: 1px solid rgba(124, 92, 191, 0.26);
  border-radius: 14px;
  background: linear-gradient(120deg, rgba(124, 92, 191, 0.06), rgba(10, 92, 122, 0.06));
}

.abs__callout-icons {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.abs__callout-icon {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #ffffff;
  border: 1px solid rgba(30, 58, 95, 0.1);
  color: #7c5cbf;
}

.abs__callout-icon svg {
  width: 19px;
  height: 19px;
  display: block;
}

.abs__callout-text {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.6;
  color: #1e3a5f;
}

/* ===================== RESPONSIVE ===================== */
@media screen and (max-width: 999px) {
  .abs__chapter {
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 0 34px;
  }
}

@media screen and (max-width: 749px) {
  .abs__inner {
    padding-inline: 20px;
  }

  /* Rail folds above the copy — sticky has nowhere useful to go on a phone */
  .abs__chapter {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .abs__rail {
    position: static;
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }

  .abs__index::before {
    display: none;
  }

  .abs__heading,
  .abs__body,
  .abs__emphasis {
    max-width: none;
  }

  .abs__callout {
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "About Story",
  "tag": "section",
  "class": "ossian-about-story-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_top_wave",
      "label": "Show wave divider at top",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Rail label",
          "default": "Journey"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (optional)"
        },
        {
          "type": "richtext",
          "id": "body_text",
          "label": "Body copy"
        },
        {
          "type": "text",
          "id": "emphasis",
          "label": "Emphasis line (optional)",
          "info": "Pulled out larger, beside an accent rule."
        },
        {
          "type": "header",
          "content": "Callout"
        },
        {
          "type": "text",
          "id": "callout_text",
          "label": "Callout text (optional)"
        },
        {
          "type": "text",
          "id": "callout_icons",
          "label": "Callout icons",
          "info": "Comma-separated: leaf, rabbit, drop, wave, shield, check",
          "default": "leaf, rabbit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Story",
      "blocks": [
        { "type": "chapter", "settings": { "label": "Journey" } },
        { "type": "chapter", "settings": { "label": "Philosophy" } }
      ]
    }
  ]
}
{% endschema %}
