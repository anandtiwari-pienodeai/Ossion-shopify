{{ 'section-ossian-pdp-breadcrumb.css' | asset_url | stylesheet_tag }}
<nav class="pdp-breadcrumb" id="pdp-breadcrumb-{{ section.id }}" aria-label="breadcrumb">
  <div class="page-width pdp-breadcrumb__inner">
    <ol class="pdp-breadcrumb__list">
      <li class="pdp-breadcrumb__item">
        <a href="{{ routes.root_url }}" class="pdp-breadcrumb__link">Home</a>
      </li>

      {%- if product.type != blank -%}
        <li class="pdp-breadcrumb__sep" aria-hidden="true">›</li>
        <li class="pdp-breadcrumb__item">
          {%- assign type_url = product.type | handle | prepend: '/collections/' -%}
          <a href="{{ section.settings.collection_url | default: type_url }}" class="pdp-breadcrumb__link">
            {{ product.type }}
          </a>
        </li>
      {%- elsif section.settings.parent_label != blank -%}
        <li class="pdp-breadcrumb__sep" aria-hidden="true">›</li>
        <li class="pdp-breadcrumb__item">
          <a href="{{ section.settings.parent_url | default: '#' }}" class="pdp-breadcrumb__link">
            {{ section.settings.parent_label }}
          </a>
        </li>
      {%- endif -%}

      <li class="pdp-breadcrumb__sep" aria-hidden="true">›</li>
      <li class="pdp-breadcrumb__item pdp-breadcrumb__item--current" aria-current="page">
        {{ product.title }}
      </li>
    </ol>
  </div>
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ request.origin | append: routes.root_url | json }}
    },
    {%- if product.type != blank -%}
      {%- assign type_url = product.type | handle | prepend: '/collections/' -%}
      {%- assign crumb_url = section.settings.collection_url | default: type_url -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.type | json }},
        "item": {{ request.origin | append: crumb_url | json }}
      },
    {%- elsif section.settings.parent_label != blank -%}
      {%- assign crumb_url = section.settings.parent_url | default: '#' -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ section.settings.parent_label | json }},
        "item": {{ request.origin | append: crumb_url | json }}
      },
    {%- endif -%}
    {
      "@type": "ListItem",
      "position": {% if product.type != blank or section.settings.parent_label != blank %}3{% else %}2{% endif %},
      "name": {{ product.title | json }},
      "item": {{ request.origin | append: product.url | json }}
    }
  ]
}
</script>


{% schema %}
{
  "name": "PDP Breadcrumb",
  "tag": "section",
  "class": "ossian-pdp-breadcrumb-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "parent_label",
      "label": "Parent label (fallback if no product type)",
      "default": "Hair Care"
    },
    {
      "type": "url",
      "id": "parent_url",
      "label": "Parent URL"
    },
    {
      "type": "url",
      "id": "collection_url",
      "label": "Collection URL override"
    }
  ],
  "presets": [
    {
      "name": "PDP Breadcrumb",
      "settings": {
        "parent_label": "Hair Care"
      }
    }
  ]
}
{% endschema %}
