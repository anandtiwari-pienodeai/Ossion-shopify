{%- comment -%}
  Ossion Brand Pillars — an image panel on the left (separate desktop / mobile images),
  a scrollable row of numbered pillar
  cards on the right with prev/next buttons and a progress bar.
  Every image is set in the theme editor.
{%- endcomment -%}

{%- liquid
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'
  assign s = section.settings
  assign hero_desktop = s.hero_image | default: s.hero_image_mobile
  assign hero_mobile = s.hero_image_mobile | default: s.hero_image
  assign hero_ratio = hero_desktop.aspect_ratio | default: 0.9
-%}

<section
  class="bpillars"
  id="bpillars-{{ section.id }}"
  style="--bp-height: {{ s.section_height }}px; --bp-hero-ratio: {{ hero_ratio }};"
>
  {%- comment -%} Left: image only, separate desktop and mobile files {%- endcomment -%}
  {%- if hero_desktop != blank -%}
    {%- if s.hero_link != blank -%}
      <a href="{{ s.hero_link }}" class="bpillars__hero" aria-label="{{ s.hero_alt | default: shop.name | escape }}">
    {%- else -%}
      <div class="bpillars__hero">
    {%- endif -%}
      <picture>
        {%- if hero_mobile != hero_desktop -%}
          <source
            media="(max-width: 989px)"
            srcset="
              {{- hero_mobile | image_url: width: 500 }} 500w,
              {{ hero_mobile | image_url: width: 650 }} 650w,
              {{ hero_mobile | image_url: width: 750 }} 750w,
              {{ hero_mobile | image_url: width: 1000 }} 1000w,
              {{ hero_mobile | image_url: width: 1400 }} 1400w
            "
            sizes="100vw"
            width="{{ hero_mobile.width }}"
            height="{{ hero_mobile.height }}"
          >
        {%- endif -%}
        {{
          hero_desktop
          | image_url: width: 1600
          | image_tag:
            class: 'bpillars__hero-img',
            alt: s.hero_alt,
            loading: 'lazy',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      </picture>
    {%- if s.hero_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="bpillars__hero bpillars__hero--empty">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'bpillars__hero-img' }}
    </div>
  {%- endif -%}

  {%- comment -%} Right: pillar cards carousel {%- endcomment -%}
  {%- if pillar_blocks.size > 0 -%}
    <div class="bpillars__rail" data-bpillars-rail>
      <div class="bpillars__viewport">
        <div class="bpillars__track" data-bpillars-track>
          {%- for block in pillar_blocks -%}
            {%- liquid
              assign b = block.settings
              assign opacity = b.overlay_opacity | default: 70 | divided_by: 100.0
              assign card_index = forloop.index | prepend: '0' | slice: -2, 2
            -%}
            <a
              href="{{ b.button_link | default: '#' }}"
              class="pillar-card"
              style="--card-shade: {{ opacity }};"
              {{ block.shopify_attributes }}
            >
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 800
                  | image_tag:
                    class: 'pillar-card__img',
                    alt: '',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '(min-width: 990px) 320px, 78vw'
                }}
              {%- endif -%}
              <span class="pillar-card__shade" aria-hidden="true"></span>

              <span class="pillar-card__top">
                <span class="pillar-card__index">{{ card_index }}</span>
                {%- if b.label != blank -%}
                  <span class="pillar-card__label">{{ b.label }}</span>
                {%- endif -%}
                {%- if b.heading_line1 != blank or b.heading_line2 != blank -%}
                  <span class="pillar-card__heading">
                    {%- if b.heading_line1 != blank -%}<span>{{ b.heading_line1 }}</span>{%- endif -%}
                    {%- if b.heading_line2 != blank -%}
                      <span{% if b.accent_line2 %} class="bpillars__accent"{% endif %}>{{ b.heading_line2 }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- if b.body_text != blank -%}
                  <span class="pillar-card__body">{{ b.body_text }}</span>
                {%- endif -%}
              </span>

              {%- if b.button_label != blank -%}
                <span class="pillar-card__cta">
                  <span class="pillar-card__cta-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                  <span class="pillar-card__cta-label">{{ b.button_label }}</span>
                </span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        <button type="button" class="bpillars__edge-next" data-bpillars-next aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>

      <div class="bpillars__controls">
        <button type="button" class="bpillars__nav" data-bpillars-prev aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <div class="bpillars__progress" aria-hidden="true">
          <span class="bpillars__progress-thumb" data-bpillars-thumb></span>
        </div>
        <button type="button" class="bpillars__nav" data-bpillars-next aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('bpillars-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-bpillars-track]');
    var thumb = root.querySelector('[data-bpillars-thumb]');
    if (!track) return;

    function step() {
      var card = track.querySelector('.pillar-card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var visible = track.scrollWidth ? track.clientWidth / track.scrollWidth : 1;
      if (thumb) {
        thumb.style.width = Math.max(visible * 100, 12) + '%';
        var progress = max > 0 ? track.scrollLeft / max : 0;
        thumb.style.left = progress * (100 - Math.max(visible * 100, 12)) + '%';
      }
      root.querySelectorAll('[data-bpillars-prev]').forEach(function (btn) {
        btn.disabled = track.scrollLeft <= 2;
      });
      root.querySelectorAll('[data-bpillars-next]').forEach(function (btn) {
        btn.disabled = track.scrollLeft >= max - 2;
      });
    }

    root.querySelectorAll('[data-bpillars-prev]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
    });
    root.querySelectorAll('[data-bpillars-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
    });

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% stylesheet %}
  .bpillars {
    --bp-navy: #0f2546;
    --bp-blue: #3b86ff;
    display: grid;
    /* The image column is as wide as the image needs at the section height, so the
       image is shown whole (never cropped); the cards take the remaining width. */
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: calc(var(--bp-height, 680px) - 80px);
    padding: 40px 60px;
    background: #f2f5f9;
    color: #fff;
  }

  .bpillars__accent {
    color: var(--bp-blue);
  }

  /* ---------- Image panel ---------- */
  .bpillars__hero {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: var(--bp-hero-ratio, 0.9);
    max-width: 58vw;
    overflow: hidden;
    background: #0a1a36;
  }

  .bpillars__hero picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bpillars__hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* contain: only matters if a very wide image hits the max-width cap */
    object-fit: contain;
    object-position: center;
  }

  /* ---------- Cards rail ---------- */
  .bpillars__rail {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-inline-start: clamp(16px, 1.6vw, 24px);
  }

  .bpillars__viewport {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .bpillars__track {
    display: flex;
    gap: clamp(10px, 1vw, 16px);
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
  }

  .bpillars__track::-webkit-scrollbar {
    display: none;
  }

  .pillar-card {
    position: relative;
    flex: 0 0 clamp(250px, 21vw, 320px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 0;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(160deg, #1d3b66, #0a1a36);
    color: #fff;
    text-decoration: none;
    scroll-snap-align: start;
  }

  .pillar-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .pillar-card:hover .pillar-card__img {
    transform: scale(1.04);
  }

  /* Darkens the top for the copy and the bottom for the button */
  .pillar-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(4 14 32 / calc(var(--card-shade, 0.7) * 0.95)) 0%,
      rgb(4 14 32 / calc(var(--card-shade, 0.7) * 0.55)) 38%,
      rgb(4 14 32 / 0) 60%,
      rgb(4 14 32 / calc(var(--card-shade, 0.7) * 0.6)) 100%
    );
  }

  .pillar-card__top,
  .pillar-card__cta {
    position: relative;
    z-index: 1;
  }

  .pillar-card__top {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2vw, 30px) clamp(20px, 2vw, 30px) 0;
  }

  .pillar-card__index {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .pillar-card__index::after {
    content: '';
    width: 38px;
    height: 1px;
    background: currentColor;
    opacity: 0.85;
  }

  .pillar-card__label {
    margin-top: 14px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .pillar-card__heading {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
    font-size: clamp(1.45rem, 1.9vw, 1.95rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .pillar-card__body {
    margin-top: 12px;
    color: rgb(255 255 255 / 0.9);
    font-size: clamp(0.9rem, 1vw, 1.02rem);
    line-height: 1.4;
  }

  .pillar-card__cta {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 clamp(20px, 2vw, 28px) clamp(20px, 2vw, 28px);
    font-size: 1rem;
    font-weight: 600;
  }

  .pillar-card__cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #fff;
    color: var(--bp-navy);
    transition: background-color 0.2s, color 0.2s;
  }

  .pillar-card:hover .pillar-card__cta-icon {
    background: var(--bp-blue);
    color: #fff;
  }

  .bpillars__edge-next {
    position: absolute;
    top: 50%;
    right: clamp(8px, 1vw, 18px);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #fff;
    color: var(--bp-navy);
    box-shadow: 0 6px 18px rgb(10 23 48 / 0.2);
    transform: translateY(-50%);
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .bpillars__edge-next:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .bpillars__controls {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 24px);
    padding-top: clamp(14px, 1.4vw, 20px);
  }

  .bpillars__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid rgb(15 37 70 / 0.12);
    border-radius: 50%;
    background: #fff;
    color: var(--bp-navy);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }

  .bpillars__nav:hover:not(:disabled) {
    background: var(--bp-navy);
    color: #fff;
  }

  .bpillars__nav:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .bpillars__progress {
    position: relative;
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: rgb(15 37 70 / 0.1);
  }

  .bpillars__progress-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 25%;
    border-radius: 4px;
    background: #1f5fe0;
    transition: left 0.15s linear, width 0.2s;
  }

  /* ---------- Tablet / mobile: stack ---------- */
  @media (max-width: 989px) {
    .bpillars {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      padding: 24px 16px;
    }

    .bpillars__hero {
      height: auto;
      aspect-ratio: auto;
      max-width: none;
    }

    /* Show the whole mobile image at its own proportions */
    .bpillars__hero-img {
      position: static;
      height: auto;
    }

    .bpillars__hero--empty .bpillars__hero-img {
      aspect-ratio: 4 / 5;
    }

    .bpillars__rail {
      padding: 16px 0 0;
    }

    .pillar-card {
      flex-basis: 78vw;
      max-width: 340px;
      min-height: 480px;
    }

    .bpillars__edge-next {
      display: none;
    }
  }

  @media (max-width: 599px) {
    .bpillars__nav {
      width: 42px;
      height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-card__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Pillars",
  "tag": "section",
  "class": "ossian-brand-pillars-section",
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (desktop)",
      "info": "Includes the 40px top/bottom padding. The left image is shown whole at this height; its width follows the image's proportions.",
      "min": 520,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "header",
      "content": "Left image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop image",
      "info": "Fills the left panel (about 41% wide × section height), cropped to fit. Around 1200 × 1360 works well."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile image",
      "info": "Shown below 990px at its full proportions. Leave empty to reuse the desktop image."
    },
    {
      "type": "text",
      "id": "hero_alt",
      "label": "Image description (alt text)",
      "info": "Describe any text in the image for screen readers."
    },
    {
      "type": "url",
      "id": "hero_link",
      "label": "Image link"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait image, about 640 × 1400. Keep the top darker or plain for the text."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Small uppercase line under the number, e.g. Our Science"
        },
        {
          "type": "text",
          "id": "heading_line1",
          "label": "Heading line 1"
        },
        {
          "type": "text",
          "id": "heading_line2",
          "label": "Heading line 2"
        },
        {
          "type": "checkbox",
          "id": "accent_line2",
          "label": "Show heading line 2 in blue",
          "default": true
        },
        {
          "type": "textarea",
          "id": "body_text",
          "label": "Text"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image darkening",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 70
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "label": "Our Science",
            "heading_line1": "From the Depths of",
            "heading_line2": "Marine Science",
            "body_text": "Advanced formulations inspired by the ocean. Proven by science.",
            "button_label": "Our Science"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "Hair Care",
            "heading_line1": "Complete Care for",
            "heading_line2": "Every Strand",
            "body_text": "Shampoo, conditioner, treatments and more for stronger, healthier hair.",
            "button_label": "Shop Hair Care"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "Styling",
            "heading_line1": "Style with",
            "heading_line2": "Confidence",
            "body_text": "Professional styling solutions for every look and occasion.",
            "button_label": "Shop Styling"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "label": "Real Results",
            "heading_line1": "Trusted by",
            "heading_line2": "Professionals",
            "body_text": "Salon performance. Everyday confidence.",
            "button_label": "Our Promise"
          }
        }
      ]
    }
  ]
}
{% endschema %}
