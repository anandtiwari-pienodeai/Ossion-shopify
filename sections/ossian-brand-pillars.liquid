<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Give+You+Glory&display=swap" rel="stylesheet">

{%- assign pillar_blocks = section.blocks | where: "type", "pillar" -%}

<section class="bpillars" id="bpillars-{{ section.id }}">
  <div class="bpillars__row">

    <!-- Left: hero image + brand lockup + CTA -->
    <a href="{{ section.settings.hero_link | default: '#' }}" class="bpillars__hero">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'bpillars__hero-img', alt: '', loading: 'lazy', widths: '400,700,1000,1200' }}
      {%- else -%}
        <div class="bpillars__hero-ph"></div>
      {%- endif -%}
      {%- if section.settings.hero_brand != blank or section.settings.hero_brand_sub != blank -%}
        <span class="bpillars__hero-brand">
          {%- if section.settings.hero_brand != blank -%}<span class="bpillars__hero-brand-name">{{ section.settings.hero_brand }}</span>{%- endif -%}
          {%- if section.settings.hero_brand_sub != blank -%}<span class="bpillars__hero-brand-sub">{{ section.settings.hero_brand_sub }}</span>{%- endif -%}
        </span>
      {%- endif -%}
      {%- if section.settings.hero_tagline_line1 != blank or section.settings.hero_tagline_line2 != blank -%}
        <span class="bpillars__hero-tagline">
          {%- if section.settings.hero_tagline_line1 != blank -%}<span>{{ section.settings.hero_tagline_line1 }}</span>{%- endif -%}
          {%- if section.settings.hero_tagline_line2 != blank -%}<span>{{ section.settings.hero_tagline_line2 }}</span>{%- endif -%}
        </span>
      {%- endif -%}
      {%- if section.settings.hero_cta_label != blank -%}
        <span class="bpillars__hero-scrim" aria-hidden="true"></span>
        <span class="bpillars__cta">
          {{ section.settings.hero_cta_label }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
      {%- endif -%}
    </a>

    <!-- Right: heading + pillar cards -->
    <div class="bpillars__right">
      {%- if section.settings.eyebrow_script != blank or section.settings.heading_white != blank or section.settings.heading_accent != blank -%}
        <div class="bpillars__heading">
          {%- if section.settings.eyebrow_script != blank -%}
            <p class="bpillars__eyebrow">{{ section.settings.eyebrow_script }}</p>
          {%- endif -%}
          {%- if section.settings.heading_white != blank or section.settings.heading_accent != blank -%}
            <p class="bpillars__heading-main">
              {%- if section.settings.heading_white != blank -%}<span>{{ section.settings.heading_white }}</span>{%- endif -%}
              {%- if section.settings.heading_accent != blank -%}<span class="bpillars__heading-accent">{{ section.settings.heading_accent }}</span>{%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if pillar_blocks.size > 0 -%}
        <div class="bpillars__cards-wrap">
        <div class="bpillars__cards" id="bpillars-carousel-{{ section.id }}">
          {%- for block in pillar_blocks -%}
            {%- assign opacity = block.settings.overlay_opacity | default: 70 | divided_by: 100.0 -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="pillar-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: class: 'pillar-card__img', alt: '', loading: 'lazy', widths: '300,450,600' }}
              {%- else -%}
                <div class="pillar-card__img pillar-card__img--placeholder"></div>
              {%- endif -%}
              <span class="pillar-card__scrim" style="background: linear-gradient(to bottom, rgba(0,14,38,0) 0%, rgba(0,14,38,{{ opacity }}) 40%, rgba(0,14,38,{{ opacity }}) 100%);" aria-hidden="true"></span>
              <span class="pillar-card__content">
                {%- if block.settings.heading_line1 != blank or block.settings.heading_line2 != blank -%}
                  <span class="pillar-card__heading">
                    {%- if block.settings.heading_line1 != blank -%}<span class="pillar-card__heading-line">{{ block.settings.heading_line1 }}</span>{%- endif -%}
                    {%- if block.settings.heading_line2 != blank -%}
                      <span class="pillar-card__heading-line{% if block.settings.accent_line2 %} pillar-card__heading-line--accent{% endif %}">{{ block.settings.heading_line2 }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.body_text != blank -%}
                  <span class="pillar-card__body">{{ block.settings.body_text }}</span>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="pillar-card__cta">
                    {{ block.settings.button_label }}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                {%- endif -%}
              </span>
            </a>
          {%- endfor -%}
        </div>

        <button class="bpillars__nav bpillars__nav--prev" id="bpillars-prev-{{ section.id }}" aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="bpillars__nav bpillars__nav--next" id="bpillars-next-{{ section.id }}" aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
(function () {
  var carousel = document.getElementById('bpillars-carousel-{{ section.id }}');
  var prevBtn  = document.getElementById('bpillars-prev-{{ section.id }}');
  var nextBtn  = document.getElementById('bpillars-next-{{ section.id }}');
  if (!carousel || !prevBtn || !nextBtn) return;

  function getScrollAmount() {
    var card = carousel.querySelector('.pillar-card');
    if (!card) return 300;
    return card.offsetWidth;
  }

  nextBtn.addEventListener('click', function () {
    carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
  });
  prevBtn.addEventListener('click', function () {
    carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
  });

  function updateArrows() {
    var atStart = carousel.scrollLeft <= 4;
    var atEnd   = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 4;
    prevBtn.style.opacity       = atStart ? '0.35' : '1';
    prevBtn.style.pointerEvents = atStart ? 'none'  : 'auto';
    nextBtn.style.opacity       = atEnd   ? '0.35' : '1';
    nextBtn.style.pointerEvents = atEnd   ? 'none'  : 'auto';
  }

  carousel.addEventListener('scroll', updateArrows, { passive: true });
  updateArrows();
})();
</script>

{% stylesheet %}

.bpillars,
.bpillars * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.bpillars {
  background: #000e26;
  overflow: hidden;
  margin-top: 60px;
}

.bpillars__row {
  display: flex;
  width: 100%;
  aspect-ratio: 1441 / 858;
}

/* ── Desktop — keep the whole section within one viewport ── */
@media (min-width: 901px) {
  .bpillars__row {
    height: 85vh;
    max-height: 85vh;
  }
}

/* ── Hero ── */
.bpillars__hero {
  position: relative;
  flex: 0 0 36.85%;
  height: 100%;
  display: block;
  overflow: hidden;
  text-decoration: none;
}

.bpillars__hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.bpillars__hero-ph {
  position: absolute;
  inset: 0;
  background: #0a1830;
}

.bpillars__hero-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 22%;
  background: linear-gradient(to top, rgba(0,14,38,0.75) 0%, rgba(0,14,38,0) 100%);
}

/* Brand lockup — top-left of hero */
.bpillars__hero-brand {
  position: absolute;
  left: 8.5%;
  top: 4%;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.bpillars__hero-brand-name {
  font-size: clamp(1.4rem, 3vw, 2.1rem);
  font-weight: 700;
  color: #3b82f6;
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.bpillars__hero-brand-sub {
  font-size: clamp(0.7rem, 1vw, 0.9rem);
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.18em;
  line-height: 1.4;
}

/* Tagline — centered, upper-middle of hero */
.bpillars__hero-tagline {
  position: absolute;
  left: 0;
  right: 0;
  top: 17%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.bpillars__hero-tagline span {
  font-size: clamp(1.05rem, 1.7vw, 1.5rem);
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.08em;
  line-height: 1.5;
  text-transform: uppercase;
}

/* ── Right column ── */
.bpillars__right {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-width: 0;
}

.bpillars__heading {
  flex: 0 0 25%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 0 48px;
}

.bpillars__eyebrow {
  font-family: 'Give You Glory', cursive;
  font-size: clamp(1.4rem, 2.1vw, 2rem);
  font-weight: 400;
  color: #d9a441;
  margin: 0 0 4px;
  line-height: 1.2;
}

.bpillars__heading-main {
  font-size: clamp(1.6rem, 3.6vw, 3.5rem);
  font-weight: 700;
  color: #f1f8fc;
  margin: 0;
  line-height: 1.15;
  letter-spacing: -0.01em;
}

.bpillars__heading-accent {
  color: #3b82f6;
}

.bpillars__heading-main span:not(:last-child) {
  margin-right: 0.3em;
}

.bpillars__cta {
  position: absolute;
  left: 25px;
  bottom: 24px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 22px;
  background: #22345a;
  border: 2px solid #fff;
  border-radius: 16px;
  color: #e5e7eb;
  font-size: clamp(0.75rem, 0.97vw, 0.875rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

.bpillars__cta svg {
  flex-shrink: 0;
}

/* ── Cards row — horizontally scrollable, 3-up in view ── */
.bpillars__cards-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
}

.bpillars__cards {
  height: 100%;
  display: flex;
  min-height: 0;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.bpillars__cards::-webkit-scrollbar {
  display: none;
}

/* ── Nav arrows ── */
.bpillars__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.5);
  background: rgba(0, 14, 38, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, opacity 0.2s;
  z-index: 2;
}

.bpillars__nav:hover {
  border-color: #fff;
  background: #22345a;
}

.bpillars__nav--prev {
  left: 12px;
}

.bpillars__nav--next {
  right: 12px;
}

.pillar-card {
  position: relative;
  flex: 0 0 33.3333%;
  height: 100%;
  display: block;
  overflow: hidden;
  border: 1px solid #182130;
  border-radius: 4px;
  text-decoration: none;
  scroll-snap-align: start;
}

.pillar-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.pillar-card__img--placeholder {
  background: #0a1830;
}

.pillar-card:hover .pillar-card__img {
  transform: scale(1.04);
}

.pillar-card__scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48%;
}

.pillar-card__content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  padding: 20px 18px 22px;
  gap: 8px;
}

/* Heading — exact Figma: 20px Jost Bold, tracking -0.4px */
.pillar-card__heading {
  display: flex;
  flex-direction: column;
  font-size: clamp(0.95rem, 1.1vw, 1.25rem);
  font-weight: 700;
  color: #f1f8fc;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.pillar-card__heading-line--accent {
  color: #366cd1;
}

/* Body — exact Figma: 14px Jost Medium, tracking -0.28px */
.pillar-card__body {
  font-size: clamp(0.7rem, 0.85vw, 0.875rem);
  font-weight: 500;
  color: #f1f8fc;
  line-height: 1.4;
  letter-spacing: -0.02em;
  opacity: 0.92;
}

/* CTA — exact Figma: 14px Jost SemiBold, tracking -0.28px */
.pillar-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  margin-top: 4px;
  padding: 10px 16px;
  background: #22345a;
  border: 2px solid #fff;
  border-radius: 16px;
  color: #e5e7eb;
  font-size: clamp(0.7rem, 0.85vw, 0.875rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

.pillar-card__cta svg {
  flex-shrink: 0;
}

/* ── Tablet ── */
@media (max-width: 900px) {
  .bpillars__row {
    flex-direction: column;
    aspect-ratio: auto;
  }

  .bpillars__hero {
    flex: none;
    height: 340px;
  }

  .bpillars__right {
    height: auto;
  }

  .bpillars__heading {
    flex: none;
    padding: 32px 24px 8px;
  }

  .bpillars__cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    overflow-x: visible;
    scroll-snap-type: none;
  }

  .bpillars__nav {
    display: none;
  }

  .pillar-card {
    flex: initial;
    height: auto;
    aspect-ratio: 228 / 460;
  }
}

/* ── Mobile ── */
@media (max-width: 560px) {
  .bpillars__hero {
    height: 300px;
  }
  .bpillars {
  overflow: hidden;
  margin-top: 20px;
}

  .bpillars__hero-brand {
    left: 6%;
    top: 6%;
  }

  .bpillars__hero-tagline {
    top: 24%;
  }

  .bpillars__cta {
    left: 16px;
    bottom: 16px;
    padding: 10px 16px;
  }

  .bpillars__heading {
    padding: 24px 18px 4px;
  }

  .bpillars__cards {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 18px;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    padding: 4px 18px;
    scrollbar-width: none;
  }

  .bpillars__cards::-webkit-scrollbar {
    display: none;
  }

  .pillar-card {
    flex: 0 0 auto;
    width: 78vw;
    max-width: 300px;
    aspect-ratio: 228 / 320;
    scroll-snap-align: start;
  }

  .pillar-card__content {
    padding: 16px 14px 18px;
  }
}

{% endstylesheet %}

