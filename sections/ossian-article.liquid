{{ 'section-ossian-article.css' | asset_url | stylesheet_tag }}
{% comment %}
  Section contract.
  Single article page: breadcrumb, tag pill, two-tone title, excerpt, date /
  read time / share row, full-width featured image, then the article body.
  The body is laid out from ordinary editor content: text before the first
  Heading 2 is the intro; each Heading 2 starts a numbered step whose first
  image sits beside its text (alternating sides); bullet lists get check
  marks and quotes become Pro Tip boxes. "You'll Also Love" lists other
  articles from the same blog in a carousel.
  @example
  <!-- templates/article.json → /blogs/news/5-everyday-habits -->
{% endcomment %}

{%- liquid
  assign article_tag = article.tags.first
  assign word_count = article.content | strip_html | split: ' ' | size
  assign read_time = word_count | divided_by: 200.0 | ceil | at_least: 1
  assign share_url = shop.url | append: article.url
  assign share_url_encoded = share_url | url_encode
  assign share_title_encoded = article.title | url_encode

  # Two-tone title: the last N words take the accent colour
  assign title_words = article.title | split: ' '
  assign accent_count = section.settings.accent_words
  assign title_plain = article.title
  assign title_accent = ''
  if accent_count > 0 and title_words.size > accent_count
    assign plain_count = title_words.size | minus: accent_count
    assign title_plain = title_words | slice: 0, plain_count | join: ' '
    assign title_accent = title_words | slice: plain_count, accent_count | join: ' '
  endif

  # Split the body into intro + one segment per Heading 2
  assign body_segments = article.content | split: '<h2'
-%}

<article class="oba" id="oba-{{ section.id }}">
  <header class="oba__wrap oba__head">
    <nav class="oba__crumbs" aria-label="{{ 'content.ossian_article.breadcrumb' | t }}">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'content.ossian_article.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        {%- if article_tag != blank -%}
          <li><a href="{{ blog.url }}/tagged/{{ article_tag | handleize }}">{{ article_tag | escape }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ article.title | escape }}</span></li>
      </ol>
    </nav>

    {%- if article_tag != blank -%}
      <a class="oba__tag" href="{{ blog.url }}/tagged/{{ article_tag | handleize }}">{{ article_tag | escape }}</a>
    {%- endif -%}

    <h1 class="oba__title">
      {{- title_plain | escape -}}
      {%- if title_accent != blank %} <span class="oba__title-accent">{{ title_accent | escape }}</span>{%- endif -%}
    </h1>

    {%- if article.excerpt != blank -%}
      <p class="oba__dek">{{ article.excerpt | strip_html | escape }}</p>
    {%- endif -%}

    <div class="oba__meta">
      <span class="oba__meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
        {{ article.published_at | time_tag: '%b %d, %Y' }}
      </span>
      <span class="oba__meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        {{ 'content.ossian_blog.read_time' | t: count: read_time }}
      </span>
      <div class="oba__share" data-oba-share>
        <span class="oba__meta-item oba__share-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 13.2 7.6 4.6M15.8 6.2 8.2 10.8"/></svg>
          {{ 'content.ossian_article.share' | t }}
        </span>
        <a class="oba__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_encoded }}" target="_blank" rel="noopener" aria-label="{{ 'content.ossian_article.share_on' | t: network: 'Facebook' }}">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4A20 20 0 0 0 14.4 4.3c-2.2 0-3.7 1.3-3.7 3.8v2.4H8.2v3h2.5V21h2.8Z"/></svg>
        </a>
        <a class="oba__share-btn" href="https://wa.me/?text={{ share_title_encoded }}%20{{ share_url_encoded }}" target="_blank" rel="noopener" aria-label="{{ 'content.ossian_article.share_on' | t: network: 'WhatsApp' }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.5-4.3a8.5 8.5 0 1 1 15.5-4.6Z"/><path d="M9 8.5c.2-.4.5-.5.8-.5h.4c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.1 1.5 2 2.6 2.6l.6-.5c.2-.1.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.4c0 .3-.1.6-.5.8-.7.4-1.6.5-2.5.1a8.6 8.6 0 0 1-4.3-4.3c-.4-.9-.3-1.8.1-2.5Z"/></svg>
        </a>
        <a class="oba__share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url_encoded }}" target="_blank" rel="noopener" aria-label="{{ 'content.ossian_article.share_on' | t: network: 'LinkedIn' }}">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.9 8.8H3.7V20h3.2V8.8ZM5.3 3.8a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.3 13.6c0-3-1.6-4.9-4.2-4.9a3.6 3.6 0 0 0-3.2 1.7V8.8H9.8V20H13v-5.9c0-1.6.6-2.7 2-2.7 1.4 0 1.9 1.1 1.9 2.7V20h3.3v-6.4Z"/></svg>
        </a>
        <button type="button" class="oba__share-btn" data-oba-copy="{{ share_url }}" aria-label="{{ 'content.ossian_article.copy_link' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>
        </button>
        <span class="oba__copy-status" role="status" aria-live="polite" data-oba-copy-status></span>
      </div>
    </div>
  </header>

  {%- if article.image != blank -%}
    <div class="oba__hero">
      {{
        article.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750,1100,1500,1900,2400',
          sizes: '100vw',
          alt: article.image.alt | default: article.title
      }}
    </div>
  {%- endif -%}

  <div class="oba__wrap oba__body">
    {%- for segment in body_segments -%}
      {%- if forloop.first -%}
        {%- assign intro_check = segment | strip_html | strip -%}
        {%- if intro_check != blank or segment contains '<img' -%}
          <div class="oba__prose oba__intro">{{ segment }}</div>
        {%- endif -%}
        {%- continue -%}
      {%- endif -%}

      {%- liquid
        assign step_html = '<h2' | append: segment
        assign step_img = ''
        assign step_text = step_html
        if step_html contains '<img'
          assign img_split = step_html | split: '<img'
          assign before_img = img_split | first
          assign after_img = step_html | remove_first: before_img | remove_first: '<img'
          assign img_attrs = after_img | split: '>' | first
          assign step_img = '<img loading="lazy"' | append: img_attrs | append: '>'
          assign after_tag = after_img | remove_first: img_attrs | remove_first: '>'
          assign step_text = before_img | append: after_tag
        endif
      -%}

      {%- if step_img != blank -%}
        <section class="oba__step{% cycle '', ' oba__step--reverse' %}">
          <div class="oba__step-media">{{ step_img }}</div>
          <div class="oba__prose oba__step-copy">{{ step_text }}</div>
        </section>
      {%- else -%}
        <section class="oba__step oba__step--text">
          <div class="oba__prose oba__step-copy">{{ step_text }}</div>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%}── You'll also love ─────────────────────────────{%- endcomment -%}
  {%- if section.settings.show_related -%}
    {%- liquid
      assign related_count = 0
      for related in blog.articles limit: 13
        if related.id != article.id
          assign related_count = related_count | plus: 1
        endif
      endfor
      assign related_count = related_count | at_most: section.settings.related_limit
    -%}
    {%- if related_count > 0 -%}
      <section class="oba__related" aria-labelledby="oba-related-{{ section.id }}">
        <div class="oba__wrap">
          <div class="oba__related-head">
            <div>
              {%- if section.settings.related_eyebrow != blank -%}
                <p class="oba__eyebrow">{{ section.settings.related_eyebrow | escape }}</p>
              {%- endif -%}
              {%- assign related_heading = section.settings.related_heading | escape | replace: '[', '<span class="oba__title-accent">' | replace: ']', '</span>' -%}
              <h2 class="oba__related-title" id="oba-related-{{ section.id }}">{{ related_heading }}</h2>
              {%- if section.settings.related_text != blank -%}
                <p class="oba__related-text">{{ section.settings.related_text | escape }}</p>
              {%- endif -%}
            </div>
            <div class="oba__related-nav">
              <button type="button" class="oba__arrow" data-oba-prev aria-label="{{ 'accessibility.slideshow_previous' | t }}" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <button type="button" class="oba__arrow" data-oba-next aria-label="{{ 'accessibility.slideshow_next' | t }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <ul class="oba__related-track" role="list" data-oba-track>
            {%- assign shown = 0 -%}
            {%- for related in blog.articles limit: 13 -%}
              {%- if related.id == article.id or shown >= related_count -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign shown = shown | plus: 1
                assign related_words = related.content | strip_html | split: ' ' | size
                assign related_time = related_words | divided_by: 200.0 | ceil | at_least: 1
              -%}
              <li class="oba__related-item">
                {%- render 'ossian-blog-card',
                  image: related.image,
                  tag: related.tags.first,
                  date: related.published_at,
                  title: related.title,
                  url: related.url,
                  read_time: related_time
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="oba__wrap oba__comments">
      <h2 class="oba__comments-title">{{ 'blogs.article.comments_heading' | t: count: article.comments_count }}</h2>
      {%- paginate article.comments by 10 -%}
        {%- for comment in article.comments -%}
          <div class="oba__comment">
            <div class="oba__prose">{{ comment.content }}</div>
            <p class="oba__comment-meta">{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
          </div>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <div class="oba__comment-pages">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endpaginate -%}
      {%- render 'blog-comment-form', article: article, section_id: section.id -%}
    </section>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

<script>
  (function () {
    var root = document.getElementById('oba-{{ section.id }}');
    if (!root) return;

    /* Copy link */
    var copyBtn = root.querySelector('[data-oba-copy]');
    var status = root.querySelector('[data-oba-copy-status]');
    var copiedText = {{ 'content.ossian_article.link_copied' | t | json }};
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var url = copyBtn.getAttribute('data-oba-copy');
        var done = function () {
          copyBtn.classList.add('is-copied');
          if (status) status.textContent = copiedText;
          setTimeout(function () {
            copyBtn.classList.remove('is-copied');
            if (status) status.textContent = '';
          }, 2500);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(function () {});
        }
      });
    }

    /* Related carousel */
    var track = root.querySelector('[data-oba-track]');
    if (!track) return;
    var items = Array.prototype.slice.call(track.children);
    var prev = root.querySelector('[data-oba-prev]');
    var next = root.querySelector('[data-oba-next]');
    var rtl = getComputedStyle(track).direction === 'rtl';

    function step() {
      return items.length > 1 ? Math.abs(items[1].offsetLeft - items[0].offsetLeft) : track.clientWidth;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var pos = Math.abs(track.scrollLeft);
      root.classList.toggle('oba--related-static', max <= 2);
      if (prev) prev.disabled = pos <= 2;
      if (next) next.disabled = pos >= max - 2;
    }
    function move(dir) {
      var target = (Math.round(Math.abs(track.scrollLeft) / step()) + dir) * step();
      track.scrollTo({ left: rtl ? -target : target, behavior: 'smooth' });
    }
    if (prev) prev.addEventListener('click', function () { move(-1); });
    if (next) next.addEventListener('click', function () { move(1); });
    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>


{% schema %}
{
  "name": "Ossian Article",
  "tag": "div",
  "class": "section-ossian-article",
  "settings": [
    { "type": "range", "id": "accent_words", "label": "Blue words at end of title", "info": "Colours the last words of the article title. 0 turns it off.", "min": 0, "max": 6, "step": 1, "default": 3 },
    { "type": "paragraph", "content": "Article layout: every Heading 2 starts a numbered step, and the first image under it sits beside the step text. Bullet lists get check marks. Quote blocks become Pro Tip boxes — start them with bold text such as \"Pro Tip:\"." },
    { "type": "header", "content": "You'll also love" },
    { "type": "checkbox", "id": "show_related", "label": "Show more articles", "default": true },
    { "type": "range", "id": "related_limit", "label": "Number of articles", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "related_eyebrow", "label": "Eyebrow", "default": "More Articles" },
    { "type": "text", "id": "related_heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent.", "default": "You’ll Also [Love]" },
    { "type": "text", "id": "related_text", "label": "Text", "default": "Explore more expert tips, guides and stories for healthier hair and skin." }
  ]
}
{% endschema %}
