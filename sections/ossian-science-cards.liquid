{% comment %}
  Section contract.
  "Advanced Hair Science" technology cards: centred intro, then cards with an image,
  a round icon badge overlapping the image edge, a title and a short description.
  @example
  <!-- templates/page.science.json → science_tech -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

<section class="oab osc" id="osc-{{ section.id }}" style="--osc-bg: {{ section.settings.background }};">
  <div class="oab-wrap">
    <div class="oab-intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oab-eyebrow oab-eyebrow--rules">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ossian-about-heading', text: section.settings.heading, class: 'oab-heading--md' -%}
      {%- if section.settings.text != blank -%}
        <p class="oab-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="osc__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="osc-card" {{ block.shopify_attributes }}>
            <div class="osc-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '300,450,600,800', sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 90vw', alt: ''
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'osc-card__ph' }}
              {%- endif -%}
              <span class="osc-card__badge" aria-hidden="true">{%- render 'ossian-about-icon', icon: block.settings.icon -%}</span>
            </div>
            <div class="osc-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="osc-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="osc-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .osc {
    background: var(--osc-bg, #fff);
    padding-block: 56px 60px;
  }

  .osc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .osc-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 8px;
    border: 1px solid #e3e8f1;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(20 40 74 / 0.06);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .osc-card:hover {
    box-shadow: 0 16px 34px rgb(20 40 74 / 0.12);
    transform: translateY(-3px);
  }

  .osc-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    background: #e6eef9;
  }

  .osc-card__media img,
  .osc-card__ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }

  .osc-card__ph { fill: rgb(30 58 95 / 0.2); }

  /* Icon badge straddling the bottom edge of the image */
  .osc-card__badge {
    position: absolute;
    inset-inline-start: 14px;
    bottom: -24px;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fff;
    color: var(--oab-accent-dark);
    box-shadow: 0 6px 18px rgb(20 40 74 / 0.14);
  }

  .osc-card__badge svg { width: 24px; height: 24px; }

  .osc-card__body {
    padding: 36px 10px 12px;
  }

  .osc-card__title {
    margin: 0 0 8px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--oab-ink);
  }

  .osc-card__text {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--oab-muted);
  }

  @media (max-width: 749px) {
    .osc { padding-block: 40px 44px; }
    .osc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .osc-card__badge { width: 44px; height: 44px; bottom: -20px; inset-inline-start: 10px; }
    .osc-card__badge svg { width: 20px; height: 20px; }
    .osc-card__body { padding: 30px 6px 8px; }
    .osc-card__title { font-size: 0.9rem; }
    .osc-card__text { font-size: 0.78rem; }
    .osc-card__media,
    .osc-card__media img,
    .osc-card__ph { border-radius: 8px; }
  }

  @media (max-width: 340px) {
    .osc__grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .osc-card { transition: none; }
    .osc-card:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian Science Cards",
  "tag": "div",
  "class": "section-ossian-science-cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent.", "default": "Advanced Hair Science" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A powerful blend of marine actives and high-performance ingredients, engineered for complete hair care." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Technology card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, about 800 × 600." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "waves", "options": [
          { "value": "waves", "label": "Waves" }, { "value": "molecule", "label": "Molecule" }, { "value": "drop", "label": "Drop" },
          { "value": "sparkle", "label": "Sparkle" }, { "value": "flask", "label": "Flask" }, { "value": "leaf", "label": "Leaf" },
          { "value": "shield", "label": "Shield" }, { "value": "coral", "label": "Coral" }, { "value": "badge", "label": "Badge" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Marine-Based Nourishing Technology" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Powered by ocean-derived actives to deeply nourish, hydrate and strengthen hair from within." }
      ]
    }
  ],
  "presets": [{ "name": "Ossian Science Cards" }]
}
{% endschema %}
