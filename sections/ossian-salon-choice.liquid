    {
      "type": "image_picker",
      "id": "feat_image",
      "label": "Image (overrides product / collection image)"
    },
    {
      "type": "text",
      "id": "feat_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "feat_label",
