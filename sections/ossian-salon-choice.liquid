<div class="ossian-salon" id="ossian-salon-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ossian-salon__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="ossian-salon__wrapper page-width">
    <button class="ossian-salon__arrow ossian-salon__arrow--prev" aria-label="Previous" data-salon-id="{{ section.id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="ossian-salon__track-outer">
      <div class="ossian-salon__track" id="ossian-salon-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="ossian-salon__card" {{ block.shopify_attributes }}>
            <div class="ossian-salon__card-top">
              {%- if block.settings.background_image != blank -%}
                {{
                  block.settings.background_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'ossian-salon__card-bg',
                    loading: 'lazy',
                    widths: '300, 450, 600'
                }}
              {%- else -%}
                <div class="ossian-salon__card-bg-placeholder"></div>
              {%- endif -%}
              {%- if block.settings.discount_badge != blank -%}
                <span class="ossian-salon__discount-badge">{{ block.settings.discount_badge }}</span>
              {%- endif -%}
              {%- if block.settings.play_icon -%}
                <div class="ossian-salon__play-btn" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="13.5" stroke="white" stroke-opacity="0.8"/><path d="M11 9.5l9 4.5-9 4.5V9.5z" fill="white"/></svg>
                </div>
              {%- endif -%}
            </div>
            <div class="ossian-salon__card-bottom">
              <div class="ossian-salon__card-media">
                {%- if block.settings.product_thumbnail != blank -%}
                  {{
                    block.settings.product_thumbnail
                    | image_url: width: 80
                    | image_tag:
                      class: 'ossian-salon__thumb',
                      loading: 'lazy'
                  }}
                {%- endif -%}
              </div>
              <div class="ossian-salon__card-info">
                {%- if block.settings.product_name != blank -%}
                  <h3 class="ossian-salon__card-name">{{ block.settings.product_name }}</h3>
                {%- endif -%}
                {%- if block.settings.product_descriptor != blank -%}
                  <p class="ossian-salon__card-descriptor">{{ block.settings.product_descriptor }}</p>
                {%- endif -%}
                {%- if block.settings.rating != blank -%}
                  <div class="ossian-salon__card-rating">
                    <span class="ossian-salon__stars">★★★★★</span>
                    <span>{{ block.settings.rating }}</span>
                  </div>
                {%- endif -%}
              </div>
              <a href="{{ block.settings.link | default: '#' }}" class="ossian-salon__shop-now">
                SHOP NOW
                <svg width="20" height="12" viewBox="0 0 20 12" fill="none"><path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <button class="ossian-salon__arrow ossian-salon__arrow--next" aria-label="Next" data-salon-id="{{ section.id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</div>

<script>
(function() {
  function initSalon(id) {
    var track = document.getElementById('ossian-salon-track-' + id);
    if (!track) return;
    var cards = track.querySelectorAll('.ossian-salon__card');
    var perPage = window.innerWidth < 768 ? 1 : window.innerWidth < 990 ? 2 : 4;
    var current = 0;
    var total = cards.length;

    function update() {
      var cardWidth = 100 / perPage;
      track.style.transform = 'translateX(-' + (current * cardWidth) + '%)';
    }

    var wrapper = document.getElementById('ossian-salon-' + id);
    var prevBtn = wrapper.querySelector('.ossian-salon__arrow--prev');
    var nextBtn = wrapper.querySelector('.ossian-salon__arrow--next');

    if (prevBtn) prevBtn.addEventListener('click', function() {
      current = Math.max(0, current - 1);
      update();
    });
    if (nextBtn) nextBtn.addEventListener('click', function() {
      current = Math.min(total - perPage, current + 1);
      update();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initSalon('{{ section.id }}');
  });
})();
</script>

{% stylesheet %}
.ossian-salon {
  padding: 64px 0;
  background: #fff;
}

.ossian-salon__heading {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 900;
  color: #1e3a5f;
  text-align: center;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin: 0 0 40px;
}

.ossian-salon__wrapper {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16px;
}

.ossian-salon__track-outer {
  flex: 1;
  overflow: hidden;
}

.ossian-salon__track {
  display: flex;
  gap: 20px;
  transition: transform 0.4s ease;
}

.ossian-salon__card {
  min-width: calc(25% - 15px);
  flex-shrink: 0;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(30,58,95,0.08);
}

.ossian-salon__card-top {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #e8e4df;
}

.ossian-salon__card-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.ossian-salon__card:hover .ossian-salon__card-bg { transform: scale(1.05); }

.ossian-salon__card-bg-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e8e4df, #d5cfc8);
}

.ossian-salon__discount-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  background: #e74c3c;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  z-index: 2;
}

.ossian-salon__play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
}

.ossian-salon__card-bottom {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ossian-salon__card-media {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ossian-salon__thumb {
  width: 50px;
  height: 68px;
  object-fit: contain;
  border-radius: 4px;
}

.ossian-salon__card-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0 0 4px;
  line-height: 1.3;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.ossian-salon__card-descriptor {
  font-size: 11px;
  color: #666;
  margin: 0;
}

.ossian-salon__card-rating {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #444;
}

.ossian-salon__stars { color: #f4c542; font-size: 13px; }

.ossian-salon__shop-now {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #1e3a5f;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  border-bottom: 1.5px solid #1e3a5f;
  padding-bottom: 2px;
  width: fit-content;
  margin-top: 4px;
  transition: opacity 0.2s;
}

.ossian-salon__shop-now:hover { opacity: 0.7; }

.ossian-salon__arrow {
  flex-shrink: 0;
  background: #1e3a5f;
  border: none;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  transition: background 0.2s;
}

.ossian-salon__arrow:hover { background: #2d5a8f; }

@media (max-width: 990px) {
  .ossian-salon__card { min-width: calc(50% - 10px); }
}

@media (max-width: 768px) {
  .ossian-salon__card { min-width: 100%; }
}
{% endstylesheet %}

