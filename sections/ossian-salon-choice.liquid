<section
  class="salon-choice"
  id="salon-section-{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top | minus: 60 }}px; padding-bottom: {{ section.settings.padding_bottom | minus: 60 }}px;"
>
  {%- if section.settings.heading != blank -%}
    <div class="page-width">
      <div class="salon-choice__header">
        <h2 class="salon-choice__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="salon-choice__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div
      class="salon-choice__coverflow"
      id="salon-cf-{{ section.id }}"
      role="region"
      aria-label="{{ section.settings.heading | default: 'Product carousel' | escape }}"
      tabindex="0"
    >
      <div class="salon-choice__stage">
        {%- for block in section.blocks -%}
          {%- assign sc_product = block.settings.product -%}
          {%- assign card_name = block.settings.product_name -%}
          {%- if card_name == blank and sc_product != blank -%}
            {%- assign card_name = sc_product.title -%}
          {%- endif -%}
          <div
            class="salon-choice__slide"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <a
              class="salon-choice__card-link"
              href="{{ block.settings.link | default: sc_product.url | default: '#' }}"
              tabindex="-1"
              aria-label="{{ card_name | default: 'View product' | escape }}"
            >
              <div class="salon-choice__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag: class: 'salon-choice__img', loading: 'lazy'
                  }}
                {%- elsif sc_product != blank and sc_product.featured_image != blank -%}
                  {{
                    sc_product.featured_image
                    | image_url: width: 800
                    | image_tag: class: 'salon-choice__img', loading: 'lazy', alt: sc_product.title
                  }}
                {%- else -%}
                  <div class="salon-choice__img-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                {%- if block.settings.discount_badge != blank -%}
                  <span class="salon-choice__badge">{{ block.settings.discount_badge }}</span>
                {%- endif -%}
              </div>

              {%- if card_name != blank or block.settings.product_descriptor != blank -%}
                <div class="salon-choice__card-label">
                  {%- if card_name != blank -%}
                    <p class="salon-choice__card-name">{{ card_name }}</p>
                  {%- endif -%}
                  {%- if block.settings.product_descriptor != blank -%}
                    <p class="salon-choice__card-desc">{{ block.settings.product_descriptor }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var SECTION_ID = {{ section.id | json }};
  var AUTOPLAY   = {{ section.settings.autoplay | json }};
  var SPEED      = {{ section.settings.autoplay_speed | times: 1000 | json }};

  function init(root) {
    if (!root) return;

    var slides  = Array.from(root.querySelectorAll('.salon-choice__slide'));
    var total   = slides.length;
    var current = 0;
    var timer   = null;

    if (total === 0) return;

    /* ── navigate ─────────────────────────────── */
    function go(idx) {
      current = ((idx % total) + total) % total;

      slides.forEach(function (slide, i) {
        var offset = i - current;
        if (offset >  total / 2) offset -= total;
        if (offset < -total / 2) offset += total;

        slide.className = 'salon-choice__slide';
        if      (offset ===  0) slide.classList.add('is-center');
        else if (offset === -1) slide.classList.add('is-left-1');
        else if (offset ===  1) slide.classList.add('is-right-1');
        else if (offset === -2) slide.classList.add('is-left-2');
        else if (offset ===  2) slide.classList.add('is-right-2');
        else                    slide.classList.add('is-hidden');

        var link = slide.querySelector('.salon-choice__card-link');
        if (link) link.tabIndex = (offset === 0) ? 0 : -1;
      });
    }

    /* ── autoplay ─────────────────────────────── */
    function startAutoplay() {
      if (!AUTOPLAY || total < 2) return;
      stopAutoplay();
      timer = setInterval(function () { go(current + 1); }, SPEED);
    }

    function stopAutoplay() {
      clearInterval(timer);
      timer = null;
    }

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin',   stopAutoplay);
    root.addEventListener('focusout',  startAutoplay);

    /* ── click side cards ─────────────────────── */
    slides.forEach(function (slide, i) {
      slide.addEventListener('click', function (e) {
        if (i !== current) {
          e.preventDefault();
          stopAutoplay();
          go(i);
          startAutoplay();
        }
      });
    });

    /* ── keyboard ─────────────────────────────── */
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  { stopAutoplay(); go(current - 1); startAutoplay(); e.preventDefault(); }
      if (e.key === 'ArrowRight') { stopAutoplay(); go(current + 1); startAutoplay(); e.preventDefault(); }
    });

    /* ── touch / mouse drag ───────────────────── */
    var pointerStartX = 0;
    var isDragging    = false;
    var stage = root.querySelector('.salon-choice__stage');

    function onPointerDown(clientX) { pointerStartX = clientX; isDragging = true; stopAutoplay(); }
    function onPointerUp(clientX) {
      if (!isDragging) return;
      isDragging = false;
      var dx = clientX - pointerStartX;
      if (Math.abs(dx) > 40) go(current + (dx < 0 ? 1 : -1));
      startAutoplay();
    }

    stage.addEventListener('touchstart', function (e) { onPointerDown(e.touches[0].clientX); }, { passive: true });
    stage.addEventListener('touchend',   function (e) { onPointerUp(e.changedTouches[0].clientX); }, { passive: true });
    stage.addEventListener('mousedown',  function (e) { onPointerDown(e.clientX); });
    document.addEventListener('mouseup', function (e) { if (isDragging) onPointerUp(e.clientX); });
    stage.addEventListener('dragstart',  function (e) { e.preventDefault(); });

    /* ── Shopify theme editor ─────────────────── */
    document.addEventListener('shopify:block:select', function (e) {
      var idx = slides.indexOf(e.target);
      if (idx !== -1) { stopAutoplay(); go(idx); }
    });
    document.addEventListener('shopify:block:deselect', startAutoplay);
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === SECTION_ID) go(0);
    });

    go(0);
    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      init(document.getElementById('salon-cf-' + SECTION_ID));
    });
  } else {
    init(document.getElementById('salon-cf-' + SECTION_ID));
  }
}());
</script>

{% stylesheet %}
/* ── Section ──────────────────────────────────── */
.salon-choice {
  overflow-x: hidden;
  background: #fff;
  font-family: 'Jost', sans-serif;
}

.salon-choice__header {
  text-align: center;
  margin-bottom: 40px;
  padding:40px 0 20px 0px;
}

.salon-choice__heading {
  
  font-weight: 600;
  
  color:#1e3a5f ;

  line-height: 1.15;
  letter-spacing: -0.01em;
}

.salon-choice__sub {
  font-size: 0.9rem;
  color: #999;
  margin: 0;
}

/* ── Coverflow ────────────────────────────────── */
.salon-choice__coverflow {
  width: 100%;
  user-select: none;
  outline: none;
}

/* ── Stage ────────────────────────────────────── */
.salon-choice__stage {
  position: relative;
  width: 100%;
  height: 500px;
  perspective: 1400px;
  perspective-origin: center 40%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
}

.salon-choice__stage:active { cursor: grabbing; }

/* ── Slides ───────────────────────────────────── */
.salon-choice__slide {
  position: absolute;
  width: clamp(220px, 22vw, 340px);
  opacity: 0;
  pointer-events: none;
  transform-origin: center center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: transform, opacity;
  transition:
    transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
    opacity   0.5s ease;
}

.salon-choice__slide.is-center {
  transform: translateX(0) rotateY(0deg) scale(1);
  z-index: 5;
  opacity: 1;
  pointer-events: auto;
}

.salon-choice__slide.is-left-1 {
  transform: translateX(-62%) rotateY(42deg) scale(0.85);
  z-index: 4;
  opacity: 1;
  pointer-events: auto;
}

.salon-choice__slide.is-right-1 {
  transform: translateX(62%) rotateY(-42deg) scale(0.85);
  z-index: 4;
  opacity: 1;
  pointer-events: auto;
}

.salon-choice__slide.is-left-2 {
  transform: translateX(-118%) rotateY(52deg) scale(0.68);
  z-index: 3;
  opacity: 0.88;
  pointer-events: auto;
}

.salon-choice__slide.is-right-2 {
  transform: translateX(118%) rotateY(-52deg) scale(0.68);
  z-index: 3;
  opacity: 0.88;
  pointer-events: auto;
}

.salon-choice__slide.is-hidden {
  opacity: 0;
  pointer-events: none;
  z-index: 0;
}

/* ── Card link ────────────────────────────────── */
.salon-choice__card-link {
  display: block;
  text-decoration: none;
  outline: none;
}

.salon-choice__card-link:focus-visible .salon-choice__media {
  box-shadow: 0 0 0 3px #111, 0 28px 70px rgba(0, 0, 0, 0.28);
}

/* ── Card media ───────────────────────────────── */
.salon-choice__media {
  position: relative;
  aspect-ratio: 3 / 4;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);
  transition: box-shadow 0.4s ease;
}

.salon-choice__slide.is-center .salon-choice__media {
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
}

.salon-choice__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
}

.salon-choice__img-placeholder {
  width: 100%;
  height: 100%;
  background: #e0ddd8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.salon-choice__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #1e3a5f;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* ── Card label (on card, center only) ────────── */
.salon-choice__card-label {
  text-align: center;
  

  opacity: 0;
  transform: translateY(6px);
  transition:
    opacity   0.35s ease 0.1s,
    transform 0.35s ease 0.1s;
  pointer-events: none;
}

.salon-choice__slide.is-center .salon-choice__card-label {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
  margin-top:40px
}

.salon-choice__card-name {
  font-family: 'Jost', sans-serif;
  font-size: 1.1rem;
  font-style: italic;
  font-weight: 700;
  color: #111;
  margin: 0 0 3px;
  line-height: 1.3;
}

.salon-choice__card-desc {
  font-size: 0.8rem;
  color: #888;
  margin: 0;
  line-height: 1.4;
}

/* ── Tablet ───────────────────────────────────── */
@media (max-width: 900px) {
  .salon-choice__stage { height: 460px; }

  .salon-choice__slide.is-left-1  { transform: translateX(-60%) rotateY(42deg) scale(0.83); }
  .salon-choice__slide.is-right-1 { transform: translateX(60%)  rotateY(-42deg) scale(0.83); }
  .salon-choice__slide.is-left-2  { transform: translateX(-115%) rotateY(52deg) scale(0.65); }
  .salon-choice__slide.is-right-2 { transform: translateX(115%)  rotateY(-52deg) scale(0.65); }
}

/* ── Mobile ───────────────────────────────────── */
@media (max-width: 600px) {
  .salon-choice__header { margin-bottom: 20px; }
  .salon-choice__stage  { height: 310px; cursor: default; }
  .salon-choice__slide  { width: clamp(140px, 40vw, 200px); }

  .salon-choice__slide.is-left-1  { transform: translateX(-58%) rotateY(40deg) scale(0.81); }
  .salon-choice__slide.is-right-1 { transform: translateX(58%)  rotateY(-40deg) scale(0.81); }
  .salon-choice__slide.is-left-2  { transform: translateX(-110%) rotateY(50deg) scale(0.63); }
  .salon-choice__slide.is-right-2 { transform: translateX(110%)  rotateY(-50deg) scale(0.63); }

  .salon-choice__card-name  { font-size: 0.95rem; }
  .salon-choice__card-label { padding-top: 12px; }
}

/* ── Small mobile ─────────────────────────────── */
@media (max-width: 380px) {
  .salon-choice__stage { height: 300px; }
  .salon-choice__slide { width: clamp(120px, 38vw, 155px); }

  .salon-choice__slide.is-left-1  { transform: translateX(-60%) rotateY(40deg) scale(0.8); }
  .salon-choice__slide.is-right-1 { transform: translateX(60%)  rotateY(-40deg) scale(0.8); }
  .salon-choice__slide.is-left-2  { transform: translateX(-112%) rotateY(50deg) scale(0.62); }
  .salon-choice__slide.is-right-2 { transform: translateX(112%)  rotateY(-50deg) scale(0.62); }
}

/* ── Reduced motion ───────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .salon-choice__slide,
  .salon-choice__card-label { transition: opacity 0.2s ease; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Salon Choice",
  "tag": "section",
  "class": "salon-choice-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Optimal Blend of Style and Performance"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A style for every need and speed."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Auto-play"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable auto-play",
      "default": false
    },
    {
      "type": "select",
      "id": "autoplay_speed",
      "label": "Auto-play speed",
      "default": "4",
      "options": [
        { "value": "2", "label": "2 seconds" },
        { "value": "3", "label": "3 seconds" },
        { "value": "4", "label": "4 seconds" },
        { "value": "5", "label": "5 seconds" },
        { "value": "6", "label": "6 seconds" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (auto-fills image, title, URL)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name (overrides product title)"
        },
        {
          "type": "text",
          "id": "product_descriptor",
          "label": "Short descriptor"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount badge (e.g. 50% off)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (overrides product URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Salon Choice",
      "settings": {
        "heading": "The Optimal Blend of Style and Performance",
        "subheading": "A style for every need and speed."
      },
      "blocks": [
        { "type": "product_card", "settings": { "product_name": "JAPANESE GLOW FACIAL KIT", "product_descriptor": "Used by 10,000+ customers", "discount_badge": "50% off" } },
        { "type": "product_card", "settings": { "product_name": "ALOEVERA LIPOSOLUBLE WAX", "product_descriptor": "Smooth Waxing. Less Pain", "discount_badge": "50% off" } },
        { "type": "product_card", "settings": { "product_name": "DE-TAN ILLUMINATE", "product_descriptor": "Tan Removal & Brightening", "discount_badge": "50% off" } },
        { "type": "product_card", "settings": { "product_name": "SUPREME STRAIGHT", "product_descriptor": "Hair Straightening System", "discount_badge": "50% off" } }
      ]
    }
  ]
}
{% endschema %}
