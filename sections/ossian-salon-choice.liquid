<section class="salon-choice">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="salon-choice__header">
        <h2 class="salon-choice__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="salon-choice__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="salon-choice__grid">
        {%- for block in section.blocks -%}
          {%- assign sc_product = block.settings.product -%}
          <a
            class="salon-choice__card"
            href="{{ block.settings.link | default: sc_product.url | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <!-- Thumbnail -->
            <div class="salon-choice__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 500
                  | image_tag: class: 'salon-choice__img', loading: 'lazy'
                }}
              {%- elsif sc_product != blank and sc_product.featured_image != blank -%}
                {{
                  sc_product.featured_image
                  | image_url: width: 500
                  | image_tag: class: 'salon-choice__img', loading: 'lazy', alt: sc_product.title
                }}
              {%- else -%}
                <div class="salon-choice__img-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endif -%}

              {%- if block.settings.discount_badge != blank -%}
                <span class="salon-choice__badge">{{ block.settings.discount_badge }}</span>
              {%- endif -%}

              {%- if block.settings.play_icon -%}
                <div class="salon-choice__play">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                </div>
              {%- endif -%}
            </div>

            <!-- Info -->
            <div class="salon-choice__info">
              <p class="salon-choice__name">
                {%- if block.settings.product_name != blank -%}
                  {{ block.settings.product_name }}
                {%- elsif sc_product != blank -%}
                  {{ sc_product.title }}
                {%- endif -%}
              </p>
              {%- assign descriptor = block.settings.product_descriptor -%}
              {%- if descriptor != blank -%}
                <p class="salon-choice__descriptor">{{ descriptor }}</p>
              {%- endif -%}
              {%- assign rating_val = block.settings.rating -%}
              {%- if rating_val != blank and rating_val != '0' -%}
                <div class="salon-choice__rating">
                  <span class="salon-choice__stars">
                    {%- assign r = rating_val | times: 1.0 | round -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= r -%}★{%- else -%}☆{%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="salon-choice__rating-val">{{ rating_val }}</span>
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.salon-choice {
  padding: 60px 0;
  background: #fff;
}

.salon-choice__header {
  text-align: center;
  margin-bottom: 36px;
}

.salon-choice__heading {
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 900;
  color: #1e3a5f;
  margin: 0 0 8px;
  font-style: italic;
  letter-spacing: -0.01em;
}

.salon-choice__sub {
  font-size: 0.9rem;
  color: #666;
  margin: 0;
}

.salon-choice__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  padding:0px 40px
}

.salon-choice__card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-radius: 14px;
  overflow: hidden;
  background: #f8f8f8;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.salon-choice__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.12);
}

.salon-choice__media {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: #ececec;
}

.salon-choice__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.salon-choice__card:hover .salon-choice__img { transform: scale(1.05); }

.salon-choice__img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0ddd8;
}

.salon-choice__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #1e3a5f;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  letter-spacing: 0.03em;
}

.salon-choice__play {
  position: absolute;
  bottom: 12px;
  right: 12px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.salon-choice__card:hover .salon-choice__play { background: rgba(0,0,0,0.7); }

.salon-choice__info {
  padding: 14px 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.salon-choice__name {
  font-size: 13px;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0;
  line-height: 1.3;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.salon-choice__descriptor {
  font-size: 12px;
  color: #777;
  margin: 0;
  line-height: 1.4;
}

.salon-choice__rating {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 4px;
}

.salon-choice__stars {
  color: #f5a623;
  font-size: 12px;
  letter-spacing: 1px;
}

.salon-choice__rating-val {
  font-size: 12px;
  font-weight: 600;
  color: #444;
}

@media (max-width: 900px) {
  .salon-choice__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
}

@media (max-width: 480px) {
  .salon-choice { padding: 40px 0; }
  .salon-choice__grid { grid-template-columns: repeat(2, 1fr); gap: 12px;
  padding: 0px 10px; }
  .salon-choice__info { padding: 10px 12px 14px; }
  .salon-choice__name { font-size: 12px; }

}
{% endstylesheet %}

{% schema %}
{
  "name": "Salon Choice",
  "tag": "section",
  "class": "salon-choice-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SALON CHOICE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (auto-fills image, title, URL)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product name (overrides product title)"
        },
        {
          "type": "text",
          "id": "product_descriptor",
          "label": "Short descriptor"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount badge (e.g. 50% off)"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating (e.g. 4.8)",
          "default": "4.8"
        },
        {
          "type": "checkbox",
          "id": "play_icon",
          "label": "Show play icon",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (overrides product URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Salon Choice",
      "settings": {
        "heading": "SALON CHOICE"
      },
      "blocks": [
        { "type": "product_card", "settings": { "product_name": "JAPANESE GLOW FACIAL KIT", "product_descriptor": "Used by 10,000+ customers", "discount_badge": "50% off", "rating": "4.8", "play_icon": true } },
        { "type": "product_card", "settings": { "product_name": "ALOEVERA LIPOSOLUBLE WAX", "product_descriptor": "Smooth Waxing. Less Pain", "discount_badge": "50% off", "rating": "4.8", "play_icon": true } },
        { "type": "product_card", "settings": { "product_name": "DE-TAN ILLUMINATE", "product_descriptor": "Tan Removal & Brightening", "discount_badge": "50% off", "rating": "4.8", "play_icon": true } },
        { "type": "product_card", "settings": { "product_name": "SUPREME STRAIGHT", "product_descriptor": "Hair Straightening System", "discount_badge": "50% off", "rating": "4.8", "play_icon": true } }
      ]
    }
  ]
}
{% endschema %}
