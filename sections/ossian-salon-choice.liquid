<section class="sc2" id="sc2-{{ section.id }}">

  {%- comment -%}── 1. Hero Banner ────────────────────────────────{%- endcomment -%}
  <div class="sc2__hero">
    {%- if section.settings.banner_image != blank -%}
      {{ section.settings.banner_image | image_url: width: 1800
         | image_tag: class: 'sc2__banner-img', loading: 'lazy', alt: section.settings.banner_alt | default: '' }}
    {%- else -%}
      <div class="sc2__banner-ph"></div>
    {%- endif -%}
  </div>

  {%- comment -%}── 2. Bottom section ─────────────────────────────{%- endcomment -%}
  <div class="sc2__bottom" style="background-color: {{ section.settings.bottom_bg }};">
    <div class="sc2__grid">

      {%- comment -%}── Before / After card ───────────────────────{%- endcomment -%}
      <div class="sc2__ba">
        <div class="sc2__ba-head">
          <svg class="sc2__ba-crown" viewBox="0 0 40 28" fill="none" aria-hidden="true">
            <path d="M2 24 L8 6 L18 16 L20 2 L22 16 L32 6 L38 24 Z" fill="#c9953a"/>
          </svg>
          <span class="sc2__ba-title">
            {{- section.settings.ba_label | default: 'REAL CLIENT RESULT' -}}
          </span>
        </div>

        <div class="sc2__bac" id="sc2-ba-{{ section.id }}">
          {%- if section.settings.before_image != blank -%}
            {{ section.settings.before_image | image_url: width: 1000
               | image_tag: class: 'sc2__bac-before', loading: 'lazy', draggable: 'false', alt: 'Before' }}
          {%- else -%}
            <div class="sc2__bac-before sc2__bac-ph">Before</div>
          {%- endif -%}

          {%- if section.settings.after_image != blank -%}
            {{ section.settings.after_image | image_url: width: 1000
               | image_tag: class: 'sc2__bac-after', loading: 'lazy', draggable: 'false', alt: 'After' }}
          {%- else -%}
            <div class="sc2__bac-after sc2__bac-ph">After</div>
          {%- endif -%}

          <div class="sc2__bac-sep"></div>
          <div class="sc2__bac-handle" aria-hidden="true">
            <svg viewBox="0 0 44 44" fill="none">
              <circle cx="22" cy="22" r="21" fill="rgba(0,0,0,0.52)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
              <path d="M16 22 L10 22 M28 22 L34 22 M16 22 L19 19 M16 22 L19 25 M28 22 L25 19 M28 22 L25 25"
                    stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <input class="sc2__bac-range" type="range" min="0" max="100" value="50"
                 aria-label="Slide to compare before and after">

          <span class="sc2__bac-tag sc2__bac-tag--b">BEFORE</span>
          <span class="sc2__bac-tag sc2__bac-tag--a">AFTER</span>
        </div>

        {%- assign icon_blocks = section.blocks | where: 'type', 'ba_icon' -%}
        {%- if icon_blocks.size > 0 -%}
          <div class="sc2__icons">
            {%- for block in icon_blocks -%}
              <div class="sc2__icon" {{ block.shopify_attributes }}>
                <span class="sc2__icon-sym">{{ block.settings.symbol | default: '✦' }}</span>
                {%- if block.settings.label != blank -%}
                  <span class="sc2__icon-lbl">{{ block.settings.label }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}── Product feature card ──────────────────────{%- endcomment -%}
      <div class="sc2__feat">
        {%- if section.settings.feat_image != blank -%}
          <div class="sc2__feat-media">
            {{ section.settings.feat_image | image_url: width: 700
               | image_tag: class: 'sc2__feat-img', loading: 'lazy', alt: section.settings.feat_headline | default: '' }}
          </div>
        {%- endif -%}

        {%- if section.settings.feat_headline != blank or section.settings.feat_bullets != blank or section.settings.feat_footer != blank -%}
          <div class="sc2__feat-body">
            {%- if section.settings.feat_headline != blank -%}
              <p class="sc2__feat-hl">{{ section.settings.feat_headline }}</p>
            {%- endif -%}
            {%- if section.settings.feat_bullets != blank -%}
              {%- assign blines = section.settings.feat_bullets | newline_to_br | split: '<br />' -%}
              <ul class="sc2__feat-ul">
                {%- for bline in blines -%}
                  {%- assign bt = bline | strip | strip_html -%}
                  {%- if bt != blank -%}
                    <li>{{ bt }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if section.settings.feat_footer != blank -%}
              <p class="sc2__feat-ft">{{ section.settings.feat_footer }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

</section>

<script>
(function () {
  var wrap = document.getElementById('sc2-ba-{{ section.id }}');
  if (!wrap) return;

  var after  = wrap.querySelector('.sc2__bac-after');
  var sep    = wrap.querySelector('.sc2__bac-sep');
  var handle = wrap.querySelector('.sc2__bac-handle');
  var range  = wrap.querySelector('.sc2__bac-range');
  var cur    = 50;

  function setPos(pct) {
    cur = Math.max(0, Math.min(100, pct));
    if (after)  after.style.clipPath = 'inset(0 ' + (100 - cur) + '% 0 0)';
    if (sep)    sep.style.left       = cur + '%';
    if (handle) handle.style.left    = cur + '%';
    if (range)  range.value          = cur;
  }

  if (range) range.addEventListener('input', function () { setPos(+this.value); });

  /* drag the handle directly */
  var dragging = false;

  function pctFromEvent(clientX) {
    var rect = wrap.getBoundingClientRect();
    return ((clientX - rect.left) / rect.width) * 100;
  }

  handle.addEventListener('mousedown', function (e) { dragging = true; e.preventDefault(); });
  document.addEventListener('mouseup',  function ()  { dragging = false; });
  document.addEventListener('mousemove', function (e) {
    if (dragging) setPos(pctFromEvent(e.clientX));
  });

  handle.addEventListener('touchstart', function (e) {
    dragging = true; e.preventDefault();
  }, { passive: false });
  document.addEventListener('touchend', function () { dragging = false; });
  document.addEventListener('touchmove', function (e) {
    if (dragging) setPos(pctFromEvent(e.touches[0].clientX));
  }, { passive: true });

  /* Shopify theme editor reload */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === {{ section.id | json }}) setPos(50);
  });

  requestAnimationFrame(function () { setPos(50); });
}());
</script>

{% stylesheet %}
/* ── Shared ───────────────────────────────────────────── */
.sc2 {
  font-family: 'Jost', sans-serif;
  overflow: hidden;
}

/* ── Hero Banner ──────────────────────────────────────── */
.sc2__hero {
  width: 100%;
  line-height: 0;
}

.sc2__banner-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.sc2__banner-ph {
  width: 100%;
  height: 340px;
  background: #e8e4dc;
}

/* ── Bottom ───────────────────────────────────────────── */
.sc2__bottom {
  background: #1e3a5f;
  padding: 36px 24px 52px;
}

.sc2__grid {
  display: grid;
  grid-template-columns: 1.65fr 1fr;
  gap: 20px;
  max-width: 1380px;
  margin: 0 auto;
}

/* ── Before / After ───────────────────────────────────── */
.sc2__ba {
  display: flex;
  flex-direction: column;
}

.sc2__ba-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.sc2__ba-crown {
  width: 26px;
  height: auto;
  flex-shrink: 0;
}

.sc2__ba-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #fff;
  text-transform: uppercase;
}

/* slider container */
.sc2__bac {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 14px;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.12);
  background: #0d2340;
  cursor: ew-resize;
  flex: 1;
}

.sc2__bac-before,
.sc2__bac-after {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  user-select: none;
  pointer-events: none;
}

.sc2__bac-before { z-index: 1; }
.sc2__bac-after  { z-index: 2; clip-path: inset(0 50% 0 0); }

.sc2__bac-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2a4a6f;
  color: rgba(255, 255, 255, 0.4);
  font-size: 0.9rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.sc2__bac-sep {
  position: absolute;
  top: 0; bottom: 0;
  left: 50%;
  width: 2px;
  background: rgba(255, 255, 255, 0.65);
  z-index: 3;
  transform: translateX(-50%);
  pointer-events: none;
}

.sc2__bac-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 4;
  width: 50px;
  height: 50px;
  cursor: ew-resize;
  pointer-events: auto;
}

.sc2__bac-handle svg {
  width: 50px;
  height: 50px;
}

/* invisible range that captures input across full area */
.sc2__bac-range {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 5;
  cursor: ew-resize;
  margin: 0;
  padding: 0;
  -webkit-appearance: none;
  appearance: none;
}

.sc2__bac-range::-webkit-slider-thumb { -webkit-appearance: none; width: 2px; height: 100%; }
.sc2__bac-range::-moz-range-thumb     { width: 2px; height: 100%; border: none; background: transparent; }

.sc2__bac-tag {
  position: absolute;
  top: 14px;
  z-index: 6;
  background: rgba(10, 20, 35, 0.82);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  padding: 5px 14px;
  border-radius: 4px;
  pointer-events: none;
}

.sc2__bac-tag--b { left: 14px; }
.sc2__bac-tag--a { right: 14px; }

/* ── Icon row ─────────────────────────────────────────── */
.sc2__icons {
  display: flex;
  justify-content: space-around;
  margin-top: 22px;
  padding: 0 12px;
}

.sc2__icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}

.sc2__icon-sym {
  font-size: 1.3rem;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1;
}

.sc2__icon-lbl {
  font-size: 0.6rem;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: center;
}

/* ── Feature card ─────────────────────────────────────── */
.sc2__feat {
  display: flex;
  flex-direction: column;
  border-radius: 14px;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.12);
  background: #0d2340;
}

.sc2__feat-media {
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

.sc2__feat-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.sc2__feat-body {
  padding: 18px 20px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.sc2__feat-hl {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  color: #fff;
  text-transform: uppercase;
  margin: 0 0 10px;
}

.sc2__feat-ul {
  list-style: none;
  padding: 0;
  margin: 0 0 10px;
}

.sc2__feat-ul li {
  position: relative;
  padding-left: 14px;
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.55;
}

.sc2__feat-ul li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: rgba(255, 255, 255, 0.45);
}

.sc2__feat-ft {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  margin: 0;
}

/* ── Tablet ───────────────────────────────────────────── */
@media (max-width: 900px) {
  .sc2__grid { grid-template-columns: 1fr; }
  .sc2__feat { flex-direction: row; min-height: 260px; }
  .sc2__feat-media { flex: 1; }
  .sc2__feat-body { flex: 1; }
}

/* ── Mobile ───────────────────────────────────────────── */
@media (max-width: 580px) {
  .sc2__bottom { padding: 24px 14px 40px; }
  .sc2__bac { aspect-ratio: 4 / 3; }

  .sc2__feat { flex-direction: column; }
  .sc2__feat-media { height: 200px; flex: none; }

  .sc2__ba-title { font-size: 0.85rem; }
}
{% endstylesheet %}

