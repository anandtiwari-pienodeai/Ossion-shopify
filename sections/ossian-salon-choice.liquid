{% comment %}
  Section contract.
  "Choose your concern" pills above a before/after result. Each pill is a tab with its own
  before/after images and recommended-product card; clicking a pill swaps the result.
  Pill before/after images fall back to the pill product's custom.before_image /
  custom.after_image metafields, then to the section's images. The panel markup lives in
  snippets/ossian-salon-choice-panel.liquid.
  @example
  <!-- templates/index.json → ossian_salon_choice -->
{% endcomment %}
{%- liquid
  # Desktop split between the before/after slider and the recommended-product card
  assign sc2_ba_width = section.settings.ba_width | default: 65
  assign sc2_feat_width = 100 | minus: sc2_ba_width
-%}
<section
  class="sc2"
  id="sc2-{{ section.id }}"
  style="--sc2-strip-bg: {{ section.settings.strip_bg }}; --sc2-bottom-bg: {{ section.settings.bottom_bg }}; --sc2-ba-cols: {{ sc2_ba_width }}fr; --sc2-feat-cols: {{ sc2_feat_width }}fr;"
>

  {%- comment -%}── 1. Feature Strip ──────────────────────────────{%- endcomment -%}
  {%- liquid
    assign pill_blocks = section.blocks | where: 'type', 'feature_pill'
    # The first pill marked "Selected first" opens first, else the first pill
    assign sc2_active = 0
    for block in pill_blocks
      if block.settings.highlighted
        assign sc2_active = forloop.index0
        break
      endif
    endfor
  -%}
  {%- if pill_blocks.size > 0 -%}
    <div class="sc2__strip" style="background-color: {{ section.settings.strip_bg }};">
      {%- if section.settings.concern_heading != blank -%}
        <h2 class="sc2__strip-heading">{{ section.settings.concern_heading }}</h2>
      {%- endif -%}
      <div class="sc2__strip-inner" role="tablist" aria-label="{{ section.settings.concern_heading | default: 'Choose your concern' | escape }}">
        {%- for block in pill_blocks -%}
          {%- assign pill_selected = false -%}
          {%- if forloop.index0 == sc2_active -%}{%- assign pill_selected = true -%}{%- endif -%}
          <button
            type="button"
            role="tab"
            id="sc2-tab-{{ block.id }}"
            class="sc2__pill sc2__pill--link{% if pill_selected %} sc2__pill--gold{% endif %}"
            aria-selected="{{ pill_selected }}"
            aria-controls="sc2-panel-{{ block.id }}"
            tabindex="{% if pill_selected %}0{% else %}-1{% endif %}"
            data-sc2-tab
            {{ block.shopify_attributes }}
          >
            <span class="sc2__pill-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'sparkle' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M10 5 L11.2 9.5 L15.5 10.5 L11.2 11.5 L10 16 L8.8 11.5 L4.5 10.5 L8.8 9.5 Z" fill="currentColor"/>
                    <path d="M19 2 L19.8 4.7 L22.5 5.5 L19.8 6.3 L19 9 L18.2 6.3 L15.5 5.5 L18.2 4.7 Z" fill="currentColor"/>
                  </svg>
                {%- when 'waves' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M2 7 Q5.5 4 9 7 Q12.5 10 16 7 Q19.5 4 23 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M2 13 Q5.5 10 9 13 Q12.5 16 16 13 Q19.5 10 23 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M2 19 Q5.5 16 9 19 Q12.5 22 16 19 Q19.5 16 23 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                {%- when 'person' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <circle cx="13" cy="9" r="5" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M4 23 C4 17.5 22 17.5 22 23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                {%- when 'drop' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M13 3 C13 3 5.5 12.5 5.5 16.5 A7.5 7.5 0 0 0 20.5 16.5 C20.5 12.5 13 3 13 3 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M13 2.5 L4 7 L4 13.5 C4 18.5 8 21.5 13 23.5 C18 21.5 22 18.5 22 13.5 L22 7 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M9.5 13 L11.5 15.5 L16.5 10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M13 3 L14.5 9.5 L21 11 L14.5 12.5 L13 19 L11.5 12.5 L5 11 L11.5 9.5 Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 26 26" fill="none">
                    <path d="M13 3 L14.5 9.5 L21 11 L14.5 12.5 L13 19 L11.5 12.5 L5 11 L11.5 9.5 Z" fill="currentColor"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="sc2__pill-text">
              <span class="sc2__pill-label">{{ block.settings.label }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="sc2__pill-sub">{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}── 2. Result: one before/after + product panel per pill ──{%- endcomment -%}
  {%- liquid
    assign ss = section.settings
    assign icon_blocks = section.blocks | where: 'type', 'ba_icon'
    assign sc2_ba_sizes = '(min-width: 901px) ' | append: sc2_ba_width | append: 'vw, 100vw'

    # Section-level result: the default for pills without images or a card of their own
    assign s_href = ss.feat_link
    if s_href == blank and ss.feat_product != blank
      assign s_href = ss.feat_product.url
    elsif s_href == blank and ss.feat_collection != blank
      assign s_href = ss.feat_collection.url
    endif
    assign s_image = ss.feat_image
    if s_image == blank and ss.feat_product == blank and ss.feat_collection != blank
      assign s_image = ss.feat_collection.image
    endif
    assign s_alt = ss.feat_alt
    if s_alt == blank and ss.feat_product == blank and ss.feat_collection != blank
      assign s_alt = ss.feat_collection.title
    endif
  -%}
  <div class="sc2__bottom">
    {%- for block in pill_blocks -%}
      {%- liquid
        assign b = block.settings
        assign pill_product = b.feat_product | default: b.product

        # Learn more: the pill's link (collection, product, custom), else its card product
        assign pill_href = ''
        if b.collection != blank
          assign pill_href = b.collection.url
        elsif b.product != blank
          assign pill_href = b.product.url
        elsif b.link != blank
          assign pill_href = b.link
        elsif b.feat_product != blank
          assign pill_href = b.feat_product.url
        endif

        # Before/after: pill images, else the product's metafields, else the section's
        assign p_before = ss.before_image
        assign p_after = ss.after_image
        if b.before_image != blank or b.after_image != blank
          assign p_before = b.before_image
          assign p_after = b.after_image
        elsif pill_product.metafields.custom.before_image != blank or pill_product.metafields.custom.after_image != blank
          assign p_before = pill_product.metafields.custom.before_image.value
          assign p_after = pill_product.metafields.custom.after_image.value
        endif

        # Card: the pill's own card when any of it is filled in, else the section's
        assign pill_has_card = false
        if b.feat_product != blank or b.feat_image != blank or b.feat_heading_white != blank or b.feat_heading_accent != blank
          assign pill_has_card = true
        endif
        # A card with only a product set uses its title and the start of its description
        assign pill_heading = b.feat_heading_white
        if pill_heading == blank and b.feat_heading_accent == blank
          assign pill_heading = b.feat_product.title
        endif
        assign pill_body = b.feat_body
        if pill_body == blank and b.feat_product != blank
          assign pill_body = b.feat_product.description | strip_html | strip | truncatewords: 24
        endif
        assign pill_hidden = true
        if forloop.index0 == sc2_active
          assign pill_hidden = false
        endif
        assign panel_id = 'sc2-panel-' | append: block.id
        assign tab_id = 'sc2-tab-' | append: block.id
      -%}
      {%- if pill_has_card -%}
        {%- render 'ossian-salon-choice-panel',
          panel_id: panel_id,
          tab_id: tab_id,
          hidden: pill_hidden,
          ba_sizes: sc2_ba_sizes,
          before_image: p_before,
          after_image: p_after,
          icon_blocks: icon_blocks,
          product: b.feat_product,
          image: b.feat_image,
          alt: b.feat_alt,
          eyebrow: b.feat_eyebrow,
          heading_white: pill_heading,
          heading_accent: b.feat_heading_accent,
          subheading: b.feat_subheading,
          body: pill_body,
          cta_label: b.feat_cta_label,
          href: pill_href
        -%}
      {%- else -%}
        {%- comment -%} The section's card keeps its own link so the button matches the product shown {%- endcomment -%}
        {%- assign section_card_href = s_href -%}
        {%- render 'ossian-salon-choice-panel',
          panel_id: panel_id,
          tab_id: tab_id,
          hidden: pill_hidden,
          ba_sizes: sc2_ba_sizes,
          before_image: p_before,
          after_image: p_after,
          icon_blocks: icon_blocks,
          product: ss.feat_product,
          image: s_image,
          alt: s_alt,
          eyebrow: ss.feat_eyebrow,
          heading_white: ss.feat_heading_white,
          heading_accent: ss.feat_heading_accent,
          subheading: ss.feat_subheading,
          body: ss.feat_body,
          cta_label: ss.feat_cta_label,
          href: section_card_href
        -%}
      {%- endif -%}
    {%- else -%}
      {%- assign panel_id = 'sc2-panel-' | append: section.id -%}
      {%- render 'ossian-salon-choice-panel',
        panel_id: panel_id,
        ba_sizes: sc2_ba_sizes,
        before_image: ss.before_image,
        after_image: ss.after_image,
        icon_blocks: icon_blocks,
        product: ss.feat_product,
        image: s_image,
        alt: s_alt,
        eyebrow: ss.feat_eyebrow,
        heading_white: ss.feat_heading_white,
        heading_accent: ss.feat_heading_accent,
        subheading: ss.feat_subheading,
        body: ss.feat_body,
        cta_label: ss.feat_cta_label,
        href: s_href
      -%}
    {%- endfor -%}
  </div>

</section>

<script>
(function () {
  var root = document.getElementById('sc2-{{ section.id }}');
  if (!root) return;
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* Before/after slider: the invisible range input drives the split (mouse, touch, keyboard) */
  function setPos(compare, pct) {
    var cur = Math.max(0, Math.min(100, pct));
    var after = compare.querySelector('.sc2__bac-after');
    var sep = compare.querySelector('.sc2__bac-sep');
    var handle = compare.querySelector('.sc2__bac-handle');
    var range = compare.querySelector('.sc2__bac-range');
    if (after) after.style.clipPath = 'inset(0 0 0 ' + cur + '%)';
    if (sep) sep.style.left = cur + '%';
    if (handle) handle.style.left = cur + '%';
    if (range) range.value = cur;
  }

  root.querySelectorAll('[data-sc2-compare]').forEach(function (compare) {
    var range = compare.querySelector('.sc2__bac-range');
    if (range) range.addEventListener('input', function () { setPos(compare, +range.value); });
    setPos(compare, 50);
  });

  /* Concern pills are tabs: selecting one shows its before/after panel */
  var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-sc2-tab]'));

  function select(tab, focus) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      t.classList.toggle('sc2__pill--gold', on);
      var panel = document.getElementById(t.getAttribute('aria-controls'));
      if (!panel) return;
      panel.hidden = !on;
      if (on) {
        var compare = panel.querySelector('[data-sc2-compare]');
        if (compare) setPos(compare, 50);
      }
    });
    if (focus) tab.focus();

    /* Bring the pill into view inside the scrolling row without scrolling the page */
    var strip = tab.parentElement;
    if (strip && strip.scrollWidth > strip.clientWidth) {
      var stripRect = strip.getBoundingClientRect();
      var tabRect = tab.getBoundingClientRect();
      strip.scrollBy({
        left: tabRect.left - stripRect.left - (stripRect.width - tabRect.width) / 2,
        behavior: reduceMotion.matches ? 'auto' : 'smooth'
      });
    }
  }

  tabs.forEach(function (tab, index) {
    tab.addEventListener('click', function () { select(tab, false); });
    tab.addEventListener('keydown', function (event) {
      var rtl = getComputedStyle(root).direction === 'rtl';
      var next = null;
      if (event.key === (rtl ? 'ArrowLeft' : 'ArrowRight')) next = tabs[(index + 1) % tabs.length];
      else if (event.key === (rtl ? 'ArrowRight' : 'ArrowLeft')) next = tabs[(index - 1 + tabs.length) % tabs.length];
      else if (event.key === 'Home') next = tabs[0];
      else if (event.key === 'End') next = tabs[tabs.length - 1];
      if (!next) return;
      event.preventDefault();
      select(next, true);
    });
  });

  /* Theme editor: selecting a pill block shows its panel */
  root.addEventListener('shopify:block:select', function (event) {
    var tab = event.target.closest && event.target.closest('[data-sc2-tab]');
    if (tab) select(tab, false);
  });
}());
</script>

{% stylesheet %}
/* ── Shared ───────────────────────────────────────────── */
.sc2 {
  font-family: 'Jost', sans-serif;
  overflow: hidden;
}

/* ── Feature Strip ────────────────────────────────────── */
.sc2__strip {
  padding: 32px 24px 28px;
}

.sc2__strip-heading {
  text-align: center;
  font-size: clamp(1.3rem, 2.4vw, 2.1rem);
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #1e3a5f;
  margin: 0 0 22px;
}

/* Only the pill row scrolls; the heading stays in place */
.sc2__strip-inner {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 0 auto;
  max-width: 1380px;
  padding-block: 6px 12px;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.sc2__strip-inner::-webkit-scrollbar { display: none; }

/* Auto margins centre the row when it fits and keep the first pill reachable when it overflows */
.sc2__strip-inner > :first-child { margin-inline-start: auto; }
.sc2__strip-inner > :last-child { margin-inline-end: auto; }

.sc2__pill {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  font: inherit;
  text-align: start;
  color: inherit;
  padding: 12px 20px;
  border-radius: 50px;
  border: none;
  background: #14284a;
  box-shadow: 0 3px 10px rgba(20, 40, 74, 0.18);
  flex-shrink: 0;
  cursor: default;
}

.sc2__pill--link {
  color: inherit;
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.sc2__pill--link:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(20, 40, 74, 0.28);
}

.sc2__pill--link:focus-visible {
  outline: 2px solid #dba84a;
  outline-offset: 3px;
}

@keyframes sc2-panel-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .sc2__grid { animation: none; }
  .sc2__pill--link { transition: none; }
  .sc2__pill--link:hover { transform: none; }
}

.sc2__pill--gold {
  background: linear-gradient(135deg, #b8832a 0%, #dba84a 50%, #c9953a 100%);
  box-shadow: 0 3px 10px rgba(184, 131, 42, 0.35);
}

.sc2__pill-icon {
  width: 26px;
  height: 26px;
  color: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc2__pill-icon svg { width: 100%; height: 100%; }

.sc2__pill-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.sc2__pill-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #fff;
  text-transform: uppercase;
  line-height: 1.25;
  white-space: nowrap;
}

.sc2__pill-sub {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
  line-height: 1.25;
  white-space: nowrap;
}

/* ── Bottom ───────────────────────────────────────────── */
.sc2__bottom {
  background: var(--sc2-bottom-bg, #1e3a5f);
  padding: 0;
}

.sc2__grid[hidden] {
  display: none;
}

.sc2__grid {
  animation: sc2-panel-in 0.35s ease;
  display: grid;
  /* Slider takes most of the row; the product card keeps enough room for its copy */
  grid-template-columns: minmax(0, var(--sc2-ba-cols, 65fr)) minmax(260px, var(--sc2-feat-cols, 35fr));
  gap: 0;
  margin: 0 auto;
  align-items: stretch;
}

/* ── Before / After ───────────────────────────────────── */
.sc2__ba {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.sc2__ba-head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  text-align: center;
  margin-bottom: 20px;
  padding: 0 24px;
}

.sc2__ba-crown {
  width: 26px;
  height: auto;
  flex-shrink: 0;
}

.sc2__ba-title {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #fff;
  text-transform: uppercase;
}

/* slider container */
.sc2__bac {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 0;
  background: #0d2340;
  cursor: ew-resize;
  flex: 1;
}

.sc2__bac-before,
.sc2__bac-after {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  user-select: none;
  pointer-events: none;
}

.sc2__bac-before { z-index: 1; }
.sc2__bac-after  { z-index: 2; clip-path: inset(0 0 0 50%); }

.sc2__bac-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2a4a6f;
  color: rgba(255, 255, 255, 0.4);
  font-size: 0.9rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.sc2__bac-sep {
  position: absolute;
  top: 0; bottom: 0;
  left: 50%;
  width: 2px;
  background: rgba(255, 255, 255, 0.65);
  z-index: 3;
  transform: translateX(-50%);
  pointer-events: none;
}

.sc2__bac-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 4;
  width: 50px;
  height: 50px;
  cursor: ew-resize;
  pointer-events: auto;
}

.sc2__bac-handle svg {
  width: 50px;
  height: 50px;
}

/* invisible range that captures input across full area */
.sc2__bac-range {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 5;
  cursor: ew-resize;
  margin: 0;
  padding: 0;
  -webkit-appearance: none;
  appearance: none;
}

.sc2__bac-range::-webkit-slider-thumb { -webkit-appearance: none; width: 2px; height: 100%; }
.sc2__bac-range::-moz-range-thumb     { width: 2px; height: 100%; border: none; background: transparent; }

.sc2__bac-tag {
  position: absolute;
  top: 14px;
  z-index: 6;
  background: rgba(10, 20, 35, 0.82);
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  padding: 5px 14px;
  border-radius: 4px;
  pointer-events: none;
}

.sc2__bac-tag--b { left: 14px; }
.sc2__bac-tag--a { right: 14px; }

/* ── Icon row ─────────────────────────────────────────── */
.sc2__icons {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 20px;
  background: #05070d;
}

.sc2__icon {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.sc2__icon-badge {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc2__icon-badge svg {
  width: 18px;
  height: 18px;
}

.sc2__icon-sym {
  font-size: 1rem;
  line-height: 1;
}

.sc2__icon-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sc2__icon-lbl {
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.3;
  white-space: nowrap;
}

.sc2__icon-sub {
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.3;
  white-space: nowrap;
}

/* ── Feature card (recommended product) ───────────────── */
/* Copy and image sit side by side when the card is wide, and stack (copy above image)
   when it is narrow, e.g. the default 20% desktop column */
.sc2__feat {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  align-content: center;
  gap: 0;
  min-width: 0;
  position: relative;
  overflow: hidden;
  background: #05070d;
  /* stretch to match BA card height inside the grid row */
  align-self: stretch;
}

.sc2__feat-body {
  display: flex;
  flex-direction: column;
  flex: 1 1 16rem;
  min-width: 0;
  padding: clamp(24px, 2.4vw, 40px) clamp(20px, 2vw, 32px);
}

.sc2__feat-eyebrow {
  font-size: clamp(0.9rem, 1.1vw, 1.05rem);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
  margin: 0 0 14px;
}

.sc2__feat-heading {
  font-size: clamp(1.35rem, 1.75vw, 2.1rem);
  overflow-wrap: break-word;
  font-weight: 800;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 14px;
}

.sc2__feat-heading-accent {
  color: #3b82f6;
}

.sc2__feat-heading span:not(:last-child) {
  margin-right: 0.28em;
}

.sc2__feat-subheading {
  font-size: clamp(0.95rem, 1.2vw, 1.15rem);
  font-weight: 600;
  color: #d9a441;
  margin: 0 0 14px;
}

.sc2__feat-desc {
  font-size: clamp(0.85rem, 1vw, 1rem);
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
  max-width: 34ch;
  margin: 0 0 26px;
}

.sc2__feat-cta {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  background: linear-gradient(135deg, #b8832a 0%, #dba84a 50%, #c9953a 100%);
  color: #fff;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  padding: 14px 30px;
  border-radius: 8px;
  text-decoration: none;
  transition: filter 0.2s;
}

.sc2__feat-cta-icon {
  display: none;
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.sc2__feat-cta:hover {
  filter: brightness(1.08);
}

.sc2__feat-media {
  flex: 1 1 12rem;
  align-self: stretch;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 clamp(16px, 1.6vw, 24px) clamp(12px, 1.2vw, 20px);
  min-width: 0;
}

.sc2__feat-img {
  width: 100%;
  height: 100%;
  max-height: 20rem;
  object-fit: contain;
  object-position: center bottom;
  display: block;
}

.sc2__feat-ph {
  width: 100%;
  height: 100%;
  min-height: 160px;
  background: #0d2340;
}

@media (min-width: 901px) {
  /* Wider slider column, so keep it from getting too tall */
  .sc2__bac { aspect-ratio: 2 / 1; }
}

/* ── Tablet ───────────────────────────────────────────── */
@media (max-width: 900px) {
  .sc2__grid { grid-template-columns: 1fr; }
  .sc2__feat { flex-direction: row; min-height: 260px; }
  .sc2__feat-media { flex: 1; padding: 16px; }
  .sc2__feat-body { flex: 1; padding: 28px 16px 28px 28px; }
}

/* ── Mobile ───────────────────────────────────────────── */
@media (max-width: 580px) {
  .sc2__bac { aspect-ratio: 4 / 3; }

  .sc2__icons {
    flex-wrap: wrap;
    gap: 14px 10px;
    padding: 16px;
  }

  .sc2__icon { flex: 0 0 47%; }

  .sc2__icon-lbl,
  .sc2__icon-sub {
    white-space: normal;
  }

  /* Framed card: before/after on top, dark product panel below */
  .sc2__bottom {
    background: var(--sc2-strip-bg, #eef1f8);
    padding: 4px 16px 28px;
  }

  .sc2__grid {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(20, 40, 74, 0.18);
  }

  .sc2__bac { aspect-ratio: 7 / 5; }

  .sc2__bac-tag {
    top: 12px;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    padding: 6px 12px;
    border-radius: 6px;
  }

  .sc2__bac-tag--b { left: 12px; }
  .sc2__bac-tag--a { right: 12px; }

  .sc2__bac-handle,
  .sc2__bac-handle svg { width: 42px; height: 42px; }

  /* Copy sits on the left, product image anchors the bottom-right corner */
  .sc2__feat {
    display: block;
    min-height: 340px;
  }

  .sc2__feat-body {
    position: relative;
    z-index: 2;
    padding: 28px 20px 30px;
  }

  .sc2__feat-eyebrow { font-size: 0.85rem; margin-bottom: 10px; }

  .sc2__feat-heading {
    font-size: clamp(1.6rem, 7.6vw, 2rem);
    line-height: 1.1;
    margin-bottom: 10px;
  }

  .sc2__feat-subheading { font-size: 1rem; margin-bottom: 12px; }

  .sc2__feat-desc,
  .sc2__feat-cta { max-width: 58%; }

  .sc2__feat-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    margin-bottom: 20px;
  }

  .sc2__feat-cta {
    gap: 10px;
    padding: 12px 22px;
    border-radius: 10px;
    color: #14284a;
    font-size: 0.95rem;
  }

  .sc2__feat-cta-icon { display: block; }

  .sc2__feat-media {
    position: absolute;
    z-index: 1;
    inset-inline-end: 0;
    bottom: 0;
    width: 46%;
    height: 64%;
    padding: 0 8px 14px 0;
  }

  .sc2__feat-img { object-position: right bottom; }

  .sc2__ba-title { font-size: 0.85rem; }

  .sc2__strip { padding: 24px 0 20px; }
  .sc2__strip-heading { margin: 0 0 16px; padding-inline: 16px; }
  .sc2__strip-inner { padding-inline: 16px; scroll-padding-inline: 16px; }
}
{% endstylesheet %}

