      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "header",
      "content": "Feature Card"
    },
    {
      "type": "product",
      "id": "feat_product",
      "label": "Link to product"
    },
    {
      "type": "collection",
      "id": "feat_collection",
      "label": "Link to collection"
