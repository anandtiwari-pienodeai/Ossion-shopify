<section class="collection-hero" id="collection-hero-{{ section.id }}">
  <div class="collection-hero__banner">
    {%- if section.settings.banner_link != blank -%}<a href="{{ section.settings.banner_link }}" class="collection-hero__link">{%- endif -%}
    {%- if section.settings.banner_image != blank -%}
      {{
        section.settings.banner_image
        | image_url: width: 2000
        | image_tag:
          class: 'collection-hero__img',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750,1100,1600,2000',
          alt: section.settings.banner_image.alt | default: collection.title
      }}
    {%- else -%}
      <div class="collection-hero__placeholder"></div>
    {%- endif -%}
    {%- if section.settings.banner_link != blank -%}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.collection-hero {
  width: 100%;
  display: block;
}

.collection-hero__banner {
  width: 100%;
  display: block;
  line-height: 0;
  padding:0px 10px
}

@media screen and (max-width: 749px) {
  .collection-hero__banner {
   
    padding: 0 8px;
  }
}

.collection-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.collection-hero__link {
  display: block;
  width: 100%;
  height: 100%;
}

.collection-hero__placeholder {
  width: 100%;
  height: var(--collection-hero-height, 480px);
  background: linear-gradient(135deg, #0b1e35 0%, #1e3a5f 100%);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Hero Banner",
  "tag": "section",
  "class": "ossian-collection-hero-section",
  "enabled_on": {
    "templates": ["collection", "index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link",
      "info": "Optional. Makes the whole banner clickable — link to any page, collection, or product."
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height (desktop)",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Banner height (mobile)",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    }
  ],
  "presets": [
    {
      "name": "Collection Hero Banner",
      "settings": {
        "banner_height": 480,
        "banner_height_mobile": 220
      }
    }
  ]
}
{% endschema %}

<style>
  #collection-hero-{{ section.id }} {
    --collection-hero-height: {{ section.settings.banner_height }}px;
    --collection-hero-height-mobile: {{ section.settings.banner_height_mobile }}px;
  }
</style>
