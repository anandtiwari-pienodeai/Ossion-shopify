{{ 'section-ossian-marine-banner.css' | asset_url | stylesheet_tag }}
<section class="marine-banner" id="marine-banner-{{ section.id }}">
  {%- if section.settings.cta_url != blank -%}
    <a
      href="{{ section.settings.cta_url }}"
      class="marine-banner__bg-link"
      {% if section.settings.cta_label != blank %}aria-hidden="true" tabindex="-1"{% endif %}
    ></a>
  {%- endif -%}
  {%- if section.settings.bg_image != blank -%}
    {{
      section.settings.bg_image
      | image_url: width: 1600
      | image_tag:
        class: 'marine-banner__bg',
        loading: 'lazy',
        widths: '750,1100,1600'
    }}
  {%- else -%}
    <div class="marine-banner__bg marine-banner__bg--fallback"></div>
  {%- endif -%}

  <div class="marine-banner__overlay"></div>

  <div class="marine-banner__content page-width">
    <!-- Brand / Left -->
    <div class="marine-banner__brand">
      <div class="marine-banner__icon-wrap">
        {%- if section.settings.icon_image != blank -%}
          {{
            section.settings.icon_image
            | image_url: width: 120
            | image_tag: class: 'marine-banner__icon', loading: 'lazy'
          }}
        {%- else -%}
          <svg class="marine-banner__icon-svg" width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="24" cy="24" r="22" stroke="white" stroke-width="1.5"/>
            <circle cx="24" cy="16" r="5" stroke="white" stroke-width="1.5"/>
            <circle cx="14" cy="30" r="5" stroke="white" stroke-width="1.5"/>
            <circle cx="34" cy="30" r="5" stroke="white" stroke-width="1.5"/>
            <line x1="24" y1="21" x2="14" y2="25" stroke="white" stroke-width="1.5"/>
            <line x1="24" y1="21" x2="34" y2="25" stroke="white" stroke-width="1.5"/>
            <line x1="14" y1="30" x2="34" y2="30" stroke="white" stroke-width="1.5"/>
          </svg>
        {%- endif -%}
      </div>
      <div class="marine-banner__brand-text">
        <span class="marine-banner__powered">{{ section.settings.powered_by_label | default: 'POWERED BY' }}</span>
        <span class="marine-banner__brand-name">{{ section.settings.brand_name | default: 'MARINE TECHNOLOGY' }}</span>
      </div>
    </div>

    <!-- Divider -->
    <div class="marine-banner__divider" aria-hidden="true"></div>

    <!-- Description -->
    {%- if section.settings.description != blank -%}
      <p class="marine-banner__desc">{{ section.settings.description }}</p>
    {%- endif -%}

    <!-- CTA -->
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="marine-banner__cta">
        {{ section.settings.cta_label }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "Marine Technology Banner",
  "tag": "section",
  "class": "ossian-marine-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Brand icon image"
    },
    {
      "type": "text",
      "id": "powered_by_label",
      "label": "Powered by label",
      "default": "POWERED BY"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "MARINE TECHNOLOGY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Ocean derived actives work in synergy with advanced science to deliver superior lift, protection and long lasting colour results."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Explore Our Science"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Marine Technology Banner",
      "settings": {
        "powered_by_label": "POWERED BY",
        "brand_name": "MARINE TECHNOLOGY",
        "description": "Ocean derived actives work in synergy with advanced science to deliver superior lift, protection and long lasting colour results.",
        "cta_label": "Explore Our Science"
      }
    }
  ]
}
{% endschema %}
