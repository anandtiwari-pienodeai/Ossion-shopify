<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">

{%- assign product_blocks = section.blocks | where: "type", "product_card" -%}
{%- assign feature_blocks = section.blocks | where: "type", "feature_item" -%}

<section class="pshowcase" id="pshowcase-{{ section.id }}">

  <!-- Section background image -->
  {%- if section.settings.bg_image != blank -%}
    <div class="pshowcase__bg" aria-hidden="true">
      {{ section.settings.bg_image | image_url: width: 1920 | image_tag: class: 'pshowcase__bg-img', alt: '', loading: 'lazy', widths: '800,1200,1600,1920' }}
    </div>
  {%- endif -%}

  <div class="pshowcase__main page-width">

    <!-- Left Panel -->
    <div class="pshowcase__left">
      {%- if section.settings.category_label != blank -%}
        <p class="pshowcase__eyebrow">{{ section.settings.category_label }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pshowcase__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <p class="pshowcase__body">{{ section.settings.body_text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="pshowcase__cta">
          {{ section.settings.cta_text }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
      <div class="pshowcase__trust">
        {%- for i in (1..3) -%}
          {%- assign icon_key = 'trust_icon_' | append: i -%}
          {%- assign label_key = 'trust_label_' | append: i -%}
          {%- assign label_val = section.settings[label_key] -%}
          {%- assign icon_val = section.settings[icon_key] -%}
          {%- if label_val != blank -%}
            <div class="pshowcase__trust-item">
              {%- if icon_val == 'flask' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9 3v7L4 19a1 1 0 00.93 1.37h14.14A1 1 0 0020 19l-5-9V3"/><line x1="6.3" y1="16" x2="17.7" y2="16"/></svg>
              {%- elsif icon_val == 'drop' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C12 2 5 10 5 15a7 7 0 0014 0c0-5-7-13-7-13z"/></svg>
              {%- elsif icon_val == 'shield' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- else -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
              {%- endif -%}
              <span>{{ label_val }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Center: Featured Card -->
    {%- for block in product_blocks limit: 1 -%}
      {%- assign card_url = block.settings.collection.url | default: block.settings.link | default: '#' -%}
      <div class="pshowcase__card pshowcase__card--featured" {{ block.shopify_attributes }}>
        {%- if block.settings.badge_label != blank -%}
          <span class="pshowcase__badge">{{ block.settings.badge_label }}</span>
        {%- endif -%}
        <a href="{{ card_url }}" class="pshowcase__img-link">
          <div class="pshowcase__img-wrap">
            {%- if block.settings.product != blank -%}
              {{ block.settings.product.featured_image | image_url: width: 800 | image_tag: class: 'pshowcase__img', alt: block.settings.product.title, loading: 'lazy', widths: '400,600,800' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'pshowcase__img', loading: 'lazy', widths: '400,600,800' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pshowcase__img pshowcase__img--placeholder' }}
            {%- endif -%}
          </div>
        </a>
        <div class="pshowcase__card-footer">
          {%- if block.settings.step_label != blank -%}
            <span class="pshowcase__step">{{ block.settings.step_label }}</span>
          {%- endif -%}
          <div class="pshowcase__card-info">
            <h3 class="pshowcase__name">
              {%- if block.settings.product != blank -%}{{ block.settings.product.title }}{%- else -%}{{ block.settings.custom_name }}{%- endif -%}
            </h3>
            {%- if block.settings.descriptor != blank -%}
              <p class="pshowcase__descriptor">{{ block.settings.descriptor }}</p>
            {%- endif -%}
          </div>
          <a href="{{ card_url }}" class="pshowcase__arrow" aria-label="View product">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    {%- endfor -%}

    <!-- Right: Stacked Secondary Cards -->
    {%- if product_blocks.size > 1 -%}
      <div class="pshowcase__stack">
        {%- for block in product_blocks limit: 2 offset: 1 -%}
          {%- assign card_url = block.settings.collection.url | default: block.settings.link | default: '#' -%}
          <div class="pshowcase__card pshowcase__card--secondary" {{ block.shopify_attributes }}>
            {%- if block.settings.badge_label != blank -%}
              <span class="pshowcase__badge">{{ block.settings.badge_label }}</span>
            {%- endif -%}
            <a href="{{ card_url }}" class="pshowcase__img-link">
              <div class="pshowcase__img-wrap">
                {%- if block.settings.product != blank -%}
                  {{ block.settings.product.featured_image | image_url: width: 600 | image_tag: class: 'pshowcase__img', alt: block.settings.product.title, loading: 'lazy', widths: '300,500,600' }}
                {%- elsif block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: class: 'pshowcase__img', loading: 'lazy', widths: '300,500,600' }}
                {%- else -%}
                  {{ 'product-2' | placeholder_svg_tag: 'pshowcase__img pshowcase__img--placeholder' }}
                {%- endif -%}
              </div>
            </a>
            <div class="pshowcase__card-footer">
              {%- if block.settings.step_label != blank -%}
                <span class="pshowcase__step">{{ block.settings.step_label }}</span>
              {%- endif -%}
              <div class="pshowcase__card-info">
                <h3 class="pshowcase__name">
                  {%- if block.settings.product != blank -%}{{ block.settings.product.title }}{%- else -%}{{ block.settings.custom_name }}{%- endif -%}
                </h3>
                {%- if block.settings.descriptor != blank -%}
                  <p class="pshowcase__descriptor">{{ block.settings.descriptor }}</p>
                {%- endif -%}
              </div>
              <a href="{{ card_url }}" class="pshowcase__arrow" aria-label="View product">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  <!-- Bottom Feature Bar -->
  {%- if feature_blocks.size > 0 -%}
    <div class="pshowcase__features">
      <div class="pshowcase__features-inner page-width">
        {%- for block in feature_blocks -%}
          <div class="pshowcase__feature" {{ block.shopify_attributes }}>
            <div class="pshowcase__feature-icon">
              {%- case block.settings.icon -%}
                {%- when 'beaker' -%}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9 3v7L4 19a1 1 0 00.93 1.37h14.14A1 1 0 0020 19l-5-9V3"/><line x1="6.3" y1="16" x2="17.7" y2="16"/></svg>
                {%- when 'triangle' -%}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3L2 21h20L12 3z"/><path d="M12 8v6"/><circle cx="12" cy="17.5" r="0.6" fill="currentColor" stroke="none"/></svg>
                {%- when 'drop' -%}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C12 2 5 10 5 15a7 7 0 0014 0c0-5-7-13-7-13z"/><path d="M9.5 15.5a3 3 0 003 2"/></svg>
                {%- when 'person' -%}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
                {%- else -%}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
            </div>
            <div class="pshowcase__feature-text">
              {%- if block.settings.title != blank -%}
                <strong>{{ block.settings.title }}</strong>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p>{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

{% stylesheet %}

/* ── Base ── */
.pshowcase,
.pshowcase * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

/* ── Section ── */
.pshowcase {
  position: relative;
  overflow: hidden;
  background: #e8eef5;
  padding: 0 0 0;
  display: flex;
  flex-direction: column;
  height: min(850px, 90vh);
}

/* ── Background Image ── */
.pshowcase__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.pshowcase__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

/* ── Main 3-col Grid ── */
.pshowcase__main {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1.5fr 1.45fr;
  grid-template-rows: minmax(0, 1fr);
  gap: 20px;
  align-items: stretch;
  padding-top: 16px;
  padding-bottom: 20px;
  flex: 1;
  min-height: 0;
}

/* ── Left Panel ── */
.pshowcase__left {
  display: flex;
  flex-direction: column;
  padding: 72px 16px 28px 0;
  min-height: 0;
  overflow: hidden;
}

/* Eyebrow — exact Figma: 32px Jost Medium, #005cc8, tracking -0.64px, NOT italic */
.pshowcase__eyebrow {
  font-size: clamp(1.25rem, 2.22vw, 2rem);
  font-weight: 500;
  font-style: normal;
  color: #005cc8;
  letter-spacing: -0.02em;
  margin: 0 0 10px;
  line-height: 1.3;
}

/* Heading — exact Figma: 54px Jost Medium, #22345a, line-height 68px */
.pshowcase__heading {
  font-size: clamp(2rem, 3.75vw, 3.375rem);
  font-weight: 500;
  color: #22345a;
  line-height: 1.26;
  margin: 0 0 20px;
  letter-spacing: -0.01em;
}

/* Body — exact Figma: 28px Jost Medium, #22345a, line-height 42px */
.pshowcase__body {
  font-size: clamp(1rem, 1.94vw, 1.75rem);
  font-weight: 500;
  color: #22345a;
  line-height: 1.5;
  margin: 0 0 32px;
}

/* CTA — exact Figma: 20px Jost SemiBold, #22345a, border 2px #2f8cf8, radius 8px */
.pshowcase__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  background: #fff;
  border: 2px solid #2f8cf8;
  border-radius: 8px;
  color: #22345a;
  font-size: clamp(0.95rem, 1.39vw, 1.25rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  text-decoration: none;
  align-self: flex-start;
  transition: background 0.22s, color 0.22s, border-color 0.22s;
  white-space: nowrap;
}

.pshowcase__cta svg {
  stroke: #22345a;
  transition: stroke 0.22s;
  flex-shrink: 0;
}

.pshowcase__cta:hover {
  background: #2f8cf8;
  color: #fff;
  border-color: #2f8cf8;
}

.pshowcase__cta:hover svg {
  stroke: #fff;
}

/* Trust icons pinned to bottom */
.pshowcase__trust {
  display: flex;
  gap: 8px;
  margin-top: auto;
  padding-top: 36px;
}

.pshowcase__trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.pshowcase__trust-item svg {
  stroke: #005cc8;
  flex-shrink: 0;
}

/* Trust label — exact Figma: 14px Jost Medium, #005cc8, tracking -0.28px */
.pshowcase__trust-item span {
  font-size: 0.875rem;
  font-weight: 500;
  color: #005cc8;
  text-align: center;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

/* ── Cards shared ── */
.pshowcase__card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  box-shadow: 0 12px 28px rgba(34, 52, 90, 0.12);
}

.pshowcase__stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: 100%;
}

.pshowcase__card--secondary {
  flex: 1;
}

/* ── Badge — white pill, thin border ── */
.pshowcase__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid rgba(34, 52, 90, 0.2);
  color: #22345a;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
  line-height: 1;
}

/* ── Product Image ── */
.pshowcase__img-link {
  flex: 1;
  display: block;
  text-decoration: none;
  min-height: 0;
}

.pshowcase__img-wrap {
  overflow: hidden;
  background: #eaecef;
  height: 100%;
}


.pshowcase__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.pshowcase__img--placeholder {
  width: 100%;
  height: 100%;
}

.pshowcase__card:hover .pshowcase__img {
  transform: scale(1.04);
}

/* ── Card Footer ── */
.pshowcase__card-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  flex-shrink: 0;
  background: #fff;
}

/* Step tag — exact Figma: dark navy pill */
.pshowcase__step {
  display: inline-flex;
  align-items: center;
  background: #22345a;
  color: #fff;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 10px;
  border-radius: 6px;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}

.pshowcase__card-info {
  flex: 1;
  min-width: 0;
}

/* Product name — exact Figma: 20px Jost Bold, #22345a, line-height 26px */
.pshowcase__name {
  font-size: clamp(0.95rem, 1.39vw, 1.25rem);
  font-weight: 700;
  color: #22345a;
  margin: 0 0 2px;
  line-height: 1.3;
}

/* Descriptor — exact Figma: 18px Jost Medium, #22345a, line-height 26px */
.pshowcase__descriptor {
  font-size: clamp(0.85rem, 1.25vw, 1.125rem);
  font-weight: 500;
  color: #22345a;
  opacity: 0.7;
  margin: 0;
  line-height: 1.44;
}

/* ── Arrow Button ── */
.pshowcase__arrow {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  border: 1.5px solid #22345a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #22345a;
  text-decoration: none;
  flex-shrink: 0;
  transition: background 0.2s, color 0.2s;
}

.pshowcase__arrow:hover {
  background: #22345a;
  color: #fff;
}

/* ── Feature Bar — exact Figma: 16px Jost Medium/Regular, #22345a ── */
.pshowcase__features {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 0 0 20px;
}

.pshowcase__features-inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 10px 24px rgba(34, 52, 90, 0.1);
}

.pshowcase__feature {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 22px 28px;
  border-right: 1px solid rgba(34, 52, 90, 0.1);
}

.pshowcase__feature:last-child {
  border-right: none;
}

.pshowcase__feature-icon {
  flex-shrink: 0;
}

.pshowcase__feature-icon svg {
  stroke: #005cc8;
  display: block;
}

/* Feature title — 16px Jost Medium */
.pshowcase__feature-text strong {
  display: block;
  font-size: 1rem;
  font-weight: 500;
  color: #22345a;
  margin-bottom: 2px;
  line-height: 1.25;
}

/* Feature subtitle — 16px Jost Regular */
.pshowcase__feature-text p {
  font-size: 1rem;
  font-weight: 400;
  color: #22345a;
  opacity: 0.6;
  margin: 0;
  line-height: 1.25;
}

/* ── Tablet (900px) ── */
@media (max-width: 900px) {
  .pshowcase {
    height: auto;
    overflow: visible;
  }

  .pshowcase__main {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: none;
    gap: 14px;
    padding-top: 40px;
    padding-bottom: 16px;
    flex: none;
    min-height: 0;
  }

  .pshowcase__left {
    grid-column: 1 / -1;
    padding: 0 0 16px;
    min-height: 0;
    overflow: visible;
  }

  .pshowcase__trust {
    margin-top: 24px;
    padding-top: 0;
    gap: 16px;
  }

  .pshowcase__trust-item {
    flex: 0 0 auto;
  }

  .pshowcase__features-inner {
    grid-template-columns: repeat(2, 1fr);
  }

  .pshowcase__feature:nth-child(2) {
    border-right: none;
  }

  .pshowcase__feature:nth-child(1),
  .pshowcase__feature:nth-child(2) {
    border-bottom: 1px solid rgba(34, 52, 90, 0.1);
  }

  .pshowcase__feature {
    padding: 18px 20px;
  }
}

/* ── Mobile (600px) ── */
@media (max-width: 600px) {
  .pshowcase__main {
    grid-template-columns: 1fr;
    gap: 12px;
    padding-top: 32px;
  }

  .pshowcase__left {
    padding: 0 0 4px;
  }

  .pshowcase__trust {
    gap: 8px;
    padding-top: 20px;
  }

  .pshowcase__trust-item {
    flex: 1;
  }

  .pshowcase__stack {
    flex-direction: row;
    height: auto;
    gap: 10px;
  }

  .pshowcase__card--secondary {
    flex: 1;
  }

  .pshowcase__card-footer {
    padding: 10px 12px;
    gap: 7px;
  }

  .pshowcase__step {
    font-size: 0.5rem;
    padding: 4px 7px;
  }

  .pshowcase__name {
    font-size: 0.85rem;
  }

  .pshowcase__descriptor {
    font-size: 0.72rem;
  }

  .pshowcase__arrow {
    width: 28px;
    height: 28px;
    min-width: 28px;
  }

  .pshowcase__arrow svg {
    width: 12px;
    height: 12px;
  }

  .pshowcase__features-inner {
    grid-template-columns: repeat(2, 1fr);
  }

  .pshowcase__feature {
    padding: 16px 14px;
    gap: 10px;
  }

  .pshowcase__feature-icon svg {
    width: 28px;
    height: 28px;
  }

  .pshowcase__feature-text strong,
  .pshowcase__feature-text p {
    font-size: 0.85rem;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "ossian-product-showcase-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section background image"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Eyebrow label",
      "default": "Hair Care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional Hair Solutions"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Advanced formulas for stronger, smoother & healthier hair."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA button link"
    },
    {
      "type": "header",
      "content": "Trust Icons"
    },
    {
      "type": "select",
      "id": "trust_icon_1",
      "label": "Icon 1",
      "options": [
        { "value": "flask", "label": "Flask" },
        { "value": "drop", "label": "Drop" },
