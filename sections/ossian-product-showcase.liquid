<div class="ossian-product-showcase" id="ossian-showcase-{{ section.id }}">
  <div class="ossian-product-showcase__header page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ossian-product-showcase__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.category_label != blank -%}
      <p class="ossian-product-showcase__label">{{ section.settings.category_label }}</p>
    {%- endif -%}
  </div>

  <div class="ossian-product-showcase__track-wrapper page-width">
    {%- if section.blocks.size > 3 -%}
      <button class="ossian-product-showcase__arrow ossian-product-showcase__arrow--prev" aria-label="Previous" data-showcase-id="{{ section.id }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}

    <div class="ossian-product-showcase__track" id="ossian-showcase-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="ossian-product-showcase__card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="ossian-product-showcase__card-link">
            <div class="ossian-product-showcase__image-wrap">
              {%- if block.settings.product != blank -%}
                {%- assign prod = block.settings.product -%}
                {{
                  prod.featured_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'ossian-product-showcase__img',
                    alt: prod.title,
                    loading: 'lazy',
                    widths: '300,400,600'
                }}
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'ossian-product-showcase__img',
                    loading: 'lazy',
                    widths: '300,400,600'
                }}
              {%- else -%}
                <div class="ossian-product-showcase__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'ossian-product-showcase__placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="ossian-product-showcase__info">
              <p class="ossian-product-showcase__tag">{{ block.settings.tag_label }}</p>
              <h3 class="ossian-product-showcase__name">
                {%- if block.settings.product != blank -%}
                  {{ block.settings.product.title }}
                {%- else -%}
                  {{ block.settings.custom_name }}
                {%- endif -%}
              </h3>
              {%- if block.settings.descriptor != blank -%}
                <p class="ossian-product-showcase__descriptor">{{ block.settings.descriptor }}</p>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 3 -%}
      <button class="ossian-product-showcase__arrow ossian-product-showcase__arrow--next" aria-label="Next" data-showcase-id="{{ section.id }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  function initShowcase(id) {
    var track = document.getElementById('ossian-showcase-track-' + id);
    if (!track) return;
    var cards = track.querySelectorAll('.ossian-product-showcase__card');
    if (cards.length <= 3) return;
    var perPage = window.innerWidth < 768 ? 1 : 3;
    var current = 0;
    var total = cards.length;

    function update() {
      var offset = current * (100 / perPage);
      track.style.transform = 'translateX(-' + offset + '%)';
    }

    var wrapper = document.getElementById('ossian-showcase-' + id);
    var prevBtn = wrapper.querySelector('.ossian-product-showcase__arrow--prev');
    var nextBtn = wrapper.querySelector('.ossian-product-showcase__arrow--next');

    if (prevBtn) prevBtn.addEventListener('click', function() {
      current = Math.max(0, current - 1);
      update();
    });
    if (nextBtn) nextBtn.addEventListener('click', function() {
      current = Math.min(total - perPage, current + 1);
      update();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    initShowcase('{{ section.id }}');
  });
})();
</script>

{% stylesheet %}
.ossian-product-showcase {
  padding: 60px 0;
}

.ossian-product-showcase__header {
  text-align: center;
  margin-bottom: 40px;
}

.ossian-product-showcase__heading {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 700;
  color: #1e3a5f;
  margin: 0 0 8px;
  line-height: 1.2;
}

.ossian-product-showcase__label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.6;
  margin: 0;
}

.ossian-product-showcase__track-wrapper {
  position: relative;
  overflow: hidden;
}

.ossian-product-showcase__track {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  transition: transform 0.4s ease;
}

.ossian-product-showcase__card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.ossian-product-showcase__image-wrap {
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #f5f5f5;
}

.ossian-product-showcase__img,
.ossian-product-showcase__placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.ossian-product-showcase__card:hover .ossian-product-showcase__img {
  transform: scale(1.04);
}

.ossian-product-showcase__info {
  padding: 16px 4px 0;
}

.ossian-product-showcase__tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.6;
  margin: 0 0 6px;
}

.ossian-product-showcase__name {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0 0 4px;
  line-height: 1.3;
}

.ossian-product-showcase__descriptor {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #666;
  margin: 0;
}

.ossian-product-showcase__arrow {
  position: absolute;
  top: 40%;
  transform: translateY(-50%);
  z-index: 10;
  background: #1e3a5f;
  border: none;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #fff;
  box-shadow: 0 4px 12px rgba(30,58,95,0.3);
  transition: background 0.2s;
}

.ossian-product-showcase__arrow:hover { background: #2d5a8f; }
.ossian-product-showcase__arrow--prev { left: -24px; }
.ossian-product-showcase__arrow--next { right: -24px; }

@media (max-width: 768px) {
  .ossian-product-showcase__track { grid-template-columns: 1fr; }
  .ossian-product-showcase__arrow { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "ossian-product-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Only what your Hair Needs"
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label",
      "default": "EXPLORE BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "custom_name",
          "label": "Custom name (if no product)"
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Category tag",
          "default": "Hair Care"
        },
        {
          "type": "text",
          "id": "descriptor",
          "label": "Descriptor tagline",
          "default": "SILK-SMOOTH, FRIZZ-FREE FINISH"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossian Product Showcase (Hair)",
      "settings": {
        "heading": "Only what your Hair Needs",
        "category_label": "EXPLORE BY CATEGORY"
      },
      "blocks": [
        { "type": "product_card", "settings": { "custom_name": "Straighten", "tag_label": "Hair Treatment", "descriptor": "SILK-SMOOTH, FRIZZ-FREE FINISH" } },
        { "type": "product_card", "settings": { "custom_name": "Developer", "tag_label": "Hair Color", "descriptor": "PRECISION COLOR, ZERO DAMAGE" } },
        { "type": "product_card", "settings": { "custom_name": "Hair Mask", "tag_label": "Hair Care", "descriptor": "UP TO 10X REPAIR" } }
      ]
    }
  ]
}
{% endschema %}
