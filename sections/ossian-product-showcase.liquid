{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product_card'
  assign feature_blocks = section.blocks | where: 'type', 'feature_item'
  assign card_count = product_blocks.size
  assign accent = section.settings.accent_color | default: '#2f8cf8'
  assign deep = section.settings.deep_color | default: '#22345a'
  assign tint = section.settings.tint_color | default: '#e4edf8'
-%}

<section
  class="pshowcase{% if section.settings.media_first %} pshowcase--media-first{% endif %}{% if section.settings.image_fit == 'contain' %} pshowcase--fit-contain{% endif %}"
  id="pshowcase-{{ section.id }}"
  style="
    --ps-accent: {{ accent }};
    --ps-deep: {{ deep }};
    --ps-tint: {{ tint }};
    --ps-pad-top: {{ section.settings.padding_top }}px;
    --ps-pad-bottom: {{ section.settings.padding_bottom }}px;
  ">

  {%- if section.settings.bg_image != blank -%}
    <div class="pshowcase__bg" aria-hidden="true">
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag: class: 'pshowcase__bg-img', alt: '', loading: 'lazy', widths: '600,900,1200,1600,2000'
      }}
    </div>
  {%- endif -%}

  <div class="pshowcase__inner">

    {%- if section.settings.top_heading != blank or section.settings.top_heading_accent != blank -%}
      <h2 class="pshowcase__top-heading">
        {{- section.settings.top_heading -}}
        {%- if section.settings.top_heading_accent != blank -%}
          <em class="pshowcase__top-heading-accent">{{ section.settings.top_heading_accent }}</em>
        {%- endif -%}
      </h2>
    {%- endif -%}

    <div class="pshowcase__main">

      <div class="pshowcase__panel">
        {%- if section.settings.category_label != blank -%}
          <p class="pshowcase__eyebrow">
            <span class="pshowcase__eyebrow-dot" aria-hidden="true"></span>
            {{ section.settings.category_label }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h3 class="pshowcase__heading">{{ section.settings.heading }}</h3>
        {%- endif -%}

        {%- if section.settings.body_text != blank -%}
          <p class="pshowcase__body">{{ section.settings.body_text }}</p>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="pshowcase__cta">
            <span>{{ section.settings.cta_text }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}

        {%- assign has_trust = false -%}
        {%- for i in (1..3) -%}
          {%- assign label_key = 'trust_label_' | append: i -%}
          {%- if section.settings[label_key] != blank -%}
            {%- assign has_trust = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_trust -%}
          <ul class="pshowcase__trust" role="list">
            {%- for i in (1..3) -%}
              {%- liquid
                assign icon_key = 'trust_icon_' | append: i
                assign label_key = 'trust_label_' | append: i
                assign label_val = section.settings[label_key]
                assign icon_val = section.settings[icon_key]
              -%}
              {%- if label_val != blank -%}
                <li class="pshowcase__trust-item">
                  {% render 'ossian-showcase-icon', icon: icon_val, size: 18 %}
                  <span>{{ label_val }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if card_count > 0 -%}
        <div class="pshowcase__cards" data-count="{{ card_count }}">
          {%- for block in product_blocks -%}
            {%- liquid
              assign card_url = block.settings.collection.url | default: block.settings.link | default: '#'
              assign card_name = block.settings.product.title | default: block.settings.custom_name | default: 'View product'
              assign name_down = block.settings.custom_name | downcase
              assign default_image = blank
              if name_down contains 'wax'
                assign default_image = 'ossion-wax.png'
              elsif name_down contains 'peel'
                assign default_image = 'ossion-peel-off.png'
              elsif name_down contains 'facial kit'
                assign default_image = 'ossion-facial-kit.png'
              endif

              assign is_featured = false
              if forloop.first and card_count == 3
                assign is_featured = true
              endif
            -%}
            <article
              class="pshowcase__card{% if is_featured %} pshowcase__card--featured{% endif %}"
              {{ block.shopify_attributes }}>
              <a class="pshowcase__card-link" href="{{ card_url }}" aria-label="{{ card_name | escape }}">
                <div class="pshowcase__media">
                  {%- if block.settings.badge_label != blank -%}
                    <span class="pshowcase__badge">{{ block.settings.badge_label }}</span>
                  {%- endif -%}
                  {%- if block.settings.step_label != blank -%}
                    <span class="pshowcase__step">{{ block.settings.step_label }}</span>
                  {%- endif -%}

                  {%- if block.settings.product != blank -%}
                    {{
                      block.settings.product.featured_image
                      | image_url: width: 900
                      | image_tag: class: 'pshowcase__img', alt: block.settings.product.title, loading: 'lazy', widths: '300,500,700,900'
                    }}
                  {%- elsif block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag: class: 'pshowcase__img', alt: card_name, loading: 'lazy', widths: '300,500,700,900'
                    }}
                  {%- elsif default_image != blank -%}
                    <img
                      src="{{ default_image | asset_url }}"
                      alt="{{ card_name | escape }}"
                      class="pshowcase__img"
                      width="900"
                      height="900"
                      loading="lazy">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'pshowcase__img pshowcase__img--placeholder' }}
                  {%- endif -%}
                </div>

                <div class="pshowcase__card-footer">
                  <div class="pshowcase__card-info">
                    <h4 class="pshowcase__name">{{ card_name }}</h4>
                    {%- if block.settings.descriptor != blank -%}
                      <p class="pshowcase__descriptor">{{ block.settings.descriptor }}</p>
                    {%- endif -%}
                  </div>
                  <span class="pshowcase__arrow" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    {%- if feature_blocks.size > 0 -%}
      <ul class="pshowcase__features" role="list" data-count="{{ feature_blocks.size }}">
        {%- for block in feature_blocks -%}
          <li class="pshowcase__feature" {{ block.shopify_attributes }}>
            <span class="pshowcase__feature-icon">
              {% render 'ossian-showcase-icon', icon: block.settings.icon, size: 24 %}
            </span>
            <span class="pshowcase__feature-text">
              {%- if block.settings.title != blank -%}
                <strong>{{ block.settings.title }}</strong>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <span>{{ block.settings.subtitle }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}

/* ══ Ossian Product Showcase ══ */

.pshowcase {
  --ps-gutter: 16px;
  --ps-radius: 20px;
  --ps-ink: var(--ps-deep, #22345a);
  --ps-muted: rgba(34, 52, 90, 0.66);
  --ps-hairline: rgba(34, 52, 90, 0.1);
  --ps-shadow: 0 18px 40px -22px rgba(19, 35, 68, 0.55);
  --ps-shadow-lift: 0 28px 54px -24px rgba(19, 35, 68, 0.6);

  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-block: var(--ps-pad-top, 72px) var(--ps-pad-bottom, 72px);
  background: var(--ps-tint, #e4edf8);
  font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
  color: var(--ps-ink);
}

.pshowcase * {
  box-sizing: border-box;
}

/* Soft light wash so the flat tint reads as depth, not a colour block */
.pshowcase::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(70% 55% at 8% -5%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 65%),
    radial-gradient(55% 45% at 100% 105%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

/* Optional background photo, dimmed behind the content */
.pshowcase__bg {
  position: absolute;
  inset: 0;
  z-index: -2;
}

.pshowcase__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pshowcase__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.72));
}

.pshowcase__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: var(--ps-gutter);
}

/* ── Section heading ── */
.pshowcase__top-heading {
  margin: 0 0 clamp(26px, 3.4vw, 44px);
  text-align: center;
  font-size: clamp(1.75rem, 3.1vw, 2.75rem);
  font-weight: 500;
  line-height: 1.22;
  letter-spacing: -0.015em;
  color: var(--ps-ink);
  text-wrap: balance;
}

.pshowcase__top-heading-accent {
  font-style: italic;
  color: var(--ps-accent, #2f8cf8);
  margin-inline-start: 0.22em;
}

/* ── Main split ── */
.pshowcase__main {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.42fr);
  gap: clamp(18px, 2.4vw, 32px);
  align-items: stretch;
}

/* Mirrored layout: cards lead, and keep the wider track under them */
.pshowcase--media-first .pshowcase__main {
  grid-template-columns: minmax(0, 1.42fr) minmax(0, 0.92fr);
}

.pshowcase--media-first .pshowcase__panel {
  order: 2;
}

/* ── Copy panel ── */
.pshowcase__panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(26px, 2.6vw, 40px);
  border-radius: var(--ps-radius);
  background: rgba(255, 255, 255, 0.62);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: var(--ps-shadow);
  backdrop-filter: blur(6px);
}

.pshowcase__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  margin: 0 0 16px;
  padding: 7px 14px 7px 12px;
  border-radius: 100px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--ps-hairline);
  font-size: 0.8125rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ps-accent, #2f8cf8);
  line-height: 1;
}

.pshowcase__eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

.pshowcase__heading {
  margin: 0 0 14px;
  font-size: clamp(1.75rem, 2.5vw, 2.5rem);
  font-weight: 500;
  line-height: 1.16;
  letter-spacing: -0.02em;
  color: var(--ps-ink);
  text-wrap: balance;
}

.pshowcase__body {
  margin: 0 0 clamp(22px, 2.4vw, 30px);
  font-size: clamp(1rem, 1.15vw, 1.1875rem);
  font-weight: 400;
  line-height: 1.55;
  color: var(--ps-muted);
  max-width: 34ch;
}

.pshowcase__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  align-self: flex-start;
  padding: 14px 24px;
  border-radius: 100px;
  border: 0;
  background: var(--ps-ink);
  color: #fff;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
}

.pshowcase__cta svg {
  flex-shrink: 0;
  transition: transform 0.25s ease;
}

.pshowcase__cta:hover {
  background: var(--ps-accent, #2f8cf8);
  transform: translateY(-2px);
  box-shadow: var(--ps-shadow);
  color: #fff;
}

.pshowcase__cta:hover svg {
  transform: translateX(3px);
}

.pshowcase__cta:focus-visible,
.pshowcase__card-link:focus-visible {
  outline: 2px solid var(--ps-accent, #2f8cf8);
  outline-offset: 3px;
}

/* ── Trust chips, pinned to the bottom of the panel ── */
.pshowcase__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
  margin: 0;
  padding: clamp(22px, 2.4vw, 32px) 0 0;
}

.pshowcase__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 13px;
  border-radius: 100px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--ps-hairline);
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1.2;
  color: var(--ps-ink);
}

.pshowcase__trust-item svg {
  color: var(--ps-accent, #2f8cf8);
  flex-shrink: 0;
}

/* ── Card grid ── */
.pshowcase__cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: clamp(12px, 1.4vw, 18px);
  min-width: 0;
}

.pshowcase__cards[data-count='1'] {
  grid-template-columns: minmax(0, 1fr);
}

.pshowcase__cards[data-count='3'] .pshowcase__card--featured {
  grid-row: span 2;
}

.pshowcase__card {
  position: relative;
  min-width: 0;
  border-radius: var(--ps-radius);
  background: #fff;
  box-shadow: var(--ps-shadow);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.pshowcase__card:hover {
  transform: translateY(-4px);
  box-shadow: var(--ps-shadow-lift);
}

.pshowcase__card-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  border-radius: inherit;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
}

/* ── Card media ── */
.pshowcase__media {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: linear-gradient(170deg, #f3f6fb 0%, #e7eef7 100%);
}

.pshowcase__cards[data-count='3'] .pshowcase__card:not(.pshowcase__card--featured) .pshowcase__media {
  aspect-ratio: auto;
  flex: 1;
  min-height: 150px;
}

.pshowcase__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
}

.pshowcase--fit-contain .pshowcase__img {
  object-fit: contain;
  padding: 10%;
}

.pshowcase__card:hover .pshowcase__img {
  transform: scale(1.05);
}

.pshowcase__badge,
.pshowcase__step {
  position: absolute;
  top: 12px;
  z-index: 2;
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1;
  padding: 6px 11px;
  border-radius: 100px;
}

.pshowcase__badge {
  left: 12px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid var(--ps-hairline);
  color: var(--ps-ink);
  backdrop-filter: blur(4px);
}

.pshowcase__step {
  right: 12px;
  background: var(--ps-ink);
  color: #fff;
}

/* ── Card footer ── */
.pshowcase__card-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  flex-shrink: 0;
}

.pshowcase__card-info {
  flex: 1;
  min-width: 0;
}

.pshowcase__name {
  margin: 0;
  font-size: clamp(1rem, 1.1vw, 1.1875rem);
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--ps-ink);
}

.pshowcase__descriptor {
  margin: 3px 0 0;
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.35;
  color: var(--ps-muted);
}

.pshowcase__arrow {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1.5px solid var(--ps-hairline);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ps-ink);
  transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

.pshowcase__card:hover .pshowcase__arrow {
  background: var(--ps-accent, #2f8cf8);
  border-color: var(--ps-accent, #2f8cf8);
  color: #fff;
  transform: translateX(2px);
}

/* ── Feature bar ── */
.pshowcase__features {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  list-style: none;
  margin: clamp(18px, 2.4vw, 32px) 0 0;
  padding: 0;
  border-radius: var(--ps-radius);
  background: #fff;
  box-shadow: var(--ps-shadow);
  overflow: hidden;
}

.pshowcase__features[data-count='3'] {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.pshowcase__features[data-count='2'] {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.pshowcase__features[data-count='1'] {
  grid-template-columns: minmax(0, 1fr);
}

.pshowcase__feature {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px 22px;
  box-shadow: inset 1px 0 0 var(--ps-hairline);
}

.pshowcase__feature:first-child {
  box-shadow: none;
}

.pshowcase__feature-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  border-radius: 12px;
  background: rgba(47, 140, 248, 0.1);
  background: color-mix(in srgb, var(--ps-accent, #2f8cf8) 12%, transparent);
  color: var(--ps-accent, #2f8cf8);
}

.pshowcase__feature-text {
  min-width: 0;
}

.pshowcase__feature-text strong {
  display: block;
  font-size: 0.9375rem;
  font-weight: 600;
  line-height: 1.25;
  color: var(--ps-ink);
}

.pshowcase__feature-text span {
  display: block;
  margin-top: 2px;
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.3;
  color: var(--ps-muted);
}

/* ── Desktop gutters ── */
@media screen and (min-width: 750px) {
  .pshowcase {
    --ps-gutter: 40px;
  }
}

/* ── Stack the split ── */
@media screen and (max-width: 989px) {
  .pshowcase__main {
    grid-template-columns: minmax(0, 1fr);
  }

  .pshowcase--media-first .pshowcase__main {
    grid-template-columns: minmax(0, 1fr);
  }

  .pshowcase--media-first .pshowcase__panel {
    order: 0;
  }

  .pshowcase__body {
    max-width: 52ch;
  }

  .pshowcase__features {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pshowcase__feature:nth-child(odd) {
    box-shadow: none;
  }

  .pshowcase__feature:nth-child(n + 3) {
    box-shadow: inset 0 1px 0 var(--ps-hairline);
  }

  .pshowcase__feature:nth-child(even):nth-child(n + 3) {
    box-shadow: inset 1px 0 0 var(--ps-hairline), inset 0 1px 0 var(--ps-hairline);
  }
}

/* ── Mobile: cards become a swipeable rail ── */
@media screen and (max-width: 749px) {
  .pshowcase__panel {
    padding: 24px 20px 22px;
  }

  .pshowcase__cards,
  .pshowcase__cards[data-count='1'] {
    display: flex;
    grid-auto-rows: auto;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--ps-gutter);
    scrollbar-width: none;
    margin-inline: calc(var(--ps-gutter) * -1);
    padding-inline: var(--ps-gutter);
    padding-block-end: 4px;
  }

  .pshowcase__cards::-webkit-scrollbar {
    display: none;
  }

  .pshowcase__card {
    flex: 0 0 74%;
    max-width: 290px;
    scroll-snap-align: start;
  }

  .pshowcase__cards[data-count='1'] .pshowcase__card {
    flex-basis: 100%;
    max-width: none;
  }

  .pshowcase__cards[data-count='3'] .pshowcase__card:not(.pshowcase__card--featured) .pshowcase__media {
    aspect-ratio: 4 / 5;
    flex: none;
  }

  .pshowcase__features {
    grid-template-columns: minmax(0, 1fr);
  }

  .pshowcase__feature {
    padding: 16px 18px;
    box-shadow: inset 0 1px 0 var(--ps-hairline);
  }

  .pshowcase__feature:first-child {
    box-shadow: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .pshowcase *,
  .pshowcase *::before,
  .pshowcase *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }

  .pshowcase__card:hover,
  .pshowcase__cta:hover {
    transform: none;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "ossian-product-showcase-section",
  "settings": [
    {
      "type": "header",
      "content": "Top Heading"
    },
    {
      "type": "text",
      "id": "top_heading",
      "label": "Heading",
      "default": "Only what your"
    },
    {
      "type": "text",
      "id": "top_heading_accent",
      "label": "Heading accent (italic, accent colour)",
      "default": "Hair Needs"
    },
    {
      "type": "header",
      "content": "Copy Panel"
    },
    {
