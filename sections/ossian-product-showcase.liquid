<section class="pshowcase" id="pshowcase-{{ section.id }}">

  <div class="pshowcase__header page-width">
    {%- if section.settings.category_label != blank -%}
      <p class="pshowcase__eyebrow">{{ section.settings.category_label }}</p>
    {%- endif -%}
    <h2 class="pshowcase__heading">
      {{- section.settings.heading_prefix -}}
      {%- if section.settings.heading_italic != blank -%}
        <em>{{- section.settings.heading_italic -}}</em>
      {%- endif -%}
    </h2>
  </div>

  <div class="pshowcase__grid page-width">
    {%- for block in section.blocks -%}
      <div
        class="pshowcase__card{% if forloop.index0 == 1 %} pshowcase__card--center{% endif %}"
        {{ block.shopify_attributes }}
      >
        <a href="{{ block.settings.link | default: '#' }}" class="pshowcase__img-link">
          <div class="pshowcase__img-wrap">
            {%- if block.settings.product != blank -%}
              {{
                block.settings.product.featured_image
                | image_url: width: 700
                | image_tag:
                  class: 'pshowcase__img',
                  alt: block.settings.product.title,
                  loading: 'lazy',
                  widths: '300,500,700'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  class: 'pshowcase__img',
                  loading: 'lazy',
                  widths: '300,500,700'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pshowcase__img pshowcase__img--placeholder' }}
            {%- endif -%}
          </div>
        </a>

        <div class="pshowcase__info">
          <div class="pshowcase__info-text">
            <h3 class="pshowcase__name">
              {%- if block.settings.product != blank -%}
                {{ block.settings.product.title }}
              {%- else -%}
                {{ block.settings.custom_name }}
              {%- endif -%}
            </h3>
            {%- if block.settings.descriptor != blank -%}
              <p class="pshowcase__descriptor">{{ block.settings.descriptor }}</p>
            {%- endif -%}
          </div>
          <a href="{{ block.settings.link | default: '#' }}" class="pshowcase__arrow" aria-label="Explore {{ block.settings.custom_name }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    {%- endfor -%}
  </div>

</section>

{% stylesheet %}
.pshowcase {
  padding: 40px 80px 0px 80px;
  background: #fff;
}

/* Header */
.pshowcase__header {
  text-align: center;
  margin-bottom: 20px;
}

.pshowcase__eyebrow {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-style: italic;
  color: #1e3a5f;
  opacity: 0.65;
  margin: 0 0 14px;
}

.pshowcase__heading {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  color: #1e3a5f;
  margin: 0;
  line-height: 1.2;
}

.pshowcase__heading em {
  font-style: italic;
  font-weight: 400;
  color: #5a87c0;
}

/* Grid — 3 columns, center card shifted down */
.pshowcase__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  align-items: start;
}

.pshowcase__card--center {
  margin-top: 60px;
}

/* Image */
.pshowcase__img-link {
  display: block;
  text-decoration: none;
}

.pshowcase__img-wrap {
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 1;
  background: #eef0f3;
}

.pshowcase__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.pshowcase__img--placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pshowcase__card:hover .pshowcase__img {
  transform: scale(1.04);
}

/* Info row */
.pshowcase__info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 2px 0;
}

.pshowcase__info-text {
  min-width: 0;
}

.pshowcase__name {
  font-size: clamp(1.25rem, 2vw, 1.55rem);
  font-weight: 800;
  color: #1e3a5f;
  margin: 0 0 5px;
  line-height: 1.2;
}

.pshowcase__descriptor {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.65;
  margin: 0;
}

/* Circle arrow button */
.pshowcase__arrow {
  width: 50px;
  height: 50px;
  min-width: 50px;
  border-radius: 50%;
  border: 1.5px solid #1e3a5f;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1e3a5f;
  text-decoration: none;
  flex-shrink: 0;
  transition: background 0.2s, color 0.2s;
}

.pshowcase__arrow:hover {
  background: #1e3a5f;
  color: #fff;
}

/* Mobile */
@media (max-width: 768px) {
  .pshowcase {
    padding: 48px 0 56px;
  }

  .pshowcase__grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .pshowcase__card--center {
    margin-top: 0;
  }

  .pshowcase__img-wrap {
    aspect-ratio: 4 / 3;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "ossian-product-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "category_label",
      "label": "Eyebrow label",
      "default": "EXPLORE BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading (normal part)",
      "default": "Only what your"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic accent part)",
      "default": "Hair Needs"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (if no product)"
        },
        {
          "type": "text",
          "id": "custom_name",
          "label": "Name (if no product)",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "descriptor",
          "label": "Descriptor tagline",
          "default": "SILK-SMOOTH, FRIZZ-FREE FINISH"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossian Product Showcase",
      "settings": {
        "category_label": "EXPLORE BY CATEGORY",
        "heading_prefix": "Only what your",
        "heading_italic": "Hair Needs"
      },
      "blocks": [
        { "type": "product_card", "settings": { "custom_name": "Straighten", "descriptor": "SILK-SMOOTH, FRIZZ-FREE FINISH" } },
        { "type": "product_card", "settings": { "custom_name": "Developer", "descriptor": "PRECISION COLOR, ZERO DAMAGE" } },
        { "type": "product_card", "settings": { "custom_name": "Hair Mask", "descriptor": "UP TO 10X REPAIR" } }
      ]
    }
  ]
}
{% endschema %}
