{% comment %}
  Section contract.
  Full-width dark banner with separate desktop and mobile background images,
  left-aligned copy and an optional feature list on the right. Used for the
  about hero, the science band and the closing promise band.
  @example
  <!-- templates/page.about.json → about_hero / about_science / about_promise -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

{%- liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign has_image = false
  if section.settings.image != blank or section.settings.image_mobile != blank
    assign has_image = true
  endif
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
  assign heading_tag = 'h2'
  if section.settings.heading_as_h1
    assign heading_tag = 'h1'
  endif
-%}

<section
  class="oab oab--dark oabn{% if has_image %} oabn--has-image{% endif %}{% if feature_blocks.size > 0 %} oabn--has-features{% endif %}"
  id="oabn-{{ section.id }}"
  style="
    --oabn-min-h: {{ section.settings.min_height }}px;
    --oabn-min-h-mobile: {{ section.settings.min_height_mobile }}px;
    --oabn-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>
  <div class="oabn__media" aria-hidden="true">
    {%- if has_image -%}
      {%- render 'ossian-about-picture',
        desktop: section.settings.image,
        mobile: section.settings.image_mobile,
        sizes: '100vw',
        eager: is_first
      -%}
    {%- endif -%}
    <span class="oabn__scrim"></span>
  </div>

  <div class="oab-wrap oabn__inner">
    <div class="oabn__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="oab-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- render 'ossian-about-heading', text: section.settings.heading, tag: heading_tag, class: 'oab-heading--xl' -%}
      {%- if section.settings.text != blank -%}
        <div class="oab-text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="oab-btn oab-btn--{{ section.settings.button_style }}" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>

    {%- if feature_blocks.size > 0 -%}
      <ul class="oabn__features" role="list">
        {%- for block in feature_blocks -%}
          <li class="oabn__feature" {{ block.shopify_attributes }}>
            <span class="oabn__feature-icon">{%- render 'ossian-about-icon', icon: block.settings.icon -%}</span>
            <span class="oabn__feature-title">{{ block.settings.title | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.oabn {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: var(--oabn-min-h, 460px);
  background: radial-gradient(110% 140% at 85% 40%, #1f4c8f 0%, #0b1f3d 55%, #061328 100%);
  color: #fff;
}

.oabn__media {
  position: absolute;
  inset: 0;
  z-index: -1;
}

/* Left-to-right scrim keeps copy legible over any merchant image */
.oabn__scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgb(8 24 50 / calc(var(--oabn-overlay) + 0.15)) 0%,
    rgb(8 24 50 / var(--oabn-overlay)) 35%,
    rgb(8 24 50 / 0) 65%
  );
}

.oabn:not(.oabn--has-image) .oabn__scrim { display: none; }

.oabn__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  padding-block: 64px;
}

.oabn__copy {
  max-width: 560px;
  min-width: 0;
}

.oabn__copy .oab-text:last-child { margin-bottom: 0; }

.oabn__features {
  display: flex;
  flex-direction: column;
  gap: 26px;
  margin: 0;
  padding: 0;
  list-style: none;
  min-width: 0;
  max-width: 280px;
}

.oabn__feature {
  display: flex;
  align-items: center;
  gap: 14px;
}

.oabn__feature-icon {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.6);
  color: #fff;
}

.oabn__feature-icon svg { width: 20px; height: 20px; }

.oabn__feature-title {
  font-size: 0.92rem;
  font-weight: 600;
  line-height: 1.35;
  color: #fff;
}

@media (max-width: 989px) {
  .oabn__inner { flex-direction: column; align-items: flex-start; }
  .oabn__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 20px;
    max-width: none;
    width: 100%;
  }
}

/* Mobile: copy sits at the top, the mobile image shows through underneath */
@media (max-width: 749px) {
  .oabn {
    align-items: flex-start;
    min-height: var(--oabn-min-h-mobile, 560px);
  }

  .oabn__scrim {
    background: linear-gradient(
      180deg,
      rgb(8 24 50 / calc(var(--oabn-overlay) + 0.2)) 0%,
      rgb(8 24 50 / var(--oabn-overlay)) 40%,
      rgb(8 24 50 / 0) 70%
    );
  }

  /* Features push the copy further down, so keep the shade under them */
  .oabn--has-features .oabn__scrim {
    background: linear-gradient(
      180deg,
      rgb(8 24 50 / calc(var(--oabn-overlay) + 0.2)) 0%,
      rgb(8 24 50 / var(--oabn-overlay)) 65%,
      rgb(8 24 50 / 0) 88%
    );
  }

  .oabn__inner { padding-block: 36px 32px; gap: 24px; }
  .oabn__feature { gap: 10px; }
  .oabn__feature-icon { width: 38px; height: 38px; }
  .oabn__feature-icon svg { width: 18px; height: 18px; }
  .oabn__feature-title { font-size: 0.8rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian About Banner",
  "tag": "div",
  "class": "section-ossian-about-banner",
  "settings": [
    { "type": "header", "content": "Banner images" },
    { "type": "image_picker", "id": "image", "label": "Desktop banner", "info": "Wide image (about 2400 × 900). Keep the left side calm — the text sits there." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile banner", "info": "Portrait image (about 750 × 1100). Keep the top calm — the text sits there." },
    { "type": "range", "id": "overlay", "label": "Text shade strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "min_height", "label": "Desktop height", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 460 },
    { "type": "range", "id": "min_height_mobile", "label": "Mobile height", "min": 360, "max": 1000, "step": 20, "unit": "px", "default": 560 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Ossion" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent. Use | for a line break.", "default": "Professional|[Care for] Real|People" },
    { "type": "checkbox", "id": "heading_as_h1", "label": "Use as page title (H1)", "info": "Turn on for the first banner on the page only.", "default": false },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Salon-inspired hair and skin care, crafted with science, innovation and a passion for self-care.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our Story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "White" },
        { "value": "outline", "label": "Outline" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "molecule",
          "options": [
            { "value": "molecule", "label": "Molecule" },
            { "value": "shield", "label": "Shield" },
            { "value": "badge", "label": "Badge" },
            { "value": "people", "label": "People" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "High Performance Formulations" }
      ]
    }
  ],
  "presets": [
    { "name": "Ossian About Banner" }
  ]
}
{% endschema %}
