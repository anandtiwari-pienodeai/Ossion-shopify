{% comment %}
  Section contract.
  Blog listing page: banner hero (separate desktop/mobile images), a sidebar
  with article search, tag categories with counts and a newsletter card, and
  a paginated grid of ossian-blog-card articles. On mobile the categories
  become a scrolling chip row and the newsletter card moves under the grid.
  @example
  <!-- templates/blog.json → /blogs/news, /blogs/news/tagged/hair-care -->
{% endcomment %}

{%- liquid
  assign hero_desktop = section.settings.hero_image | default: section.settings.hero_image_mobile
  assign hero_mobile = section.settings.hero_image_mobile | default: section.settings.hero_image

  # Category list: merchant order when provided, otherwise every tag on the blog
  assign category_source = section.settings.categories | newline_to_br | strip_newlines | split: '<br />'
  assign has_custom_categories = false
  for line in category_source
    assign line_clean = line | strip
    if line_clean != blank
      assign has_custom_categories = true
      break
    endif
  endfor
  unless has_custom_categories
    assign category_source = blog.all_tags
  endunless

  # Counts are only accurate on the unfiltered listing (tag pages filter blog.articles)
  assign show_counts = false
  if section.settings.show_counts and current_tags == blank
    assign show_counts = true
  endif
-%}

<section class="obp" id="obp-{{ section.id }}">
  {%- comment -%}── Hero ─────────────────────────────────────────{%- endcomment -%}
  <div class="obp__hero" style="--obp-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
    {%- if hero_desktop != blank -%}
      <div class="obp__hero-media" aria-hidden="true">
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ hero_mobile | image_url: width: 750 }} 750w,
              {{ hero_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
            width="{{ hero_mobile.width }}"
            height="{{ hero_mobile.height }}"
          >
          {{
            hero_desktop
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '1000,1400,1900,2400',
              sizes: '100vw',
              alt: ''
          }}
        </picture>
      </div>
    {%- endif -%}

    <div class="obp__wrap obp__hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="obp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- assign hero_heading = section.settings.heading | default: blog.title -%}
      {%- assign hero_heading_html = hero_heading | escape | replace: '[', '<span class="obp__accent">' | replace: ']', '</span>' | replace: '|', '<br>' -%}
      <h1 class="obp__heading">{{ hero_heading_html }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="obp__lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}── Body ─────────────────────────────────────────{%- endcomment -%}
  <div class="obp__wrap obp__layout">
    <aside class="obp__side">
      <form class="obp__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="article">
        <input type="hidden" name="options[prefix]" value="last">
        <label class="visually-hidden" for="obp-search-{{ section.id }}">{{ 'content.ossian_blog.search_label' | t }}</label>
        <svg class="obp__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input
          class="obp__search-input"
          type="search"
          id="obp-search-{{ section.id }}"
          name="q"
          placeholder="{{ 'content.ossian_blog.search_placeholder' | t }}"
          autocomplete="off"
        >
      </form>

      <nav class="obp__cats" aria-label="{{ 'content.ossian_blog.categories' | t }}">
        <ul class="obp__cat-list" role="list">
          <li>
            <a class="obp__cat{% if current_tags == blank %} is-active{% endif %}" href="{{ blog.url }}" {% if current_tags == blank %}aria-current="page"{% endif %}>
              <span class="obp__cat-name">{{ 'content.ossian_blog.all_articles' | t }}</span>
              {%- if show_counts -%}<span class="obp__cat-count">{{ blog.articles_count }}</span>{%- endif -%}
            </a>
          </li>
          {%- for raw_tag in category_source -%}
            {%- liquid
              assign tag = raw_tag | strip
              if tag == blank
                continue
              endif
              assign tag_handle = tag | handleize
              assign tag_active = false
              for current in current_tags
                assign current_handle = current | handleize
                if current_handle == tag_handle
                  assign tag_active = true
                endif
              endfor
              if show_counts
                assign tag_count = 0
                for counted in blog.articles limit: 50
                  for counted_tag in counted.tags
                    assign counted_handle = counted_tag | handleize
                    if counted_handle == tag_handle
                      assign tag_count = tag_count | plus: 1
                      break
                    endif
                  endfor
                endfor
              endif
            -%}
            <li>
              <a class="obp__cat{% if tag_active %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag_handle }}" {% if tag_active %}aria-current="page"{% endif %}>
                <span class="obp__cat-name">{{ tag | escape }}</span>
                {%- if show_counts -%}<span class="obp__cat-count">{{ tag_count }}</span>{%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </aside>

    <div class="obp__main">
      {%- paginate blog.articles by section.settings.per_page -%}
        {%- if blog.articles.size > 0 -%}
          <ul class="obp__grid" role="list">
            {%- for article in blog.articles -%}
              {%- liquid
                assign card_tag = article.tags.first
                for raw_tag in current_tags
                  assign card_tag = raw_tag
                endfor
                assign card_excerpt = article.excerpt_or_content | strip_html | truncatewords: 24
                assign word_count = article.content | strip_html | split: ' ' | size
                assign read_time = word_count | divided_by: 200.0 | ceil | at_least: 1
                assign eager_card = false
                if forloop.index <= 3
                  assign eager_card = true
                endif
              -%}
              <li class="obp__item">
                {%- render 'ossian-blog-card',
                  image: article.image,
                  tag: card_tag,
                  date: article.published_at,
                  title: article.title,
                  excerpt: card_excerpt,
                  url: article.url,
                  read_time: read_time,
                  eager: eager_card
                -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="obp__pagination" aria-label="{{ 'content.ossian_blog.pagination' | t }}">
              <ul role="list">
                <li>
                  {%- if paginate.previous -%}
                    <a class="obp__page obp__page--arrow" href="{{ paginate.previous.url }}" aria-label="{{ 'accessibility.slideshow_previous' | t }}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                    </a>
                  {%- else -%}
                    <span class="obp__page obp__page--arrow is-disabled" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                    </span>
                  {%- endif -%}
                </li>
                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a class="obp__page" href="{{ part.url }}">{{ part.title }}</a>
                    {%- elsif part.title contains 'hellip' or part.title contains '…' -%}
                      <span class="obp__page obp__page--gap">{{ part.title }}</span>
                    {%- else -%}
                      <span class="obp__page is-current" aria-current="page">{{ part.title }}</span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                <li>
                  {%- if paginate.next -%}
                    <a class="obp__page obp__page--arrow" href="{{ paginate.next.url }}" aria-label="{{ 'accessibility.slideshow_next' | t }}">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                    </a>
                  {%- else -%}
                    <span class="obp__page obp__page--arrow is-disabled" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                    </span>
                  {%- endif -%}
                </li>
              </ul>
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="obp__empty">{{ 'content.ossian_blog.empty' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="obp__news">
        {%- if section.settings.news_eyebrow != blank -%}
          <p class="obp__news-eyebrow">{{ section.settings.news_eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.news_heading != blank -%}
          <h2 class="obp__news-title">{{ section.settings.news_heading | escape }}</h2>
        {%- endif -%}
        {%- form 'customer', id: 'obp-news-form', class: 'obp__news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="obp__news-msg" role="status" tabindex="-1" autofocus>{{ 'content.ossian_blog.subscribed' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="obp__news-msg obp__news-msg--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <label class="visually-hidden" for="obp-news-email-{{ section.id }}">{{ 'content.ossian_blog.email_label' | t }}</label>
            <input
              class="obp__news-input"
              type="email"
              id="obp-news-email-{{ section.id }}"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ 'content.ossian_blog.email_placeholder' | t }}"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
            <button type="submit" class="obp__news-btn">
              {{ 'content.ossian_blog.subscribe' | t }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
            </button>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.obp {
  --obp-ink: #13233f;
  --obp-navy: #0f2a55;
  --obp-accent: #2f6fd6;
  --obp-accent-light: #7fb0ff;
  --obp-muted: #5b6577;
  --obp-line: #dbe2ee;
  background: #f4f7fc;
  padding-bottom: 56px;
}

.obp__wrap {
  width: 100%;
  max-width: 1280px;
  margin-inline: auto;
  padding-inline: 40px;
}

/* Hero */
.obp__hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: 300px;
  background: radial-gradient(110% 160% at 85% 30%, #1f4c8f 0%, #0b1f3d 55%, #061328 100%);
  color: #fff;
}

.obp__hero-media {
  position: absolute;
  inset: 0;
  z-index: -1;
}

.obp__hero-media::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgb(8 24 50 / calc(var(--obp-overlay) + 0.2)) 0%,
    rgb(8 24 50 / var(--obp-overlay)) 40%,
    rgb(8 24 50 / 0) 75%
  );
}

.obp__hero-media picture,
.obp__hero-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.obp__hero-inner { padding-block: 44px; }

.obp__eyebrow {
  margin: 0 0 12px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.85);
}

.obp__heading {
  margin: 0 0 14px;
  max-width: 18ch;
  font-size: clamp(2rem, 3.6vw, 3rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: #fff;
}

.obp__accent { color: var(--obp-accent-light); }

.obp__lead {
  margin: 0;
  max-width: 46ch;
  font-size: 1rem;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.86);
}

/* Layout */
.obp__layout {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  grid-template-areas:
    'side main'
    'news main';
  grid-template-rows: auto 1fr;
  gap: 28px 32px;
  align-items: start;
  margin-top: 24px;
}

.obp__side { grid-area: side; min-width: 0; }
.obp__main { grid-area: main; min-width: 0; }
.obp__news { grid-area: news; min-width: 0; }

/* Search */
.obp__search {
  position: relative;
  margin-bottom: 14px;
}

.obp__search-icon {
  position: absolute;
  inset-inline-start: 14px;
  top: 50%;
  width: 18px;
  height: 18px;
  color: var(--obp-ink);
  transform: translateY(-50%);
  pointer-events: none;
}

.obp__search-input {
  width: 100%;
  min-height: 46px;
  padding: 10px 14px;
  padding-inline-start: 42px;
  border: 1px solid var(--obp-line);
  border-radius: 8px;
  background: #fff;
  color: var(--obp-ink);
  font: inherit;
  font-size: 0.92rem;
}

.obp__search-input:focus-visible {
  outline: none;
  border-color: var(--obp-navy);
  box-shadow: 0 0 0 3px rgba(15, 42, 85, 0.15);
}

/* Categories */
.obp__cats {
  padding: 8px;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 6px 22px rgba(20, 40, 74, 0.06);
}

.obp__cat-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.obp__cat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 44px;
  padding: 8px 14px;
  border-radius: 8px;
  color: var(--obp-ink);
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.obp__cat:hover { background: #f0f4fb; }

.obp__cat.is-active {
  background: #e3ecfa;
  color: var(--obp-navy);
  font-weight: 700;
}

.obp__cat:focus-visible { outline: 2px solid var(--obp-accent); outline-offset: 1px; }

.obp__cat-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

.obp__cat-count {
  flex-shrink: 0;
  font-size: 0.85rem;
  color: var(--obp-muted);
}

.obp__cat.is-active .obp__cat-count { color: var(--obp-navy); }

/* Grid */
.obp__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.obp__item { display: flex; min-width: 0; }

.obp__empty {
  margin: 0;
  padding: 48px 24px;
  border-radius: 12px;
  background: #fff;
  text-align: center;
  color: var(--obp-muted);
}

/* Pagination */
.obp__pagination { margin-top: 32px; }

.obp__pagination ul {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.obp__page {
  min-width: 40px;
  height: 40px;
  padding: 0 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--obp-line);
  border-radius: 8px;
  background: #fff;
  color: var(--obp-ink);
  font-size: 0.92rem;
  font-weight: 600;
  text-decoration: none;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.obp__page svg { width: 16px; height: 16px; }
a.obp__page:hover { border-color: var(--obp-navy); }
.obp__page:focus-visible { outline: 2px solid var(--obp-accent); outline-offset: 2px; }
.obp__page.is-current { background: var(--obp-navy); border-color: var(--obp-navy); color: #fff; }
.obp__page--gap { border-color: transparent; background: transparent; }
.obp__page.is-disabled { opacity: 0.4; }
[dir='rtl'] .obp__page--arrow svg { transform: scaleX(-1); }

/* Newsletter */
.obp__news {
  padding: 24px 20px;
  border-radius: 12px;
  background: linear-gradient(160deg, #e9f0fb 0%, #dde7f6 100%);
}

.obp__news-eyebrow {
  margin: 0 0 8px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--obp-accent);
}

.obp__news-title {
  margin: 0 0 16px;
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1.35;
  color: var(--obp-ink);
}

.obp__news-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.obp__news-input {
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid var(--obp-line);
  border-radius: 8px;
  background: #fff;
  color: var(--obp-ink);
  font: inherit;
  font-size: 0.9rem;
}

.obp__news-input:focus-visible {
  outline: none;
  border-color: var(--obp-navy);
  box-shadow: 0 0 0 3px rgba(15, 42, 85, 0.15);
}

.obp__news-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 44px;
  border: 0;
  border-radius: 8px;
  background: var(--obp-navy);
  color: #fff;
  font: inherit;
  font-size: 0.92rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease;
}

.obp__news-btn svg { width: 16px; height: 16px; }
.obp__news-btn:hover { background: #1e3a5f; }
.obp__news-btn:focus-visible { outline: 2px solid var(--obp-accent); outline-offset: 3px; }
[dir='rtl'] .obp__news-btn svg { transform: scaleX(-1); }

.obp__news-msg { margin: 0; font-size: 0.88rem; color: #1d6b38; }
.obp__news-msg--error { color: #a12a1f; }

@media (max-width: 1199px) {
  .obp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* Tablet + mobile: single column, categories as a scrolling chip row */
@media (max-width: 989px) {
  .obp__layout {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'side'
      'main'
      'news';
    grid-template-rows: auto;
    gap: 20px;
  }

  .obp__cats {
    padding: 0;
    background: transparent;
    box-shadow: none;
    margin-inline: -40px;
  }

  .obp__cat-list {
    flex-direction: row;
    gap: 8px;
    padding-inline: 40px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .obp__cat-list::-webkit-scrollbar { display: none; }

  .obp__cat {
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--obp-line);
    border-radius: 8px;
    background: #fff;
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .obp__cat.is-active {
    border-color: var(--obp-navy);
    background: var(--obp-navy);
    color: #fff;
  }

  .obp__cat-count { display: none; }
}

@media (max-width: 749px) {
  .obp { padding-bottom: 36px; }
  .obp__wrap { padding-inline: 16px; }
  .obp__hero { min-height: 260px; align-items: flex-start; }
  .obp__hero-inner { padding-block: 28px; }
  .obp__eyebrow { font-size: 0.68rem; margin-bottom: 8px; }
  .obp__heading { font-size: clamp(1.8rem, 8vw, 2.2rem); max-width: 12ch; }
  .obp__lead { max-width: 30ch; font-size: 0.86rem; }
  .obp__layout { margin-top: 16px; gap: 16px; }
  .obp__search { margin-bottom: 12px; }
  .obp__cats { margin-inline: -16px; }
  .obp__cat-list { padding-inline: 16px; }
  .obp__grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .obp__pagination { margin-top: 24px; }
  .obp__page { min-width: 36px; height: 36px; }
}

@media (prefers-reduced-motion: reduce) {
  .obp__cat,
  .obp__page,
  .obp__news-btn { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian Blog Page",
  "tag": "div",
  "class": "section-ossian-blog-main",
  "settings": [
    { "type": "header", "content": "Hero banner" },
    { "type": "image_picker", "id": "hero_image", "label": "Desktop banner", "info": "Wide image (about 2400 × 600). Keep the left side calm — the text sits there." },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "Mobile banner", "info": "About 750 × 520. Keep the left side calm. Falls back to the desktop banner." },
    { "type": "range", "id": "overlay", "label": "Text shade strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Blog & Articles" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent. Use | for a line break. Defaults to the blog title.", "default": "Insights for|[Healthier Hair & Skin]" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Expert tips, routines, ingredient insights and more — curated to help you look and feel your best." },
    { "type": "header", "content": "Articles" },
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "textarea", "id": "categories", "label": "Categories", "info": "Article tags to list, one per line, in display order. Leave empty to list every tag used on the blog.", "default": "Hair Care\nSkin Care\nIngredients\nTips & Guides\nSalon Care\nOssion Science" },
