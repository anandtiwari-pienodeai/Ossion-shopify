<div
  class="ossian-about-sustainability"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-about-sustainability__inner">
    <div class="ossian-about-sustainability__icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M2 12h20"/>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
    </div>

    {% if section.settings.heading != blank %}
      <h2 class="ossian-about-sustainability__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <p class="ossian-about-sustainability__content">{{ section.settings.content }}</p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="ossian-about-sustainability__pillars">
        {% for block in section.blocks %}
          <div class="ossian-about-sustainability__pillar" {{ block.shopify_attributes }}>
            <h3 class="ossian-about-sustainability__pillar-heading">{{ block.settings.heading }}</h3>
            <p class="ossian-about-sustainability__pillar-text">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .ossian-about-sustainability {
    background: #f0f9ff;
  }

  .ossian-about-sustainability__inner {
    max-width: 896px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .ossian-about-sustainability__icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #1e3a5f;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(30, 58, 95, 0.25);
  }

  .ossian-about-sustainability__heading {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .ossian-about-sustainability__content {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.7;
    margin: 0;
    max-width: 720px;
  }

  .ossian-about-sustainability__pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    margin-top: 16px;
    text-align: left;
  }

  .ossian-about-sustainability__pillar {
    background: #ffffff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    padding: 24px;
  }

  .ossian-about-sustainability__pillar-heading {
    font-size: 1rem;
    font-weight: 600;
    color: #1e3a5f;
    margin: 0 0 8px;
  }

  .ossian-about-sustainability__pillar-text {
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ossian-about-sustainability__inner {
      padding: 0 20px;
    }
    .ossian-about-sustainability__pillars {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About - Sustainability",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "pillar",
      "name": "Sustainability Pillar",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Eco-Friendly Packaging"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Recyclable and biodegradable materials wherever possible."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Committed to Sustainability"
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Content",
      "default": "We believe in beauty that doesn't cost the earth. Our commitment to sustainability is woven into everything we do, from ingredient sourcing to packaging choices and manufacturing practices."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About - Sustainability",
      "settings": {
        "heading": "Committed to Sustainability",
        "content": "We believe in beauty that doesn't cost the earth. Our commitment to sustainability is woven into everything we do, from ingredient sourcing to packaging choices and manufacturing practices."
      },
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "heading": "Eco-Friendly Packaging",
            "text": "Recyclable and biodegradable materials wherever possible."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "Ethical Sourcing",
            "text": "Responsibly sourced ingredients from trusted suppliers around the world."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "Cruelty-Free",
            "text": "Never tested on animals, certified cruelty-free by leading organisations."
          }
        }
      ]
    }
  ]
}
{% endschema %}
