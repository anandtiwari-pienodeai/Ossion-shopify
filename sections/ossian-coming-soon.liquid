{% comment %}
  Section contract.
  Branded "Coming soon" screen for the password page (templates/password.json). Shown to
  visitors while Online Store → Preferences → Password protection is on. Collects launch
  sign-ups as customers tagged "newsletter, coming-soon". The password footer below it keeps
  the "Enter using password" link for the owner.
  @example
  <!-- templates/password.json → sections.main.type = "ossian-coming-soon" -->
{% endcomment %}

{%- liquid
  assign form_id = 'ComingSoonForm-' | append: section.id
  assign bg = section.settings.background_image
  assign bg_mobile = section.settings.background_image_mobile | default: bg
-%}

<div
  class="ocs"
  style="--ocs-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if bg != blank -%}
    <picture class="ocs__bg" aria-hidden="true">
      <source media="(max-width: 749px)" srcset="{{ bg_mobile | image_url: width: 1080 }}">
      {{
        bg
        | image_url: width: 2400
        | image_tag:
          class: 'ocs__bg-img',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800,1200,1600,2000,2400',
          sizes: '100vw',
          alt: ''
      }}
    </picture>
  {%- endif -%}

  <div class="ocs__inner">
    <div class="ocs__logo">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag:
            class: 'ocs__logo-img',
            loading: 'eager',
            widths: '260,390,520',
            sizes: '(min-width: 750px) 260px, 200px',
            alt: shop.name
        }}
      {%- else -%}
        {%- assign logo_url = 'ossion-logo.png' | asset_url -%}
        <img
          class="ocs__logo-img ocs__logo-img--invert"
          src="{{ logo_url }}&width=520"
          alt="{{ shop.name | escape }}"
          width="720"
          height="193"
        >
      {%- endif -%}
    </div>

    {%- if section.settings.eyebrow != blank -%}
      <p class="ocs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="ocs__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="ocs__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: form_id, class: 'ocs__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, coming-soon">
        {%- if form.posted_successfully? -%}
          <p class="ocs__msg ocs__msg--success" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </p>
        {%- else -%}
          <div class="ocs__field">
            <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.placeholder | escape }}</label>
            <input
              class="ocs__input"
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              placeholder="{{ section.settings.placeholder | escape }}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-error"
              {% endif %}
            >
            <button type="submit" class="ocs__submit">{{ section.settings.button_label | escape }}</button>
          </div>
          {%- if form.errors -%}
            <p class="ocs__msg ocs__msg--error" id="{{ form_id }}-error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <a
        class="ocs__social"
        href="{{ section.settings.instagram_url }}"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        <span>{{ section.settings.instagram_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-ossian-coming-soon {
    flex-grow: 1;
    display: flex;
  }

  .ocs {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 64px 20px;
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 85% 10%, rgb(217 164 65 / 0.16) 0%, transparent 60%),
      radial-gradient(70% 60% at 10% 100%, rgb(31 76 140 / 0.45) 0%, transparent 65%),
      linear-gradient(160deg, #1e3a5f 0%, #0f2038 100%);
    color: #fff;
    text-align: center;
  }

  .ocs__bg,
  .ocs__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ocs__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(15 32 56 / var(--ocs-overlay, 0.6));
  }

  .ocs__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    width: 100%;
    max-width: 620px;
  }

  .ocs__logo-img {
    display: block;
    width: 200px;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .ocs__logo-img {
      width: 260px;
    }
  }

  /* The bundled logo is dark; flip it to white on the navy background */
  .ocs__logo-img--invert {
    filter: brightness(0) invert(1);
  }

  .ocs__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 14px 0 0;
    color: #d9a441;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .ocs__eyebrow::before,
  .ocs__eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .ocs__heading {
    margin: 0;
    color: #fff;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 600;
    line-height: 1.1;
    overflow-wrap: break-word;
  }

  .ocs__text {
    max-width: 520px;
    color: rgb(255 255 255 / 0.8);
    font-size: 1rem;
    line-height: 1.6;
  }

  .ocs__text p {
    margin: 0;
  }

  .ocs__form {
    width: 100%;
    max-width: 480px;
    margin-top: 8px;
  }

  .ocs__field {
    display: flex;
    gap: 8px;
    padding: 6px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
  }

  /* .ocs scope beats the theme's global input fill */
  .ocs .ocs__input {
    flex: 1;
    min-width: 0;
    padding: 0 16px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
  }

  .ocs__input::placeholder {
    color: rgb(255 255 255 / 0.6);
  }

  .ocs__input:focus {
    outline: none;
  }

  .ocs__field:focus-within {
    border-color: #d9a441;
  }

  .ocs__submit {
    flex: 0 0 auto;
    padding: 12px 22px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #b8832a 0%, #dba84a 50%, #c9953a 100%);
    color: #fff;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .ocs__submit:hover {
    filter: brightness(1.06);
  }

  .ocs__submit:focus-visible,
  .ocs__social:focus-visible {
    outline: 2px solid #d9a441;
    outline-offset: 3px;
  }

  @media screen and (max-width: 480px) {
    .ocs__field {
      flex-direction: column;
      border-radius: 16px;
    }

    .ocs__input {
      min-height: 44px;
      text-align: center;
    }
  }

  .ocs__msg {
    margin: 0;
    font-size: 0.9rem;
  }

  .ocs__msg--success {
    padding: 14px 18px;
    border: 1px solid rgb(217 164 65 / 0.5);
    border-radius: 12px;
    color: #f3d9a4;
  }

  .ocs__msg--error {
    margin-top: 10px;
    color: #ffb4a8;
  }

  .ocs__social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .ocs__social svg {
    width: 20px;
    height: 20px;
  }

  .ocs__social:hover {
    color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coming soon",
  "class": "section-ossian-coming-soon",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use a white or light logo. Leave empty to show the store logo in white."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Without one, a navy brand background is used. 2400 × 1350px."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. 1080 × 1920px."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Launching soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something beautiful is coming"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Professional hair and skin care, powered by marine science. Be the first to know when we launch.</p>"
    },
    {
      "type": "header",
      "content": "Sign-up form"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email sign-up",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We'll let you know as soon as we launch."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram label",
      "default": "Follow us on Instagram"
    }
  ]
}
{% endschema %}
