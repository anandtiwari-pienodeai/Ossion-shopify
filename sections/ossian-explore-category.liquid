{{ 'section-ossian-explore-category.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Ossian Explore More Category.

  Card source, in order:
    1. The current collection's `custom.explore_categories` metafield — a list
       of collections. One card per collection, each illustrated by the first
       product in that collection (so the collection's own sort order decides
       which product appears).
    2. Automatic: the store's other collections (skipping the current one, empty
       ones and the excluded handles), each illustrated by its first in-stock product.
    3. The section's manually configured Category Card blocks, used when automatic
       collections are switched off.
{%- endcomment -%}

{%- liquid
  assign mapped = collection.metafields.custom.explore_categories.value
  assign max_cards = section.settings.max_cards | default: 4

  assign mapped_count = 0
  if mapped != blank
    for cat in mapped
      if cat == blank
        continue
      endif
      if section.settings.hide_current and cat.id == collection.id
        continue
      endif
      assign mapped_count = mapped_count | plus: 1
    endfor
  endif

  # Automatic source: real collections, so the cards always show live products
  assign auto_count = 0
  assign excluded = section.settings.exclude_handles | downcase | remove: ' ' | split: ','
  if mapped_count == 0 and section.settings.auto_collections
    for cat in collections
      if excluded contains cat.handle or cat.handle == 'all' or cat.products_count == 0
        continue
      endif
      if section.settings.hide_current and collection != blank and cat.id == collection.id
        continue
      endif
      assign auto_count = auto_count | plus: 1
    endfor
  endif
-%}

{%- if mapped_count > 0 or auto_count > 0 or section.blocks.size > 0 -%}
  <section class="explore-cat" id="explore-cat-{{ section.id }}">
    <div class="explore-cat__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="explore-cat__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="explore-cat__grid">
        {%- if mapped_count > 0 -%}

          {%- assign shown = 0 -%}
          {%- for cat in mapped -%}
            {%- if shown >= max_cards -%}{%- break -%}{%- endif -%}
            {%- if cat == blank -%}{%- continue -%}{%- endif -%}
            {%- if section.settings.hide_current and cat.id == collection.id -%}{%- continue -%}{%- endif -%}

            {%- assign cat_product = cat.products.first -%}
            {%- render 'explore-category-card',
              ec_collection: cat,
              ec_product: cat_product,
              ec_label: cat.title,
              ec_cta: section.settings.cta_label
            -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}

        {%- elsif auto_count > 0 -%}

          {%- assign shown = 0 -%}
          {%- for cat in collections -%}
            {%- if shown >= max_cards -%}{%- break -%}{%- endif -%}
            {%- if excluded contains cat.handle or cat.handle == 'all' or cat.products_count == 0 -%}{%- continue -%}{%- endif -%}
            {%- if section.settings.hide_current and collection != blank and cat.id == collection.id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign cat_product = blank
              for candidate in cat.products
                if candidate.available
                  assign cat_product = candidate
                  break
                endif
              endfor
              if cat_product == blank
                assign cat_product = cat.products.first
              endif
            -%}
            {%- render 'explore-category-card',
              ec_collection: cat,
              ec_product: cat_product,
              ec_label: cat.title,
              ec_cta: section.settings.cta_label
            -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}

        {%- else -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'category_card' -%}
              {%- liquid
                assign b_collection = block.settings.collection
                assign b_product = block.settings.product
                if b_product == blank and b_collection != blank
                  assign b_product = b_collection.products.first
                endif

                assign b_label = block.settings.category_label
                if b_product != blank and b_product.type != blank
                  assign b_label = b_product.type
                endif
              -%}
              {%- render 'explore-category-card',
                ec_collection: b_collection,
                ec_product: b_product,
                ec_image: block.settings.image,
                ec_label: b_label,
                ec_name: block.settings.name,
                ec_price: block.settings.price,
                ec_rating: block.settings.rating,
                ec_reviews: block.settings.review_count,
                ec_link: block.settings.link,
                ec_cta: block.settings.cta_label,
                ec_attrs: block.shopify_attributes
              -%}
            {%- endif -%}
          {%- endfor -%}

        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}


{% schema %}
{
  "name": "Explore More Category",
  "tag": "section",
  "class": "ossian-explore-category-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "On a collection page, the cards come from that collection's 'Explore more categories' metafield — set it in Products > Collections. Each card shows the first product in the collection it points to. The Category Card blocks below are the fallback for collections with no mapping."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "EXPLORE MORE CATEGORY"
    },
    {
      "type": "header",
      "content": "Mapped cards"
    },
    {
      "type": "range",
      "id": "max_cards",
      "label": "Maximum cards",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "hide_current",
      "label": "Hide the collection being viewed",
      "default": true,
      "info": "Skips a mapped collection if the shopper is already on it."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "checkbox",
      "id": "auto_collections",
      "label": "Show store collections automatically",
      "default": true,
      "info": "Builds the cards from your collections, each showing its first in-stock product. Used when the collection has no custom.explore_categories mapping. Turn off to use the Category Card blocks instead."
    },
    {
      "type": "text",
      "id": "exclude_handles",
      "label": "Collections to skip",
      "default": "frontpage, test",
      "info": "Comma-separated collection handles, e.g. frontpage, test."
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "The card links here and, if no product is chosen below, shows the first product in it."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (auto-fills image, title, price)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category label",
          "default": "HAIR CARE"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name override"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price override (e.g. ₹1,999)",
          "info": "Used only if no product is selected"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating (e.g. 4.8)",
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count (e.g. 210)",
          "default": "210"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (overrides collection / product URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore More Category",
      "settings": {
        "heading": "EXPLORE MORE CATEGORY"
      }
    }
  ]
}
{% endschema %}
