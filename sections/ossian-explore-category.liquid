<section class="explore-cat" id="explore-cat-{{ section.id }}">
  <div class="explore-cat__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="explore-cat__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="explore-cat__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category_card' -%}
          {%- assign ec_product = block.settings.product -%}
          <div class="explore-cat__card" {{ block.shopify_attributes }}>
            <!-- Image -->
            <div class="explore-cat__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag:
                    class: 'explore-cat__img',
                    loading: 'lazy',
                    widths: '200,300,400'
                }}
              {%- elsif ec_product != blank and ec_product.featured_image != blank -%}
                {{
                  ec_product.featured_image
                  | image_url: width: 400
                  | image_tag:
                    class: 'explore-cat__img',
                    loading: 'lazy',
                    alt: ec_product.title,
                    widths: '200,300,400'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'explore-cat__img explore-cat__img--placeholder' }}
              {%- endif -%}
            </div>

            <!-- Info -->
            <div class="explore-cat__info">
              {%- assign cat_label = block.settings.category_label -%}
              {%- if cat_label != blank -%}
                <span class="explore-cat__cat-label">{{ cat_label }}</span>
              {%- elsif ec_product.type != blank -%}
                <span class="explore-cat__cat-label">{{ ec_product.type }}</span>
              {%- endif -%}

              <h3 class="explore-cat__name">
                {%- if block.settings.name != blank -%}
                  {{ block.settings.name }}
                {%- elsif ec_product != blank -%}
                  {{ ec_product.title }}
                {%- else -%}
                  Product Name
                {%- endif -%}
              </h3>

              <!-- Rating -->
              {%- assign rating_val = block.settings.rating -%}
              {%- if ec_product.metafields.reviews.rating.value != blank -%}
                {%- assign rating_val = ec_product.metafields.reviews.rating.value -%}
              {%- endif -%}
              {%- if rating_val != blank -%}
                <div class="explore-cat__rating">
                  <span class="explore-cat__stars" aria-hidden="true">
                    {%- assign r = rating_val | times: 1.0 | round -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= r -%}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#f5a623"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- else -%}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f5a623" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="explore-cat__rating-val">{{ rating_val }}</span>
                  {%- if block.settings.review_count != blank -%}
                    <span class="explore-cat__review-count">({{ block.settings.review_count }})</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <!-- Price -->
              {%- if ec_product != blank -%}
                <p class="explore-cat__price">{{ ec_product.price | money }}</p>
              {%- elsif block.settings.price != blank -%}
                <p class="explore-cat__price">{{ block.settings.price }}</p>
              {%- endif -%}

              <!-- View All -->
              <a
                href="{{ block.settings.link | default: ec_product.url | default: '#' }}"
                class="explore-cat__viewall"
              >
                {{ block.settings.cta_label | default: 'View all' }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.explore-cat {
  background: #fff;
  padding: 20px 40px;
}

.explore-cat__heading {
  text-align: center;
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #1e3a5f;
  margin: 0 0 36px;
  font-style: italic;
  font-family: var(--font-primary--family, sans-serif);
}

.explore-cat__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  padding: 0 20px;
}

.explore-cat__card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #f7f7f7;
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}

.explore-cat__card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px rgba(30,58,95,0.12);
}

.explore-cat__media {
  flex: 0 0 42%;
  min-height: 140px;
  overflow: hidden;
  position: relative;
  background: #ececec;
}

.explore-cat__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.explore-cat__img--placeholder {
  width: 100%;
  height: 100%;
}

.explore-cat__card:hover .explore-cat__img {
  transform: scale(1.05);
}

.explore-cat__info {
  flex: 1;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
}

.explore-cat__cat-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #1e3a5f;
  font-family: var(--font-body--family, sans-serif);
}

.explore-cat__name {
  font-size: 13px;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0;
  line-height: 1.3;
  font-family: var(--font-body--family, sans-serif);
}

.explore-cat__rating {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 2px;
}

.explore-cat__stars {
  display: flex;
  align-items: center;
  gap: 1px;
}

.explore-cat__rating-val,
.explore-cat__review-count {
  font-size: 11px;
  color: #666;
  font-weight: 500;
  font-family: var(--font-body--family, sans-serif);
}

.explore-cat__price {
  font-size: 13px;
  font-weight: 700;
  color: #1e3a5f;
  margin: 0;
  margin-top: 2px;
  font-family: var(--font-body--family, sans-serif);
}

.explore-cat__viewall {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 700;
  color: #1e3a5f;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: #e6ecf5;
  border-radius: 4px;
  padding: 5px 10px;
  margin-top: 6px;
  align-self: flex-start;
  transition: background 0.2s, color 0.2s;
  font-family: var(--font-body--family, sans-serif);
}

.explore-cat__viewall:hover {
  background: #1e3a5f;
  color: #fff;
}

@media (max-width: 1024px) {
  .explore-cat__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .explore-cat {
    padding: 28px 0 36px;
  }

  .explore-cat__inner {
    padding-inline: 0;
  }

  .explore-cat__heading {
    font-size: clamp(1.1rem, 5vw, 1.5rem);
    margin-bottom: 20px;
    padding-inline: 16px;
  }

  /* ── Scrollable carousel ── */
  .explore-cat__grid {
    display: flex;
    flex-direction: row;
    grid-template-columns: unset;
    gap: 12px;
    padding: 4px 16px 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .explore-cat__grid::-webkit-scrollbar {
    display: none;
  }

  /* Each card: fixed width, snaps into place */
  .explore-cat__card {
    flex: 0 0 72vw;
    max-width: 280px;
    scroll-snap-align: start;
    flex-direction: column;
    border-radius: 10px;
  }

  .explore-cat__media {
    flex: none;
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: unset;
  }

  .explore-cat__info {
    padding: 10px 12px 14px;
    gap: 4px;
  }

  .explore-cat__name {
    font-size: 12px;
  }

  .explore-cat__viewall {
    font-size: 10px;
    padding: 4px 8px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Explore More Category",
  "tag": "section",
  "class": "ossian-explore-category-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "EXPLORE MORE CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (auto-fills image, title, price)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "category_label",
          "label": "Category label",
          "default": "HAIR CARE"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name override"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price override (e.g. ₹1,999)",
          "info": "Used only if no product is selected"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating (e.g. 4.8)",
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review count (e.g. 210)",
          "default": "210"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (overrides product URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Explore More Category",
      "settings": {
        "heading": "EXPLORE MORE CATEGORY"
      },
      "blocks": [
        { "type": "category_card", "settings": { "category_label": "HAIR CARE", "name": "Caviar Mask", "rating": "4.8", "review_count": "210", "price": "₹1,999", "cta_label": "View all" } },
        { "type": "category_card", "settings": { "category_label": "HAIR CARE", "name": "Caviar Mask", "rating": "4.8", "review_count": "210", "price": "₹1,999", "cta_label": "View all" } },
        { "type": "category_card", "settings": { "category_label": "HAIR CARE", "name": "Caviar Mask", "rating": "4.8", "review_count": "210", "price": "₹1,999", "cta_label": "View all" } },
        { "type": "category_card", "settings": { "category_label": "HAIR CARE", "name": "Caviar Mask", "rating": "4.8", "review_count": "210", "price": "₹1,999", "cta_label": "View all" } }
      ]
    }
  ]
}
{% endschema %}
