{%- assign collection = collections[section.settings.collection] -%}

<div class="ossian-best-sellers">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ossian-best-sellers__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ossian-best-sellers__grid">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_count -%}
          {%- assign product_block = section.blocks[forloop.index0] -%}
          <div class="ossian-best-sellers__card">
            <a href="{{ product.url }}" class="ossian-best-sellers__card-link">
              <div class="ossian-best-sellers__image-wrap">
                {%- if product_block and product_block.settings.badge != blank -%}
                  <span class="ossian-best-sellers__badge">{{ product_block.settings.badge }}</span>
                {%- endif -%}
                <button class="ossian-best-sellers__wishlist" aria-label="Add to wishlist" onclick="event.preventDefault()">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'ossian-best-sellers__img',
                    alt: product.title,
                    loading: 'lazy',
                    widths: '300, 400, 600'
                }}
              </div>
              <div class="ossian-best-sellers__info">
                {%- assign product_type = product.type | upcase -%}
                {%- if product_type != blank -%}
                  <p class="ossian-best-sellers__type">{{ product_type }}</p>
                {%- endif -%}
                <h3 class="ossian-best-sellers__name">{{ product.title }}</h3>
                <div class="ossian-best-sellers__rating">
                  <span class="ossian-best-sellers__stars" aria-hidden="true">★★★★★</span>
                  <span class="ossian-best-sellers__rating-text">
                    {%- if product_block and product_block.settings.rating != blank -%}
                      {{ product_block.settings.rating }}
                    {%- else -%}
                      4.9
                    {%- endif -%}
                  </span>
                </div>
                {%- if product_block and product_block.settings.tags != blank -%}
                  <div class="ossian-best-sellers__tags">
                    {%- assign tags_list = product_block.settings.tags | split: ',' -%}
                    {%- for tag in tags_list -%}
                      <span class="ossian-best-sellers__tag">{{ tag | strip }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="ossian-best-sellers__pricing">
                  <span class="ossian-best-sellers__price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <s class="ossian-best-sellers__compare">{{ product.compare_at_price | money }}</s>
                    {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                    <span class="ossian-best-sellers__discount">{{ discount }}% off</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            <button
              class="ossian-best-sellers__atc"
              data-product-id="{{ product.variants.first.id }}"
              onclick="
                fetch('/cart/add.js', {
                  method: 'POST',
                  headers: {'Content-Type': 'application/json'},
                  body: JSON.stringify({id: {{ product.variants.first.id }}, quantity: 1})
                }).then(function(r) {
                  if(r.ok) { document.dispatchEvent(new CustomEvent('cart:refresh')); }
                });
              "
            >
              ADD TO CART
            </button>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="ossian-best-sellers__card ossian-best-sellers__card--placeholder" {{ block.shopify_attributes }}>
            <div class="ossian-best-sellers__image-wrap">
              {%- if block.settings.badge != blank -%}
                <span class="ossian-best-sellers__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.product_image != blank -%}
                {{
                  block.settings.product_image
                  | image_url: width: 500
                  | image_tag:
                    class: 'ossian-best-sellers__img',
                    loading: 'lazy'
                }}
              {%- else -%}
                <div class="ossian-best-sellers__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
            </div>
            <div class="ossian-best-sellers__info">
              {%- if block.settings.category != blank -%}
                <p class="ossian-best-sellers__type">{{ block.settings.category }}</p>
              {%- endif -%}
              <h3 class="ossian-best-sellers__name">{{ block.settings.name }}</h3>
              <div class="ossian-best-sellers__rating">
                <span class="ossian-best-sellers__stars" aria-hidden="true">★★★★★</span>
                <span class="ossian-best-sellers__rating-text">{{ block.settings.rating }}</span>
              </div>
              {%- if block.settings.tags != blank -%}
                <div class="ossian-best-sellers__tags">
                  {%- assign tags_list = block.settings.tags | split: ',' -%}
                  {%- for tag in tags_list -%}
                    <span class="ossian-best-sellers__tag">{{ tag | strip }}</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <div class="ossian-best-sellers__pricing">
                <span class="ossian-best-sellers__price">{{ block.settings.price }}</span>
                {%- if block.settings.compare_price != blank -%}
                  <s class="ossian-best-sellers__compare">{{ block.settings.compare_price }}</s>
                  <span class="ossian-best-sellers__discount">{{ block.settings.discount }}</span>
                {%- endif -%}
              </div>
            </div>
            <button class="ossian-best-sellers__atc">ADD TO CART</button>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.ossian-best-sellers {
  padding: 64px 0;
  background: #fff;
}

.ossian-best-sellers__heading {
  font-size: clamp(1.8rem, 3vw, 2.8rem);
  font-weight: 900;
  color: #1e3a5f;
  text-align: center;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin: 0 0 48px;
}

.ossian-best-sellers__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.ossian-best-sellers__card {
  display: flex;
  flex-direction: column;
}

.ossian-best-sellers__card-link {
  text-decoration: none;
  color: inherit;
  flex: 1;
}

.ossian-best-sellers__image-wrap {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #f5f0eb;
  margin-bottom: 14px;
}

.ossian-best-sellers__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.ossian-best-sellers__card:hover .ossian-best-sellers__img { transform: scale(1.04); }

.ossian-best-sellers__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #1e3a5f;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
  z-index: 2;
}

.ossian-best-sellers__wishlist {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(255,255,255,0.9);
  border: none;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #1e3a5f;
  z-index: 2;
  transition: background 0.2s;
}

.ossian-best-sellers__wishlist:hover { background: #fff; }

.ossian-best-sellers__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0ece7;
}

.ossian-best-sellers__type {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.6;
  margin: 0 0 6px;
}

.ossian-best-sellers__name {
  font-size: 0.9rem;
  font-weight: 600;
  color: #1e3a5f;
  margin: 0 0 8px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ossian-best-sellers__rating {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}

.ossian-best-sellers__stars {
  color: #f4c542;
  font-size: 14px;
  letter-spacing: 1px;
}

.ossian-best-sellers__rating-text {
  font-size: 12px;
  font-weight: 600;
  color: #444;
}

.ossian-best-sellers__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 10px;
}

.ossian-best-sellers__tag {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1px solid #1e3a5f;
  color: #1e3a5f;
  padding: 3px 7px;
  border-radius: 20px;
}

.ossian-best-sellers__pricing {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.ossian-best-sellers__price {
  font-size: 1.1rem;
  font-weight: 700;
  color: #1e3a5f;
}

.ossian-best-sellers__compare {
  font-size: 0.85rem;
  color: #999;
  text-decoration: line-through;
}

.ossian-best-sellers__discount {
  font-size: 0.8rem;
  font-weight: 700;
  color: #e74c3c;
}

.ossian-best-sellers__atc {
  width: 100%;
  background: #1e3a5f;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 14px 20px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: auto;
}

.ossian-best-sellers__atc:hover { background: #2d5a8f; }

@media (max-width: 990px) {
  .ossian-best-sellers__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 560px) {
  .ossian-best-sellers__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "ossian-best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (overrides blocks)"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (e.g. BEST SELLER)"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Product name"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating (e.g. 4.9 (210))",
          "default": "4.9 (210)"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (comma separated)",
