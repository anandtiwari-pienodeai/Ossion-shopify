{%- assign col = collections[section.settings.collection] -%}
{%- assign has_products = false -%}
{%- if col != blank and col.products_count > 0 -%}
  {%- assign has_products = true -%}
{%- endif -%}

<section class="obs">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="obs__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="obs__grid">

      {%- if has_products -%}

        {%- for product in col.products limit: section.settings.products_count -%}

          {%- comment -%} Resolve badge from product tags {%- endcomment -%}
          {%- assign badge_text = '' -%}
          {%- for tag in product.tags -%}
            {%- if badge_text == '' -%}
              {%- assign tl = tag | downcase -%}
              {%- if tl == 'best seller' or tl == 'best-seller' -%}
                {%- assign badge_text = 'BEST SELLER' -%}
              {%- elsif tl == 'top rated' or tl == 'top-rated' -%}
                {%- assign badge_text = 'TOP RATED' -%}
              {%- elsif tl == 'trending' -%}
                {%- assign badge_text = 'TRENDING' -%}
              {%- elsif tl == 'new' or tl == 'new arrival' -%}
                {%- assign badge_text = 'NEW' -%}
              {%- elsif tl == 'sale' -%}
                {%- assign badge_text = 'SALE' -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Collect display tags (skip badge tags) {%- endcomment -%}
          {%- assign badge_tags = 'best seller,best-seller,top rated,top-rated,trending,new,new arrival,sale' | split: ',' -%}
          {%- assign display_tags = '' -%}
          {%- assign display_tag_count = 0 -%}
          {%- for tag in product.tags -%}
            {%- if display_tag_count < 3 -%}
              {%- assign tl = tag | downcase -%}
              {%- unless badge_tags contains tl -%}
                {%- if display_tags == '' -%}
                  {%- assign display_tags = tag -%}
                {%- else -%}
                  {%- assign display_tags = display_tags | append: '|||' | append: tag -%}
                {%- endif -%}
                {%- assign display_tag_count = display_tag_count | plus: 1 -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="obs__card">
            <a href="{{ product.url }}" class="obs__card-link">

              <div class="obs__img-wrap">
                {%- if badge_text != blank -%}
                  <span class="obs__badge">{{ badge_text }}</span>
                {%- endif -%}

                <button
                  class="obs__wishlist"
                  aria-label="Add to wishlist"
                  onclick="event.preventDefault()"
                  type="button"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>
                </button>

                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'obs__img',
                      alt: product.title,
                      loading: 'lazy',
                      widths: '300,450,600'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'obs__img obs__img--placeholder' }}
                {%- endif -%}
              </div>

              <div class="obs__info">
                {%- if product.type != blank -%}
                  <p class="obs__type">{{ product.type | upcase }}</p>
                {%- endif -%}

                <h3 class="obs__name">{{ product.title }}</h3>

                <div class="obs__rating" aria-label="4.9 stars">
                  <span class="obs__stars" aria-hidden="true">★★★★★</span>
                </div>

                {%- if display_tags != blank -%}
                  <div class="obs__tags">
                    {%- assign tag_arr = display_tags | split: '|||' -%}
                    {%- for tag in tag_arr -%}
                      <span class="obs__tag">{{ tag }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="obs__pricing">
                  <span class="obs__price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <s class="obs__compare">{{ product.compare_at_price | money }}</s>
                    {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                    <span class="obs__discount">{{ pct }}% off</span>
                  {%- endif -%}
                </div>
              </div>

            </a>

            <button
              class="obs__atc"
              type="button"
              data-variant-id="{{ product.variants.first.id }}"
              data-product-title="{{ product.title | escape }}"
            >
              ADD TO CART
            </button>
          </div>

        {%- endfor -%}

      {%- else -%}

        {%- comment -%} Placeholder grid shown in theme editor before collection is selected {%- endcomment -%}
        {%- for i in (1..section.settings.products_count) -%}
          <div class="obs__card obs__card--placeholder">
            <div class="obs__img-wrap">
              {{ 'product-1' | placeholder_svg_tag: 'obs__img obs__img--placeholder' }}
            </div>
            <div class="obs__info">
              <p class="obs__type">CATEGORY</p>
              <h3 class="obs__name">Select a collection above</h3>
              <div class="obs__pricing">
                <span class="obs__price">₹0.00</span>
              </div>
            </div>
            <button class="obs__atc" disabled type="button">ADD TO CART</button>
          </div>
        {%- endfor -%}

      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function () {
  document.querySelectorAll('.obs__atc[data-variant-id]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var variantId = parseInt(btn.dataset.variantId);
      if (!variantId) return;

      var original = btn.textContent;
      btn.textContent = 'ADDING…';
      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          btn.textContent = 'ADDED ✓';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          setTimeout(function () {
            btn.textContent = original;
            btn.disabled = false;
          }, 2000);
        })
        .catch(function () {
          btn.textContent = original;
          btn.disabled = false;
        });
    });
  });
})();
</script>

{% stylesheet %}
.obs {
  padding: 64px 0;
  background: #fff;
}

.obs__heading {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 900;
  color: #1e3a5f;
  text-align: center;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0 0 48px;
}

/* Grid */
.obs__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

/* Card */
.obs__card {
  display: flex;
  flex-direction: column;
}

.obs__card-link {
  text-decoration: none;
  color: inherit;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Image */
.obs__img-wrap {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #f5f0eb;
  margin-bottom: 14px;
  flex-shrink: 0;
}

.obs__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.obs__img--placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.obs__card:hover .obs__img {
  transform: scale(1.04);
}

/* Badge */
.obs__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  background: #1e3a5f;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
}

/* Wishlist */
.obs__wishlist {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #1e3a5f;
  transition: background 0.2s;
}

.obs__wishlist:hover {
  background: #fff;
}

/* Info */
.obs__info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.obs__type {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.55;
  margin: 0 0 5px;
}

.obs__name {
  font-size: 0.88rem;
  font-weight: 600;
  color: #1e3a5f;
  margin: 0 0 8px;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.obs__rating {
  margin-bottom: 8px;
}

.obs__stars {
  color: #f4c430;
  font-size: 13px;
  letter-spacing: 1px;
}

/* Tags */
.obs__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 10px;
}

.obs__tag {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  border: 1px solid rgba(30, 58, 95, 0.35);
  color: #1e3a5f;
  padding: 3px 7px;
  border-radius: 20px;
}

/* Pricing */
.obs__pricing {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 14px;
  margin-top: auto;
}

.obs__price {
  font-size: 1.05rem;
  font-weight: 700;
  color: #1e3a5f;
}

.obs__compare {
  font-size: 0.82rem;
  color: #aaa;
  text-decoration: line-through;
}

.obs__discount {
  font-size: 0.78rem;
  font-weight: 700;
  color: #d63031;
}

/* Add to cart */
.obs__atc {
  width: 100%;
  background: #1e3a5f;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 13px 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: auto;
}

.obs__atc:hover:not(:disabled) {
  background: #2d5a8f;
}

.obs__atc:disabled {
  opacity: 0.5;
  cursor: default;
}

/* Responsive */
@media (max-width: 990px) {
  .obs__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 560px) {
  .obs__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "ossian-best-sellers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Ossian Best Sellers"
    }
  ]
}
{% endschema %}
