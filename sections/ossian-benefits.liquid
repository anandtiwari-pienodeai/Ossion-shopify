<div
  class="ossian-benefits section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="ossian-benefits__grid">
      {% for block in section.blocks %}
        {% assign icon = block.settings.icon %}
        <div class="ossian-benefits__item" {{ block.shopify_attributes }}>
          <div class="ossian-benefits__icon-circle">
            {% if icon == 'truck' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {% elsif icon == 'shield-check' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9,12 11,14 15,10"></polyline></svg>
            {% elsif icon == 'headphones' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
            {% elsif icon == 'award' %}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21,13.89 7,23 12,20 17,23 15.79,13.88"></polyline></svg>
            {% endif %}
          </div>
          <div class="ossian-benefits__content">
            <h4 class="ossian-benefits__heading">{{ block.settings.heading }}</h4>
            <p class="ossian-benefits__subtext">{{ block.settings.subtext }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 749px) {
    .ossian-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ossian-benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 12px;
  }

  .ossian-benefits__icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #eff6ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e3a5f;
    flex-shrink: 0;
  }

  .ossian-benefits__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ossian-benefits__heading {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: #111827;
  }

  .ossian-benefits__subtext {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Benefits Bar",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "shield-check", "label": "Shield Check" },
            { "value": "headphones", "label": "Headphones" },
            { "value": "award", "label": "Award" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Orders over $100"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Benefits Bar"
    }
  ]
}
{% endschema %}
