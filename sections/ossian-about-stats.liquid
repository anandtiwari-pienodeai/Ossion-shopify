<div
  class="ossian-about-stats"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ossian-about-stats__inner">
    {% for block in section.blocks %}
      <div class="ossian-about-stats__item" {{ block.shopify_attributes }}>
        <span class="ossian-about-stats__number">{{ block.settings.number }}</span>
        <span class="ossian-about-stats__label">{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .ossian-about-stats {
    background: #ffffff;
    border-bottom: 1px solid #f3f4f6;
  }

  .ossian-about-stats__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ossian-about-stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .ossian-about-stats__number {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #1e3a5f;
    line-height: 1;
  }

  .ossian-about-stats__label {
    font-size: 1rem;
    color: #6b7280;
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    .ossian-about-stats__inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 20px;
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About - Stats Bar",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "50+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Products"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "About - Stats Bar",
      "blocks": [
        { "type": "stat", "settings": { "number": "50+", "label": "Products" } },
        { "type": "stat", "settings": { "number": "1M+", "label": "Happy Customers" } },
        { "type": "stat", "settings": { "number": "30+", "label": "Countries" } },
        { "type": "stat", "settings": { "number": "15+", "label": "Years of Excellence" } }
      ]
    }
  ]
}
{% endschema %}
