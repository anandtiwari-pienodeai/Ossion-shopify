

<div
  class="ossiongram section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>

  {%- if section.settings.heading != blank -%}
    <div class="ossiongram__header">
      <h2 class="ossiongram__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="ossiongram__scroll-area">
    <div class="ossiongram__track">

      {%- for block in section.blocks -%}
        {%- assign bi = forloop.index0 -%}
        {%- assign mid = section.id | append: '-' | append: bi -%}

        {%- assign p1 = all_products[block.settings.product_1] -%}
        {%- assign p2 = all_products[block.settings.product_2] -%}
        {%- assign p3 = all_products[block.settings.product_3] -%}
        {%- assign p4 = all_products[block.settings.product_4] -%}

        {%- assign slot_count = 0 -%}
        {%- if p1.title != blank or block.settings.p1_name != blank -%}{%- assign slot_count = slot_count | plus: 1 -%}{%- endif -%}
        {%- if p2.title != blank or block.settings.p2_name != blank -%}{%- assign slot_count = slot_count | plus: 1 -%}{%- endif -%}
        {%- if p3.title != blank or block.settings.p3_name != blank -%}{%- assign slot_count = slot_count | plus: 1 -%}{%- endif -%}
        {%- if p4.title != blank or block.settings.p4_name != blank -%}{%- assign slot_count = slot_count | plus: 1 -%}{%- endif -%}

        <div class="ossiongram__reel-wrap" {{ block.shopify_attributes }}>

          <!-- Reel Card -->
          <div class="ossiongram__card" data-modal="ossiongram-modal-{{ mid }}" role="button" tabindex="0" aria-label="Open reel viewer">
            <div class="ossiongram__card-media">
              {%- if block.settings.video_url != blank -%}
                <video
                  class="ossiongram__card-video"
                  src="{{ block.settings.video_url }}"
                  autoplay muted loop playsinline
                  preload="metadata"
                ></video>
              {%- elsif block.settings.thumbnail != blank -%}
                {{
                  block.settings.thumbnail
                  | image_url: width: 520
                  | image_tag: loading: 'lazy', class: 'ossiongram__card-img', alt: block.settings.overlay_text
                }}
              {%- else -%}
                <div class="ossiongram__card-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              {%- endif -%}
              <div class="ossiongram__card-overlay" aria-hidden="true"></div>
              {%- if slot_count > 0 -%}
                <div class="ossiongram__card-tag-badge" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                  {{ slot_count }}
                </div>
              {%- endif -%}
              {%- if block.settings.overlay_text != blank -%}
                <p class="ossiongram__card-text">{{ block.settings.overlay_text }}</p>
              {%- endif -%}
            </div>
          </div>

          <!-- Below Card - product info with cycling -->
          {%- if slot_count > 0 -%}
            <div class="ossiongram__below" data-current="0" data-total="{{ slot_count }}">

              {%- if p1.title != blank or block.settings.p1_name != blank -%}
                <div class="ossiongram__slot ossiongram__slot--active">
                  <div class="ossiongram__slot-row">
                    {%- if block.settings.p1_img != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ block.settings.p1_img | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- elsif p1.featured_image != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ p1.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- endif -%}
                    <div class="ossiongram__slot-info">
                      <p class="ossiongram__slot-name">{% if p1.title != blank %}{{ p1.title }}{% else %}{{ block.settings.p1_name }}{% endif %}</p>
                      <p class="ossiongram__slot-price">{% if p1.title != blank %}{{ p1.price | money }}{% else %}{{ block.settings.p1_price }}{% endif %}</p>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if p2.title != blank or block.settings.p2_name != blank -%}
                <div class="ossiongram__slot">
                  <div class="ossiongram__slot-row">
                    {%- if block.settings.p2_img != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ block.settings.p2_img | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- elsif p2.featured_image != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ p2.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- endif -%}
                    <div class="ossiongram__slot-info">
                      <p class="ossiongram__slot-name">{% if p2.title != blank %}{{ p2.title }}{% else %}{{ block.settings.p2_name }}{% endif %}</p>
                      <p class="ossiongram__slot-price">{% if p2.title != blank %}{{ p2.price | money }}{% else %}{{ block.settings.p2_price }}{% endif %}</p>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if p3.title != blank or block.settings.p3_name != blank -%}
                <div class="ossiongram__slot">
                  <div class="ossiongram__slot-row">
                    {%- if block.settings.p3_img != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ block.settings.p3_img | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- elsif p3.featured_image != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ p3.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- endif -%}
                    <div class="ossiongram__slot-info">
                      <p class="ossiongram__slot-name">{% if p3.title != blank %}{{ p3.title }}{% else %}{{ block.settings.p3_name }}{% endif %}</p>
                      <p class="ossiongram__slot-price">{% if p3.title != blank %}{{ p3.price | money }}{% else %}{{ block.settings.p3_price }}{% endif %}</p>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if p4.title != blank or block.settings.p4_name != blank -%}
                <div class="ossiongram__slot">
                  <div class="ossiongram__slot-row">
                    {%- if block.settings.p4_img != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ block.settings.p4_img | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- elsif p4.featured_image != blank -%}
                      <div class="ossiongram__thumb-wrap">
                        {{ p4.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', class: 'ossiongram__thumb-img', alt: '' }}
                      </div>
                    {%- endif -%}
                    <div class="ossiongram__slot-info">
                      <p class="ossiongram__slot-name">{% if p4.title != blank %}{{ p4.title }}{% else %}{{ block.settings.p4_name }}{% endif %}</p>
                      <p class="ossiongram__slot-price">{% if p4.title != blank %}{{ p4.price | money }}{% else %}{{ block.settings.p4_price }}{% endif %}</p>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if slot_count > 1 -%}
                <div class="ossiongram__product-nav">
                  <button class="ossiongram__nav-btn ossiongram__nav-prev" aria-label="Previous product">&#9664;</button>
                  <button class="ossiongram__nav-btn ossiongram__nav-next" aria-label="Next product">&#9654;</button>
                </div>
              {%- endif -%}

            </div>
          {%- endif -%}

        </div>

        <!-- Modal Popup -->
        <div
          class="ossiongram__modal"
          id="ossiongram-modal-{{ mid }}"
          role="dialog"
          aria-modal="true"
          aria-label="Reel viewer"
          hidden
        >
          <div class="ossiongram__modal-overlay" aria-hidden="true"></div>
          <div class="ossiongram__modal-container">

            <button class="ossiongram__modal-close" aria-label="Close reel viewer">&times;</button>

            <!-- Left panel - video -->
            <div class="ossiongram__modal-left">
              <div class="ossiongram__modal-media-wrap">
                {%- if block.settings.video_url != blank -%}
                  <video
                    class="ossiongram__modal-video"
                    src="{{ block.settings.video_url }}"
                    autoplay muted loop playsinline
                  ></video>
                {%- elsif block.settings.thumbnail != blank -%}
                  {{
                    block.settings.thumbnail
                    | image_url: width: 700
                    | image_tag: loading: 'lazy', class: 'ossiongram__modal-img', alt: ''
                  }}
                {%- else -%}
                  <div class="ossiongram__modal-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                {%- endif -%}

                <div class="ossiongram__modal-video-overlay" aria-hidden="true"></div>

                {%- if block.settings.video_url != blank -%}
                  <button class="ossiongram__mute-btn" aria-label="Toggle mute">
                    <svg class="ossiongram__icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <line x1="23" y1="9" x2="17" y2="15"></line>
                      <line x1="17" y1="9" x2="23" y2="15"></line>
                    </svg>
                    <svg class="ossiongram__icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                    </svg>
                  </button>
                {%- endif -%}

                {%- if block.settings.modal_text != blank -%}
                  <p class="ossiongram__modal-text">{{ block.settings.modal_text }}</p>
                {%- endif -%}
              </div>
            </div>

            <!-- Right panel - product cards -->
            <div class="ossiongram__modal-right">
              {%- if slot_count > 0 -%}
                <p class="ossiongram__modal-products-label">Tagged Products</p>
                <div class="ossiongram__modal-products">

                  {%- for slot_index in (0..3) -%}
                    {%- if slot_index == 0 -%}{%- assign mp = p1 -%}{%- assign m_img = block.settings.p1_img -%}{%- assign m_name = block.settings.p1_name -%}{%- assign m_price = block.settings.p1_price -%}{%- assign m_url = block.settings.p1_url -%}{%- endif -%}
                    {%- if slot_index == 1 -%}{%- assign mp = p2 -%}{%- assign m_img = block.settings.p2_img -%}{%- assign m_name = block.settings.p2_name -%}{%- assign m_price = block.settings.p2_price -%}{%- assign m_url = block.settings.p2_url -%}{%- endif -%}
                    {%- if slot_index == 2 -%}{%- assign mp = p3 -%}{%- assign m_img = block.settings.p3_img -%}{%- assign m_name = block.settings.p3_name -%}{%- assign m_price = block.settings.p3_price -%}{%- assign m_url = block.settings.p3_url -%}{%- endif -%}
                    {%- if slot_index == 3 -%}{%- assign mp = p4 -%}{%- assign m_img = block.settings.p4_img -%}{%- assign m_name = block.settings.p4_name -%}{%- assign m_price = block.settings.p4_price -%}{%- assign m_url = block.settings.p4_url -%}{%- endif -%}

                    {%- unless mp.title != blank or m_name != blank -%}{%- continue -%}{%- endunless -%}

                    {%- assign mp_on_sale = false -%}
                    {%- if mp.compare_at_price > mp.price -%}{%- assign mp_on_sale = true -%}{%- endif -%}

                    <div class="ossiongram__modal-product">
                      <a href="{% if mp.url != blank %}{{ mp.url }}{% elsif m_url != blank %}{{ m_url }}{% endif %}" class="ossiongram__modal-product-img-link">
                        {%- if m_img != blank -%}
                          {{ m_img | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ossiongram__modal-product-img', alt: mp.title | default: m_name }}
                        {%- elsif mp.featured_image != blank -%}
                          {{ mp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ossiongram__modal-product-img', alt: mp.title }}
                        {%- else -%}
                          <div class="ossiongram__modal-product-img ossiongram__modal-product-img--placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                        {%- endif -%}
                        {%- if mp_on_sale -%}
                          <span class="ossiongram__modal-product-sale-badge">Sale</span>
                        {%- endif -%}
                      </a>
                      <div class="ossiongram__modal-product-body">
                        {%- if mp.vendor != blank -%}
                          <span class="ossiongram__modal-product-vendor">{{ mp.vendor }}</span>
                        {%- endif -%}
                        <p class="ossiongram__modal-product-name">{% if mp.title != blank %}{{ mp.title }}{% else %}{{ m_name }}{% endif %}</p>
                        <div class="ossiongram__modal-product-price-row">
                          <span class="ossiongram__modal-product-price{% if mp_on_sale %} ossiongram__modal-product-price--sale{% endif %}">
                            {% if mp.title != blank %}{{ mp.price | money }}{% else %}{{ m_price }}{% endif %}
                          </span>
                          {%- if mp_on_sale -%}
                            <span class="ossiongram__modal-product-compare-price">{{ mp.compare_at_price | money }}</span>
                          {%- endif -%}
                        </div>
                        {%- if mp.title != blank -%}
                          {% form 'product', mp, class: 'ossiongram__modal-product-form' %}
                            <input type="hidden" name="id" value="{{ mp.selected_or_first_available_variant.id }}">
                            <button
                              type="submit"
                              class="ossiongram__modal-product-btn"
                              {% unless mp.available %}disabled{% endunless %}
                            >
                              {%- if mp.available -%}
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                Add to Cart
                              {%- else -%}
                                Sold Out
                              {%- endif -%}
                            </button>
                          {% endform %}
                        {%- elsif m_url != blank -%}
                          <a href="{{ m_url }}" class="ossiongram__modal-product-btn">View Product</a>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}

                </div>
              {%- endif -%}
            </div>

          </div>
        </div>

      {%- endfor -%}
    </div>
  </div>

</div>

{% stylesheet %}

  .ossiongram {
    background: #fff;
    overflow: hidden;
  }


  .ossiongram__header {
    text-align: center;
    padding: 0 24px 48px;
  }

  .ossiongram__heading {
    font-family: var(--font-h2--family, Georgia, serif);
    font-style: var(--font-h2--style, normal);
    font-weight: 300;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.06em;
    color: #101828;
    margin: 0;
    line-height: 1.2;
  }

 
  .ossiongram__scroll-area {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 40px 16px;
  }

  .ossiongram__scroll-area::-webkit-scrollbar { display: none; }

  .ossiongram__track {
    display: flex;
    gap: 20px;
    width: max-content;
    align-items: flex-start;
  }

  /* -- Reel wrap (card + below) -------------------------- */
  .ossiongram__reel-wrap {
    flex-shrink: 0;
    width: 230px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }


  .ossiongram__card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    display: block;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ossiongram__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.15), 0 4px 8px -2px rgba(0, 0, 0, 0.08);
  }

  .ossiongram__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #101828;
  }

  .ossiongram__card-video,
  .ossiongram__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .ossiongram__card:hover .ossiongram__card-video,
  .ossiongram__card:hover .ossiongram__card-img {
    transform: scale(1.03);
  }

  .ossiongram__card-placeholder {
    width: 100%;
    height: 100%;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ossiongram__card-placeholder svg { width: 72px; height: 72px; opacity: 0.2; }

  .ossiongram__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 24, 40, 0.72) 0%, rgba(16, 24, 40, 0.12) 45%, rgba(16, 24, 40, 0) 72%);
    pointer-events: none;
  }

  .ossiongram__card-tag-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(16, 24, 40, 0.65);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 9px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 5px;
    pointer-events: none;
    z-index: 5;
    letter-spacing: 0.01em;
  }

  .ossiongram__card-text {
    position: absolute;
    bottom: 20px;
    left: 14px;
    right: 14px;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #fff;
    pointer-events: none;
  }

  
  .ossiongram__slot { display: none; }
  .ossiongram__slot--active { display: block; }

  .ossiongram__slot-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .ossiongram__thumb-wrap {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    overflow: hidden;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
  }

  .ossiongram__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ossiongram__slot-info { flex: 1; min-width: 0; }

  .ossiongram__slot-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #101828;
    margin: 0 0 4px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ossiongram__slot-price {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0;
  }

  .ossiongram__product-nav {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 10px;
  }

  .ossiongram__nav-btn {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    width: 28px;
    height: 28px;
    cursor: pointer;
    font-size: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #374151;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
    padding: 0;
  }

  .ossiongram__nav-btn:hover {
    background: #f3f4f6;
    border-color: #1e3a5f;
    color: #1e3a5f;
  }

  /* -- Modal --------------------------------------------- */
  .ossiongram__modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ossiongram__modal[hidden] { display: none; }

  .ossiongram__modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(16, 24, 40, 0.85);
    cursor: pointer;
  }

  .ossiongram__modal-container {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: stretch;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    width: 100%;
    max-width: 880px;
    max-height: 88vh;
    box-shadow: 0 25px 50px -12px rgba(16, 24, 40, 0.45);
  }

  /* Close button */
  .ossiongram__modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 20;
    background: rgba(16, 24, 40, 0.45);
    border: none;
    color: #fff;
    font-size: 1.25rem;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: background 0.2s;
  }

  .ossiongram__modal-close:hover { background: rgba(16, 24, 40, 0.7); }

  /* Left panel */
  .ossiongram__modal-left {
    flex-shrink: 0;
    width: 320px;
    background: #101828;
    position: relative;
  }

  .ossiongram__modal-media-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ossiongram__modal-video,
  .ossiongram__modal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ossiongram__modal-placeholder {
    width: 100%;
    height: 100%;
    background: #1a2535;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ossiongram__modal-placeholder svg { width: 80px; height: 80px; opacity: 0.18; }

  .ossiongram__modal-video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(16, 24, 40, 0.55) 0%, rgba(16, 24, 40, 0) 55%);
    pointer-events: none;
  }

  /* Mute button - top-center of video */
  .ossiongram__mute-btn {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background: rgba(16, 24, 40, 0.5);
    border: none;
    color: #fff;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, opacity 0.2s;
  }

  .ossiongram__mute-btn:hover { background: rgba(16, 24, 40, 0.75); }

  .ossiongram__modal-text {
    position: absolute;
    bottom: 24px;
    left: 16px;
    right: 16px;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #fff;
    text-shadow: 0 1px 8px rgba(16, 24, 40, 0.6);
    pointer-events: none;
    z-index: 5;
  }

  /* Right panel */
  .ossiongram__modal-right {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    padding: 28px 24px;
    scrollbar-width: thin;
    scrollbar-color: #e5e7eb transparent;
  }

  .ossiongram__modal-right::-webkit-scrollbar { width: 4px; }
  .ossiongram__modal-right::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 4px; }

  .ossiongram__modal-products-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #9ca3af;
    margin: 0 0 14px;
  }

  .ossiongram__modal-products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .ossiongram__modal-product {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .ossiongram__modal-product:hover {
    box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .ossiongram__modal-product-img-link {
    display: block;
    position: relative;
    text-decoration: none;
    flex-shrink: 0;
  }

  .ossiongram__modal-product-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #f3f4f6;
    display: block;
    transition: transform 0.3s;
  }

  .ossiongram__modal-product:hover .ossiongram__modal-product-img { transform: scale(1.04); }

  .ossiongram__modal-product-img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ossiongram__modal-product-img--placeholder svg { width: 50px; height: 50px; opacity: 0.18; }

  .ossiongram__modal-product-sale-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #dc2626;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .ossiongram__modal-product-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    flex: 1;
  }

  .ossiongram__modal-product-vendor {
    font-size: 0.65rem;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ossiongram__modal-product-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #101828;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ossiongram__modal-product-price-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .ossiongram__modal-product-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e3a5f;
  }

  .ossiongram__modal-product-price--sale { color: #dc2626; }

  .ossiongram__modal-product-compare-price {
    font-size: 0.75rem;
    color: #9ca3af;
    text-decoration: line-through;
    font-weight: 500;
  }

  .ossiongram__modal-product-form { margin-top: auto; }

  .ossiongram__modal-product-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin-top: auto;
    background: #1e3a5f;
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 9px 8px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .ossiongram__modal-product-btn:hover { opacity: 0.85; color: #fff; }
  .ossiongram__modal-product-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  /* -- Mobile -------------------------------------------- */
  @media screen and (max-width: 749px) {
    .ossiongram__modal-container {
      flex-direction: column;
      max-height: 92vh;
    }

    .ossiongram__modal-left {
      width: 100%;
      flex-shrink: 0;
      height: 52vw;
      max-height: 280px;
      position: relative;
    }

    .ossiongram__modal-right { padding: 16px; }

    .ossiongram__modal-products { gap: 12px; }

    .ossiongram__reel-wrap { width: 185px; }

    .ossiongram__scroll-area { padding: 0 16px 16px; }
  }

  @media screen and (max-width: 479px) {
    .ossiongram__reel-wrap { width: 158px; }
  }
{% endstylesheet %}

<script>
(function () {
  function initossiongram(scope) {
    /* -- Product cycling below each card -- */
    scope.querySelectorAll('.ossiongram__below').forEach(function (below) {
      var slots = Array.from(below.querySelectorAll('.ossiongram__slot'));
      if (slots.length < 2) return;

      var current = 0;

      function goTo(idx) {
        slots[current].classList.remove('ossiongram__slot--active');
        current = (idx + slots.length) % slots.length;
        slots[current].classList.add('ossiongram__slot--active');
      }

      var prev = below.querySelector('.ossiongram__nav-prev');
      var next = below.querySelector('.ossiongram__nav-next');
      if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); goTo(current - 1); });
      if (next) next.addEventListener('click', function (e) { e.stopPropagation(); goTo(current + 1); });
    });

    /* -- Modal open -- */
    scope.querySelectorAll('.ossiongram__card').forEach(function (card) {
      function openFromCard() {
        var modal = document.getElementById(card.dataset.modal);
        if (!modal) return;
        openModal(modal);
      }
      card.addEventListener('click', openFromCard);
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openFromCard(); }
      });
    });

    /* -- Modal close - overlay + x -- */
    scope.querySelectorAll('.ossiongram__modal-overlay, .ossiongram__modal-close').forEach(function (el) {
      el.addEventListener('click', function () {
        var modal = el.closest('.ossiongram__modal');
        if (modal) closeModal(modal);
      });
    });

    /* -- Mute toggle -- */
    scope.querySelectorAll('.ossiongram__mute-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var modal = btn.closest('.ossiongram__modal');
        var video = modal && modal.querySelector('.ossiongram__modal-video');
        if (!video) return;
        video.muted = !video.muted;
        setMuteIcon(modal, video.muted);
      });
    });

    /* -- ESC to close -- */
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      scope.querySelectorAll('.ossiongram__modal:not([hidden])').forEach(closeModal);
    });
  }

  function openModal(modal) {
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    var video = modal.querySelector('.ossiongram__modal-video');
    if (video) {
      video.muted = true;
      video.currentTime = 0;
      video.play().catch(function () {});
      setMuteIcon(modal, true);
    }
  }

  function closeModal(modal) {
    modal.hidden = true;
    document.body.style.overflow = '';
    var video = modal.querySelector('.ossiongram__modal-video');
    if (video) video.pause();
  }

  function setMuteIcon(modal, isMuted) {
    var muted   = modal.querySelector('.ossiongram__icon-muted');
    var unmuted = modal.querySelector('.ossiongram__icon-unmuted');
    if (muted)   muted.hidden   = !isMuted;
    if (unmuted) unmuted.hidden =  isMuted;
  }

  /* Support Shopify theme editor re-renders */
  document.addEventListener('shopify:section:load', function (e) {
    var section = e.target.querySelector('.ossiongram');
    if (section) initossiongram(section);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.ossiongram').forEach(initossiongram);
    });
  } else {
    document.querySelectorAll('.ossiongram').forEach(initossiongram);
  }
})();
</script>

