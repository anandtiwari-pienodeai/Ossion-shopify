{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_filter_count = 0
  for filter in collection.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign active_filter_count = active_filter_count | plus: 1
        endif
      when 'boolean'
        if filter.active_values.size > 0
          assign active_filter_count = active_filter_count | plus: 1
        endif
      else
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endcase
  endfor
-%}

<script
  src="{{ 'ossian-plp.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  class="ossian-plp color-{{ section.settings.color_scheme }}{% if section.settings.product_grid_width == 'full-width' %} ossian-plp--full-width{% endif %}{% if section.settings.full_width_on_mobile %} ossian-plp--full-width-mobile{% endif %}"
  id="OssianPlp-{{ section.id }}"
  data-ossian-plp
  style="
    --ossian-plp-padding-block-start: {{ section.settings.padding-block-start }}px;
    --ossian-plp-padding-block-end: {{ section.settings.padding-block-end }}px;
    --ossian-plp-gap-h: {{ section.settings.columns_gap_horizontal }}px;
    --ossian-plp-gap-v: {{ section.settings.columns_gap_vertical }}px;
    --ossian-plp-columns-desktop: {{ desktop_columns }};
    --ossian-plp-columns-mobile: {{ mobile_columns }};
  "
>
  {% render 'skip-to-content-link', href: '#OssianPlpGrid-', append: section.id, text: 'accessibility.skip_to_results_list' %}

  <div class="ossian-plp__toolbar">
    <button type="button" class="ossian-plp__filter-toggle" data-ossian-plp-drawer-open aria-haspopup="dialog">
      {{ 'icon-filter.svg' | inline_asset_content }}
      Filters
      {%- if active_filter_count > 0 -%}
        <span class="ossian-plp__filter-count">{{ active_filter_count }}</span>
      {%- endif -%}
    </button>

    <p class="ossian-plp__count" role="status">
      {{ 'content.item_count' | t: count: collection.products_count }}
    </p>

    <div class="ossian-plp__sort">
      <label for="OssianPlpSort-{{ section.id }}" class="visually-hidden">{{ 'actions.sort' | t }}</label>
      <select
        id="OssianPlpSort-{{ section.id }}"
        name="sort_by"
        form="OssianPlpFilterForm-{{ section.id }}"
        data-ossian-plp-sort
        class="ossian-plp__sort-select"
      >
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>

      {%- comment -%}
        Styled sort menu. ossian-plp.js reveals it and hides the native select (kept as the no-JS fallback);
        choosing an option sets the select's value, which submits the filter form as before.
      {%- endcomment -%}
      {%- assign current_sort_name = '' -%}
      {%- for option in collection.sort_options -%}
        {%- if option.value == sort_by -%}{%- assign current_sort_name = option.name -%}{%- endif -%}
      {%- endfor -%}
      <div class="ossian-plp__sort-menu" data-ossian-sort-menu hidden>
        <button
          type="button"
          class="ossian-plp__sort-trigger"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="OssianPlpSortList-{{ section.id }}"
          data-ossian-sort-trigger
        >
          <span class="ossian-plp__sort-label">{{ 'content.ossian_plp.sort_by' | t }}</span>
          <span class="ossian-plp__sort-value" data-ossian-sort-current>{{ current_sort_name | default: collection.sort_options.first.name }}</span>
          <svg class="ossian-plp__sort-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <ul
          id="OssianPlpSortList-{{ section.id }}"
          class="ossian-plp__sort-list"
          role="listbox"
          tabindex="-1"
          aria-label="{{ 'content.ossian_plp.sort_by' | t }}"
          data-ossian-sort-list
          hidden
        >
          {%- for option in collection.sort_options -%}
            <li
              id="OssianPlpSortOption-{{ section.id }}-{{ forloop.index }}"
              class="ossian-plp__sort-option"
              role="option"
              data-value="{{ option.value }}"
              aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
            >
              <svg class="ossian-plp__sort-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
              <span>{{ option.name }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>

  <div class="ossian-plp__body">
    <div class="ossian-plp__backdrop" data-ossian-plp-backdrop data-ossian-plp-drawer-close></div>

    <aside class="ossian-plp__filters" data-ossian-plp-drawer aria-label="{{ 'accessibility.filters' | t }}">
      <div class="ossian-plp__filters-head">
        <span class="ossian-plp__filters-title">{{ 'content.filters' | t }}</span>
        <button type="button" class="ossian-plp__filters-close" data-ossian-plp-drawer-close aria-label="{{ 'actions.close' | t }}">
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <form
        id="OssianPlpFilterForm-{{ section.id }}"
        action="{{ collection.url }}"
        method="get"
        class="ossian-plp__filters-form"
        data-ossian-plp-form
      >
        {%- if collection.filters.size == 0 -%}
          <p class="ossian-plp__filters-empty">No filters available.</p>
        {%- endif -%}

        {%- for filter in collection.filters -%}
          {%- liquid
            # Groups start collapsed; a group opens when it already has an active selection
            assign filter_active = false
            if filter.type == 'price_range'
              if filter.min_value.value != blank or filter.max_value.value != blank
                assign filter_active = true
              endif
            elsif filter.active_values.size > 0
              assign filter_active = true
            endif
          -%}
          <details class="ossian-plp__filter-group"{% if filter_active %} open{% endif %}>
            <summary class="ossian-plp__filter-title">
              <span>{{ filter.label }}</span>
              {%- if filter_active and filter.type != 'price_range' -%}
                <span class="ossian-plp__filter-active-count">{{ filter.active_values.size }}</span>
              {%- endif -%}
              <svg class="ossian-plp__filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>

            {%- case filter.type -%}
              {%- when 'list' -%}
                <div class="ossian-plp__filter-options">
                  {%- for value in filter.values -%}
                    {%- assign is_soldout = false -%}
                    {%- if value.count == 0 and value.active == false -%}
                      {%- assign is_soldout = true -%}
                    {%- endif -%}
                    <label class="ossian-plp__filter-option{% if is_soldout %} is-disabled{% endif %}">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}checked{% endif %}
                        {% if is_soldout %}disabled{% endif %}
                      >
                      <span class="ossian-plp__filter-option-label">{{ value.label }}</span>
                      <span class="ossian-plp__filter-option-count">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- when 'boolean' -%}
                {%- assign bool_value = filter.values.first -%}
                <div class="ossian-plp__filter-options">
                  <label class="ossian-plp__filter-option">
                    <input
                      type="checkbox"
                      name="{{ bool_value.param_name }}"
                      value="{{ bool_value.value }}"
                      {% if bool_value.active %}checked{% endif %}
                    >
                    <span class="ossian-plp__filter-option-label">{{ bool_value.label | default: filter.label }}</span>
                  </label>
                </div>

              {%- when 'price_range' -%}
                <div class="ossian-plp__price-inputs">
                  <label class="ossian-plp__price-field">
                    <span class="ossian-plp__price-currency">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      min="0"
                      step="0.01"
                      name="{{ filter.min_value.param_name }}"
                      value="{{ filter.min_value.value | money_without_currency }}"
                      placeholder="0"
                      aria-label="{{ 'accessibility.price_filter_low' | t }}"
                    >
                  </label>
                  <span class="ossian-plp__price-sep">{{ 'fields.separator' | t }}</span>
                  <label class="ossian-plp__price-field">
                    <span class="ossian-plp__price-currency">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      inputmode="decimal"
                      min="0"
                      step="0.01"
                      name="{{ filter.max_value.param_name }}"
                      value="{{ filter.max_value.value | money_without_currency }}"
                      placeholder="{{ filter.range_max | money_without_currency }}"
                      aria-label="{{ 'accessibility.price_filter_high' | t }}"
                    >
                  </label>
                </div>
                {%- assign formatted_range_max = filter.range_max | money -%}
                <p class="ossian-plp__price-hint">
                  {{ 'content.price_filter_html' | t: price: formatted_range_max }}
                </p>
            {%- endcase -%}
          </details>
        {%- endfor -%}

        <div class="ossian-plp__filters-actions">
          <a href="{{ collection.url }}{% if sort_by %}?sort_by={{ sort_by }}{% endif %}" class="ossian-plp__clear-all">
            {{ 'actions.clear_all' | t }}
          </a>
          <button type="submit" class="ossian-plp__apply">
            {{ 'actions.see_items' | t: count: collection.products_count }}
          </button>
        </div>
      </form>
    </aside>

    <div class="ossian-plp__grid-wrap">
      {%- paginate collection.products by products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div class="ossian-plp__empty">
            <h2 class="ossian-plp__empty-title">{{ 'content.no_products_found' | t }}</h2>
            <p>{{ 'content.use_fewer_filters_html' | t: link: collection.url }}</p>
          </div>
        {%- else -%}
          <ul class="ossian-plp__grid" id="OssianPlpGrid-{{ section.id }}" role="list">
            {%- for product in collection.products -%}
              <li class="ossian-plp__grid-item">
                {%- render 'ossian-plp-card', product: product, section_id: section.id -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- render 'pagination-controls', paginate: paginate -%}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": []
}
{% endschema %}
