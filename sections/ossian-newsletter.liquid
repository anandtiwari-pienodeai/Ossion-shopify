{% comment %}
  Section contract.
  Newsletter banner: rounded card over a soft background image (separate
  desktop / mobile pickers, bundled art as fallback) with eyebrow, two-tone
  heading, text, an email signup form and a row of benefit icons. Signups
  are saved as customers tagged "newsletter".
  @example
  <!-- Homepage → Add section → Ossian Newsletter -->
{% endcomment %}

{%- liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign form_id = 'ossian-newsletter-' | append: section.id

  if section.settings.background_image != blank
    assign bg_desktop = section.settings.background_image | image_url: width: 2400
  else
    assign bg_desktop = 'ossion-newsletter-bg.jpg' | asset_url
  endif
  # Desktop and mobile backgrounds are independent: each uses its own picker or its own bundled art
  if section.settings.background_image_mobile != blank
    assign bg_mobile = section.settings.background_image_mobile | image_url: width: 1000
  else
    assign bg_mobile = 'ossion-newsletter-bg-mobile.jpg' | asset_url
  endif

  assign heading_html = section.settings.heading | escape | replace: '[', '<span class="onl__accent">' | replace: ']', '</span>' | replace: '|', '<br>'
-%}

<section
  class="onl"
  id="onl-{{ section.id }}"
  style="
    --onl-bg-desktop: url('{{ bg_desktop }}');
    --onl-bg-mobile: url('{{ bg_mobile }}');
    --onl-page-bg: {{ section.settings.page_background }};
  "
>
  <div class="onl__wrap">
    <div class="onl__card">
      {%- if section.settings.show_sparkles -%}
        <svg class="onl__sparkle onl__sparkle--start" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0c.6 5.6 3.4 10.4 12 12-8.6 1.6-11.4 6.4-12 12-.6-5.6-3.4-10.4-12-12 8.6-1.6 11.4-6.4 12-12Z"/></svg>
        <svg class="onl__sparkle onl__sparkle--end" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0c.6 5.6 3.4 10.4 12 12-8.6 1.6-11.4 6.4-12 12-.6-5.6-3.4-10.4-12-12 8.6-1.6 11.4-6.4 12-12Z"/></svg>
      {%- endif -%}

      <div class="onl__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="onl__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="onl__heading">{{ heading_html }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="onl__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="onl__form-area">
        {%- form 'customer', id: form_id, class: 'onl__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="onl__msg onl__msg--success" role="status" tabindex="-1" autofocus>
              {{ 'content.ossian_newsletter.success' | t }}
            </p>
          {%- else -%}
            <div class="onl__field">
              <label class="visually-hidden" for="{{ form_id }}-email">{{ 'content.ossian_newsletter.email_label' | t }}</label>
              <svg class="onl__field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <input
                class="onl__input"
                type="email"
                id="{{ form_id }}-email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder="{{ section.settings.placeholder | escape }}"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="{{ form_id }}-error"
                {% endif %}
              >
              <button type="submit" class="onl__submit">
                {{ section.settings.button_label | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="onl__msg onl__msg--error" id="{{ form_id }}-error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if feature_blocks.size > 0 -%}
        <ul class="onl__features" role="list">
          {%- for block in feature_blocks -%}
            <li class="onl__feature" {{ block.shopify_attributes }}>
              <span class="onl__feature-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'bell' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9Z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
                  {%- when 'document' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
                  {%- when 'sparkle' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3c.5 4.7 2.8 7.5 7.5 9-4.7 1.5-7 4.3-7.5 9-.5-4.7-2.8-7.5-7.5-9 4.7-1.5 7-4.3 7.5-9Z"/></svg>
                  {%- when 'tag' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8S10.5 3.5 8 4.2C6 4.8 7 8 12 8Zm0 0s1.5-4.5 4-3.8c2 .6 1 3.8-4 3.8Z"/></svg>
                {%- endcase -%}
              </span>
              <span class="onl__feature-title">{{ block.settings.title | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.onl {
  --onl-ink: #13233f;
  --onl-navy: #0b2456;
  --onl-accent: #2f6fd6;
  --onl-muted: #4b5568;
  background: var(--onl-page-bg, #fff);
  padding-block: 40px;
}

.onl__wrap {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 16px;
}

.onl__card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(400px, 1fr) minmax(400px, 1.05fr) auto;
  align-items: center;
  gap: 32px clamp(20px, 2.5vw, 48px);
  padding: 40px clamp(28px, 4vw, 120px);
  border-radius: 20px;
  background: #eef4fd var(--onl-bg-desktop) center / cover no-repeat;
}

.onl__sparkle {
  position: absolute;
  z-index: -1;
  width: 32px;
  height: 32px;
  fill: #2f6fd6;
}

.onl__sparkle--start { top: 18px; inset-inline-start: 18px; width: 26px; height: 26px; }
.onl__sparkle--end { top: 82px; inset-inline-end: 30px; width: 26px; height: 26px; }

/* Copy */
.onl__copy { min-width: 0; }

.onl__eyebrow {
  margin: 0 0 10px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--onl-accent);
}

.onl__heading {
  margin: 0 0 12px;
  font-size: clamp(1.25rem, 1.65vw, 1.95rem);
  font-weight: 800;
  line-height: 1.2;
  color: var(--onl-ink);
  overflow-wrap: break-word;
}

.onl__accent { color: var(--onl-accent); white-space: nowrap; }

.onl__text {
  margin: 0;
  max-width: 48ch;
  font-size: 1rem;
  line-height: 1.5;
  color: var(--onl-muted);
}

/* Form */
.onl__form-area { min-width: 0; }

.onl__field {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px;
  padding-inline-start: 52px;
  border-radius: 999px;
  background: #fff;
  box-shadow: 0 12px 30px rgba(20, 40, 74, 0.1);
}

.onl__field:focus-within { box-shadow: 0 0 0 3px rgba(47, 111, 214, 0.25), 0 12px 30px rgba(20, 40, 74, 0.1); }

.onl__field-icon {
  position: absolute;
  inset-inline-start: 20px;
  top: 50%;
  width: 22px;
  height: 22px;
  color: #6b7587;
  transform: translateY(-50%);
  pointer-events: none;
}

.onl__input {
  flex: 1;
  min-width: 0;
  min-height: 56px;
  padding: 0 8px 0 0;
  border: 0;
  background: transparent;
  color: var(--onl-ink);
  font: inherit;
  font-size: 1rem;
}

.onl__input::placeholder { color: #6b7587; }
.onl__input:focus { outline: none; }

.onl__submit {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  min-height: 56px;
  padding: 0 24px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #0d2a63 0%, #071a3f 100%);
  color: #fff;
  font: inherit;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: filter 0.2s ease;
}

.onl__submit svg { width: 20px; height: 20px; }
.onl__submit:hover { filter: brightness(1.15); }
.onl__submit:focus-visible { outline: 2px solid var(--onl-accent); outline-offset: 3px; }
[dir='rtl'] .onl__submit svg { transform: scaleX(-1); }

.onl__msg { margin: 10px 0 0; padding-inline: 20px; font-size: 0.9rem; }
.onl__msg--success { margin: 0; padding: 18px 24px; border-radius: 999px; background: #fff; color: #1d6b38; font-weight: 600; }
.onl__msg--error { color: #a12a1f; }

/* Benefits */
.onl__features {
  display: flex;
  gap: 20px;
  margin: 0;
  padding-block: 16px;
  padding-inline: 32px 0;
  list-style: none;
  border-inline-start: 1px solid rgba(19, 35, 63, 0.12);
}

.onl__feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  width: 92px;
  text-align: center;
}

.onl__feature-icon {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #dfe9f9;
  color: var(--onl-accent);
}

.onl__feature-icon svg { width: 30px; height: 30px; }

.onl__feature-title {
  font-size: 0.95rem;
  line-height: 1.3;
  color: var(--onl-ink);
}

/* Tablet: copy + form on top, benefits below */
@media (max-width: 1279px) {
  .onl__card {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding: 36px 48px;
  }

  .onl__features {
    grid-column: 1 / -1;
    justify-content: center;
    padding: 20px 0 0;
    border-inline-start: 0;
    border-top: 1px solid rgba(19, 35, 63, 0.12);
  }
}

/* Mobile: single column, mobile background */
@media (max-width: 749px) {
  .onl { padding-block: 24px; }

  .onl__card {
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    padding: 32px 20px 26px;
    border-radius: 16px;
    background-image: var(--onl-bg-mobile);
    background-position: center;
    text-align: center;
  }

  .onl__sparkle--start { top: 18px; inset-inline-start: 16px; width: 22px; height: 22px; }
  .onl__sparkle--end { top: auto; bottom: 22px; inset-inline-end: 14px; width: 18px; height: 18px; }

  .onl__eyebrow { font-size: 0.7rem; }
  .onl__heading { font-size: 1.45rem; }
  .onl__text { margin-inline: auto; font-size: 0.92rem; }

  /* Stacked field + full-width button keeps both easy to tap */
  .onl__field {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .onl__field:focus-within { box-shadow: none; }

  .onl__field-icon { top: 26px; inset-inline-start: 18px; transform: translateY(-50%); }

  .onl__input {
    min-height: 52px;
    padding: 0 18px;
    padding-inline-start: 50px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(20, 40, 74, 0.08);
  }

  .onl__input:focus-visible { outline: 2px solid var(--onl-accent); outline-offset: 2px; }

  .onl__submit { justify-content: center; min-height: 52px; }

  .onl__features {
    justify-content: space-between;
    gap: 8px;
    padding-top: 18px;
  }

  .onl__feature { width: auto; flex: 1; gap: 8px; }
  .onl__feature-icon { width: 52px; height: 52px; }
  .onl__feature-icon svg { width: 24px; height: 24px; }
  .onl__feature-title { font-size: 0.82rem; }
}

@media (prefers-reduced-motion: reduce) {
  .onl__submit { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossian Newsletter",
  "tag": "div",
  "class": "section-ossian-newsletter",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Desktop background", "info": "Wide image (about 2000 × 670). Keep the middle calm. Defaults to the bundled Ossion art." },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Mobile background", "info": "Portrait image (about 940 × 1670). Defaults to the bundled Ossion mobile art." },
    { "type": "checkbox", "id": "show_sparkles", "label": "Show sparkle accents", "default": true },
    { "type": "color", "id": "page_background", "label": "Area around the card", "default": "#ffffff" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay Connected" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] for the blue accent. Use | for a line break.", "default": "Get Beauty Tips,|New Launches & [Exclusive Offers]" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe to our newsletter and be the first to know about new products, expert tips and special offers." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gift",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "bell", "label": "Bell" },
            { "value": "document", "label": "Document" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "tag", "label": "Tag" },
            { "value": "truck", "label": "Delivery truck" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Exclusive Offers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossian Newsletter",
      "blocks": [
        { "type": "feature", "settings": { "icon": "gift", "title": "Exclusive Offers" } },
        { "type": "feature", "settings": { "icon": "bell", "title": "New Launches" } },
        { "type": "feature", "settings": { "icon": "document", "title": "Expert Beauty Tips" } }
      ]
    }
  ]
}
{% endschema %}
