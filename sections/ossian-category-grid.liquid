<div
  class="ossian-category-grid section color-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="ossian-category-grid__header">
        {% if section.settings.heading != blank %}
          <h2 class="ossian-category-grid__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ossian-category-grid__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ossian-category-grid__grid">
      {% for block in section.blocks %}
        {% assign col = collections[block.settings.collection] %}
        {% if col != blank %}
          {% assign card_url   = col.url %}
          {% assign card_title = col.title %}
          {% assign card_image = col.featured_image %}
        {% else %}
          {% assign card_url   = block.settings.link %}
          {% assign card_title = block.settings.title %}
          {% assign card_image = block.settings.image %}
        {% endif %}
        <a href="{{ card_url }}" class="ossian-category-grid__card" {{ block.shopify_attributes }}>
          <div class="ossian-category-grid__image-wrap">
            {% if card_image != blank %}
              {{ card_image | image_url: width: 572 | image_tag: loading: 'lazy', class: 'ossian-category-grid__image', alt: card_title }}
            {% else %}
              <div class="ossian-category-grid__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
            {% endif %}
          </div>
          <div class="ossian-category-grid__label">
            <span>{{ card_title }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ossian-category-grid__header {
    text-align: center;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ossian-category-grid__title {
    font-size: 2.25rem;
    font-weight: 700;
    margin: 0;
    color: #101828;
  }

  .ossian-category-grid__subtitle {
    font-size: 1.125rem;
    color: #4a5565;
    margin: 0;
  }

  .ossian-category-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 989px) {
    .ossian-category-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 499px) {
    .ossian-category-grid__grid {
      gap: 12px;
    }
    .ossian-category-grid__title {
      font-size: 1.75rem;
    }
  }

  .ossian-category-grid__card {
    text-decoration: none;
    display: block;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .ossian-category-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.15);
  }

  .ossian-category-grid__image-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .ossian-category-grid__image,
  .ossian-category-grid__image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .ossian-category-grid__card:hover .ossian-category-grid__image {
    transform: scale(1.05);
  }

  .ossian-category-grid__label {
    padding: 16px;
    text-align: center;
  }

  .ossian-category-grid__label span {
    font-size: 1.125rem;
    font-weight: 600;
    color: #101828;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override title (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Override link (optional)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Discover the perfect products for your hair care needs"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Hair Color" } },
        { "type": "category", "settings": { "title": "Lightening" } },
        { "type": "category", "settings": { "title": "Straightening" } },
        { "type": "category", "settings": { "title": "Treatment" } }
      ]
    }
  ]
}
{% endschema %}
