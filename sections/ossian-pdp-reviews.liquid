{{ 'section-ossian-pdp-reviews.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Ossian PDP Reviews — horizontally scrolling customer review carousel.
  Reviews are theme blocks, so placeholder content can be shipped before the
  store has real Judge.me data. See the Judge.me override at the end of the
  stylesheet for the app widget itself.
{%- endcomment -%}

{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
{%- assign review_count = review_blocks.size -%}

{%- assign total_score = 0 -%}
{%- assign c5 = 0 -%}
{%- assign c4 = 0 -%}
{%- assign c3 = 0 -%}
{%- assign c2 = 0 -%}
{%- assign c1 = 0 -%}
{%- for block in review_blocks -%}
  {%- assign r = block.settings.rating | times: 1 -%}
  {%- assign total_score = total_score | plus: r -%}
  {%- case r -%}
    {%- when 5 -%}{%- assign c5 = c5 | plus: 1 -%}
    {%- when 4 -%}{%- assign c4 = c4 | plus: 1 -%}
    {%- when 3 -%}{%- assign c3 = c3 | plus: 1 -%}
    {%- when 2 -%}{%- assign c2 = c2 | plus: 1 -%}
    {%- else -%}{%- assign c1 = c1 | plus: 1 -%}
  {%- endcase -%}
{%- endfor -%}

{%- if review_count > 0 -%}
  {%- assign avg_raw = total_score | times: 1.0 | divided_by: review_count -%}
  {%- assign avg_display = avg_raw | round: 1 -%}
  {%- assign avg_stars = avg_raw | round -%}
{%- else -%}
  {%- assign avg_display = 0 -%}
  {%- assign avg_stars = 0 -%}
{%- endif -%}

{%- capture star_svg -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.47 5.01 5.53.81-4 3.9.94 5.51L10 14.13l-4.94 2.6.94-5.51-4-3.9 5.53-.81z"/></svg>{%- endcapture -%}

<section class="opr" id="opr-{{ section.id }}" data-opr>
  <div class="page-width opr__inner">

    <div class="opr__header">
      <div class="opr__headings">
        {%- if section.settings.eyebrow != blank -%}
          <p class="opr__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="opr__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if review_count > 0 -%}
        <div class="opr__summary">
          <div class="opr__score">
            <span class="opr__score-num">{{ avg_display }}</span>
            <span class="opr__score-out">/ 5</span>
          </div>
          <div class="opr__score-meta">
            <div class="opr__stars opr__stars--lg" role="img" aria-label="{{ avg_display }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="opr__star{% if i > avg_stars %} opr__star--empty{% endif %}">{{ star_svg }}</span>
              {%- endfor -%}
            </div>
            <p class="opr__count">
              {%- if review_count == 1 -%}
                Based on 1 review
              {%- else -%}
                Based on {{ review_count }} reviews
              {%- endif -%}
            </p>
          </div>

          <div class="opr__bars">
            {%- assign bar_counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
            {%- for bar_count in bar_counts -%}
              {%- assign star_label = 5 | minus: forloop.index0 -%}
              {%- assign pct = bar_count | times: 100 | divided_by: review_count -%}
              <div class="opr__bar-row">
                <span class="opr__bar-label">{{ star_label }}★</span>
                <span class="opr__bar-track"><span class="opr__bar-fill" style="width: {{ pct }}%;"></span></span>
                <span class="opr__bar-count">{{ bar_count }}</span>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if review_count > 0 -%}
      <div class="opr__carousel-wrap">
        <button class="opr__nav opr__nav--prev" type="button" data-opr-prev aria-label="Previous reviews">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <div class="opr__carousel" data-opr-track tabindex="0" role="region" aria-label="Customer reviews">
          {%- for block in review_blocks -%}
            {%- assign rating = block.settings.rating | times: 1 -%}
            {%- assign author = block.settings.author | default: 'Verified Buyer' -%}
            <article class="opr__card" {{ block.shopify_attributes }}>
              <div class="opr__card-top">
                <span class="opr__avatar" aria-hidden="true">{{ author | strip | slice: 0 | upcase }}</span>
                <div class="opr__who">
                  <span class="opr__author">{{ author }}</span>
                  {%- if block.settings.verified -%}
                    <span class="opr__verified">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      Verified Purchase
                    </span>
                  {%- endif -%}
                </div>
                {%- if block.settings.date != blank -%}
                  <span class="opr__date">{{ block.settings.date }}</span>
                {%- endif -%}
              </div>

              <div class="opr__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="opr__star{% if i > rating %} opr__star--empty{% endif %}">{{ star_svg }}</span>
                {%- endfor -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="opr__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <p class="opr__card-body">{{ block.settings.body }}</p>
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                <div class="opr__card-media">
                  {{
                    block.settings.image
                    | image_url: width: 320
                    | image_tag: class: 'opr__card-img', loading: 'lazy', widths: '160,320,480', alt: block.settings.title
                  }}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <button class="opr__nav opr__nav--next" type="button" data-opr-next aria-label="Next reviews">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var section = document.getElementById('opr-{{ section.id }}');
  if (!section) return;

  var track   = section.querySelector('[data-opr-track]');
  var prevBtn = section.querySelector('[data-opr-prev]');
  var nextBtn = section.querySelector('[data-opr-next]');
  if (!track || !prevBtn || !nextBtn) return;

  function scrollAmount() {
    var card = track.querySelector('.opr__card');
    if (!card) return 320;
    var gap = parseInt(getComputedStyle(track).gap) || 20;
    return card.offsetWidth + gap;
  }

  nextBtn.addEventListener('click', function () {
    track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
  });
  prevBtn.addEventListener('click', function () {
    track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
  });

  function updateArrows() {
    var atStart = track.scrollLeft <= 4;
    var atEnd   = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    prevBtn.disabled = atStart;
    nextBtn.disabled = atEnd;
  }

  track.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();

  /* Drag to scroll (pointer devices) */
  var dragging = false, startX = 0, startScroll = 0, moved = false;

  track.addEventListener('mousedown', function (e) {
    dragging = true; moved = false;
    startX = e.pageX;
    startScroll = track.scrollLeft;
    track.classList.add('is-dragging');
  });

  document.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    var delta = e.pageX - startX;
    if (Math.abs(delta) > 3) moved = true;
    track.scrollLeft = startScroll - delta;
  });

  document.addEventListener('mouseup', function () {
    if (!dragging) return;
    dragging = false;
    track.classList.remove('is-dragging');
  });

  track.addEventListener('click', function (e) {
    if (moved) { e.preventDefault(); e.stopPropagation(); }
  }, true);
})();
</script>


{% schema %}
{
  "name": "PDP Reviews",
  "tag": "section",
  "class": "ossian-pdp-reviews-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "REAL RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "paragraph",
      "content": "The rating average and breakdown are calculated from the review blocks below."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer name",
          "default": "Anjali S."
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ],
          "default": "5"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date label",
          "default": "12 Aug 2026"
