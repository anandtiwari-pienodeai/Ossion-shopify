<div class="ossian-science-wrap">
<div class="ossian-science-wrap__dots" aria-hidden="true"></div>
<div
  class="ossian-science"
  style="
    {%- if section.settings.background_image != blank -%}
      --science-bg: image-set(
        url('{{ section.settings.background_image | image_url: width: 750 }}') 1x,
        url('{{ section.settings.background_image | image_url: width: 1500 }}') 2x,
        url('{{ section.settings.background_image | image_url: width: 1920 }}') 3x
      );
    {%- else -%}
      --science-bg: none;
    {%- endif -%}
  "
>
  <div class="ossian-science__card page-width">
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h2 class="ossian-science__heading">
        {%- if section.settings.heading != blank -%}<span>{{ section.settings.heading }}</span>{%- endif -%}
        {%- if section.settings.heading_accent != blank -%}<span class="ossian-science__heading-accent">{{ section.settings.heading_accent }}</span>{%- endif -%}
      </h2>
      <svg class="ossian-science__squiggle" width="70" height="14" viewBox="0 0 70 14" fill="none" aria-hidden="true">
        <path d="M2 7c4-8 10-8 14 0s10 8 14 0 10-8 14 0 10 8 14 0 8-6 10-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="ossian-science__description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ossian-science__badges">
        {%- for block in section.blocks -%}
          <div class="ossian-science__badge" {{ block.shopify_attributes }}>
            <div class="ossian-science__badge-icon">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 100
                  | image_tag:
                    class: 'ossian-science__badge-img',
                    loading: 'lazy'
                }}
              {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'leaf' -%}
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none">
                      <path d="M21 34C13 30 9 22 12 13c9-1 17 3 19 11 2 8-3 13-10 10z" fill="#3fa74a"/>
                      <path d="M21 34V16" stroke="#2c7a37" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  {%- when 'wave' -%}
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none">
                      <path d="M21 6c5 5 9 10 6 17-2 5-8 6-11 2-2-3-1-6 1-7 3-1 5 1 4 4" stroke="#1e8a9e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="#bfe6ec"/>
                      <path d="M8 30c3-2 6-2 9 0s6 2 9 0 6-2 8 0" stroke="#1e8a9e" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none">
                      <path d="M21 6c5 7 10 13 10 18a10 10 0 01-20 0c0-5 5-11 10-18z" fill="#2f6fed"/>
                      <path d="M9 32c3-2 6-2 9 0s6 2 9 0" stroke="#1e8a9e" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}
              <span class="ossian-science__badge-label">{{ block.settings.label }}</span>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="ossian-science__badge-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.quiz_text != blank or section.settings.button_label != blank -%}
      <div class="ossian-science__quiz">
        <div class="ossian-science__quiz-info">
          <span class="ossian-science__quiz-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6a1 1 0 0 1 1 1v1H8V4a1 1 0 0 1 1-1Z"/><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9.5 12a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.4v.3"/><circle cx="12" cy="18.5" r=".6" fill="white" stroke="none"/></svg>
          </span>
          {%- if section.settings.quiz_text != blank -%}
            <p class="ossian-science__quiz-text">{{ section.settings.quiz_text }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: '#' }}" class="ossian-science__cta">
            {{ section.settings.button_label }}
            <svg width="20" height="12" viewBox="0 0 20 12" fill="none"><path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.banner_heading != blank or section.settings.banner_subheading_white != blank or section.settings.banner_subheading_accent != blank -%}
  <div class="otb">
    <div class="otb__inner page-width">

      <div class="otb__media otb__media--left">
        {%- if section.settings.banner_left_image != blank -%}
          {{ section.settings.banner_left_image | image_url: width: 700 | image_tag: class: 'otb__img', loading: 'lazy', widths: '300,500,700', alt: section.settings.banner_left_image_alt | default: '' }}
        {%- else -%}
          {{ 'ossion-science-left.png' | asset_url | image_tag: class: 'otb__img', loading: 'lazy', alt: section.settings.banner_left_image_alt | default: '' }}
        {%- endif -%}
      </div>

      <div class="otb__content">
        {%- if section.settings.banner_heading != blank -%}
          <h2 class="otb__heading">{{ section.settings.banner_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.banner_subheading_white != blank or section.settings.banner_subheading_accent != blank -%}
          <p class="otb__subheading">
            {%- if section.settings.banner_subheading_white != blank -%}<em class="otb__subheading-white">{{ section.settings.banner_subheading_white }}</em>{%- endif -%}
            {%- if section.settings.banner_subheading_accent != blank -%}<em class="otb__subheading-accent">{{ section.settings.banner_subheading_accent }}</em>{%- endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.banner_body != blank -%}
          <p class="otb__body">{{ section.settings.banner_body }}</p>
        {%- endif -%}
      </div>

      <div class="otb__media otb__media--right">
        {%- if section.settings.banner_right_image != blank -%}
          {{ section.settings.banner_right_image | image_url: width: 700 | image_tag: class: 'otb__img', loading: 'lazy', widths: '300,500,700', alt: section.settings.banner_right_image_alt | default: '' }}
        {%- else -%}
          {{ 'ossion-science-right.png' | asset_url | image_tag: class: 'otb__img', loading: 'lazy', alt: section.settings.banner_right_image_alt | default: '' }}
        {%- endif -%}
      </div>

    </div>
  </div>
{%- endif -%}
</div>

{% stylesheet %}
.ossian-science-wrap {
  position: relative;
  overflow: hidden;
  background: radial-gradient(120% 160% at 50% 0%, #16294f 0%, #0a1730 55%, #060f24 100%);
}

.ossian-science-wrap__dots {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.18) 1.5px, transparent 1.5px);
  background-size: 46px 46px;
  background-position: 10px 10px;
  mask-image: radial-gradient(60% 90% at 50% 50%, rgba(0, 0, 0, 0.6), transparent 100%);
  pointer-events: none;
}

.ossian-science {
  position: relative;
  z-index: 1;
  background: transparent;
  padding: clamp(16px, 3vh, 48px) 20px;
  min-height: 80svh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ossian-science__card {
  position: relative;
  z-index: 1;
  background: transparent;
  padding: clamp(18px, 2.5vh, 36px) clamp(20px, 4vw, 48px) clamp(14px, 2vh, 28px);
  text-align: center;
  max-width: 1080px;
  max-height: 100%;
  margin: 0 auto;
}

.ossian-science__heading {
  font-size: clamp(1.4rem, 2.6vw + 1vh, 2.25rem);
  font-weight: 800;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0;
}

.ossian-science__heading-accent {
  color: #dba84a;
  margin-left: 0.3em;
}

.ossian-science__squiggle {
  display: block;
  color: #dba84a;
  margin: 4px auto 12px;
}

.ossian-science__description {
  font-size: clamp(0.85rem, 1.1vw + 0.4vh, 1.05rem);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
  margin: 0 auto 20px;
  max-width: 700px;
}

.ossian-science__badges {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 20px;
}

.ossian-science__badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex: 1;
  max-width: 260px;
  padding: 0 24px;
  border-right: 1px solid rgba(255, 255, 255, 0.18);
}

.ossian-science__badge:last-child {
  border-right: none;
}

.ossian-science__badge-icon {
  width: clamp(52px, 6vw + 3vh, 84px);
  height: clamp(52px, 6vw + 3vh, 84px);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8px 20px rgba(30, 58, 95, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ossian-science__badge-img {
  width: 60%;
  height: 60%;
  object-fit: contain;
}

.ossian-science__badge-label {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: #ffffff;
  text-align: center;
}

.ossian-science__badge-desc {
  font-size: 0.78rem;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  margin: 0;
}

.ossian-science__quiz {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 18px;
  padding: 10px 10px 10px 18px;
  text-align: left;
}

.ossian-science__quiz-info {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.ossian-science__quiz-icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a63c9, #123a70);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ossian-science__quiz-text {
  font-size: 0.92rem;
  font-weight: 600;
  line-height: 1.3;
  color: #ffffff;
  margin: 0;
}

.ossian-science__cta {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10px;
  color: #ffffff;
  background: linear-gradient(135deg, #b8832a 0%, #dba84a 50%, #c9953a 100%);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 10px;
  transition: filter 0.2s;
}

.ossian-science__cta:hover {
  filter: brightness(1.08);
}

@media (max-width: 768px) {
  .ossian-science__card { padding: 24px 20px; }

  .ossian-science__badges {
    flex-wrap: wrap;
    row-gap: 16px;
    margin-bottom: 16px;
  }

  .ossian-science__badge {
    flex: 0 0 50%;
    max-width: none;
    border-right: none;
    padding: 0 10px;
  }

  .ossian-science__quiz {
    flex-direction: column;
    align-items: stretch;
    text-align: center;
  }

  .ossian-science__quiz-info { flex-direction: column; text-align: center; }
  .ossian-science__cta { justify-content: center; }
}

/* ── Transformation Banner (below the science card) ── */
.otb,
.otb * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.otb {
  position: relative;
  overflow: hidden;
  padding: 70px 20px;
}

.otb__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1.3fr 1fr;
  align-items: center;
  gap: 40px;
}

.otb__media {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
  min-height: 240px;
}

.otb__img {
  width: 100%;
  height: 100%;
  max-height: 320px;
  object-fit: contain;
  display: block;
}

.otb__img--placeholder {
  width: 100%;
  height: 240px;
  opacity: 0.55;
}

.otb__content {
  text-align: center;
  padding: 0 12px;
}

.otb__heading {
  font-size: clamp(2rem, 4vw, 3.25rem);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #ffffff;
  margin: 0 0 6px;
  line-height: 1.15;
}

.otb__subheading {
  margin: 0 0 22px;
  font-size: clamp(1.5rem, 2.6vw, 2.25rem);
  line-height: 1.2;
}

.otb__subheading-white,
.otb__subheading-accent {
  font-style: italic;
  font-weight: 500;
}

.otb__subheading-white {
  color: #ffffff;
}

.otb__subheading-accent {
  color: #dba84a;
  margin-left: 0.3em;
}

.otb__body {
  font-size: clamp(1rem, 1.3vw, 1.25rem);
  font-weight: 400;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.5;
  margin: 0 auto;
  max-width: 34ch;
}

@media (max-width: 900px) {
  .otb { padding: 48px 20px; }
  .otb__inner { grid-template-columns: 1fr; gap: 24px; }
  .otb__media { min-height: 180px; }
  .otb__media--left { order: 2; }
  .otb__content { order: 1; }
  .otb__media--right { order: 3; }
  .otb__img { max-height: 220px; }
}

@media (max-width: 600px) {
  .otb { padding: 40px 16px; }
  .otb__heading { font-size: 1.75rem; }
  .otb__subheading { font-size: 1.35rem; margin-bottom: 16px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ossion Science",
  "tag": "section",
  "class": "ossian-science-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (ocean/texture)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OSSION"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "SCIENCE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Lorem ipsum dolor sit amet consectetur. Non metus praesent enim diam fringilis. Sagittis nec convallis virra non risus auctor prom. Quis duam dui curabitur pharetra amet enim."
    },
    {
      "type": "header",
      "content": "Quiz bar"
    },
    {
      "type": "text",
      "id": "quiz_text",
      "label": "Quiz prompt text",
      "default": "Curious about what your skin or hair needs?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Quiz button label",
      "default": "TAKE THE QUIZ"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Quiz button URL"
    },
    {
      "type": "header",
      "content": "Transformation Banner"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading",
      "default": "Salon Choice"
    },
    {
      "type": "text",
      "id": "banner_subheading_white",
      "label": "Banner subheading (white, italic)",
      "default": "Real"
    },
    {
      "type": "text",
      "id": "banner_subheading_accent",
      "label": "Banner subheading accent (gold, italic)",
      "default": "Transformations"
    },
    {
      "type": "textarea",
      "id": "banner_body",
      "label": "Banner body text",
      "default": "Professional care, Real results, Loved by thousands"
    },
    {
      "type": "image_picker",
      "id": "banner_left_image",
      "label": "Banner left image"
    },
    {
      "type": "text",
      "id": "banner_left_image_alt",
      "label": "Banner left image alt text"
    },
    {
      "type": "image_picker",
      "id": "banner_right_image",
      "label": "Banner right image"
    },
    {
      "type": "text",
      "id": "banner_right_image_alt",
      "label": "Banner right image alt text"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Fallback icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "wave", "label": "Wave / Marine" }
          ],
          "default": "droplet"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "DERMAT TESTED"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Gentle on skin, tested for safety and purity."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Science",
      "settings": {
        "heading": "OSSION",
        "heading_accent": "SCIENCE",
        "quiz_text": "Curious about what your skin or hair needs?",
        "button_label": "TAKE THE QUIZ",
        "banner_heading": "Salon Choice",
        "banner_subheading_white": "Real",
        "banner_subheading_accent": "Transformations",
        "banner_body": "Professional care, Real results, Loved by thousands"
      },
      "blocks": [
        { "type": "badge", "settings": { "label": "DERMAT TESTED", "icon_type": "droplet", "description": "Gentle on skin, tested for safety and purity." } },
        { "type": "badge", "settings": { "label": "VEGAN FORMULA", "icon_type": "leaf", "description": "Plant-powered ingredients for a conscious choice." } },
        { "type": "badge", "settings": { "label": "MARINE TECHNOLOGY", "icon_type": "wave", "description": "Harnessing ocean science for effective solutions." } }
      ]
    }
  ]
}
{% endschema %}
