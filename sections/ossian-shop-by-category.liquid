<div class="ossian-sbc">
  <div class="page-width">
    <div class="ossian-sbc__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ossian-sbc__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ossian-sbc__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="ossian-sbc__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="ossian-sbc__card"
          {{ block.shopify_attributes }}
        >
          <div class="ossian-sbc__image-wrap">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 500
                | image_tag:
                  class: 'ossian-sbc__img',
                  loading: 'lazy',
                  widths: '250, 350, 500'
              }}
            {%- else -%}
              <div class="ossian-sbc__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
            <div class="ossian-sbc__card-overlay"></div>
          </div>
          <div class="ossian-sbc__card-info">
            <h3 class="ossian-sbc__card-name">{{ block.settings.name }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="ossian-sbc__card-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.tagline != blank -%}
      <p class="ossian-sbc__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ossian-sbc {
  padding: 64px 0;
  background: #fff;
}

.ossian-sbc__header {
  margin-bottom: 32px;
}

.ossian-sbc__eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.6;
  margin: 0 0 8px;
}

.ossian-sbc__heading {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 700;
  color: #1e3a5f;
  margin: 0;
  line-height: 1.2;
}

.ossian-sbc__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}

.ossian-sbc__card {
  display: block;
  text-decoration: none;
  color: inherit;
  border-radius: 12px;
  overflow: hidden;
  background: #f5f5f5;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.ossian-sbc__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(30,58,95,0.15);
}

.ossian-sbc__image-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.ossian-sbc__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.ossian-sbc__card:hover .ossian-sbc__img { transform: scale(1.06); }

.ossian-sbc__card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(30,58,95,0.5), transparent);
}

.ossian-sbc__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8e4df;
}

.ossian-sbc__card-info {
  padding: 16px;
  background: #1e3a5f;
}

.ossian-sbc__card-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 6px;
  line-height: 1.3;
}

.ossian-sbc__card-desc {
  font-size: 11px;
  color: rgba(255,255,255,0.7);
  margin: 0;
  line-height: 1.5;
}

.ossian-sbc__tagline {
  text-align: center;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #1e3a5f;
  opacity: 0.6;
  margin: 0;
}

@media (max-width: 990px) {
  .ossian-sbc__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 560px) {
  .ossian-sbc__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "ossian-sbc-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "OSSION SALONE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Bottom tagline",
      "default": "MARINE - BASED TECHNOLOGY  |  PROFESSIONAL USE  |  FREE SHIPPING ABOVE ₹999"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Heat Protector"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Smooth | Shield | Style"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Shop by Category",
      "settings": {
        "eyebrow": "OSSION SALONE",
        "heading": "Shop by Category",
        "tagline": "MARINE - BASED TECHNOLOGY  |  PROFESSIONAL USE  |  FREE SHIPPING ABOVE ₹999"
      },
      "blocks": [
        { "type": "category", "settings": { "name": "Heat Protector", "description": "Smooth | Shield | Style" } },
        { "type": "category", "settings": { "name": "Permanent Hair Color", "description": "Enriched with Amino Acids" } },
        { "type": "category", "settings": { "name": "Red Wine Wax", "description": "Enriched with Wine Polyphenol Extract" } },
        { "type": "category", "settings": { "name": "After-Wax Calming Oil", "description": "Leaves the skin soft, smooth and nourished" } }
      ]
    }
  ]
}
{% endschema %}
