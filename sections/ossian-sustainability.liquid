<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">

{%- assign commitment_blocks = section.blocks | where: 'type', 'commitment' -%}

<section class="osus" style="background-color: {{ section.settings.background_color }};">
  <div class="osus__inner page-width{% if section.settings.image_position == 'left' %} osus__inner--reverse{% endif %}">

    <div class="osus__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="osus__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="osus__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="osus__body">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if commitment_blocks.size > 0 -%}
        <div class="osus__commitments">
          {%- for block in commitment_blocks -%}
            <div class="osus__commitment" {{ block.shopify_attributes }}>
              <span class="osus__commitment-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'water' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2C12 2 5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13z"/></svg>
                  {%- when 'recycle' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/><path d="m10 15-3 3 3 3"/><path d="M13.379 4.264 15.71 8.5"/><path d="M17.5 8.5h-9"/><path d="m20 15-3-3-3 3"/></svg>
                  {%- when 'energy' -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 14.5H12L11 22l8.5-12.5H12L13 2z"/></svg>
                  {%- else -%}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 10.5 15 16 9"/></svg>
                {%- endcase -%}
              </span>
              <div class="osus__commitment-text">
                {%- if block.settings.label != blank -%}
                  <span class="osus__commitment-label">{{ block.settings.label }}</span>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <span class="osus__commitment-desc">{{ block.settings.description }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="osus__cta">
          {{ section.settings.cta_label }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="osus__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: class: 'osus__img', loading: 'lazy', widths: '400,600,800,900' }}
      {%- else -%}
        <div class="osus__img-ph"></div>
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
.osus,
.osus * {
  font-family: 'Jost', sans-serif;
  box-sizing: border-box;
}

.osus {
  padding: 80px 0;
}

.osus__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.osus__inner--reverse {
  direction: rtl;
}

.osus__inner--reverse > * {
  direction: ltr;
}

.osus__eyebrow {
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #2e9e4a;
  margin: 0 0 12px;
}

.osus__heading {
  font-size: clamp(1.9rem, 3.2vw, 2.75rem);
  font-weight: 700;
  color: #1e3a5f;
  line-height: 1.2;
  margin: 0 0 20px;
}

.osus__body {
  font-size: 1rem;
  line-height: 1.7;
  color: #45536b;
  margin: 0 0 28px;
}

.osus__body p { margin: 0 0 1em; }
.osus__body p:last-child { margin-bottom: 0; }

.osus__commitments {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 32px;
  padding-top: 8px;
  border-top: 1px solid rgba(30, 58, 95, 0.1);
}

.osus__commitment {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding-top: 18px;
}

.osus__commitment-icon {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #eaf6ee;
  color: #2e9e4a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.osus__commitment-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.osus__commitment-label {
  font-size: 0.95rem;
  font-weight: 700;
  color: #1e3a5f;
}

.osus__commitment-desc {
  font-size: 0.85rem;
  line-height: 1.45;
  color: #6b7a91;
}

.osus__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #1e3a5f;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid rgba(30, 58, 95, 0.35);
  padding-bottom: 2px;
  transition: border-color 0.2s;
}

.osus__cta:hover { border-color: #1e3a5f; }

.osus__media { position: relative; }

.osus__img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
  object-fit: cover;
}

.osus__img-ph {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 20px;
  background: #eaf6ee;
}

@media (max-width: 900px) {
  .osus { padding: 56px 0; }
  .osus__inner {
    grid-template-columns: 1fr;
    gap: 32px;
    direction: ltr;
  }
  .osus__media { order: -1; }
}

@media (max-width: 600px) {
  .osus { padding: 40px 0; }
  .osus__heading { font-size: clamp(1.6rem, 6vw, 2rem); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Sustainability",
  "tag": "section",
  "class": "ossian-sustainability-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "SUSTAINABILITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Committed to sustainability"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>We're reducing our footprint at every stage - from formulation to packaging - so professional results never come at the planet's expense.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "commitment",
      "name": "Commitment",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "water", "label": "Water" },
            { "value": "recycle", "label": "Packaging / Recycle" },
            { "value": "energy", "label": "Energy" },
            { "value": "check", "label": "Check" }
          ],
          "default": "water"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Water use"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Formulated to minimise water use across our supply chain."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainability",
      "blocks": [
        { "type": "commitment", "settings": { "icon": "water", "label": "Water use", "description": "Formulated to minimise water use across our supply chain." } },
        { "type": "commitment", "settings": { "icon": "recycle", "label": "Packaging", "description": "Moving toward recyclable and refillable packaging." } },
        { "type": "commitment", "settings": { "icon": "energy", "label": "Energy circularity", "description": "Manufacturing powered by renewable energy sources." } }
      ]
    }
  ]
}
{% endschema %}
