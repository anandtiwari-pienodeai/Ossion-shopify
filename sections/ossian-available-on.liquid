<div class="ossian-available">
  {%- if section.settings.heading != blank -%}
    <div class="page-width">
      <h2 class="ossian-available__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="ossian-available__track-outer">
    <div class="ossian-available__track">
      {%- comment -%}
        Repeat the logo set enough times that the track is always wider
        than any viewport — otherwise the -50% loop shows a visible gap
        of blank space once the (short) content runs out mid-scroll.
        Only the first set is real/accessible; the rest are aria-hidden
        duplicates purely for the marquee illusion.
      {%- endcomment -%}
      {%- for i in (1..10) -%}
        {%- if i == 1 -%}
          <div class="ossian-available__inner">
            {%- for block in section.blocks -%}
              <a
                href="{{ block.settings.url | default: '#' }}"
                class="ossian-available__logo"
                target="_blank"
                rel="noopener"
                aria-label="{{ block.settings.platform_name }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 240
                    | image_tag:
                      class: 'ossian-available__logo-img',
                      alt: block.settings.platform_name,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="ossian-available__logo-text">{{ block.settings.platform_name }}</span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="ossian-available__inner" aria-hidden="true">
            {%- for block in section.blocks -%}
              <div class="ossian-available__logo">
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 240
                    | image_tag:
                      class: 'ossian-available__logo-img',
                      alt: block.settings.platform_name,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="ossian-available__logo-text">{{ block.settings.platform_name }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
/* ── Section ── */
.ossian-available {
  background: #fff;
  padding: 52px 0 20px;
  overflow: hidden;
}

/* ── Heading ── */
.ossian-available__heading {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 900;
  color: #1e3a5f;
  text-align: center;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0 0 36px;
}

/* ── Marquee outer: full bleed ── */
.ossian-available__track-outer {
  overflow: hidden;
  width: 100%;
  /* Soft fade at the edges */
  mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    transparent 0%,
    black 8%,
    black 92%,
    transparent 100%
  );
}

/* ── Marquee track: 10 identical sets in a row (keeps the track wider
   than any viewport so the loop never runs out of content) ── */
.ossian-available__track {
  display: flex;
  width: max-content;
  animation: ossian-available-scroll 110s linear infinite;
}

.ossian-available__track:hover {
  animation-play-state: paused;
}

.ossian-available__inner {
  display: flex;
  align-items: center;
  gap: 20px;
  padding-right: 20px;
}

/* ── Logo tile ── */
.ossian-available__logo {
  flex-shrink: 0;
  width: clamp(100px, 9vw, 140px);
  height: clamp(100px, 2vw, 140px);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20px;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.ossian-available__logo:hover {
  transform: scale(1.06);
  box-shadow: 0 8px 28px rgba(30,58,95,0.18);
}

.ossian-available__logo-img {
  width: 80%;
  height: 80%;
  object-fit: contain;
  border-radius: 0;
}

.ossian-available__logo-text {
  font-size: clamp(11px, 1.2vw, 14px);
  font-weight: 700;
  color: #1e3a5f;
  text-align: center;
  padding: 8px;
  line-height: 1.3;
}

/* ── Keyframe ── */
@keyframes ossian-available-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ── Accessibility: reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .ossian-available__track {
    animation: none;
    justify-content: center;
    width: 100%;
    flex-wrap: wrap;
    gap: 16px;
    padding: 0 20px;
  }
  .ossian-available__inner[aria-hidden="true"] { display: none; }
  .ossian-available__inner { flex-wrap: wrap; justify-content: center; }
}

/* ── Large desktop (≥1400px) ── */
@media (min-width: 1400px) {
  .ossian-available { padding: 60px 0 20px; }
  .ossian-available__inner { gap: 28px; padding-right: 28px; }
}

/* ── Tablet (769px–1023px) ── */
@media (min-width: 769px) and (max-width: 1023px) {
  .ossian-available { padding: 44px 0 48px; }
  .ossian-available__heading { margin: 0 0 28px; }
  .ossian-available__logo { width: 110px; height: 110px; border-radius: 16px; }
  .ossian-available__inner { gap: 16px; padding-right: 16px; }
}

/* ── Mobile (≤768px) ── */
@media (max-width: 768px) {
  .ossian-available { padding: 32px 0 36px; }

  .ossian-available__heading {
    font-size: clamp(1.3rem, 5vw, 1.8rem);
    margin: 0 0 24px;
    padding: 0 16px;
  }

  .ossian-available__logo {
    width: 80px;
    height: 80px;
    border-radius: 14px;
  }

  .ossian-available__logo-text { font-size: 10px; padding: 6px; }

  .ossian-available__inner { gap: 12px; padding-right: 12px; }

  /* Slower on mobile (fewer logos visible) */
  .ossian-available__track { animation-duration: 80s; }

  /* Narrower fade zone on small screens */
  .ossian-available__track-outer {
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
  }
}

/* ── Small mobile (≤380px) ── */
@media (max-width: 380px) {
  .ossian-available__logo { width: 68px; height: 68px; border-radius: 12px; }
  .ossian-available__inner { gap: 10px; padding-right: 10px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Available On",
  "tag": "section",
  "class": "ossian-available-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE'RE ALSO AVAILABLE ON"
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        {
          "type": "text",
          "id": "platform_name",
          "label": "Platform name",
          "default": "Amazon"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Available On",
      "settings": { "heading": "WE'RE ALSO AVAILABLE ON" },
      "blocks": [
        { "type": "platform", "settings": { "platform_name": "Blinkit" } },
        { "type": "platform", "settings": { "platform_name": "Amazon" } },
        { "type": "platform", "settings": { "platform_name": "Zepto" } },
        { "type": "platform", "settings": { "platform_name": "Swiggy Instamart" } }
      ]
    }
  ]
}
{% endschema %}
