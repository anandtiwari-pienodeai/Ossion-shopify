<div class="ossian-available">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ossian-available__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="ossian-available__track-outer">
      <div class="ossian-available__track">
        <div class="ossian-available__inner">
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.url | default: '#' }}"
              class="ossian-available__logo"
              target="_blank"
              rel="noopener"
              aria-label="{{ block.settings.platform_name }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 200
                  | image_tag:
                    class: 'ossian-available__logo-img',
                    alt: block.settings.platform_name,
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="ossian-available__logo-text">{{ block.settings.platform_name }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
        <div class="ossian-available__inner" aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="ossian-available__logo">
              {%- if block.settings.logo != blank -%}
                {{
                  block.settings.logo
                  | image_url: width: 200
                  | image_tag:
                    class: 'ossian-available__logo-img',
                    alt: block.settings.platform_name,
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="ossian-available__logo-text">{{ block.settings.platform_name }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.ossian-available {
  background: #eef2f8;
  padding: 56px 0;
  overflow: hidden;
}

.ossian-available__heading {
  font-size: clamp(1.4rem, 2.5vw, 2rem);
  font-weight: 900;
  color: #1e3a5f;
  text-align: center;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0 0 40px;
}

.ossian-available__track-outer {
  overflow: hidden;
  width: 100%;
}

.ossian-available__track {
  display: flex;
  width: max-content;
  animation: ossian-available-scroll 20s linear infinite;
}

.ossian-available__inner {
  display: flex;
  align-items: center;
  gap: 24px;
  padding-right: 24px;
}

.ossian-available__logo {
  flex-shrink: 0;
  width: 140px;
  height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
}

.ossian-available__logo:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 24px rgba(30,58,95,0.15);
}

.ossian-available__logo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 24px;
}

.ossian-available__logo-text {
  font-size: 14px;
  font-weight: 700;
  color: #1e3a5f;
  text-align: center;
  padding: 8px;
}

@keyframes ossian-available-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .ossian-available__track { animation: none; }
  .ossian-available__inner[aria-hidden="true"] { display: none; }
}

@media (max-width: 768px) {
  .ossian-available__logo { width: 100px; height: 100px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Available On",
  "tag": "section",
  "class": "ossian-available-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE'RE ALSO AVAILABLE ON"
    }
  ],
  "blocks": [
    {
      "type": "platform",
      "name": "Platform",
      "settings": [
        {
          "type": "text",
          "id": "platform_name",
          "label": "Platform name",
          "default": "Amazon"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossion Available On",
      "settings": { "heading": "WE'RE ALSO AVAILABLE ON" },
      "blocks": [
        { "type": "platform", "settings": { "platform_name": "Blinkit" } },
        { "type": "platform", "settings": { "platform_name": "Amazon" } },
        { "type": "platform", "settings": { "platform_name": "Zepto" } },
        { "type": "platform", "settings": { "platform_name": "Swiggy Instamart" } }
      ]
    }
  ]
}
{% endschema %}
