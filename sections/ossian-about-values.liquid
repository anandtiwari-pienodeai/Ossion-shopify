{{ 'section-ossian-about-values.css' | asset_url | stylesheet_tag }}
{% comment %}
  Section contract.
  Row of brand values: outlined icon circle, title and short text per block.
  Four across on desktop, two across on mobile.
  @example
  <!-- templates/page.about.json → about_values -->
{% endcomment %}

{%- render 'ossian-about-styles' -%}

<section class="oab oabv" id="oabv-{{ section.id }}" style="--oabv-bg: {{ section.settings.background }};">
  <div class="oab-wrap">
    {%- if section.blocks.size > 0 -%}
      <ul class="oabv__list" role="list">
        {%- for block in section.blocks -%}
          <li class="oabv__item" {{ block.shopify_attributes }}>
            <span class="oabv__icon">{%- render 'ossian-about-icon', icon: block.settings.icon -%}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="oabv__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="oabv__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "Ossian About Values",
  "tag": "div",
  "class": "section-ossian-about-values",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#eef3fb" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "diamond",
          "options": [
            { "value": "diamond", "label": "Diamond" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "people", "label": "People" },
            { "value": "shield", "label": "Shield" },
            { "value": "badge", "label": "Badge" },
            { "value": "heart", "label": "Heart" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "molecule", "label": "Molecule" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Salon Trusted" },
        { "type": "text", "id": "text", "label": "Text", "default": "Preferred by professionals" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ossian About Values",
      "blocks": [
        { "type": "value", "settings": { "icon": "diamond", "title": "Salon Trusted", "text": "Preferred by professionals" } },
        { "type": "value", "settings": { "icon": "flask", "title": "Science Backed", "text": "Advanced formulations for real results" } },
        { "type": "value", "settings": { "icon": "leaf", "title": "Gentle & Effective", "text": "Caring for your hair & skin" } },
        { "type": "value", "settings": { "icon": "people", "title": "For Everyone", "text": "Quality care, accessible to all" } }
      ]
    }
  ]
}
{% endschema %}
